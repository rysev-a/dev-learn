# Скопируйте в deploy/.env и заполните. Файл .env в git не кладём.

# Адрес сайта: домен (Caddy сам получит HTTPS-сертификат) или :80 для проверки по обычному HTTP без домена
SAY_SITE=say.example.com
# Порты на хосте (если 80/443 заняты, например другим прокси)
SAY_HTTP_PORT=80
SAY_HTTPS_PORT=443
# 1 — cookie сессии только по HTTPS (для домена); 0 — только для проверки по :80
SAY_SECURE_COOKIE=1

# Общий секрет API и воркера: openssl rand -hex 32
SAY_WORKER_TOKEN=change-me

# Слоты проверок: не больше числа ядер, выделенных dind (SAY_SANDBOX_CPUS)
SAY_LIGHT_SLOTS=2
SAY_HEAVY_SLOTS=1
# Потолок ресурсов ВСЕХ песочниц сразу (cgroup контейнера dind) — чтобы код учеников не ронял сайт
SAY_SANDBOX_CPUS=3
SAY_SANDBOX_MEM=6g
