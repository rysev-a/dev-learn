# Скопируйте в deploy/.env и заполните. Файл .env в git не кладём.

# Образы: реестр с косой чертой на конце (пусто — локальные образы) и тег; нужны, только если образы собирают не на сервере
# SAY_REGISTRY=ghcr.io/owner/
# SAY_TAG=latest

# Рабочий режим: домен и HTTPS (Let's Encrypt). Без этого Traefik отдаёт сайт только по HTTP (traefik/http.yml)
# SAY_DOMAIN=say.example.com
# SAY_TRAEFIK_CONFIG=./traefik/tls.yml
# ACME_EMAIL=
# Публичный адрес сайта (для ссылок в письмах): https://домен или http://адрес-машины
SAY_URL=https://say.example.com
# Порты Traefik на хосте (если 80/443 заняты)
SAY_HTTP_PORT=80
SAY_HTTPS_PORT=443

# Общий секрет API и воркера: openssl rand -hex 32
SAY_WORKER_TOKEN=change-me

# Потолок очереди проверок кода (дальше — 503 и окно о перегрузке)
SAY_QUEUE_LIMIT=40

# Слоты проверок: не больше числа ядер, выделенных dind (SAY_SANDBOX_CPUS)
SAY_LIGHT_SLOTS=2
SAY_HEAVY_SLOTS=1
# Потолок ресурсов ВСЕХ песочниц сразу (cgroup контейнера dind) — чтобы код учеников не ронял сайт
SAY_SANDBOX_CPUS=3
SAY_SANDBOX_MEM=6g

# --- SurrealDB и вход ---
# пароль root-пользователя SurrealDB и начальный администратор (вход по email)
SURREAL_PASS=change-me-too
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# почта для подтверждения адреса и сброса пароля; без SMTP_HOST письма никуда не уходят (видны только в задачах админки)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
SITE_NAME=CS.Core
