# Copy to deploy/.env and fill in. The .env file is not committed to git.

# Images: registry with a trailing slash (empty means local images) and tag; needed only if images are not built on the server
# CS_CORE_REGISTRY=ghcr.io/owner/
# CS_CORE_TAG=latest

# Production mode: domain and HTTPS (Let's Encrypt). Without it Traefik serves the site over HTTP only (traefik/http.yml)
# CS_CORE_DOMAIN=cs-core.example.com
# CS_CORE_TRAEFIK_CONFIG=./traefik/tls.yml
# ACME_EMAIL=
# Public site address (for links in emails): https://domain or http://machine-address
CS_CORE_URL=https://cs-core.example.com
# Traefik ports on the host (if 80/443 are taken)
CS_CORE_HTTP_PORT=80
CS_CORE_HTTPS_PORT=443

# Shared secret of the API and the worker: openssl rand -hex 32
CS_CORE_WORKER_TOKEN=change-me

# Code-check queue limit (beyond it: 503 and an overload notice)
CS_CORE_QUEUE_LIMIT=40

# Check slots: no more than the number of cores given to dind (CS_CORE_SANDBOX_CPUS)
CS_CORE_LIGHT_SLOTS=2
CS_CORE_HEAVY_SLOTS=1
# Resource cap for ALL sandboxes together (dind container cgroup), so students' code cannot bring the site down
CS_CORE_SANDBOX_CPUS=3
CS_CORE_SANDBOX_MEM=6g

# --- SurrealDB and sign-in ---
# SurrealDB root password and the initial administrator (sign-in by email)
SURREAL_PASS=change-me-too
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# mail for address confirmation and password reset; without SMTP_HOST no mail is sent (visible only in admin tasks)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
SITE_NAME=CS.Core
