# Frontend behind Traefik: inside the network we listen on plain HTTP (CS_CORE_SITE=:80), Traefik handles HTTPS and certificates
{$CS_CORE_SITE:localhost} {
	encode zstd gzip

	# The worker API is reachable only inside the compose network (the worker calls api:8000 directly)
	@internal path /internal/*
	handle @internal {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}
