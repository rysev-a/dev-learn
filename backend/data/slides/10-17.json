ётся литералом, поля читают через точку; если имя переменной совпало с полем, его не повторяют","Поля лежат подряд на стеке: два i32 дают восемь байт — никаких заголовков объекта, как в питоне","Процессор любит выровненные адреса: в repr(C) между полями появляется пустое место, а раст сам переставит поля и сэкономит его"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["struct Point { x: i32, y: i32 }","let p = Point { x: 1, y: 2 };","println!(\"{}\", p.x);"],"hl":[1],"lang":"rust","size":10.0,"lh":18.0,"w":320.0}],[{"t":"cell","id":"m0","x":130.0,"y":70.0,"w":98.0,"h":26.0,"text":"x = 1","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"m1","x":230.0,"y":70.0,"w":98.0,"h":26.0,"text":"y = 2","tone":"green","size":8.5,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":104.0,"text":"size_of::<Point>() = 8","size":10.0,"mono":true},{"t":"text","id":"a","x":130.0,"y":46.0,"text":"+0","size":8.5},{"t":"text","id":"b","x":230.0,"y":46.0,"text":"+4","size":8.5}],[{"t":"text","id":"l1","x":180.0,"y":20.0,"text":"#[repr(C)] { a: u8, b: u32, c: u8 }  = 12 байт","size":8.5,"mono":true},{"t":"cell","id":"c0","x":36.0,"y":44.0,"w":22.0,"h":26.0,"text":"a","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"c1","x":84.0,"y":44.0,"w":70.0,"h":26.0,"text":"пусто","tone":"muted","size":8.5,"sub_size":8.5},{"t":"cell","id":"c2","x":168.0,"y":44.0,"w":94.0,"h":26.0,"text":"b","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"c3","x":228.0,"y":44.0,"w":22.0,"h":26.0,"text":"c","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"c4","x":276.0,"y":44.0,"w":70.0,"h":26.0,"text":"пусто","tone":"muted","size":8.5,"sub_size":8.5},{"t":"text","id":"l2","x":180.0,"y":100.0,"text":"по умолчанию раст переставляет: b, a, c  = 8 байт","size":8.5,"mono":true},{"t":"cell","id":"r0","x":108.0,"y":124.0,"w":94.0,"h":26.0,"text":"b","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"r1","x":168.0,"y":124.0,"w":22.0,"h":26.0,"text":"a","tone":"gre