","util.h:","config.h:   # -MP: фиктивные цели"],"hl":[0],"lang":"c","size":9.5,"lh":24.0,"w":345.0}],[{"t":"code","id":"c~code","x":20.0,"y":40.0,"lines":["CFLAGS += -MMD -MP","-include $(OBJ:.o=.d)"],"hl":[0,1],"lang":"c","size":11.0,"lh":28.0,"w":320.0}]],"cues":[19.3,20.3]}]},{"title":"Структура проекта","sub":"Каталоги и флаги","short":"Структура","main":"Публичные и внутренние заголовки; -Wall -Wextra.","body":[{"t":"scene","labels":["Каталоги","Публичное и внутреннее","Предупреждения"],"captions":["src — исходники, include — публичные заголовки, tests — тесты, build — результаты, которые можно удалить целиком","Публичный заголовок содержит только нужное клиентам; внутренний лежит рядом с исходниками","Всегда -Wall -Wextra, для релиза — оптимизация; крупные проекты используют CMake — генератор тех же графов зависимостей"],"frames":[[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["project/","  src/      include/","  tests/    build/","  Makefile"],"lang":"c","size":11.0,"lh":24.0,"w":320.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":120.0,"h":28.0,"text":"include/util.h","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":104.0,"w":120.0,"h":28.0,"text":"src/util_impl.h","tone":"blue","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":280.0,"y":60.0,"text":"для клиентов","size":9.5},{"t":"text","id":"m","x":280.0,"y":104.0,"text":"только свои","size":9.5}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["CFLAGS = -Wall -Wextra -g","release: CFLAGS += -O2 -DNDEBUG"],"hl":[0,1],"lang":"c","size":10.0,"lh":28.0,"w":330.0}]],"cues":[13.1,27.7]}]},{"title":"Итоги","sub":"Что дальше","short":"Итоги","main":"Дальше — неопределённое поведение и санитайзеры.","body":[{"t":"scene","labels":["Файлы и имена","Библиотеки и make","Дальше"],"captions":["Каждый .c компилируется отдельно; определение одно, объявлений много; static скрывает имена, заголовки — интерфейс, непрозрачные типы — устройство","Релокации исправляют адреса; статические библ