ичего не меняем, changed=False","Иначе заменяем или добавляем и возвращаем changed=True"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["def ensure_line(lines, line, regexp):","    hits = [i for i, l in enumerate(lines)","            if re.search(regexp, l)]","    i = hits[-1] if hits else len(lines)","    if i < len(lines) and lines[i] == line:","        return False","    lines[i:i + 1] = [line]","    return True"],"hl":[1,2],"lang":"python","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["def ensure_line(lines, line, regexp):","    hits = [i for i, l in enumerate(lines)","            if re.search(regexp, l)]","    i = hits[-1] if hits else len(lines)","    if i < len(lines) and lines[i] == line:","        return False","    lines[i:i + 1] = [line]","    return True"],"hl":[3],"lang":"python","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["def ensure_line(lines, line, regexp):","    hits = [i for i, l in enumerate(lines)","            if re.search(regexp, l)]","    i = hits[-1] if hits else len(lines)","    if i < len(lines) and lines[i] == line:","        return False","    lines[i:i + 1] = [line]","    return True"],"hl":[4,5],"lang":"python","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["def ensure_line(lines, line, regexp):","    hits = [i for i, l in enumerate(lines)","            if re.search(regexp, l)]","    i = hits[-1] if hits else len(lines)","    if i < len(lines) and lines[i] == line:","        return False","    lines[i:i + 1] = [line]","    return True"],"hl":[6,7],"lang":"python","size":9.0,"lh":13.0,"w":320.0}]],"cues":[9.6,19.7,28.6]}]},{"title":"Драй-ран и дифф","sub":"Глава 23 · Python как слой управления","short":"Dry-run","main":"Тот же код без записи и дифф того, что изменилось бы.","body":[{"t":"scene","labels":["Утилиты","Ansible","Дифф","Предел"],"captions":["apt-get -s и rsync -n показывают действия без выполнения","ansib