 значение","entry(k).or_insert(v) вставляет, только если ключа нет, и возвращает &mut V","Counter и defaultdict(int) → *m.entry(w).or_insert(0) += 1 — одна строка, один поиск по ключу"],"frames":[[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["m.insert(\"a\", 1);   // None","m.insert(\"a\", 5);   // Some(1)"],"lang":"rust","size":11.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let e = m.entry(\"k\");","let v: &mut i32 = e.or_insert(0);"],"hl":[1],"lang":"rust","size":10.5,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["for w in text.split_whitespace() {","    *counts.entry(w).or_insert(0) += 1;","}"],"hl":[1],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}]],"cues":[12.4,27.9]}]},{"title":"entry глубже","sub":"or_default, and_modify","short":"entry глубже","main":"Группировка за один поиск.","body":[{"t":"scene","labels":["or_default","and_modify","Группировка"],"captions":["or_default() вставляет значение по умолчанию: 0, пустой вектор, пустую строку","and_modify(…) меняет, если ключ есть; or_insert_with(…) вычисляет значение лениво","defaultdict(list) → m.entry(k).or_default().push(v) — группировка за один поиск"],"frames":[[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["m.entry(k).or_default();   // 0, [], \"\""],"hl":[0],"lang":"rust","size":11.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["m.entry(k)","    .and_modify(|v| *v += 1)","    .or_insert(1);"],"hl":[1,2],"lang":"rust","size":11.0,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let mut g: HashMap<usize, Vec<&str>> = HashMap::new();","for w in words {","    g.entry(w.len()).or_default().push(w);","}"],"hl":[2],"lang":"rust","size":8.5,"lh":22.0,"w":340.0}]],"cues":[16.8,24.9]}]},{"title":"Перебор","sub":"Порядок","short":"Перебор","main":"iter, keys, values; порядок произволен.","body":[{"t":"scene","labels":["items → iter","Порядок","BTreeMap, IndexMap"],"captions":["items(), keys(), values() → it