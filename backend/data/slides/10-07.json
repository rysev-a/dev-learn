ому значению","v.iter().sum(), max(), min(), enumerate(), map, filter — цепочки итераторов"],"frames":[[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["for x in &v {","    println!(\"{x}\");","}"],"hl":[0],"lang":"rust","size":12.0,"lh":24.0,"w":310.0}],[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["for x in &mut v {","    *x += 1;","}"],"hl":[0,1],"lang":"rust","size":12.0,"lh":24.0,"w":310.0}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["let s: i32 = v.iter().sum();","let m = v.iter().max();   // Option","let big: Vec<i32> = v.iter()","    .filter(|x| **x > 1).cloned().collect();"],"lang":"rust","size":9.0,"lh":22.0,"w":340.0}]],"cues":[16.8,24.5]}]},{"title":"Изменение вектора","sub":"insert, remove, extend","short":"Изменение","main":"Методы изменения; нужен let mut.","body":[{"t":"scene","labels":["insert и remove","extend и clear","mut обязателен"],"captions":["insert(i, x) вставляет на позицию; remove(i) удаляет по индексу и возвращает значение","extend дописывает другой вектор, clear очищает, contains ищет, reverse переворачивает, dedup убирает соседние дубли","Менять вектор можно, только если он объявлен let mut — как и обычную переменную"],"frames":[[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["let mut v = vec![1, 2, 3];","v.insert(1, 9);   // [1, 9, 2, 3]","v.remove(0);      // [9, 2, 3]"],"hl":[1,2],"lang":"rust","size":10.5,"lh":22.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["v.extend([7, 8]);","v.contains(&7);   // true","v.reverse();","v.clear();"],"lang":"rust","size":11.0,"lh":22.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let v = vec![1, 2];","v.push(3);   // ✕ cannot borrow as mutable"],"hl":[1],"bad":[1],"lang":"rust","size":10.5,"lh":26.0,"w":340.0}]],"cues":[14.6,26.2]}]},{"title":"Сортировка и поиск","sub":"sort, binary_search","short":"Сортировка","main":"sort, sort_by_key, binary_search, max, min.","body":[{"t":"scene","labels":["sort","sort_by_key","Поиск"],"captions":["v.sort() упорядочив