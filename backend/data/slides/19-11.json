":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"VLAN: +4 к кадру, MTU не меняется","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"VXLAN: -50 (IPv4), -70 (IPv6)","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"Ethernet: 1500, jumbo 9000","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"VLAN: +4 к кадру, MTU не меняется","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"VXLAN: -50 (IPv4), -70 (IPv6)","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":180.0,"y":122.0,"w":280.0,"h":24.0,"text":"ping -M do -s MTU-28","tone":"green","size":9.0,"sub_size":8.5}]],"cues":[9.3,18.8,26.5]}]},{"title":"Диагностика MTU","sub":"Глава 11 · Сеть Linux","short":"Диагноз","main":"Малые пакеты идут, большие висят: ищем границу пингом.","body":[{"t":"scene","labels":["Симптом","Поиск","Локально","Маршрутизатор"],"captions":["Симптом: ping и ssh работают, большой файл или страница виснет","Ищем границу: ping -M do -s N, меняя N","message too long: мал MTU самого интерфейса","Frag needed and DF set (mtu = N): ответ маршрутизатора на пути"],"frames":[[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"ping идёт, большой файл висит","tone":"red","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"ping идёт, большой файл висит","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"ping -M do -s 1472 host","tone":"yellow","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"ping идёт, большой файл висит","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"ping -M do -s 1472 host","tone":"yellow","size":9.0,"sub_size":8.5},{