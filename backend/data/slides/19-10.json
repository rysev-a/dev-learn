","listening","learning","forwarding"],"captions":["blocking: порт слушает только служебные кадры BPDU","listening: 15 с, данные не пускает","learning: ещё 15 с, адреса запоминает, но не пересылает","forwarding: порт работает полностью; без STP порты сразу здесь"],"frames":[[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"blocking","tone":"red","size":8.5,"sub_size":8.5}],[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"blocking","tone":"red","size":8.5,"sub_size":8.5},{"t":"cell","id":"n1","x":135.0,"y":70.0,"w":76.0,"h":52.0,"text":"listening\n15 с","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":85.0,"y1":70.0,"x2":96.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6}],[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"blocking","tone":"red","size":8.5,"sub_size":8.5},{"t":"cell","id":"n1","x":135.0,"y":70.0,"w":76.0,"h":52.0,"text":"listening\n15 с","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":85.0,"y1":70.0,"x2":96.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"cell","id":"n2","x":224.0,"y":70.0,"w":76.0,"h":52.0,"text":"learning\n15 с","tone":"blue","size":8.5,"sub_size":8.5},{"t":"line","id":"a2","x1":174.0,"y1":70.0,"x2":185.0,"y2":70.0,"tone":"blue","arrow":true,"width":1.6}],[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"blocking","tone":"red","size":8.5,"sub_size":8.5},{"t":"cell","id":"n1","x":135.0,"y":70.0,"w":76.0,"h":52.0,"text":"listening\n15 с","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":85.0,"y1":70.0,"x2":96.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"cell","id":"n2","x":224.0,"y":70.0,"w":76.0,"h":52.0,"text":"learning\n15 с","tone":"blue","size":8.5,"sub_size":8.5},{"t":"line","id":"a2","x1":174.0,"y1":70.0,"x2":185.0,"y2":70.0,"tone":"blue","arrow":true,"width":1.6},{"t":"cell","id":"n3","x":313.0,"y":70.0,"w":76.0,"h":52.0,"text":"forwarding","tone":"green","size":8.5,