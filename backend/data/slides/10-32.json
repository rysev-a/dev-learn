futures"],"frames":[[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":230.0,"h":34.0,"text":"размер = размер + размер…","tone":"red","size":11.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["Box::pin(fact(n - 1)).await"],"hl":[0],"lang":"rust","size":12.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["let buf = vec![0u8; 1_000_000];   // в куче","work().await;"],"hl":[0],"lang":"rust","size":10.0,"lh":28.0,"w":340.0}]],"cues":[18.5,31.4]}]},{"title":"Отмена","sub":"Cancel safety","short":"Отмена","main":"Любой .await может быть последним.","body":[{"t":"scene","labels":["Любой .await — возможный конец","Cancel safety","Нет async Drop"],"captions":["Фьючер могут отбросить на любом .await: промежуточное состояние в локальных переменных пропадёт","Пример: часть данных уже прочитана в локальный буфер, чтение отменили в select! — данные потеряны","Асинхронного Drop в языке нет: очистка с ожиданием — явный метод close().await или отдельная задача"],"frames":[[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":230.0,"h":34.0,"text":"… .await ✂ drop","tone":"yellow","size":12.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["let n = rx.read(&mut buf).await?;   // часть в buf","select!{ … }   // отмена → buf пропал"],"hl":[1],"lang":"rust","size":8.5,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["conn.close().await;   // явно","// а не impl Drop с .await"],"hl":[0],"lang":"rust","size":11.0,"lh":28.0,"w":340.0}]],"cues":[13.5,30.1]}]},{"title":"Итоги","sub":"Что дальше","short":"Итоги","main":"Дальше — tokio.","body":[{"t":"scene","labels":["Запомнить","Правила","Дальше"],"captions":["async-блок — автомат с состояниями по .await; ссылки внутри → Pin; почти всё Unpin, кроме автоматов","spawn: Send + 'static — владение, Arc, move; guard std Mutex не через .await; рекурсия — Box::pin; код выдерживает отмену","Следующая глава — tokio: рантайм, #[tokio::main], spawn, JoinSet"],"frames":[[{"t":"cell","id