ер, границы и переполнение","Python: True + 1 = 2, 'a' — строка; Rust: bool не число, char и &str — разные типы","Python: int(\"5\"), float(n); Rust: parse, as, From — всегда явно, смешивать типы нельзя"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":36.0,"text":"int: любой\nразмер","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":36.0,"text":"i8…i128\nu8…u128","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":36.0,"text":"True + 1 → 2","tone":"muted","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":36.0,"text":"true + 1 ✕","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["# Python: int(\"5\") + 1","// Rust: \"5\".parse::<i32>()","//       .unwrap() + 1"],"hl":[1,2],"lang":"rust","size":10.5,"lh":22.0,"w":340.0}]],"cues":[15.5,20.7]}]},{"title":"Итоги","sub":"Что дальше","short":"Итоги","main":"Дальше — функции.","body":[{"t":"scene","labels":["Типы","Правила","Дальше"],"captions":["Целые: iN и uN; дробные: f32, f64; bool и char","Размер выбирайте по задаче: числа — i32, индексы — usize; переполнение и преобразования — явно; условие — только bool","Следующая глава — функции: как обернуть вычисление и вернуть значение"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"i32","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"f64","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"bool","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"char","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["let n: usize = 3;","let x = n as f64 / 2.0;","let ok = x > 1.0;","let ch = 'я';"],"lang":"rust","size":11.0,"lh":22.0,"w":340.0}],[{"t":"cell","id":"