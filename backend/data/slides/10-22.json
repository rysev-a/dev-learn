ь действие, проверить результат: три части, одна проверка по смыслу на тест","Таблица пар «вход → ожидаемое» прогоняется одним циклом; главное — граничные случаи: пусто, ноль, максимум, минус","Мутационная проверка: нарочно сломайте реализацию — хотя бы один тест обязан покраснеть"],"frames":[[{"t":"code","id":"c","x":14.0,"y":36.0,"lines":["let mut s = Stack::new();      // arrange","s.push(1);                     // act","assert_eq!(s.pop(), Some(1));  // assert"],"hl":[0,1,2],"lang":"rust","size":9.0,"lh":22.0,"w":350.0}],[{"t":"code","id":"c","x":14.0,"y":30.0,"lines":["let cases = [(0, 0), (1, 1), (-1, 1),","             (i32::MAX, i32::MAX)];","for (x, want) in cases {","    assert_eq!(abs(x), want);","}"],"hl":[0,1],"lang":"rust","size":9.5,"lh":17.0,"w":350.0}],[{"t":"cell","id":"g","x":100.0,"y":50.0,"w":150.0,"h":26.0,"text":"верная реализация: 0 провалов","tone":"green","size":8.0,"sub_size":8.5},{"t":"cell","id":"m","x":90.0,"y":90.0,"w":110.0,"h":26.0,"text":"мутант: abs → x","tone":"red","size":8.5,"sub_size":8.5},{"t":"cell","id":"r","x":280.0,"y":90.0,"w":110.0,"h":26.0,"text":"провалов ≥ 1","tone":"green","size":9.0,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":90.0,"x2":224.0,"y2":90.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":140.0,"text":"тесты, которые не краснеют — не тесты","size":9.5}]],"cues":[14.4,26.3]}]},{"title":"Ошибки библиотеки","sub":"Error, source, non_exhaustive","short":"Ошибки","main":"Свой enum, Display, Error, From; паника только при нарушении контракта.","body":[{"t":"scene","labels":["Перечисление ошибок","source()","non_exhaustive"],"captions":["Публичная функция возвращает Result со своим enum: Display для людей, Error для экосистемы, From для ?","Метод source() отдаёт причину — так строятся цепочки «не удалось прочитать конфиг: неверное число»","#[non_exhaustive] разрешает позже добавлять варианты без ломки совместимости; паниковать можно лишь при нарушении контракта"],"frames":[[{"