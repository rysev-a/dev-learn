н 0: пакет доходит до моста и дальше не идёт","sysctl -w включает пересылку до перезагрузки","Строка в файле /etc/sysctl.d/*.conf сохраняет значение","Политика drop для FORWARD требует отдельного правила"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sysctl net.ipv4.ip_forward","net.ipv4.ip_forward = 0","$ sudo sysctl -w net.ipv4.ip_forward=1","net.ipv4.ip_forward = 1","# survive a reboot:","net.ipv4.ip_forward = 1","  > /etc/sysctl.d/99-forward.conf","# FORWARD policy DROP: allow br0"],"hl":[0,1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sysctl net.ipv4.ip_forward","net.ipv4.ip_forward = 0","$ sudo sysctl -w net.ipv4.ip_forward=1","net.ipv4.ip_forward = 1","# survive a reboot:","net.ipv4.ip_forward = 1","  > /etc/sysctl.d/99-forward.conf","# FORWARD policy DROP: allow br0"],"hl":[2,3],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sysctl net.ipv4.ip_forward","net.ipv4.ip_forward = 0","$ sudo sysctl -w net.ipv4.ip_forward=1","net.ipv4.ip_forward = 1","# survive a reboot:","net.ipv4.ip_forward = 1","  > /etc/sysctl.d/99-forward.conf","# FORWARD policy DROP: allow br0"],"hl":[4,5,6],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sysctl net.ipv4.ip_forward","net.ipv4.ip_forward = 0","$ sudo sysctl -w net.ipv4.ip_forward=1","net.ipv4.ip_forward = 1","# survive a reboot:","net.ipv4.ip_forward = 1","  > /etc/sysctl.d/99-forward.conf","# FORWARD policy DROP: allow br0"],"hl":[7],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[14.1,22.7,33.2]}]},{"title":"Маскарад","sub":"Глава 12 · Сеть Linux","short":"NAT","main":"Правило в nat/postrouting подменяет частный адрес адресом выхода.","body":[{"t":"scene","labels":["iptables","nftables","Правило","Ответы"],"captions":["iptables: источник из подсети, выход не через br0","nftables: таблица ip nat и цепочка postrouting типа nat","Правило: подсеть, выход не через br0, masquerade","Ответы подменяет conntrack, обратных правил не нужно"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo iptables -t nat -A POSTROUTING \\","    -s 10.200.0.0/24 ! -o br0 -j MASQUERADE","# the same in nftables:","table ip nat {","  chain postrouting {","    type nat hook postrouting priority 100;","    ip saddr 10.200.0.0/24 oifname != \"br0\"","      masquerade","} }"],"hl":[0,1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo iptables -t nat -A POSTROUTING \\","    -s 10.200.0.0/24 ! -o br0 -j MASQUERADE","# the same in nftables:","table ip nat {","  chain postrouting {","    type nat hook postrouting priority 100;","    ip saddr 10.200.0.0/24 oifname != \"br0\"","      masquerade","} }"],"hl":[3,4,5],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo iptables -t nat -A POSTROUTING \\","    -s 10.200.0.0/24 ! -o br0 -j MASQUERADE","# the same in nftables:","table ip nat {","  chain postrouting {","    type nat hook postrouting priority 100;","    ip saddr 10.200.0.0/24 oifname != \"br0\"","      masquerade","} }"],"hl":[6,7],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo iptables -t nat -A POSTROUTING \\","    -s 10.200.0.0/24 ! -o br0 -j MASQUERADE","# the same in nftables:","table ip nat {","  chain postrouting {","    type nat hook postrouting priority 100;","    ip saddr 10.200.0.0/24 oifname != \"br0\"","      masquerade","} }"],"hl":[8],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[10.4,22.1,32.3]}]},{"title":"Таблица conntrack","sub":"Глава 12 · Сеть Linux","short":"conntrack","main":"Две четвёрки в строке: исходная и ответная показывают подмену.","body":[{"t":"scene","labels":["Команда","Исходная","Ответная","Вывод"],"captions":["conntrack -L -n отбирает записи подмены источника","Исходная: клиент 10.200.0.2 идёт на 203.0.113.9","Ответная: придёт на адрес хоста 192.168.1.10","Адрес получателя ответа не равен исходному источнику: это SNAT"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo conntrack -L -n","tcp 6 431982 ESTABLISHED"," src=10.200.0.2 dst=203.0.113.9"," sport=45678 dport=80"," src=203.0.113.9 dst=192.168.1.10"," sport=80 dport=45678 [ASSURED]","# reply dst != original src: SNAT"],"hl":[0,1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo conntrack -L -n","tcp 6 431982 ESTABLISHED"," src=10.200.0.2 dst=203.0.113.9"," sport=45678 dport=80"," src=203.0.113.9 dst=192.168.1.10"," sport=80 dport=45678 [ASSURED]","# reply dst != original src: SNAT"],"hl":[2,3],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo conntrack -L -n","tcp 6 431982 ESTABLISHED"," src=10.200.0.2 dst=203.0.113.9"," sport=45678 dport=80"," src=203.0.113.9 dst=192.168.1.10"," sport=80 dport=45678 [ASSURED]","# reply dst != original src: SNAT"],"hl":[4,5],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo conntrack -L -n","tcp 6 431982 ESTABLISHED"," src=10.200.0.2 dst=203.0.113.9"," sport=45678 dport=80"," src=203.0.113.9 dst=192.168.1.10"," sport=80 dport=45678 [ASSURED]","# reply dst != original src: SNAT"],"hl":[6],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[10.6,20.8,30.3]}]},{"title":"Публикация порта","sub":"Глава 12 · Сеть Linux","short":"DNAT","main":"DNAT в prerouting для внешних, в output для самого хоста.","body":[{"t":"scene","labels":["Внешние","С хоста","127.0.0.1","FORWARD"],"captions":["PREROUTING: порт 8080 хоста уходит на 10.200.0.2:80","OUTPUT: то же для соединений с самого хоста на его адрес","Для 127.0.0.1 обычно нужен route_localnet=1 или прокси","Пересылаемый пакет должен пройти правила FORWARD"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo iptables -t nat -A PREROUTING \\