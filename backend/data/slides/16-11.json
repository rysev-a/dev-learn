{"book":16,"chapter":11,"rubric":"ОТ ASSEMBLER К ЯЗЫКУ C / ПРОЕКТЫ И ИНСТРУМЕНТЫ / ГЛАВА 11","slides":[{"title":"Что такое UB","sub":"Глава 11 · гарантий нет","short":"UB","main":"Неопределённое поведение — полная свобода компилятора.","body":[{"t":"scene","labels":["Три вида","Свобода компилятора","Не «что-то странное»"],"captions":["Определяется реализацией (документировано), не специфицировано (несколько допустимых вариантов) и неопределённое поведение — стандарт ничего не обещает","При UB программа вправе работать, упасть, вернуть мусор или вести себя иначе в другой версии компилятора","Это не «странный результат», а отсутствие гарантий: компилятор не обязан проверять такие случаи и не станет"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":40.0,"w":140.0,"h":26.0,"text":"определяется реализацией","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":76.0,"w":140.0,"h":26.0,"text":"не специфицировано","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"cell","id":"c","x":90.0,"y":112.0,"w":140.0,"h":26.0,"text":"неопределённое (UB)","tone":"red","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":290.0,"y":76.0,"text":"от лучшего\nк худшему","size":9.5}],[{"t":"cell","id":"a","x":70.0,"y":40.0,"w":100.0,"h":26.0,"text":"работает","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":190.0,"y":40.0,"w":100.0,"h":26.0,"text":"падает","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":70.0,"y":90.0,"w":100.0,"h":26.0,"text":"мусор","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"d","x":190.0,"y":90.0,"w":100.0,"h":26.0,"text":"иначе завтра","tone":"muted","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":140.0,"text":"всё допустимо","size":9.5}],[{"t":"code","id":"c~code","x":20.0,"y":40.0,"lines":["int a[4];","a[4] = 1;   // ✕ UB — и неизвестно, что будет"],"bad":[1],"lang":"c","size":10.5,"lh":28.0,"w":330.0}]],"cues":[14.1,34.8]}]},{"title":"Основные группы","sub":"Память, арифметика, прочее","short":"Группы","main":"Границы, указатели, знаковая арифметика, алиасинг.","body":[{"t":"scene","labels":["Память","Арифметика","Прочее"],"captions":["Выход за границы, разыменование NULL и висячего указателя, чтение после free, двойной free, возврат адреса локальной","Переполнение знакового целого, деление на ноль, сдвиг на ширину типа и больше, чтение неинициализированной переменной","Строгий алиасинг и выравнивание, запись в строковый литерал, пересекающиеся memcpy, гонки данных потоков"],"frames":[[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["a[n] = 0;          // за границей","*p;               // p == NULL","free(p); *p;       // после free","return &local;    // кадра нет"],"lang":"c","size":10.0,"lh":22.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["INT_MAX + 1;       // UB","x / 0;             // UB","1u << 32;          // UB","int v; v + 1;       // UB"],"lang":"c","size":10.5,"lh":22.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["*(int *)&f;        // алиасинг","char *s = \"ab\"; s[0] = 'x';","memcpy(b + 2, b, 6);   // пересечение","// гонка потоков"],"lang":"c","size":9.5,"lh":22.0,"w":330.0}]],"cues":[15.5,27.2]}]},{"title":"Оптимизатор и UB","sub":"Рассуждение от противного","short":"Оптимизатор","main":"Проверки исчезают, ошибка видна только в -O2.","body":[{"t":"scene","labels":["x + 1 > x","Проверка после разыменования","Смотрим ассемблер"],"captions":["Для знакового x выражение x + 1 > x компилятор заменяет на истину: переполнения «не бывает»","if (!p) после *p удаляется как лишняя: раз разыменовали, значит p не NULL","gcc -O2 -S показывает, что осталось: проверки и ветки исчезают, а ошибка видна только в оптимизированной сборке"],"frames":[[{"t":"code","id":"c","x":10.0,"y":36.0,"lines":["int f(int x) { return x + 1 > x; }",""],"hl":[0],"lang":"c","size":10.0,"lh":24.0,"w":340.0},{"t":"code","id":"a","x":130.0,"y":100.0,"lines":["li a0, 1","ret"],"lang":"asm","size":10.0,"lh":18.0,"w":110.0},{"t":"text","id":"n","x":270.0,"y":106.0,"text":"всегда 1","tone":"yellow","size":9.5}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["int v = p->a;       // разыменовали","if (!p) return -1;  // удалено!","return v;"],"hl":[1],"bad":[1],"lang":"c","size":10.5,"lh":24.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["$ gcc -O2 -S main.c","$ gcc -O0 -S main.c"],"hl":[0],"lang":"c","size":11.0,"lh":28.0,"w":320.0}]],"cues":[18.6,30.9]}]},{"title":"Неинициализированные данные","sub":"Остатки на стеке","short":"Неинициализ.","main":"Инициализируйте при объявлении; calloc даёт нули.","body":[{"t":"scene","labels":["Остатки на стеке","malloc не обнуляет","Как защищаться"],"captions":["Локальная переменная получает то, что осталось на стеке от прошлых вызовов; читать её нельзя","malloc возвращает память как есть; нули даёт calloc; программа годами работает, пока там случайно лежит ноль","Инициализируйте при объявлении; -Wall -Wextra находят часть случаев; для остальных — MSan и Valgrind"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":50.0,"w":140.0,"h":26.0,"text":"кадр f: старые данные","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":86.0,"w":140.0,"h":26.0,"text":"кадр g: int s;","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"line","id":"e","x1":160.0,"y1":62.0,"x2":160.0,"y2":74.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"text","id":"n","x":280.0,"y":86.0,"text":"s = мусор\nот f","tone":"red","size":9.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["int *a = malloc(n * sizeof *a);   // не нули","int *b = calloc(n, sizeof *b);   // нули"],"hl":[1],"lang":"c","size":9.0,"lh":28.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["int s = 0;","int a[8] = {0};","-Wall -Wextra -Wmaybe-uninitialized"],"hl":[0,1],"lang":"c","size":10.5,"lh":24.0,"w":330.0}]],"cues":[12.9,23.9]}]},{"title":"Время жизни","sub":"Висячие указатели","short":"Время жизни","main":"Возврат локальной, use-after-free, выход из блока.","body":[{"t":"scene","labels":["Возврат локальной","После free","Вне блока"],"captions":["Функция вернула адрес своей локальной переменной: кадр исчез, указатель смотрит в никуда","free освободил блок, а указатель остался: память может годами хранить старые данные","Указатель на переменную блока, который закончился: то же самое на стеке"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["int *f(void) {","    int x = 5;","    return &x;   // ✕","}"],"bad":[2],"lang":"c","size":11.0,"lh":22.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["free(p);","*p = 1;        // ✕ use-after-free","p = NULL;      // защита"],"bad":[1],"lang":"c","size":10.5,"lh":26.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["int *p;","{ int x = 5; p = &x; }","*p;   // ✕ stack-use-after-scope"],"bad":[2],"lang":"c","size":10.5,"lh":24.0,"w":320.0}]],"cues":[12.2,23.9]}]},{"title":"Предупреждения и анализ","sub":"-Wall -Wextra -Werror","short":"Предупреждения","main":"Статические анализаторы находят ошибки на непройденных путях.","body":[{"t":"scene","labels":["Предупреждения","-Werror","Статический анализ"],"captions":["-Wall -Wextra -Wpedantic, а ещё -Wshadow, -Wconversion, -Wformat=2: затенение, потеря точности, неверные форматы","-Werror превращает предупреждения в ошибки: в чистой сборке каждое новое предупреждение сразу заметно","-fanalyzer в gcc, clang-tidy и cppcheck находят ошибки на путях, до которых тесты не добираются"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["gcc -Wall -Wextra -Wpedantic \\","    -Wshadow -Wconversion -Wformat=2 main.c"],"lang":"c","size":10.0,"lh":28.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["CFLAGS = -Wall -Wextra -Werror","main.c:7: error: unused variable 'x'"],"hl":[0],"lang":"c","size":10.0,"lh":28.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["gcc -fanalyzer main.c","clang-tidy main.c --","cppcheck --enable=all src/"],"lang":"c","size":10.5,"lh":24.0,"w":320.0}]],"cues":[15.4,23.7]}]},{"title":"AddressSanitizer","sub":"Красные зоны","short":"ASan","main":"Границы, use-after-free, double free и утечки с отчётом.","body":[{"t":"scene","labels":["Красные зоны","Что находит","Отчёт"],"captions":["ASan окружает блоки запретными зонами и ведёт теневую карту памяти: каждый байт — доступен он или нет","Выход за границы кучи, стека и глобальных данных, use-after-free, double free, утечки; замедление примерно в два раза","-fsanitize=address -g -fno-omit-frame-pointer даёт отчёт со стеком вызовов и указанием, где память выделена и освобождена"],"frames":[[{"t":"cell","id":"z0","x":70.0,"y":66.0,"w":96.0,"h":34.0,"text":"красная","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"z1","x":170.0,"y":66.0,"w":96.0,"h":34.0,"text":"данные","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"z2","x":270.0,"y":66.0,"w":96.0,"h":34.0,"text":"красная","tone":"red","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":124.0,"text":"доступ к красной зоне → отчёт и остановка","size":9.5}],[{"t":"cell","id":"a","x":90.0,"y":40.0,"w":130.0,"h":24.0,"text":"heap-buffer-overflow","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":70.0,"w":130.0,"h":24.0,"text":"stack-buffer-overflow","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"c","x":90.0,"y":100.0,"w":130.0,"h":24.0,"text":"heap-use-after-free","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"d","x":90.0,"y":130.0,"w":130.0,"h":24.0,"text":"detected memory leaks","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"text","id":"n","x":290.0,"y":86.0,"text":"×2 к времени","size":9.5}],[{"t":"code","id":"c~code","x":10.0,"y":30.0,"lines":["ERROR: AddressSanitizer: heap-buffer-overflow","WRITE of size 4 at 0x… thread T0","    #0 fill main.c:12","    #1 main main.c:30","allocated by thread T0 here:  #1 main main.c:28"],"hl":[2],"lang":"c","size":8.0,"lh":20.0,"w":350.0}]],"cues":[8.6,23.4]}]},{"title":"UBSan, MSan, TSan","sub":"Отдельные сборки","short":"UBSan","main":"-fsanitize=undefined и -fno-sanitize-recover=all.","body":[{"t":"scene","labels":["UBSan","Не продолжать","MSan и TSan"],"captions":["-fsanitize=undefined вставляет проверки: переполнение знаковых, сдвиги, деление на ноль, NULL, выравнивание, границы массивов, VLA","По умолчанию печатает и продолжает; -fno-sanitize-recover=all останавливает программу на первой ошибке","MSan (clang) — неинициализированные чтения, TSan — гонки данных; санитайзеры почти не совмещаются, делают отдельные сборки"],"frames":[[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["runtime error: signed integer overflow","runtime error: shift exponent 32 …","runtime error: division by zero","runtime error: index 8 out of bounds"],"bad":[0,1,2,3],"lang":"c","size":9.5,"lh":22.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["gcc -fsanitize=undefined \\","    -fno-sanitize-recover=all main.c"],"hl":[1],"lang":"c","size":10.5,"lh":28.0,"w":330.0}],[{"t":"cell","id":"a","x":80.0,"y":50.0,"w":110.0,"h":28.0,"text":"ASan + UBSan","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":80.0,"y":100.0,"w":110.0,"h":28.0,"text":"MSan","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c~cell","x":250.0,"y":50.0,"w":110.0,"h":28.0,"text":"TSan","tone":"blue","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":250.0,"y":105.0,"text":"отдельные\nсборки","size":9.5}]],"cues":[20.8,30.7]}]},{"title":"gdb","sub":"Точки остановки и стек","short":"gdb","main":"-g -O0; break, next, print, backtrace, watch.","body":[{"t":"scene","labels":["Сборка и запуск","Шаги и значения","Стек и память"],"captions":["Для gdb программу собирают с -g -O0: иначе переменные исчезают из кода; break ставит точку остановки, run запускает","next — строка без захода, step — с заходом, print — значение, watch — следить за переменной, finish — выйти из функции","backtrace показывает стек вызовов, x/8xw — память в шестнадцатеричном виде; дамп памяти позволяет разобрать аварию постфактум"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["$ gcc -g -O0 main.c -o app","$ gdb ./app","(gdb) break main","(gdb) run"],"hl":[2,3],"lang":"c","size":10.5,"lh":22.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["(gdb) next","(gdb) print n","$1 = 7","(gdb) watch total","(gdb) finish"],"hl":[1,3],"lang":"c","size":10.5,"lh":20.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["(gdb) backtrace","#0 sum (a=0x…, n=3) at main.c:8","#1 main () at main.c:20","(gdb) x/4xw a"],"hl":[0,3],"lang":"c","size":9.5,"lh":22.0,"w":330.0}]],"cues":[10.9,31.7]}]},{"title":"assert и тесты","sub":"Инварианты и регрессии","short":"assert","main":"Каждую найденную ошибку превращайте в тест.","body":[{"t":"scene","labels":["assert","static_assert","Тест из ошибки"],"captions":["assert(cond) проверяет инвариант и при нарушении печатает условие, файл и строку; -DNDEBUG его выключает — побочных эффектов внутри нет","_Static_assert проверяет условие при компиляции: размеры типов, константы","Трассировка в stderr с макросом места вызова часто быстрее отладчика; найденную ошибку превращают в регрессионный тест"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["#include <assert.h>","assert(i < n);","// Assertion `i < n' failed. main.c:12"],"hl":[1],"lang":"c","size":10.0,"lh":26.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["_Static_assert(sizeof(int) == 4,","                \"нужен 32-битный int\");"],"hl":[0],"lang":"c","size":10.5,"lh":28.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["#define TRACE(...) fprintf(stderr, __VA_ARGS__)","void test_bug_123(void) {","    assert(parse(\"1e\") == -1);","}"],"hl":[2],"lang":"c","size":9.0,"lh":22.0,"w":340.0}]],"cues":[21.1,26.1]}]},{"title":"Valgrind","sub":"Без пересборки","short":"Valgrind","main":"Запасной вариант; медленный, но точный.","body":[{"t":"scene","labels":["Без пересборки","Что находит","Когда нужен"],"captions":["Valgrind выполняет готовый файл на виртуальном процессоре и контролирует каждое обращение к памяти","Memcheck находит неинициализированные чтения, утечки и выход за границы кучи; замедление в десятки раз","Запасной вариант, когда исходники трудно пересобрать, и источник точного отчёта об утечках; чаще сначала ASan и UBSan"],"frames":[[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["$ valgrind ./app","==1234== Memcheck, a memory error detector"],"hl":[0],"lang":"c","size":10.5,"lh":28.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["Invalid read of size 4","Conditional jump depends on uninitialised value","100 bytes in 1 blocks are definitely lost"],"bad":[0,1,2],"lang":"c","size":9.0,"lh":24.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":120.0,"h":28.0,"text":"ASan + UBSan","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":250.0,"y":60.0,"w":110.0,"h":28.0,"text":"Valgrind","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":112.0,"text":"быстро — сначала; запасной — потом","size":9.5}]],"cues":[13.4,28.3]}]},{"title":"Метод поиска ошибки","sub":"Сокращение, бисекция, фаззинг","short":"Метод","main":"Воспроизвести, сократить, проверить гипотезу.","body":[{"t":"scene","labels":["Воспроизвести и сократить","Бисекция","Фаззинг"],"captions":["Воспроизведите надёжно, затем уменьшайте входные данные, пока ошибка сохраняется","Если ошибка появилась между версиями, двоичный поиск по истории находит виновный коммит за log₂ n шагов","Фаззер подаёт мутированные данные под санитайзерами и ловит аварии; каждая находка становится регрессионным тестом"],"frames":[[{"t":"cell","id":"a","x":60.0,"y":76.0,"w":80.0,"h":28.0,"text":"1000 байт","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":76.0,"w":80.0,"h":28.0,"text":"40 байт","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":300.0,"y":76.0,"w":80.0,"h":28.0,"text":"7 байт","tone":"green","size":10.0,"sub_size":8.5},{"t":"line","id":"e1","x1":100.0,"y1":76.