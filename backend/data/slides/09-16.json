,"Триггер INSTEAD OF перехватывает операцию и выполняет команды над таблицами","Простые представления на одной таблице в других СУБД обновляются автоматически"],"frames":[[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["INSERT INTO v_customer_totals VALUES (…);"],"bad":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"e","x":180.0,"y":100.0,"w":260.0,"h":26.0,"text":"cannot modify v — it is a view","tone":"red","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["CREATE TRIGGER v_ins INSTEAD OF INSERT","ON v BEGIN","  INSERT INTO customers (name) VALUES (NEW.name);","END;"],"hl":[0,2],"lang":"sql","size":9.0,"lh":13.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":40.0,"text":"простое представление:\nавтообновление","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":150.0,"h":40.0,"text":"JOIN и GROUP BY:\nневозможно","tone":"red","size":9.0,"sub_size":8.5}]],"cues":[12.9,25.7]}]},{"title":"Скорость","sub":"Встраивание","short":"Скорость","main":"Запрос к VIEW разворачивается в запрос к таблицам: индексы работают.","body":[{"t":"scene","labels":["Встраивание","Условие внутрь","Агрегаты"],"captions":["Запрос к представлению разворачивается в запрос к таблицам — индексы работают","Условие из внешнего запроса обычно проталкивается внутрь и уменьшает работу","Если внутри GROUP BY или окна, условие проталкивается не всегда — смотрите план"],"frames":[[{"t":"cell","id":"a","x":70.0,"y":70.0,"w":100.0,"h":34.0,"text":"SELECT …\nFROM v","tone":"blue","size":9.5,"sub_size":8.5},{"t":"line","id":"e","x1":122.0,"y1":70.0,"x2":138.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"b","x":250.0,"y":70.0,"w":160.0,"h":34.0,"text":"запрос к таблицам\nс их индексами","tone":"green","size":9.0,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["SELECT * FROM v_orders WHERE cust = 5;"],"hl":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"g","x":180.0,"y":100.0,"w":280.0,"h":26.0,"text":"→ WHERE cust = 5 внутри плана","tone":"green","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["EXPLAIN QUERY PLAN","SELECT * FROM v_totals WHERE cust = 5;"],"hl":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"text","id":"n","x":180.0,"y":100.0,"text":"проверяйте план запроса к VIEW","tone":"yellow","size":10.0}]],"cues":[12.1,24.3]}]},{"title":"Ограничения","sub":"Что помнить","short":"Ограничения","main":"Звёздочка в VIEW опасна; изменение таблиц может сломать представление.","body":[{"t":"scene","labels":["Звёздочка","Сломанная ссылка","ORDER BY внутри"],"captions":["SELECT * раскрывается при создании: новый столбец таблицы в представлении не появится","Переименовали или удалили столбец — обращение к VIEW даёт ошибку","ORDER BY внутри представления обычно бессмысленен: порядок задаёт вызывающий"],"frames":[[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["CREATE VIEW v AS SELECT * FROM t;","ALTER TABLE t ADD COLUMN extra …;"],"hl":[0],"lang":"sql","size":9.5,"lh":14.0,"w":340.0},{"t":"cell","id":"e","x":180.0,"y":100.0,"w":250.0,"h":26.0,"text":"extra в v не появится","tone":"yellow","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["ALTER TABLE t DROP COLUMN old;","SELECT * FROM v;"],"bad":[1],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"e","x":180.0,"y":100.0,"w":250.0,"h":26.0,"text":"no such column: old","tone":"red","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["CREATE VIEW v AS SELECT … ORDER BY name;"],"bad":[0],"lang":"sql","size":9.5,"lh":14.0,"w":340.0},{"t":"text","id":"n","x":180.0,"y":100.0,"text":"пишите ORDER BY в запросе к VIEW","tone":"yellow","size":10.0}]],"cues":[12.4,24.8]}]},{"title":"Практика","sub":"Соглашения","short":"Практика","main":"Префикс в имени, явные столбцы, текст запроса в файле миграции.","body":[{"t":"scene","labels":["Имена","Явные столбцы","Не злоупотреблять"],"captions":["Префикс v_ и смысловое имя: v_active_customers, v_revenue_by_month","Столбцы перечисляем явно и даём понятные псевдонимы","Если запрос нужен один раз — хватит CTE, представление не нужно"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":150.0,"h":28.0,"text":"v_active_customers","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":150.0,"h":28.0,"text":"v_revenue_by_month","tone":"green","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"по имени видно, что это не таблица","size":9.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["CREATE VIEW v_orders AS","SELECT o.id, o.created, c.name AS customer,","       o.total","FROM orders o JOIN customers c ON c.id = o.cust;"],"hl":[1,2],"lang":"sql","size":9.5,"lh":13.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":36.0,"text":"одноразово:\nWITH (CTE)","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":150.0,"h":36.0,"text":"многократно:\nVIEW","tone":"green","size":10.0,"sub_size":8.5}]],"cues":[12.5,25.0]}]},{"title":"Что дальше","sub":"Итоги раздела «Основы SQL»","short":"Дальше","main":"Вы владеете всем набором SQL; дальше — устройство баз изнутри.","body":[{"t":"scene","labels":["Запросы","Данные и структура","Дальше"],"captions":["SELECT, WHERE, ORDER BY, GROUP BY, JOIN, подзапросы, CTE, окна","INSERT, UPDATE, DELETE, транзакции, CREATE, ALTER, индексы, представления","Дальше — как всё это устроено внутри: хранение, транзакции, оптимизатор"],"frames":[[{"t":"cell","id":"a","x":65.0,"y":50.0,"w":110.0,"h":26.0,"text":"SELECT WHERE","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":50.0,"w":110.0,"h":26.0,"text":"GROUP BY HAVING","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"c","x":295.0,"y":50.0,"w":110.0,"h":26.0,"text":"JOIN","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"d","x":122.0,"y":96.0,"w":110.0,"h":26.0,"text":"подзап