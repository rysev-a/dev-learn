ент"],"frames":[[{"t":"cell","id":"e0","x":40.0,"y":60.0,"w":30.0,"h":22.0,"text":"·","tone":"muted","size":12.0,"sub_size":8.5},{"t":"cell","id":"e1","x":80.0,"y":60.0,"w":30.0,"h":22.0,"text":"·","tone":"muted","size":12.0,"sub_size":8.5},{"t":"cell","id":"e2","x":120.0,"y":60.0,"w":30.0,"h":22.0,"text":"·","tone":"muted","size":12.0,"sub_size":8.5},{"t":"cell","id":"e3","x":160.0,"y":60.0,"w":30.0,"h":22.0,"text":"·","tone":"muted","size":12.0,"sub_size":8.5},{"t":"cell","id":"e4","x":200.0,"y":60.0,"w":30.0,"h":22.0,"text":"·","tone":"muted","size":12.0,"sub_size":8.5},{"t":"cell","id":"e5","x":240.0,"y":60.0,"w":30.0,"h":22.0,"text":"·","tone":"muted","size":12.0,"sub_size":8.5},{"t":"cell","id":"e6","x":280.0,"y":60.0,"w":30.0,"h":22.0,"text":"·","tone":"muted","size":12.0,"sub_size":8.5},{"t":"cell","id":"e7","x":320.0,"y":60.0,"w":30.0,"h":22.0,"text":"·","tone":"muted","size":12.0,"sub_size":8.5},{"t":"cell","id":"d","x":330.0,"y":60.0,"w":40.0,"h":22.0,"text":"▲","tone":"green","size":11.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"вызов — только после паузы","size":10.0}],[{"t":"cell","id":"e0","x":40.0,"y":60.0,"w":30.0,"h":22.0,"text":"▲","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"e1","x":80.0,"y":60.0,"w":30.0,"h":22.0,"text":"·","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"e2","x":120.0,"y":60.0,"w":30.0,"h":22.0,"text":"·","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"e3","x":160.0,"y":60.0,"w":30.0,"h":22.0,"text":"▲","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"e4","x":200.0,"y":60.0,"w":30.0,"h":22.0,"text":"·","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"e5","x":240.0,"y":60.0,"w":30.0,"h":22.0,"text":"·","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"e6","x":280.0,"y":60.0,"w":30.0,"h":22.0,"text":"▲","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"e7","x":320.0,"y":60.0,"w":30.0,"h":22.0,"text":"·","tone":"muted","si