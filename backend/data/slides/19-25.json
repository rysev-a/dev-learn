ом, затем destroy.","body":[{"t":"scene","labels":["define","shutdown","destroy","undefine"],"captions":["defineXML делает домен постоянным, create запускает его","shutdown лишь просит гостя и возвращается сразу; гость может отказать","destroy выдёргивает шнур питания; флаг GRACEFUL оставляет только SIGTERM","undefine удаляет определение; createXML запускает временный домен"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["dom = conn.defineXML(xml)    # persistent","dom.create()                 # start","dom.shutdown()               # ask the guest","# poll dom.state() until the deadline","dom.destroy()                # power cord","dom.destroyFlags(1)  # GRACEFUL: SIGTERM only","dom.undefine()               # drop definition"],"hl":[0,1],"lang":"python","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["dom = conn.defineXML(xml)    # persistent","dom.create()                 # start","dom.shutdown()               # ask the guest","# poll dom.state() until the deadline","dom.destroy()                # power cord","dom.destroyFlags(1)  # GRACEFUL: SIGTERM only","dom.undefine()               # drop definition"],"hl":[2,3],"lang":"python","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["dom = conn.defineXML(xml)    # persistent","dom.create()                 # start","dom.shutdown()               # ask the guest","# poll dom.state() until the deadline","dom.destroy()                # power cord","dom.destroyFlags(1)  # GRACEFUL: SIGTERM only","dom.undefine()               # drop definition"],"hl":[4,5],"lang":"python","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["dom = conn.defineXML(xml)    # persistent","dom.create()                 # start","dom.shutdown()               # ask the guest","# poll dom.state() until the deadline","dom.destroy()                # power cord","dom.destroyFlags(1)  # GRACEFUL: SIGTERM only","dom.undefine()               # drop 