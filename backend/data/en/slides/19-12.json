00.0.1 crosses the bridge","A ping to an outside address: Network is unreachable, no default route","ip route add default via 10.200.0.1 gives a way to the host"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo ip -n red addr add 10.200.0.2/24 \\","    dev eth0","$ sudo ip -n red link set eth0 up","$ sudo ip netns exec red ping -c1 10.200.0.1","64 bytes from 10.200.0.1: ttl=64","$ sudo ip netns exec red ping -c1 8.8.8.8","ping: connect: Network is unreachable","$ sudo ip -n red route add default \\","    via 10.200.0.1"],"hl":[0,1,2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo ip -n red addr add 10.200.0.2/24 \\","    dev eth0","$ sudo ip -n red link set eth0 up","$ sudo ip netns exec red ping -c1 10.200.0.1","64 bytes from 10.200.0.1: ttl=64","$ sudo ip netns exec red ping -c1 8.8.8.8","ping: connect: Network is unreachable","$ sudo ip -n red route add default \\","    via 10.200.0.1"],"hl":[3,4],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo ip -n red addr add 10.200.0.2/24 \\","    dev eth0","$ sudo ip -n red link set eth0 up","$ sudo ip netns exec red ping -c1 10.200.0.1","64 bytes from 10.200.0.1: ttl=64","$ sudo ip netns exec red ping -c1 8.8.8.8","ping: connect: Network is unreachable","$ sudo ip -n red route add default \\","    via 10.200.0.1"],"hl":[5,6],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo ip -n red addr add 10.200.0.2/24 \\","    dev eth0","$ sudo ip -n red link set eth0 up","$ sudo ip netns exec red ping -c1 10.200.0.1","64 bytes from 10.200.0.1: ttl=64","$ sudo ip netns exec red ping -c1 8.8.8.8","ping: connect: Network is unreachable","$ sudo ip -n red route add default \\","    via 10.200.0.1"],"hl":[7,8],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[11.2,18.8,29.2]}]},{"title":"Packet forwarding","sub":"Chapter 12 · Linux networking","short":"ip_forward","main":"The host forwards foreign packets only when net.ipv4.ip_forward=1.","body":[{"t":"scene","labels":["Value","Enable","Persist","Filter"],"captions":["By default ip_forward is 0: the packet reaches the bridge and goes no further","sysctl -w enables forwarding until reboot","A line in a file /etc/sysctl.d/*.conf keeps the value","A drop policy for FORWARD needs a separate rule"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sysctl net.ipv4.ip_forward","net.ipv4.ip_forward = 0","$ sudo sysctl -w net.ipv4.ip_forward=1","net.ipv4.ip_forward = 1","# survive a reboot:","net.ipv4.ip_forward = 1","  > /etc/sysctl.d/99-forward.conf","# FORWARD policy DROP: allow br0"],"hl":[0,1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sysctl net.ipv4.ip_forward","net.ipv4.ip_forward = 0","$ sudo sysctl -w net.ipv4.ip_forward=1","net.ipv4.ip_forward = 1","# survive a reboot:","net.ipv4.ip_forward = 1","  > /etc/sysctl.d/99-forward.conf","# FORWARD policy DROP: allow br0"],"hl":[2,3],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sysctl net.ipv4.ip_forward","net.ipv4.ip_forward = 0","$ sudo sysctl -w net.ipv4.ip_forward=1","net.ipv4.ip_forward = 1","# survive a reboot:","net.ipv4.ip_forward = 1","  > /etc/sysctl.d/99-forward.conf","# FORWARD policy DROP: allow br0"],"hl":[4,5,6],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sysctl net.ipv4.ip_forward","net.ipv4.ip_forward = 0","$ sudo sysctl -w net.ipv4.ip_forward=1","net.ipv4.ip_forward = 1","# survive a reboot:","net.ipv4.ip_forward = 1","  > /etc/sysctl.d/99-forward.conf","# FORWARD policy DROP: allow br0"],"hl":[7],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[13.6,20.9,30.3]}]},{"title":"Masquerade","sub":"Chapter 12 · Linux networking","short":"NAT","main":"A nat/postrouting rule replaces a private address with the exit address.","body":[{"t":"scene","labels":["iptables","nftables","Rule","Replies"],"captions":["iptables: a source from the subnet, exit not through br0","nftables: the table ip nat and a postrouting chain of type nat","The rule: the subnet, exit not through br0, masquerade","conntrack rewrites replies, no reverse rules are needed"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo iptables -t nat -A POSTROUTING \\","    -s 10.200.0.0/24 ! -o br0 -j MASQUERADE","# the same in nftables:","table ip nat {","  chain postrouting {","    type nat hook postrouting priority 100;","    ip saddr 10.200.0.0/24 oifname != \"br0\"","      masquerade","} }"],"hl":[0,1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo iptables -t nat -A POSTROUTING \\","    -s 10.200.0.0/24 ! -o br0 -j MASQUERADE","# the same in nftables:","table ip nat {","  chain postrouting {","    type nat hook postrouting priority 100;","    ip saddr 10.200.0.0/24 oifname != \"br0\"","      masquerade","} }"],"hl":[3,4,5],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo iptables -t nat -A POSTROUTING \\","    -s 10.200.0.0/24 ! -o br0 -j MASQUERADE","# the same in nftables:","table ip nat {","  chain postrouting {","    type nat hook postrouting priority 100;","    ip saddr 10.200.0.0/24 oifname != \"br0\"","      masquerade","} }"],"hl":[6,7],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo iptables -t nat -A POSTROUTING \\","    -s 10.200.0.0/24 ! -o br0 -j MASQUERADE","# the same in nftables:","table ip nat {","  chain postrouting {","    type nat hook postrouting priority 100;","    ip saddr 10.200.0.0/24 oifname != \"br0\"","      masquerade","} }"],"hl":[8],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[10.7,22.5,32.7]}]},{"title":"The conntrack table","sub":"Chapter 12 · Linux networking","short":"conntrack","main":"Two tuples per line: the original and the reply show the translation.","body":[{"t":"scene","labels":["Command","Original","Reply","Verdict"],"captions":["conntrack -L -n selects source-translation entries","Original: the client 10.200.0.2 goes to 203.0.113.9","Reply: will arrive at the host address 192.168.1.10","The reply destination differs from the original source: that is SNAT"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo conntrack -L -n","tcp 6 431982 ESTABLISHED"," src=10.200.0.2 dst=203.0.113.9"," sport=45678 dport=80"," src=203.0.113.9 dst=192.168.1.10"," sport=80 dport=45678 [ASSURED]","# reply dst != original src: SNAT"],"hl":[0,1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo conntrack -L -n","tcp 6 431982 ESTABLISHED"," src=10.200.0.2 dst=203.0.113.9"," sport=45678 dport=80"," src=203.0.113.9 dst=192.168.1.10"," sport=80 dport=45678 [ASSURED]","# reply dst != original src: SNAT"],"hl":[2,3],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo conntrack -L -n","tcp 6 431982 ESTABLISHED"," src=10.200.0.2 dst=203.0.113.9"," sport=45678 dport=80"," src=203.0.113.9 dst=192.168.1.10"," sport=80 dport=45678 [ASSURED]","# reply dst != original src: SNAT"],"hl":[4,5],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo conntrack -L -n","tcp 6 431982 ESTABLISHED"," src=10.200.0.2 dst=203.0.113.9"," sport=45678 dport=80"," src=203.0.113.9 dst=192.168.1.10"," sport=80 dport=45678 [ASSURED]","# reply dst != original src: SNAT"],"hl":[6],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[9.4,19.0,28.6]}]},{"title":"Publishing a port","sub":"Chapter 12 · Linux networking","short":"DNAT","main":"DNAT in prerouting for outsiders, in output for the host itself.","body":[{"t":"scene","labels":["Outside","From host","127.0.0.1","FORWARD"],"captions":["PREROUTING: host port 8080 goes to 10.200.0.2:80","OUTPUT: the same for connections from the host to its own address","127.0.0.1 usually needs route_localnet=1 or a proxy","The forwarded packet must pass the FORWARD rules"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo iptables -t nat -A PREROUTING \\","    -p tcp --dport 8080 -j DNAT \\","    --to-destination 10.200.0.2:80","$ sudo iptables -t nat -A OUTPUT \\","    -d 192.168.1.10 -p tcp --dport 8080 \\","    -j DNAT --to-destination 10.200.0.2:80","# 127.0.0.1: route_localnet=1 too","# FORWARD must accept the packet"],"hl":[0,1,2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo iptables -t nat -A PREROUTING \\","    -p tcp --dport 8080 -j DNAT \\","    --to-destination 10.200.0.2:80","$ sudo iptables -t nat -A OUTPUT \\","    -d 192.168.1.10 -p tcp --dport 8080 \\","    -j DNAT --to-destination 10.200.0.2:80","# 127.0.0.1: route_localnet=1 too","# FORWARD must accept the packet"],"hl":[3,4,5],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo iptables -t nat -A PREROUTING \\","    -p tcp --dport 8080 -j DNAT \\","    --to-destination 10.200.0.2:80","$ sudo iptables -t nat -A OUTPUT \\","    -d 192.168.1.10 -p tcp --dport 8080 \\","    -j DNAT --to-destination 10.200.0.2:80","# 127.0.0.1: route_localnet=1 too","# FORWARD must accept the packet"],"hl":[6],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ sudo iptables -t nat -A PREROUTING \\","    -p tcp --dport 8080 -j DNAT \\","    --to-destination 10.200.0.2:80","$ sudo iptables -t nat -A OUTPUT \\","    -d 192.168.1.10 -p tcp --dport 8080 \\","    -j DNAT --to-destination 10.200.0.2:80","# 127.0.0.1: route_localnet=1 too","# FORWARD must accept the packet"],"hl":[7],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[9.4,22.1,32.1]}]},{"title":"Debugging along the path","sub":"Chapter 12 · Linux networking","short":"The path","main":"tcpdump -n at three points shows where the packet vanished.","body":[{"t":"scene","labels":["In red","Bridge","Exit","Server"],"captions":["ip netns exec red tcpdump -ni eth0: the request left","Seen on br0 but not at the exit: ip_forward or a filter","A private source address at the exit: no masquerade","Left with the host address, no reply: the outside, conntrack"],"frames":[[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"red\neth0","tone":"blue","size":8.5,"sub_size":8.5}],[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"red\neth0","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"n1","x":135.0,"y":70.0,"w":76.0,"h":52.0,"text":"br0","tone":"violet","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":85.0,"y1":70.0,"x2":96.0,"y2":70.0,"tone":"violet","arrow":true,"width":1.6}],[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"red\neth0","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"n1","x":135.0,"y":70.0,"w":76.0,"h":52.0,"text":"br0","tone":"violet","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":85.0,"y1":70.0,"x2":96.0,"y2":70.0,"tone":"violet","arrow":true,"width":1.6},{"t":"cell","id":"n2","x":224.0,"y":70.0,"w":76.0,"h":52.0,"text":"exit\nenp1s0","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"line","id":"a2","x1":174.0,"y1":70.0,"x2":185.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6}],[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"red\neth0","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"n1","x":135.0,"y":70.0,"w":76.0,"h":52.0,"text":"br0","tone":"violet","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":85.0,"y1":70.0,"x2":96.0,"y2":70.0,"tone":"violet","arrow":true,"width":1.6},{"t":"cell","id":"n2","x":224.0,"y":70.0,"w":76.0,"h":52.0,"text":"exit\nenp1s0","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"line","id":"a2","x1":174.0,"y1":70.0,"x2":185.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.