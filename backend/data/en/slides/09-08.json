":"green","size":9.5}]],"cues":[11.8,23.5]}]},{"title":"Transactions","sub":"BEGIN, COMMIT, ROLLBACK","short":"Transactions","main":"A transaction is all or nothing: COMMIT saves, ROLLBACK cancels.","body":[{"t":"scene","labels":["BEGIN","COMMIT","ROLLBACK"],"captions":["BEGIN starts a transaction: changes are visible only to you for now","COMMIT makes all changes permanent at once","ROLLBACK returns the data to the state before BEGIN"],"frames":[[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["BEGIN;","UPDATE acc SET sum = sum - 100 WHERE id = 1;","UPDATE acc SET sum = sum + 100 WHERE id = 2;"],"hl":[0],"lang":"sql","size":9.5,"lh":14.0,"w":340.0},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"changes not yet committed","tone":"yellow","size":9.5}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["BEGIN;","UPDATE acc SET sum = sum - 100 WHERE id = 1;","UPDATE acc SET sum = sum + 100 WHERE id = 2;","COMMIT;"],"hl":[3],"lang":"sql","size":9.5,"lh":13.0,"w":340.0},{"t":"cell","id":"g","x":180.0,"y":120.0,"w":200.0,"h":28.0,"text":"both changes saved","tone":"green","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["BEGIN;","UPDATE acc SET sum = sum - 100 WHERE id = 1;","-- failure!","ROLLBACK;"],"hl":[3],"lang":"sql","size":9.5,"lh":13.0,"w":340.0},{"t":"cell","id":"g","x":180.0,"y":120.0,"w":220.0,"h":28.0,"text":"data as before BEGIN","tone":"yellow","size":9.5,"sub_size":8.5}]],"cues":[12.7,25.5]}]},{"title":"Constraints","sub":"What the database rejects","short":"Constraints","main":"NOT NULL, UNIQUE, PRIMARY KEY and FOREIGN KEY protect data from mistakes.","body":[{"t":"scene","labels":["NOT NULL","UNIQUE and key","FOREIGN KEY"],"captions":["A required column skipped — the command fails","A duplicate in a unique column or key — an error","An order for a nonexistent customer can't be inserted; PRAGMA foreign_keys = ON"],"frames":[[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["INSERT INTO customers (id) VALUES (9);"],"bad":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"e","x":180.0,"y":100.0,"w":280.0,"h":28.0,"text":"NOT NULL constraint failed: customers.name","tone":"red","size":9.0,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["INSERT INTO customers (id, name) VALUES (1, 'Me');"],"bad":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"e","x":180.0,"y":100.0,"w":260.0,"h":28.0,"text":"UNIQUE constraint failed: customers.id","tone":"red","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["PRAGMA foreign_keys = ON;","INSERT INTO orders (cust) VALUES (999);"],"hl":[0],"bad":[1],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"e","x":180.0,"y":100.0,"w":280.0,"h":28.0,"text":"FOREIGN KEY constraint failed","tone":"red","size":9.5,"sub_size":8.5}]],"cues":[12.5,25.0]}]},{"title":"UPSERT","sub":"Insert or update","short":"UPSERT","main":"ON CONFLICT DO UPDATE updates the row if the insert violated a key.","body":[{"t":"scene","labels":["Conflict","DO UPDATE","Cruder ways"],"captions":["A row with this key already exists — a plain INSERT gives an error","ON CONFLICT … DO UPDATE updates it; excluded — the values you tried to insert","OR REPLACE deletes and reinserts (loses other columns), OR IGNORE silently skips"],"frames":[[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["INSERT INTO stock (id, qty) VALUES (7, 5);"],"bad":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"t-h0","x":145.0,"y":60.0,"w":48.0,"h":18.0,"text":"id","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"t-h1","x":200.0,"y":60.0,"w":58.0,"h":18.0,"text":"qty","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"t-r0c0","x":145.0,"y":80.0,"w":48.0,"h":18.0,"text":"7","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"t-r0c1","x":200.0,"y":80.0,"w":58.0,"h":18.0,"text":"150","tone":"blue","size":9.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"id = 7 already exists","