ext":"error[E0502]: cannot borrow `v` as mutable\nbecause it is also borrowed as immutable\n  let first = &v[0];  — borrow here\n  v.push(4);          — mutation here","tone":"red","size":8.0,"sub_size":8.5}]],"cues":[17.4,29.4]}]},{"title":"When a borrow ends","sub":"Non-lexical lifetimes","short":"End of borrow","main":"A reference lives to its last use, not to the closing brace.","body":[{"t":"scene","labels":["Borrow","To the last use","Used later"],"captions":["The reference r lives from creation to its last use, not to the closing brace","After println the reference r is no longer needed — the borrow is over, and the vector can be changed again","If you read through r after push, the borrow is still needed: the error comes back"],"frames":[[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["let mut v = vec![1, 2];","let r = &v[0];","println!(\"{r}\");","v.push(3);","}"],"hl":[1,2],"lang":"rust","size":10.0,"lh":18.0,"w":200.0},{"t":"line","id":"br","x1":232.0,"y1":38.0,"x2":232.0,"y2":54.0,"tone":"blue","width":3.0},{"t":"text","id":"n","x":290.0,"y":46.0,"text":"borrow r","tone":"blue","size":9.0}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["let mut v = vec![1, 2];","let r = &v[0];","println!(\"{r}\");","v.push(3);","}"],"hl":[3],"lang":"rust","size":10.0,"lh":18.0,"w":200.0},{"t":"line","id":"br","x1":232.0,"y1":38.0,"x2":232.0,"y2":54.0,"tone":"muted","width":3.0,"o":0.4},{"t":"text","id":"n","x":290.0,"y":46.0,"text":"borrow over","tone":"green","size":9.0},{"t":"text","id":"m","x":290.0,"y":92.0,"text":"can write","tone":"green","size":9.0}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["let mut v = vec![1, 2];","let r = &v[0];","v.push(3);","println!(\"{r}\");","}"],"hl":[2],"bad":[2],"lang":"rust","size":10.0,"lh":18.0,"w":200.0},{"t":"line","id":"br","x1":232.0,"y1":38.0,"x2":232.0,"y2":72.0,"tone":"red","width":3.0},{"t":"text","id":"n","x":290.0,"y":92.0,"text":"r still needed ✕","tone":"red","size":9.0}]],"cues":[14.4,30.7]}]},{"title":"A reference to something gone","sub":"The call frame died","short":"Dangling reference","main":"You cannot return a reference to a local: return ownership.","body":[{"t":"scene","labels":["Function frame","Frame gone","Return ownership"],"captions":["The local string lives in the function's frame, and a reference to it is about to leave","The function returned, the frame vanished with the string — the reference would point into a dead zone; Rust refuses to build such code","The fix: return the string itself — ownership goes to the caller, and the data outlives the frame"],"frames":[[{"t":"cell","id":"m","x":90.0,"y":40.0,"w":140.0,"h":40.0,"text":"main","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"f","x":90.0,"y":100.0,"w":140.0,"h":56.0,"text":"make()\ns = \"hi\"","tone":"green","size":9.0,"sub_size":8.5},{"t":"code","id":"c","x":190.0,"y":18.0,"lines":["fn make() -> &String {","    let s = String::from(\"hi\");","    &s","}"],"hl":[2],"lang":"rust","size":8.5,"lh":15.0,"w":160.0}],[{"t":"cell","id":"m","x":90.0,"y":40.0,"w":140.0,"h":40.0,"text":"main: r = &…","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"f","x":90.0,"y":112.0,"w":140.0,"h":40.0,"text":"frame freed","tone":"red","size":9.0,"sub_size":8.5,"o":0.4},{"t":"line","id":"e","x1":90.0,"y1":60.0,"x2":90.0,"y2":94.0,"tone":"red","arrow":true,"width":1.6},{"t":"cell","id":"e1","x":270.0,"y":90.0,"w":140.0,"h":66.0,"text":"error[E0106]\nmissing lifetime specifier\nreturns a reference to\ndata owned by the function","tone":"red","size":8.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["fn make() -> String {","    let s = String::from(\"hi\");","    s","}"],"hl":[2],"lang":"rust","size":9.5,"lh":16.0,"w":180.0},{"t":"cell","id":"m","x":290.0,"y":56.0,"w":80.0,"h":36.0,"text":"main: r\nString","tone":"green","size":8.5,"sub_size":8.5},{"t":"text","id":"n","x":290.0,"y":100.0,"text":"ownership moved out","size":8.5}]],"cues":[9.9,27.8]}]},{"title":"Slices","sub":"&str and &[T]","short":"Slices","main":"A slice is a pointer and a length (16 bytes); a literal points into .rodata.","body":[{"t":"scene","labels":["&str — part of a string","Pointer and length","Literal"],"captions":["A slice points at a piece of someone else's data: &s[0..5] is the first five bytes of the string, no copying","A slice is two words: a pointer to the start and a length, sixteen bytes; it does not own the data","A literal is a slice too: it points at a read-only section of the executable itself"],"frames":[[{"t":"cell","id":"c0","x":50.0,"y":70.0,"w":24.0,"h":26.0,"text":"h","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"c1","x":76.0,"y":70.0,"w":24.0,"h":26.0,"text":"e","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"c2","x":102.0,"y":70.0,"w":24.0,"h":26.0,"text":"l","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"c3","x":128.0,"y":70.0,"w":24.0,"h":26.0,"text":"l","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"c4","x":154.0,"y":70.0,"w":24.0,"h":26.0,"text":"o","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"c5","x":180.0,"y":70.0,"w":24.0,"h":26.0,"text":" ","tone":"muted","size":10.0,"sub_size":8.5,"o":0.6},{"t":"cell","id":"c6","x":206.0,"y":70.0,"w":24.0,"h":26.0,"text":"w","tone":"muted","size":10.0,"sub_size":8.5,"o":0.6},{"t":"cell","id":"c7","x":232.0,"y":70.0,"w":24.0,"h":26.0,"text":"o","tone":"muted","size":10.0,"sub_size":8.5,"o":0.6},{"t":"cell","id":"c8","x":258.0,"y":70.0,"w":24.0,"h":26.0,"text":"r","tone":"muted","size":10.0,"sub_size":8.5,"o":0.6},{"t":"cell","id":"c9","x":284.0,"y":70.0,"w":24.0,"h":26.0,"text":"l","tone":"muted","size":10.0,"sub_size":8.5,"o":0.6},{"t":"cell","id":"c10","x":310.0,"y":70.0,"w":24.0,"h":26.0,"text":"d","tone":"muted","size":10.0,"sub_size":8.5,"o":0.6},{"t":"line","id":"br","x1":38.0,"y1":94.0,"x2":162.0,"y2":94.0,"tone":"green","width":3.0},{"t":"text","id":"n","x":100.0,"y":114.0,"text":"&s[0..5]","tone":"green","size":9.5,"mono":true}]