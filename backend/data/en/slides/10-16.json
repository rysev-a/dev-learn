.0,"text":"main: x @ 0x7ffe…d0","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"f","x":110.0,"y":90.0,"w":180.0,"h":30.0,"text":"inner: y @ 0x7ffe…b0","tone":"green","size":9.0,"sub_size":8.5},{"t":"line","id":"e~line","x1":110.0,"y1":56.0,"x2":110.0,"y2":74.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":148.0,"text":"y < x — the stack grows down","size":9.5,"mono":true}],[{"t":"code","id":"c","x":12.0,"y":40.0,"lines":["fn twice(x: &mut i32) {","    bump(x);","    bump(x);","}"],"hl":[1,2],"lang":"rust","size":10.0,"lh":17.0,"w":200.0},{"t":"cell","id":"n~cell","x":285.0,"y":70.0,"w":120.0,"h":44.0,"text":"bump(&mut *x)\nadded for you","tone":"yellow","size":8.5,"sub_size":8.5}]],"cues":[22.4,41.8]}]},{"title":"Summary","sub":"What next","short":"Summary","main":"References are checked pointers; there are no dangling pointers in safe Rust.","body":[{"t":"scene","labels":["Two references","What it protects from","What next"],"captions":["&T — read, many; &mut T — write, one; both are eight-byte pointers","Dangling pointers, reading during a write and references that outlive the owner are cut off at build time","Next — structs, enums and pattern matching: how to describe data"],"frames":[[{"t":"cell","id":"a","x":100.0,"y":56.0,"w":130.0,"h":34.0,"text":"&T\nmany readers","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":260.0,"y":56.0,"w":130.0,"h":34.0,"text":"&mut T\none writer","tone":"red","size":9.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":112.0,"text":"neither is ownership","size":9.5}],[{"t":"cell","id":"r1","x":180.0,"y":38.0,"w":300.0,"h":24.0,"text":"dangling reference — frame or buffer already freed","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"r2","x":180.0,"y":74.0,"w":300.0,"h":24.0,"text":"reader + writer at once","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"r3","x":180.0,"y":110.0,"w":300.0,"h":24.0,"text":"reference that outlived its owner","tone":"red","si