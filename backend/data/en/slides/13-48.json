 lighter and Python-to-Python calls don't use the C stack; depth is limited by sys.getrecursionlimit()"],"frames":[[{"t":"code","id":"c","x":40.0,"y":40.0,"lines":["LOAD_FAST   a","LOAD_FAST   b","BINARY_OP   +","RETURN_VALUE"],"hl":[2],"lang":"python","size":12.0,"lh":24.0,"w":240.0},{"t":"cell","id":"p","x":300.0,"y":70.0,"w":70.0,"h":26.0,"text":"pointer","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"line","id":"e","x1":262.0,"y1":70.0,"x2":256.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6}],[{"t":"cell","id":"f","x":180.0,"y":70.0,"w":230.0,"h":100.0,"text":"frame","tone":"blue","size":9.0,"sub_size":8.5,"dash":true},{"t":"cell","id":"a","x":100.0,"y":46.0,"w":100.0,"h":22.0,"text":"instruction: #3","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":100.0,"y":78.0,"w":100.0,"h":22.0,"text":"locals: a, b","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"c~cell","x":250.0,"y":62.0,"w":90.0,"h":48.0,"text":"value\nstack","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"k0","x":180.0,"y":130.0,"w":120.0,"h":22.0,"text":"frame 1","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"k1","x":180.0,"y":102.0,"w":120.0,"h":22.0,"text":"frame 2","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"k2","x":180.0,"y":74.0,"w":120.0,"h":22.0,"text":"frame 3","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"k3","x":180.0,"y":46.0,"w":120.0,"h":22.0,"text":"frame 4","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":320.0,"y":76.0,"text":"RecursionError","tone":"red","size":10.0}]],"cues":[13.4,21.5]}]},{"title":"Specialization","sub":"3.11 adaptive interpreter","short":"Specialization","main":"Stable types, fast code.","body":[{"t":"scene","labels":["Hot code","Specialization","Rollback"],"captions":["An instruction runs many times, and the interpreter notices which types it sees (3.11+)","Adding two ints is replaced by a fast version, reading an instance attribute by an instruction with a ready offset","If the type suddenly changes, specialization is rolled back; so keep types stable in hot spots"],"frames":[[{"t":"code","id":"c","x":40.0,"y":56.0,"lines":["for i in range(1000000):","    total = total + i","# same types: int + int"],"hl":[1],"lang":"python","size":11.5,"lh":26.0,"w":300.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":120.0,"h":34.0,"text":"BINARY_OP","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":140.0,"h":34.0,"text":"BINARY_OP_ADD_INT","tone":"green","size":9.5,"sub_size":8.5},{"t":"line","id":"e","x1":156.0,"y1":70.0,"x2":198.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":118.0,"text":"dis.dis(f, adaptive=True)","size":10.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":130.0,"h":34.0,"text":"BINARY_OP_ADD_INT","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":110.0,"h":34.0,"text":"str + str → rollback","tone":"red","size":9.5,"sub_size":8.5},{"t":"line","id":"e","x1":156.0,"y1":70.0,"x2":214.0,"y2":70.0,"tone":"red","arrow":true,"width":1.6}]],"cues":[19.1,27.9]}]},{"title":"Exceptions and local names","sub":"Speed in practice","short":"Speed","main":"Measure first, then optimize.","body":[{"t":"scene","labels":["try is almost free","Locals are faster","Measure first"],"captions":["Since 3.11 a try block costs nothing until an exception is raised","A local name is read by number, a global is looked up in a dict — so in the hottest loops a function is sometimes copied into a local name","Don't make it a habit: the modern interpreter does a lot itself — measure first"],"frames":[[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["try:","    risky()        # no error — free","except ValueError:","    ...             # cost — only on raise"],"lang":"python","size":11.0,"lh":26.0,"w":320.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["def f(items, _len=len):","    for x in items:","        n = _len(x)","# LOAD_FAST is faster than LOAD_GLOBAL"],"hl":[2,3],"lang":"python","size":11.0,"lh":26.0,"w":320.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"measure","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":110.0,"h":30.0,"text":"then change","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":70.0,"x2":214.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6}]],"cues":[12.4,22.1]}]},{"title":"JIT","sub":"Experimental, 3.13","short":"JIT","main":"Groundwork, not required.","body":[{"t":"scene","labels":["Copy and patch","Off","Groundwork"],"captions":["3.13 added an experimental JIT: ready machine-code templates are stitched together for hot sections","Off by default: enabled by building the interpreter and an environment variable","The gain is modest — a direction: faster without changing the language; too early to rely on"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":34.0,"text":"machine-code\ntemplates","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":120.0,"h":34.0,"text":"stitching for\nhot code","tone":"green","size":9.0,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":70.0,"x2":206.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"JIT: off","tone":"muted","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":130.0,"h":30.0,"text":"build + PYTHON_JIT","tone":"yellow","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"3.13","tone":"blue","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":110.0,"h":30.0,"text":"…faster","tone":"green","size":12.0,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":70.0,"x2":214.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[13.9,20.2]}]},{"title":"GIL","sub":"One thread at a time","short":"GIL","main":"Good for I/O, no help for math.","body":[{"t":"scene","labels":["One thread","Switching","I/O"],"captions":["The GIL is the global lock: at any moment only one thread runs bytecode; it protects internal structures and reference counts","Every 5 ms (sys.getswitchinterval()) the lock passes to another thread","While waiting for I/O the lock is released — threads suit networking; CPU-bound math they don't speed up"],"frames":[[{"t":"cell","id":"a","x":60.0,"y":56.0,"w":70.0,"h":26.0,"text":"thread 1","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":60.0,"y":100.0,"w":70.0,"h":26.0,"text":"thread 2","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"g","x":230.0,"y":78.0,"w":110.0,"h":44.0,"text":"GIL\n(lock)","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"line","id":"e","x1":96.0,"y1":56.0,"x2":174.0,"y2":68.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"cell","id":"a","x":60.0,"y":56.0,"w":70.0,"h":26.0,"text":"thread 1","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":60.0,"y":100.0,"w":70.0,"h":26.0,"text":"thread 2","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"g","x":230.0,"y":78.0,"w":110.0,"h":44.0,"text":"GIL\n(lock)","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"line","id":"e","x1":96.0,"y1":100.0,"x2":174.0,"y2":88.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n","x":320.0,"y":78.0,"text":"5 ms","tone":"yellow","size":11.0}],[{"t":"cell","id":"a","x":90.0,"y":56.0,"w":130.0,"h":28.0,"text":"I/O wait: GIL freed","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":56.0,"w":120.0,"h":28.0,"text":"another thread runs","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":108.0,"w":220.0,"h":28.0,"text":"CPU-bound: threads don't help","tone":"red","size":10.0,"sub_size":8.5}]],"cues":[10.4,30.4]}]},{"title":"The GIL and races","sub":"x += 1 is not atomic","short":"Races","main":"Protect shared data with a lock.","body":[{"t":"scene","labels":["x += 1","Lost update","Lock"],"captions":["x += 1 is several instructions: read, add, write; a switch can happen between them","Two threads read the same value — one increment is lost","Protect shared data with threading.Lock or pass it through a queue; races rarely show in tests"],"frames":[[{"t":"code","id":"c","x":40.0,"y":50.0,"lines":["LOAD  x","ADD   1","STORE x","# a switch can happen in between"],"hl":[0,1,2],"lang":"python","size":12.0,"lh":26.0,"w":260.0}],[{"t":"cell","id":"a","x":70.0,"y":56.0,"w":90.0,"h":26.0,"text":"T1: reads 5","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":70.0,"y":96.0,"w":90.0,"h":26.0,"text":"T2: reads 5","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"c~cell","x":220.0,"y":56.0,"w":90.0,"h":26.0,"text":"T1: writes 6","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"d","x":220.0,"y":96.0,"w":90.0,"h":26.0,"text":"T2: writes 6","tone":"red","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":320.0,"y":76.0,"text":"expected 7","tone":"red","size":10.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["with lock:","    x += 1","# or queue.Queue between threads"],"hl":[0,1],"lang":"python","size":12.0,"lh":28.0,"w":300.0}]],"cues":[13.7,26.5]}]},{"title":"Getting around the GIL","sub":"Processes, C, subinterpreters","short":"Workarounds","main":"Each way has a price.","body":[{"t":"scene","labels":["Processes","C extensions","Subinterpreters"],"captions":["Each process has its own interpreter and GIL: ProcessPoolExecutor — the price is copying data","C extensions (NumPy) release the GIL while computing — threads running them work in parallel","Since 3.12 subinterpreters have their own GIL, and 3.14 put the interface in the standard library: light isolation in one process"],"frames":[[{"t":"cell","id":"a","x":70.0,"y":56.0,"w":70.0,"h":26.0,"text":"process 1","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":56.0,"w":70.0,"h":26.0,"text":"process 2","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":290.0,"y":56.0,"w":70.0,"h":26.0,"text":"process 3","tone":"green","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"three interpreters — three cores","size":10.5}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":120.0,"h":30.0,"text":"NumPy: GIL released","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":120.0,"h":30.0,"text":"threads in parallel","tone":"blue","size":9.5,"sub_size":8.5},{"t":"line","id":"e","x1":156.0,"y1":70.0,"x2":204.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"cell","id":"a","x":180.0,"y":70.0,"w":230.0,"h":100.0,"text":"one process","tone":"blue","size":9.0,"sub_size":8.5,"dash":true},{"t":"cell","id":"b","x":120.0,"y":70.0,"w":80.0,"h":36.0,"text":"subint. 1\nown GIL","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"c","x":240.0,"y":70.0,"w":80.0,"h":36.0,"text":"subint. 2\nown GIL","tone":"green","size":8.5,"sub_size":8.5}]],"cues":[16.2,28.7]}]},{"title":"No-GIL build","sub":"PEP 703","short":"No GIL","main":"A separate interpreter and a build flag.","body":[{"t":"scene","labels":["PEP 703","How to check","Switch"],"captions":["3.13: experimental free-threaded build (PEP 703), officially supported in 3.14; a separate interpreter is installed (python3.13t)","sys._is_gil_enabled() says whether the lock is on; sysconfig.get_config_var('Py_GIL_DISABLED') — the build type","The PYTHON_GIL environment variable turns the lock on or off explicitly"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"python3.13","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":120.0,"h":30.0,"text":"python3.13t","tone":"green","size":11.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":118.0,"text":"no GIL — a separate build","size":10.5}],[{"t":"code","id":"c","x":24.0,"y":56.0,"lines":["sys._is_gil_enabled()     # True / False","sysconfig.get_config_var(","    'Py