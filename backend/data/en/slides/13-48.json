{"book":13,"chapter":48,"rubric":"PYTHON AS A FIRST LANGUAGE / PYTHON INTERNALS / CHAPTER 48","slides":[{"title":"How a program runs","sub":"Chapter questions","short":"Questions","main":"Lasting ideas over small details.","body":[{"t":"scene","labels":["Questions","The path","CPython"],"captions":["What happens between launch and result? Why don't threads speed up calculations? What does «no GIL» mean?","Text → tree → code object with bytecode → interpreter evaluation loop","Many details change between versions — we focus on lasting ideas of the standard implementation"],"frames":[[{"t":"text","id":"q1","x":180.0,"y":40.0,"text":"how does a program run?","size":12.0},{"t":"text","id":"q2","x":180.0,"y":80.0,"text":"why don't threads speed up math?","size":12.0},{"t":"text","id":"q3","x":180.0,"y":120.0,"text":"what is «no GIL»?","tone":"yellow","size":12.0}],[{"t":"cell","id":"a","x":56.0,"y":70.0,"w":76.0,"h":30.0,"text":"text","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":148.0,"y":70.0,"w":76.0,"h":30.0,"text":"tree","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"c","x":244.0,"y":70.0,"w":84.0,"h":30.0,"text":"bytecode","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"cell","id":"d","x":332.0,"y":70.0,"w":52.0,"h":30.0,"text":"loop","tone":"green","size":10.5,"sub_size":8.5},{"t":"line","id":"e1","x1":94.0,"y1":70.0,"x2":110.0,"y2":70.0,"tone":"muted","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":186.0,"y1":70.0,"x2":202.0,"y2":70.0,"tone":"muted","arrow":true,"width":1.6},{"t":"line","id":"e3","x1":286.0,"y1":70.0,"x2":306.0,"y2":70.0,"tone":"muted","arrow":true,"width":1.6}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":120.0,"h":30.0,"text":"CPython 3.13","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":120.0,"h":30.0,"text":"details change","tone":"muted","size":10.5,"sub_size":8.5}]],"cues":[14.3,28.0]}]},{"title":"__pycache__","sub":"Bytecode cache","short":"pyc","main":"Compile