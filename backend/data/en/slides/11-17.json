lback","Scope"],"captions":["A variable is declared with two hyphens and read with the var function","The second argument of var gives a fallback in case the variable is missing","Variables are inherited: a value set in a block is seen only by it and its descendants"],"frames":[[{"t":"code","id":"c","x":14.0,"y":40.0,"lines":[":root {","  --brand: #2563eb;","}","a { color: var(--brand); }"],"hl":[1,3],"lang":"css","size":10.0,"lh":15.0,"w":200.0},{"t":"text","id":"n","x":180.0,"y":130.0,"text":"declared on root, read with var()","size":10.0}],[{"t":"code","id":"c","x":14.0,"y":40.0,"lines":[".btn {","  color: var(--btn, #333);","}"],"hl":[1],"lang":"css","size":10.0,"lh":15.0,"w":200.0},{"t":"cell","id":"r","x":290.0,"y":55.0,"w":120.0,"h":26.0,"text":"no --btn → #333","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":130.0,"text":"the fallback saves you if the variable is missing","size":10.0}],[{"t":"cell","id":"t0","x":180.0,"y":22.0,"w":160.0,"h":26.0,"text":":root { --c: blue }","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"t1","x":95.0,"y":75.0,"w":140.0,"h":26.0,"text":".card { --c: red }","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"t2","x":265.0,"y":75.0,"w":120.0,"h":26.0,"text":".plain","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"t3","x":95.0,"y":130.0,"w":100.0,"h":26.0,"text":"p → red","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"t4","x":265.0,"y":130.0,"w":100.0,"h":26.0,"text":"p → blue","tone":"blue","size":9.0,"sub_size":8.5},{"t":"line","id":"e1","x1":140.0,"y1":34.0,"x2":110.0,"y2":62.0,"tone":"blue","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":220.0,"y1":34.0,"x2":250.0,"y2":62.0,"tone":"blue","arrow":true,"width":1.6},{"t":"line","id":"e3","x1":95.0,"y1":88.0,"x2":95.0,"y2":117.0,"tone":"red","arrow":true,"width":1.6},{"t":"line","id":"e4","x1":265.0,"y1":88.0,"x2":265.0,"y2":117.0,"tone":"blue","arrow":true,"width":1.6}]],"cues":[9.6,25.9]}]},{"title":"Themes","sub":"Light and dark","main":"Semantic names on the root, overridden for the dark scheme.","body":[{"t":"scene","labels":["Tokens","Two themes","Media query","Switch"],"captions":["Semantic names are declared on the root: background, text, accent","Light and dark themes differ only in the values of the same names","Inside a color-scheme media query we override the names for a dark system theme","A manual switch adds a class to the root, and the choice is saved in storage"],"frames":[[{"t":"cell","id":"t1","x":60.0,"y":60.0,"w":100.0,"h":34.0,"text":"--bg","tone":"muted","size":10.0,"sub":"background","sub_size":8.5},{"t":"cell","id":"t2","x":180.0,"y":60.0,"w":100.0,"h":34.0,"text":"--fg","tone":"muted","size":10.0,"sub":"text","sub_size":8.5},{"t":"cell","id":"t3","x":300.0,"y":60.0,"w":100.0,"h":34.0,"text":"--accent","tone":"muted","size":10.0,"sub":"accent","sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":135.0,"text":"semantic names, not colors","size":10.0}],[{"t":"cell","id":"l","x":95.0,"y":75.0,"w":130.0,"h":60.0,"text":"light\n--bg: #fff\n--fg: #222","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"d","x":265.0,"y":75.0,"w":130.0,"h":60.0,"text":"dark\n--bg: #111\n--fg: #eee","tone":"violet","size":9.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":135.0,"text":"same names, different values","size":10.0}],[{"t":"code","id":"c","x":14.0,"y":40.0,"lines":[":root { --bg: #fff; }","@media (prefers-color-scheme: dark) {","  :root { --bg: #111; }","}"],"hl":[1,2],"lang":"css","size":9.0,"lh":15.0,"w":280.0},{"t":"text","id":"n","x":180.0,"y":125.0,"text":"system dark scheme on: dark theme","size":10.0}],[{"t":"code","id":"c","x":14.0,"y":40.0,"lines":[".dark { --bg: #111; --fg: #eee; }"],"hl":[0],"lang":"css","size":9.0,"lh":15.0,"w":280.0},{"t":"code","id":"j","x":14.0,"y":66.0,"lines":["root.classList.toggle('dark');","localStorage.theme = 'dark';"],"lang":"js","size":9.0,"lh":14.0,"w":280.0},{"t":"text","id":"n","x":180.0,"y":125.0,"text":"manual switch and a memory of the choice","size":10.0}]],"cues":[8.4,24.9,32.6]}]},{"title":"Cascade pitfalls","sub":"How to find the cause","main":"Usually specificity or a typo is to blame; the answer is in the dev panel.","body":[{"t":"scene","labels":["Specificity","Typo and unit","Nested ems","Dev panel"],"captions":["A rule does not apply: a more specific one overrides it, and you edit the wrong selector","A typo in a property name and a forgotten unit silently drop the declaration","Nested ems silently multiplied and blew up the font","The dev panel shows applied and crossed-out rules and the final value"],"frames":[[{"t":"code","id":"c","x":14.0,"y":50.0,"lines":["#card .t { color: red; }",".t { color: blue; }"],"bad":[1],"lang":"css","size":10.0,"lh":16.0,"w":200.0},{"t":"cell","id":"w0","x":290.0,"y":47.0,"w":64.0,"h":14.0,"text":"1·1·0","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"w1","x":290.0,"y":63.0,"w":64.0,"h":14.0,"text":"0·1·0","tone":"red","size":8.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":125.0,"text":"can't win by being weaker: need another selector","tone":"red","size":10.0}],[{"t":"code","id":"c","x":14.0,"y":40.0,"lines":["p {","  colour: red;","  margin: 10;","}"],"bad":[1,2],"lang":"css","size":10.0,"lh":16.0,"w":200.0},{"t":"cell","id":"e1","x":300.0,"y":53.0,"w":80.0,"h":14.0,"text":"typo","tone":"red","size":8.5,"sub_size":8.5},{"t":"cell","id":"e2","x":300.0,"y":69.0,"w":80.0,"h":14.0,"text":"no unit","tone":"red","size":8.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":125.0,"text":"the browser silently drops the declaration","size":10.0}],[{"t":"cell","id":"m1","x":60.0,"y":70.0,"w":80.0,"h":34.0,"text":"20px","tone":"yellow","size":9.5,"sub":"parent","sub_size":8.5},{"t":"cell","id":"m2","x":180.0,"y":70.0,"w":80.0,"h":34.0,"text":"30px","tone":"yellow","size":9.5,"sub":"1.5em","sub_size":8.5},{"t":"cell","id":"m3","x":300.0,"y":70.0,"w":80.0,"h":34.0,"text":"45px","tone":"red","size":9.5,"sub":"1.5em","sub_size":8.5},{"t":"line","id":"a1","x1":104.0,"y1":70.0,"x2":136.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"line","id":"a2","x1":224.0,"y1":70.0,"x2":256.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":135.0,"text":"1.5 × 1.5: the font grew more than planned","size":10.0}],[{"t":"zone","id":"dt","x":180.0,"y":80.0,"w":320.0,"h":112.0,"tone":"outline","label":"dev panel: Styles"},{"t":"cell","id":"r1","x":180.0,"y":48.0,"w":290.0,"h":22.0,"text":"#card .t { color: red; }","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"r2","x":180.0,"y":76.0,"w":290.0,"h":22.0,"text":".t { color: blue; }","tone":"red","size":9.0,"sub_size":8.5,"dash":true},{"t":"cell","id":"r3","x":180.0,"y":104.0,"w":290.0,"h":22.0,"text":"Computed: color → rgb(255, 0, 0)","tone":"blue","size":9.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":152.0,"text":"crossed out: lost in the cascade","size":10.0}]],"cues":[8.9,19.6,26.1]}]},{"title":"Checklist","sub":"Good CSS","main":"A simple cascade, rem, variables and debugging in the panel.","body":[{"t":"scene","labels":["Cascade","Units","Variables","Debugging"],"captions":["Design the cascade: classes, low specificity, importance only for utilities","Text in rems, line length in characters, fluid sizes with clamp","Colors and spacing live in variables, and themes come from overriding them","In a dispute, open the dev panel instead of adding another ID"],"frames":[[{"t":"cell","id":"a0","x":60.0,"y":26.0,"w":90.0,"h":28.0,"text":"Cascade","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b0","x":233.0,"y":26.0,"w":240.0,"h":28.0,"text":"classes, low specificity, font on the root","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"a0","x":60.0,"y":26.0,"w":90.0,"h":28.0,"text":"Cascade","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b0","x":233.0,"y":26.0,"w":240.0,"h":28.0,"text":"classes, low specificity, font on the root","tone":"blue","s