":"Routing","main":"The shard map is cached and refreshed on error.","body":[{"t":"scene","labels":["Client knows the map","Proxy","Map cache"],"captions":["The client library computes the shard itself: fast, but rules must be updated on every client","An intermediary accepts requests and forwards them: clients stay simple, but the proxy is one more hop","The shard map is cached; a \"wrong shard\" error forces a refetch of the map"],"frames":[[{"t":"cell","id":"c","x":70.0,"y":76.0,"w":80.0,"h":28.0,"text":"client\n+ map","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"a","x":280.0,"y":50.0,"w":66.0,"h":30.0,"text":"shard A","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":280.0,"y":102.0,"w":66.0,"h":30.0,"text":"shard B","tone":"muted","size":9.0,"sub_size":8.5},{"t":"line","id":"e","x1":110.0,"y1":70.0,"x2":248.0,"y2":52.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"cell","id":"c","x":60.0,"y":76.0,"w":70.0,"h":28.0,"text":"client","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"p","x":170.0,"y":76.0,"w":70.0,"h":28.0,"text":"proxy","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"cell","id":"a","x":300.0,"y":50.0,"w":66.0,"h":30.0,"text":"shard A","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":300.0,"y":102.0,"w":66.0,"h":30.0,"text":"shard B","tone":"muted","size":9.0,"sub_size":8.5},{"t":"line","id":"e1","x1":96.0,"y1":76.0,"x2":134.0,"y2":76.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":206.0,"y1":70.0,"x2":266.0,"y2":52.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"cell","id":"c","x":70.0,"y":76.0,"w":80.0,"h":28.0,"text":"map cache","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"e~cell","x":200.0,"y":76.0,"w":90.0,"h":28.0,"text":"\"wrong shard\"","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"m","x":320.0,"y":76.0,"w":70.0,"h":28.0,"text":"new map","tone":"green","size":8.5,"sub_size":8.5},{"t":"line","id":"e1","x1":110.0,"y1":76.0,"x2":154.