":180.0,"y":158.0,"text":"dup ACKs save speed, timeouts kill it","tone":"yellow","size":9.0}]],"cues":[12.6,22.4,31.6]},{"t":"note","text":"SACK lets us resend only the needed blocks."}]},{"title":"CUBIC and BBR","sub":"Modern algorithms","short":"CUBIC and BBR","main":"CUBIC is the Linux default; BBR measures the link and nearly ignores random loss.","body":[{"t":"scene","labels":["Reno","CUBIC","BBR","ECN"],"captions":["Classic: halve on loss, +1 segment up","CUBIC grows on a cubic curve, to 70% of the window after loss","BBR measures the link, holds speed near BDP, ignoring loss","ECN lets a router signal congestion without dropping packets"],"frames":[[{"t":"cell","id":"r","x":70.0,"y":50.0,"w":100.0,"h":30.0,"text":"Reno\n÷2, +1 per RTT","tone":"muted","size":8.0,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":50.0,"w":100.0,"h":30.0,"text":"CUBIC\n×0.7, cubic","tone":"green","size":8.0,"sub_size":8.5,"o":0.4},{"t":"cell","id":"b","x":290.0,"y":50.0,"w":100.0,"h":30.0,"text":"BBR\nlink model","tone":"yellow","size":8.0,"sub_size":8.5,"o":0.4}],[{"t":"cell","id":"r","x":70.0,"y":50.0,"w":100.0,"h":30.0,"text":"Reno\n÷2, +1 per RTT","tone":"muted","size":8.0,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":50.0,"w":100.0,"h":30.0,"text":"CUBIC\n×0.7, cubic","tone":"green","size":8.0,"sub_size":8.5},{"t":"cell","id":"b","x":290.0,"y":50.0,"w":100.0,"h":30.0,"text":"BBR\nlink model","tone":"yellow","size":8.0,"sub_size":8.5,"o":0.4},{"t":"text","id":"t2","x":180.0,"y":82.0,"text":"Linux default","tone":"green","size":8.5}],[{"t":"cell","id":"r","x":70.0,"y":50.0,"w":100.0,"h":30.0,"text":"Reno\n÷2, +1 per RTT","tone":"muted","size":8.0,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":50.0,"w":100.0,"h":30.0,"text":"CUBIC\n×0.7, cubic","tone":"green","size":8.0,"sub_size":8.5},{"t":"cell","id":"b","x":290.0,"y":50.0,"w":100.0,"h":30.0,"text":"BBR\nlink model","tone":"yellow","size":8.0,"sub_size":8.5},{"t":"text","id":"t2","x":180.0,"y":82.0,"text":"Linux default","tone":"green","size":8.5},{"t":"text","id":"t3","x":290.0,"y":82.0,"text":"barely reacts to loss","tone":"yellow","size":8.5},{"t":"text","id":"t3b","x":180.0,"y":112.0,"text":"good where loss isn't congestion: Wi-Fi, satellite","size":8.5}],[{"t":"cell","id":"r","x":70.0,"y":50.0,"w":100.0,"h":30.0,"text":"Reno\n÷2, +1 per RTT","tone":"muted","size":8.0,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":50.0,"w":100.0,"h":30.0,"text":"CUBIC\n×0.7, cubic","tone":"green","size":8.0,"sub_size":8.5},{"t":"cell","id":"b","x":290.0,"y":50.0,"w":100.0,"h":30.0,"text":"BBR\nlink model","tone":"yellow","size":8.0,"sub_size":8.5},{"t":"text","id":"t2","x":180.0,"y":82.0,"text":"Linux default","tone":"green","size":8.5},{"t":"text","id":"t3","x":290.0,"y":82.0,"text":"barely reacts to loss","tone":"yellow","size":8.5},{"t":"text","id":"t3b","x":180.0,"y":112.0,"text":"good where loss isn't congestion: Wi-Fi, satellite","size":8.5},{"t":"cell","id":"ecn","x":180.0,"y":145.0,"w":220.0,"h":22.0,"text":"ECN: signal congestion without loss","tone":"blue","size":8.5,"sub_size":8.5}]],"cues":[6.4,15.5,34.8]},{"t":"note","text":"ECN signals congestion without packet loss."}]},{"title":"Buffers and delay","sub":"Bufferbloat","short":"Buffers","main":"A huge buffer hides loss, but the queue adds hundreds of ms of delay.","body":[{"t":"scene","labels":["Buffer","Bloat","Effect","Cure"],"captions":["A big buffer at the bottleneck hides losses","But the queue fills up: delay grows by hundreds of ms","Speed is high, but interactive apps suffer","A shorter queue and smart disciplines like fq_codel"],"frames":[[{"t":"cell","id":"s","x":40.0,"y":80.0,"w":52.0,"h":28.0,"text":"sender","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"r","x":320.0,"y":80.0,"w":52.0,"h":28.0,"text":"recv.","tone":"blue","size":9.0,"sub_size":8.5},{"t":"zone","id":"q","x":180.0,"y":80.0,"w":110.0,"h":34.0,"tone":"yellow","label":"queue"},{"t":"cell","id":"p0","x":140.0,"y":80.0,"w":12.0,"h":22.0,"