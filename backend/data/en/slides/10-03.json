{"book":10,"chapter":3,"rubric":"LEARNING RUST / GETTING TO KNOW RUST / CHAPTER 3","slides":[{"title":"Scalar types","sub":"Chapter 3 · Static typing","short":"Introduction","main":"Four scalar kinds: integers, floats, bool, char; the programmer sets the number's size.","body":[{"t":"scene","labels":["Static types","Four kinds","You choose the size"],"captions":["Every value's type is known at compile time: no adding a number to a word","Scalar types: integers, floats, bool and char — a single value","In Python int is one unbounded type; in Rust the programmer picks the size"],"frames":[[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["let n = 5;","let s = \"five\";","// n + s   ✕"],"hl":[2],"bad":[2],"lang":"rust","size":13.0,"lh":24.0,"w":300.0}],[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"integers","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"floats","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"bool","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"char","tone":"blue","size":10.5,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"Python: int\nunbounded","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"Rust: i8…i128\nfixed size","tone":"green","size":10.0,"sub_size":8.5}]],"cues":[14.9,30.0]}]},{"title":"Integers","sub":"iN and uN","short":"Integers","main":"i8…i128 signed, u8…u128 unsigned; usize is for indexes; default is i32.","body":[{"t":"scene","labels":["Signed and unsigned","Ranges","isize, usize, default"],"captions":["i8 i16 i32 i64 i128 — signed; u8 u16 u32 u64 u128 — unsigned","i8: −128 to 127; u8: 0 to 255; n bits give 2ⁿ values","usize is pointer-sized, used for indexes and lengths; default integer is i32"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":46.0,"w":76.0,"h":28.0,"text":"i8","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":46.0,"w":76.0,"h":28.0,"text":"i16","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":46.0,"w":76.0,"h":28.0,"text":"i32","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":46.0,"w":76.0,"h":28.0,"text":"i64","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"b0","x":50.0,"y":94.0,"w":76.0,"h":28.0,"text":"u8","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"b1","x":136.0,"y":94.0,"w":76.0,"h":28.0,"text":"u16","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"b2","x":222.0,"y":94.0,"w":76.0,"h":28.0,"text":"u32","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"b3","x":308.0,"y":94.0,"w":76.0,"h":28.0,"text":"u64","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":52.0,"w":140.0,"h":34.0,"text":"i8: −128 … 127","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":52.0,"w":140.0,"h":34.0,"text":"u8: 0 … 255","tone":"green","size":10.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"8 bits = 256 values","size":10.0}],[{"t":"cell","id":"a","x":90.0,"y":56.0,"w":120.0,"h":30.0,"text":"usize: indexes","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":56.0,"w":120.0,"h":30.0,"text":"let n = 7; → i32","tone":"green","size":10.0,"sub_size":8.5}]],"cues":[14.8,23.9]}]},{"title":"Overflow","sub":"When it won't fit","short":"Overflow","main":"debug — panic, release — wrap; checked/wrapping/saturating/overflowing.","body":[{"t":"scene","labels":["255 + 1","Debug and release","Explicit methods"],"captions":["u8 holds up to 255: what if you add one?","debug: panic \"attempt to add with overflow\"; release: wraps to 0","checked_add → Option, wrapping_add → wraps, saturating_add → clamps, overflowing_add → pair"],"frames":[[{"t":"cell","id":"a","x":100.0,"y":66.0,"w":80.0,"h":44.0,"text":"x: u8\n255","tone":"blue","size":11.0,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":66.0,"text":"+ 1","size":14.0},{"t":"cell","id":"q","x":270.0,"y":66.0,"w":70.0,"h":44.0,"text":"?","tone":"yellow","size":16.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":40.0,"text":"debug\npanic!","tone":"red","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":40.0,"text":"release\n→ 0","tone":"yellow","size":11.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["255u8.checked_add(1)      // None","255u8.wrapping_add(1)     // 0","255u8.saturating_add(1)   // 255","255u8.overflowing_add(1)  // (0, true)"],"lang":"rust","size":9.5,"lh":22.0,"w":340.0}]],"cues":[13.9,25.6]}]},{"title":"Literals","sub":"How to write numbers","short":"Literals","main":"1_000, 0xff, 0o17, 0b1010, 10u8, b'A'.","body":[{"t":"scene","labels":["Underscores","Number bases","Suffix and byte"],"captions":["1_000_000 — underscores are for readability only","0xff — hexadecimal, 0o17 — octal, 0b1010 — binary","10u8 — a number with a type suffix; b'A' — a byte (u8)"],"frames":[[{"t":"code","id":"c","x":30.0,"y":50.0,"lines":["let million = 1_000_000;","let big = 3_000_000_000_i64;"],"hl":[0,1],"lang":"rust","size":11.0,"lh":24.0,"w":320.0}],[{"t":"code","id":"c","x":30.0,"y":36.0,"lines":["let a = 0xff;     // 255","let b = 0o17;     // 15","let c = 0b1010;   // 10"],"hl":[0,1,2],"lang":"rust","size":12.0,"lh":22.0,"w":300.0}],[{"t":"code","id":"c","x":30.0,"y":50.0,"lines":["let x = 10u8;","let a = b'A';   // 65u8"],"hl":[0,1],"lang":"rust","size":13.0,"lh":24.0,"w":300.0}]],"cues":[11.9,26.6]}]},{"title":"Floating-point numbers","sub":"f32 and f64","short":"Floats","main":"f64 by default; IEEE 754; inf and NaN.","body":[{"t":"scene","labels":["f32 and f64","IEEE 754","inf and NaN"],"captions":["f32 — 32 bits, f64 — 64 bits; f64 is default, with twice the precision","0.1 + 0.2 ≠ 0.3: as in Python, binary representation is inexact","1.0 / 0.0 gives inf; 0.0 / 0.0 is NaN, not even equal to itself; check with is_nan()"],"frames":[[{"t":"cell","id":"a","x":100.0,"y":60.0,"w":120.0,"h":40.0,"text":"f32\n~7 digits","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":260.0,"y":60.0,"w":120.0,"h":40.0,"text":"f64\n~16 digits","tone":"green","size":11.0,"sub_size":8.5}],[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["0.1 + 0.2 == 0.3","// false","0.1 + 0.2   // 0.30000000000000004"],"hl":[1],"lang":"rust","size":11.0,"lh":24.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["1.0 / 0.0      // inf","0.0 / 0.0      // NaN","f64::NAN == f64::NAN  // false","x.is_nan()    // check"],"lang":"rust","size":10.0,"lh":22.0,"w":340.0}]],"cues":[15.2,30.1]}]},{"title":"Arithmetic","sub":"Operations and division","short":"Arithmetic","main":"Integer division drops the fraction; no **; types don't mix.","body":[{"t":"scene","labels":["Integer division","Division by zero","Power and mixing"],"captions":["7 / 2 = 3: integer division gives an integer; 7 % 2 = 1 — remainder; for a float result use at least one f64","Integer by zero — panic; float by zero — inf","Power — methods pow and powi, no ** operator; i32 + i64 — type error"],"frames":[[{"t":"code","id":"c","x":30.0,"y":30.0,"lines":["7 / 2      // 3","7 % 2      // 1","7.0 / 2.0  // 3.5"],"hl":[0,2],"lang":"rust","size":13.0,"lh":24.0,"w":300.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":40.0,"text":"5 / 0\npanic!","tone":"red","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":40.0,"text":"5.0 / 0.0\ninf","tone":"yellow","size":11.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["2_i32.pow(10)      // 1024","2.0_f64.powi(3)    // 8.0","let s = a_i32 + b_i64;","// error: mismatched types"],"hl":[3],"bad":[2,3],"lang":"rust","size":10.0,"lh":22.0,"w":340.0}]],"cues":[16.1,25.4]}]},{"title":"Conversion with as","sub":"x as f64","short":"as","main":"as changes the type explicitly, but may cut bits and fractions.","body":[{"t":"scene","labels":["x as f64","Truncation","Careful with as"],"captions":["as — explicit conversion: let f = n as f64;","256 as u8 = 0: high bits are cut off; 3.99 as i32 = 3: fraction is dropped","−1 as u32 gives 4294967295; safer to use From and TryFrom — they never lose data silently"],"frames":[[{"t":"code","id":"c","x":30.0,"y":50.0,"lines":["let n = 5;","let f = n as f64;   // 5.0"],"hl":[1],"lang":"rust","size":13.0,"lh":24.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["256 as u8     // 0","3.99 as i32   // 3","300.0 as u8   // 255"],"hl":[0,1,2],"lang":"rust","size":12.0,"lh":22.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["-1_i32 as u32   // 4294967295","u8::try_from(300)  // Err"],"hl":[0],"lang":"rust","size":11.0,"lh":26.0,"w":340.0}]],"cues":[8.8,25.9]}]},{"title":"bool","sub":"true and false","short":"bool","main":"&&, ||, !; only bool in a condition.","body":[{"t":"scene","labels":["true and false","&&, ||, !","No \"truthiness\""],"captions":["bool — two values; a comparison always gives a bool","&& — \"and\", || — \"or\", ! — \"not\"; the right side of && isn't evaluated if the left is false","if 1 {…} or if \"\" {…} is not allowed: the condition must be bool — write an explicit comparison"],"frames":[[{"t":"cell","id":"a","x":100.0,"y":60.0,"w":100.0,"h":36.0,"text":"true","tone":"green","size":13.0,"sub_size":8.5},{"t":"cell","id":"b","x":260.0,"y":60.0,"w":100.0,"h":36.0,"text":"false","tone":"red","size":13.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":118.0,"text":"5 > 3   →   true","size":10.5,"mono":true}],[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["let a = true;","let b = false;","a && b   // false","a || b   // true","!a       // false"],"lang":"rust","size":10.5,"lh":18.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["if 1 { }   // ✕ expected bool","if n != 0 { }   // ✓","if !s.is_empty() { }   // ✓"],"hl":[0],"bad":[0],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}]],"cues":[17.8,27.4]}]},{"title":"char","sub":"Unicode character","short":"char","main":"Single quotes, 4 bytes, methods and casting.","body":[{"t":"scene","labels":["Single quotes","4 bytes","Methods and as"],"captions":["char — one Unicode character in single quotes; a string uses double quotes","char takes 4 bytes: enough for «é», a hieroglyph, or an emoji","is_alphabetic, is_numeric, to_uppercase, to_digit; 'A' as u32 = 65; u8 as char"],"frames":[[{"t":"cell","id":"a","x":100.0,"y":60.0,"w":100.0,"h":40.0,"text":"'a'  — char","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":260.0,"y":60.0,"w":100.0,"h":40.0,"text":"\"a\"  — &str","tone":"green","size":11.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":66.0,"y":50.0,"w":80.0,"h":30.0,"text":"'z'","tone":"blue","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":150.0,"y":50.0,"w":80.0,"h":30.0,"text":"'é'","tone":"blue","size":12.0,"sub_size":8.5},{"t":"cell","id":"c","x":234.0,"y":50.0,"w":80.0,"h":30.0,"text":"'😀'","tone":"blue","size":12.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"each one — 4 bytes","size":10.0}],[{"t":"code","id":"c~code","x":20.0,"y":30.0,"lines":["'7'.to_digit(10)      // Some(7)","'a'.is_alphabetic()   // true","'A' as u32            // 65","97u8 as char          // 'a'"],"lang":"rust","size":10.0,"lh":22.0,"w":340.0}]],"cues":[15.8,30.1]}]},{"title":"From, TryFrom, parse","sub":"Safe conversions","short":"Conversions","main":"From — lossless, TryFrom — checked, parse — from text.","body":[{"t":"scene","labels":["From","TryFrom","parse"],"captions":["i64::from(x) — lossless widening; always safe","u8::try_from(x) — narrowing: Ok(number) or Err if it doesn't fit","\"42\".parse::<i32>() — from text: Ok(42) or Err; unwrap() stops the program on error"],"frames":[[{"t":"code","id":"c","x":30.0,"y":50.0,"lines":["let x: i32 = 5;","let y = i64::from(x);"],"hl":[1],"lang":"rust","size":12.0,"lh":24.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["u8::try_from(200)   // Ok(200)","u8::try_from(300)   // Err(..)"],"hl":[1],"lang":"rust","size":11.0,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["\"42\".parse::<i32>()    // Ok(42)","\"abc\".parse::<i32>()   // Err","let n: i32 = \"7\".parse().unwrap();"],"hl":[2],"lang":"rust","size":10.0,"lh":22.0,"w":340.0}]],"cues":[12.9,27.0]}]},{"title":"Methods and constants","sub":"abs, pow, MAX","short":"Methods","main":"Number methods, type limits, size_of.","body":[{"t":"scene","labels":["Number methods","Type limits","size_of"],"captions":["abs, pow, min, max; floats also have sqrt, floor, ceil, round","i32::MAX = 2147483647, i32::MIN, u8::MAX = 255 — limits live in type constants","std::mem::size_of::<T>() — type size in bytes: i32 → 4, f64 → 8, char → 4"],"frames":[[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["(-5_i32).abs()      // 5","4.0_f64.sqrt()     // 2.0","2.5_f64.round()    // 3.0","7.min(3)           // 3"],"lang":"rust","size":10.0,"lh":22.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["i32::MAX   // 2147483647","i32::MIN   // -2147483648","u8::MAX    // 255"],"lang":"rust","size":11.0,"lh":24.0,"w":340.0}],[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"u8 → 1","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"i32 → 4","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"f64 → 8","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"char → 4","tone":"blue","size":10.0,"sub_size":8.5}]],"cues":[12.9,25.0]}]},{"title":"After Python","sub":"What changed","short":"After Python","main":"No unbounded int; bool is not a number; types don't mix.","body":[{"t":"scene","labels":["Integers","bool and char","Conversions"],"captions":["Python: int grows without bound; Rust: every type has a size, limits and overflow","Python: True + 1 = 2, 'a' is a string; Rust: bool is not a number, char and &str differ","Python: int(\"5\"), float(n); Rust: parse, as, From — always explicit, no mixing types"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":36.0,"text":"int: any\nsize","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":36.0,"text":"i8…i128\nu8…u128","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":36.0,"text":"True + 1 → 2","tone":"muted","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":36.0,"text":"true + 1 ✕","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["# Python: int(\"5\") + 1","// Rust: \"5\".parse::<i32>()","//       .unwrap() + 1"],"hl":[1,2],"lang":"rust","size":10.5,"lh":22.0,"w":340.0}]],"cues":[15.5,20.7]}]},{"title":"Summary","sub":"What's next","short":"Summary","main":"Next — functions.","body":[{"t":"scene","labels":["Types","Rules","Next"],"captions":["Integers: iN and uN; floats: f32, f64; bool and char","Pick size by task: numbers — i32, indexes — usize; overflow and conversions explicit; condition only bool","Next chapter — functions: how to wrap a computation and return a value"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"i32","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"f64","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"bool","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"char","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["let n: usize = 3;","let x = n as f64 / 2.0;","let ok = x > 1.0;","let ch = 'я';"],"lang":"rust","size":11.0,"lh":22.0,"w":340.0}],[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":220.0,"h":34.0,"text":"fn add(a: i32, b: i32) -> i32","tone":"blue","size":10.5,"sub_size":8.5}]],"cues":[9.5,23.3]}]}]}