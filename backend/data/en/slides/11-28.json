 and open connections break it","Speculation rules prefetch or prerender the next page, taking data saving and network speed into account"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["/assets/app.9f2c.js","  Cache-Control: max-age=31536000, immutable","/index.html","  Cache-Control: no-cache"],"hl":[1,3],"lang":"js","size":9.5,"lh":24.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":120.0,"h":32.0,"text":"back → instant","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":120.0,"h":32.0,"text":"unload ✕","tone":"red","size":10.0,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":116.0,"text":"bfcache","size":10.0}],[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["{ \"prefetch\": [{","    \"urls\": [\"/next\"],","    \"eagerness\": \"moderate\" }] }"],"hl":[2],"lang":"js","size":10.0,"lh":26.0,"w":330.0}]],"cues":[9.6,19.6]}]},{"title":"Islands and budgets","sub":"Hydration and CI","short":"Budgets","main":"Compare medians.","body":[{"t":"scene","labels":["Islands","Hydration triggers","Budgets in CI"],"captions":["The server sends ready markup and interactive parts come alive separately: islands architecture","Hydration by trigger: on load, when idle, when visible, or on first interaction","The build fails if a size or metric goes over its limit; compare medians of several runs, since one measurement is noisy"],"frames":[[{"t":"cell","id":"p","x":180.0,"y":70.0,"w":280.0,"h":90.0,"text":"ready markup","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"a","x":100.0,"y":70.0,"w":80.0,"h":36.0,"text":"island","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":250.0,"y":70.0,"w":80.0,"h":36.0,"text":"island","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"t0","x":66.0,"y":70.0,"w":68.0,"h":30.0,"text":"load","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"t1","x":142.0,"y":70.0,"w":68.0,"h":30.0,"text":"idle","tone":"blue","size":9.5,"sub_size":8.5},{"t":"ce