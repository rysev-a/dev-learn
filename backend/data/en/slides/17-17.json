ize":8.5},{"t":"cell","id":"n2","x":95.0,"y":110.0,"w":158.0,"h":46.0,"text":"image\nstorage","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":265.0,"y":110.0,"w":158.0,"h":46.0,"text":"engine down:\nVMs keep running","tone":"yellow","size":9.0,"sub_size":8.5}]],"cues":[11.1,19.2,26.5]}]},{"title":"Object hierarchy","sub":"Chapter 17 · oVirt architecture","short":"Hierarchy","main":"Data center, cluster, host, machine: the ladder of permissions and policies.","body":[{"t":"scene","labels":["Data center","Cluster","Host","Machine"],"captions":["The data center: the boundary of shared resources, storage and networks attach to it","The cluster: hosts with compatible CPUs, VMs move between them","The host: the server where machines actually run","A VM belongs to a cluster and currently runs on one of its hosts"],"frames":[[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"data center","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"data center","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"cluster","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"data center","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"cluster","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"host","tone":"green","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"data center","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"cluster","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"host","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":180.0,"y":122.0,"w":280.0,"h":24.0,"t