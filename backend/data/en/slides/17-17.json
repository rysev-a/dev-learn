,12.4,25.4]}]},{"title":"The host: a chain of four links","sub":"Chapter 17 · oVirt architecture","short":"Host","main":"Engine, VDSM, libvirt, QEMU/KVM.","body":[{"t":"scene","labels":["Engine","VDSM","libvirt","QEMU/KVM"],"captions":["The engine gives orders over an encrypted channel","VDSM on port 54321 accepts them and watches the host's storage and network","libvirt starts and configures QEMU processes","QEMU uses KVM and runs the guest"],"frames":[[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"engine","tone":"blue","size":8.5,"sub_size":8.5}],[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"engine","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"n1","x":135.0,"y":70.0,"w":76.0,"h":52.0,"text":"VDSM\n:54321","tone":"violet","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":85.0,"y1":70.0,"x2":96.0,"y2":70.0,"tone":"violet","arrow":true,"width":1.6}],[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"engine","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"n1","x":135.0,"y":70.0,"w":76.0,"h":52.0,"text":"VDSM\n:54321","tone":"violet","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":85.0,"y1":70.0,"x2":96.0,"y2":70.0,"tone":"violet","arrow":true,"width":1.6},{"t":"cell","id":"n2","x":224.0,"y":70.0,"w":76.0,"h":52.0,"text":"libvirt","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"line","id":"a2","x1":174.0,"y1":70.0,"x2":185.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6}],[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"engine","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"n1","x":135.0,"y":70.0,"w":76.0,"h":52.0,"text":"VDSM\n:54321","tone":"violet","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":85.0,"y1":70.0,"x2":96.0,"y2":70.0,"tone":"violet","arrow":true,"width":1.6},{"t":"cell","id":"n2","x":224.0,"y":70.0,"w":76.0,"h":52.0,"text":"libvirt","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"line","id":"a2","x1":174.0,"y1":70.0,"x2":185.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"cell","id":"n3","x":313.0,"y":70.0,"w":76.0,"h":52.0,"text":"QEMU\n+ KVM","tone":"green","size":8.5,"sub_size":8.5},{"t":"line","id":"a3","x1":263.0,"y1":70.0,"x2":274.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[7.6,19.2,26.0]}]},{"title":"How a machine starts","sub":"Chapter 17 · oVirt architecture","short":"Start","main":"Permissions, host choice, command, preparation, QEMU process.","body":[{"t":"scene","labels":["Access","Host","Command","Running"],"captions":["The engine checks the administrator's permissions","The scheduler picks a host, the database marks the machine as starting","VDSM gets the create command, prepares disks and network, calls libvirt","The QEMU process is up, VDSM reports upward, the status becomes running"],"frames":[[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"permission check","tone":"muted","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"permission check","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"host choice, status WaitForLaunch","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"permission check","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"host choice, status WaitForLaunch","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"VDSM: disks, network, libvirt","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"permission check","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"host choice, status WaitForLaunch","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"VD