mport map"],"captions":["A dotted path is looked up next to the file; in ES modules the extension is required","A bare name is searched in node_modules up the folders; the exports field in package.json exposes only chosen entry points","The browser has no node_modules: an import map, a small JSON in the page, resolves bare names"],"frames":[[{"t":"code","id":"c","x":30.0,"y":50.0,"lines":["import a from './a.js';","import b from '../lib/b.js';"],"hl":[0,1],"lang":"js","size":11.5,"lh":26.0,"w":300.0}],[{"t":"cell","id":"a","x":90.0,"y":40.0,"w":120.0,"h":24.0,"text":"app/src/x.js","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":74.0,"w":140.0,"h":24.0,"text":"app/node_modules/lodash","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"c~cell","x":90.0,"y":108.0,"w":120.0,"h":24.0,"text":"node_modules/lodash","tone":"green","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":290.0,"y":76.0,"text":"up the\nfolders","size":10.0}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["<script type=\"importmap\">","{ \"imports\": {","  \"lodash\": \"/vendor/lodash.js\"","} }","</script>"],"hl":[2],"lang":"js","size":10.0,"lh":20.0,"w":330.0}]],"cues":[10.1,32.1]}]},{"title":"throw, try, finally","sub":"Exceptions and the stack","short":"Exceptions","main":"finally always runs: release resources there.","body":[{"t":"scene","labels":["throw","Bubbling up the stack","finally"],"captions":["An exception interrupts normal flow and is thrown with throw; throw an Error or a subclass","It bubbles up the call stack until a try/catch; an error has a name, a message and a stack","The finally block always runs, even on return: release resources there"],"frames":[[{"t":"code","id":"c","x":30.0,"y":50.0,"lines":["function div(a, b) {","  if (b === 0) throw new RangeError('division by zero');","  return a / b;","}"],"hl":[1],"lang":"js","size":10.0,"lh":22.0,"w":310.0}],[{"t":"cell","id":"s0","x":90.0,"y":40.0,"w":90.0,"h":26.0,"text":"main()","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"s1","x":90.0,"y":74.0,"w":90.0,"h":26.0,"text":"run()","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"s2","x":90.0,"y":108.0,"w":90.0,"h":26.0,"text":"div()","tone":"red","size":10.0,"sub_size":8.5},{"t":"line","id":"e0","x1":90.0,"y1":100.0,"x2":90.0,"y2":82.0,"tone":"red","arrow":true,"width":1.6},{"t":"line","id":"e1","x1":90.0,"y1":66.0,"x2":90.0,"y2":48.0,"tone":"red","arrow":true,"width":1.6},{"t":"cell","id":"c~cell","x":270.0,"y":40.0,"w":100.0,"h":26.0,"text":"catch ✓","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"code","id":"c","x":30.0,"y":36.0,"lines":["const f = open(path);","try {","  return parse(f);","} finally {","  f.close();   // always","}"],"hl":[4],"lang":"js","size":10.5,"lh":19.0,"w":300.0}]],"cues":[10.6,25.8]}]},{"title":"Good errors","sub":"Classes, cause, AggregateError","short":"Error classes","main":"cause keeps the root cause.","body":[{"t":"scene","labels":["Custom class","cause","AggregateError"],"captions":["Custom error classes carry a machine-readable code and context: validation, network, \"not found\"","The cause field wraps the original error in a more meaningful one without losing the root cause","AggregateError combines several errors, e.g. when several requests fail in parallel"],"frames":[[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["class NotFound extends Error {","  constructor(id) {","    super(`no record ${id}`);","    this.name = 'NotFound';","    this.code = 'E_NOT_FOUND';","  }","}"],"hl":[4],"lang":"js","size":9.5,"lh":18.0,"w":330.0}],[{"t":"cell","id":"a","x":90.0,"y":40.0,"w":150.0,"h":26.0,"text":"failed to save the order","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":80.0,"w":150.0,"h":26.0,"text":"connection dropped","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"c~cell","x":90.0,"y":120.0,"w":150.0,"h":26.0,"text":"timeout","tone":"red","size":10.0,"sub_size":8.5},{"t":"line","id":"e1","x1":90.0,"y1":94.0,"x2":90.0,"y2":66.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":90.0,"y1":134.0,"x2":90.0,"y2":106.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n","x":290.0,"y":80.0,"text":"cause →","size":10.0,"mono":true}],[{"t":"code","id":"c","x":30.0,"y":50.0,"lines":["const r = await Promise.allSettled(jobs);","throw new AggregateError(","  fails, 'some requests failed');"],"hl":[1],"lang":"js","size":10.0,"lh":24.0,"w":310.0}]],"cues":[11.9,32.7]}]},{"title":"Result instead of exception","sub":"Expected outcomes","short":"Result","main":"Return the expected as a value; use exceptions for the exceptional.","body":[{"t":"scene","labels":["Expected outcome","Result","Programmer errors"],"captions":["Not every failure is an exception: array search returns undefined, input parsing returns an outcome object","A \"success or error\" object makes the caller check the outcome and prevents forgetting to handle it","Programmer errors are fixed in code; operational ones (disk, network) are handled at runtime and retried"],"frames":[[{"t":"code","id":"c","x":40.0,"y":50.0,"lines":["[1, 2, 3].find((x) => x > 5)","// undefined is not an exception"],"hl":[1],"lang":"js","size":11.0,"lh":26.0,"w":280.0}],[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["function parseAge(s) {","  const n = Number(s);","  return n >= 0 ? { ok: true, value: n }","                : { ok: false, error: 'age' };","}"],"hl":[2,3],"lang":"js","size":9.5,"lh":20.0,"w":330.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":130.0,"h":40.0,"text":"touching\nundefined","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":130.0,"h":40.0,"text":"disk full,\nnetwork gone","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"text","id":"a1","x":90.0,"y":110.0,"text":"fix the code","size":9.5},{"t":"text","id":"b1","x":270.0,"y":110.0,"text":"handle it","size":9.5}]],"cues":[16.4,30.3]}]},{"title":"Retries and timeouts","sub":"Exponential backoff","short":"Retries","main":"Retry only idempotent operations, and with a pause.","body":[{"t":"scene","labels":["Attempts","Exponential pause","Timeout"],"captions":["A network request can be retried, but cap the attempts and retry only idempotent operations","The pause grows exponentially, plus jitter: thousands of clients won't hit the server at once","Every I/O operation has a waiting limit, or a hung request freezes the program forever"],"frames":[[{"t":"cell","id":"a0","x":70.0,"y":70.0,"w":70.0,"h":30.0,"text":"attempt 1","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"a1","x":170.0,"y":70.0,"w":70.0,"h":30.0,"text":"attempt 2","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"a2","x":270.0,"y":70.0,"w":70.0,"h":30.0,"text":"attempt 3","tone":"green","size":9.0,"sub_size":8.5},{"t":"line","id":"e0","x1":108.0,"y1":70.0,"x2":132.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e1","x1":208.0,"y1":70.0,"x2":232.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"cell","id":"b0","x":60.0,"y":110.0,"w":56.0,"h":12.0,"text":"100","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"b1","x":140.0,"y":96.0,"w":56.0,"h":28.0,"text":"200","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"b2","x":220.0,"y":82.0,"w":56.0,"h":44.0,"text":"400","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"b3","x":300.0,"y":68.0,"w":56.0,"h":60.0,"text":"800","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":28.0,"text":"pause, ms: ×2 each time + jitter","size":10.0}],[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["const ac = new AbortController();","setTimeout(() => ac.abort(), 5000);","await fetch(url, { signal: ac.signal });"],"hl":[1,2],"lang":"js","size":10.0,"lh":24.0,"w":310.0}]],"cues":[20.3,28.7]}]},{"title":"Unhandled errors","sub":"Global handlers","short":"Global","main":"The last line of defense: report, then shut down gracefully.","body":[{"t":"scene","labels":["In the browser","In Node.js","Last line of defense"],"captions":["In the browser an unhandled error goes to the console and the page lives on; events error and unhandledrejection","In Node.js an unhandled exception ends the process; events uncaughtException and unhandledRejection","Global handlers report to monitoring but don't pretend all is fine: state is unknown, so shut down safely"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["window.addEventListener('error', (e) => {","  report(e.error);","});","window.addEventListener('unhandledrejection', …);"],"hl":[0,3],"lang":"js","size":9.5,"lh":22.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["process.on('uncaughtException', (e) => {","  report(e);","  process.exit(1);","});"],"hl":[2],"lang":"js","size":10.0,"lh":22.0,"w":330.0}],[{"t":"cell","id":"e","x":90.0,"y":70.0,"w":100.0,"h":34.0,"text":"error","tone":"red","size":11.0,"sub_size":8.5},{"t":"line","id":"e1","x1":142.0,"y1":70.0,"x2":196.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"m","x":270.0,"y":70.0,"w":110.0,"h":34.0,"text":"monitoring\n(Sentry)","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":120.0,"text":"report, then graceful shutdown","size":9.5}]],"cues":[12.1,25.9]}]},{"title":"Debugging errors","sub":"Stack and context","short":"Debugging","main":"Don't swallow exceptions and don't throw strings.","body":[{"t":"scene","labels":["Stack","Context","Don't swallow"],"captions":["Read the stack bottom-up: the bottom line is where it began, the top is where it was thrown; pause on exceptions","A message with context: not \"invalid value\" but \"age must be 0 to 150, got -5\"","An empty catch turns an error into a mystery; and don't throw strings, they have no stack"],"frames":[[{"t":"cell","id":"s0","x":180.0,"y":40.0,"w":220.0,"h":26.0,"text":"at div (math.js:2)","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"s1","x":180.0,"y":74.0,"w":220.0,"h":26.0,"text":"at run (app.js:14)","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"s2","x":180.0,"y":108.0,"w":220.0,"h":26.0,"text":"at main (app.js:30)","tone":"blue","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":320.0,"y":40.0,"text":"← thrown","tone":"red","size":9.0},{"t":"text","id":"n2","x":320.0,"y":108.0,"text":"← start","size":9.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["throw new RangeError(","  `age 0–150, got ${age}`",");"],"hl":[1],"lang":"js","size":10.5,"lh":24.0,"w":330.0}],[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["try { risky(); } catch {}   // bad","throw 'error';             // bad","throw new Error('error');  // good"],"hl":[2],"bad":[0,1],"lang":"js","size":10.0,"lh":26.0,"w":310.0}]],"cues":[13.9,28.4]}]},{"title":"Summary","sub":"What's next","short":"Summary","main":"Next: promises and async/await.","body":[{"t":"scene","labels":["Modules","Errors","Next"],"captions":["ESM: own scope, live bindings, default and named exports, import() on demand; CommonJS is synchronous and returns a copy","throw, try/catch/finally, custom classes and cause; expected as values, network with retry and timeout, uncaught to monitoring","Next is asynchrony: promises and async/await"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":120.0,"h":30.0,"text":"import / export","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":240.0,"y":60.0,"w":130.0,"h":30.0,"text":"require","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":160.0,"y":116.0,"w":190.0,"h":28.0,"text":"avoid cycles","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":120.0,"h":30.0,"text":"try / catch / finally","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":240.0,"y":60.0,"w":130.0,"h":30.0,"text":"cause","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":160.0,"y":116.0,"w":190.0,"h":28.0,"text":"retry + timeout","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c~cod