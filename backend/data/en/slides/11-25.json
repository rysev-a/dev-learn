{"book":11,"chapter":25,"rubric":"MODERN FRONTEND / JAVASCRIPT IN THE BROWSER / CHAPTER 17","slides":[{"title":"The Data Path","sub":"Chapter 25 · From Form to Storage","short":"Intro","main":"Typed input must be checked, sent and not lost.","body":[{"t":"scene","labels":["Input","Check and send","Saving"],"captions":["Through forms the user hands data to the app","Input must be checked and sent; storage keeps it across page reloads","State can even be restored from the address bar — we will follow the whole data path"],"frames":[[{"t":"cell","id":"f","x":180.0,"y":70.0,"w":160.0,"h":60.0,"text":"form","tone":"yellow","size":12.0,"sub_size":8.5}],[{"t":"cell","id":"f","x":70.0,"y":70.0,"w":80.0,"h":34.0,"text":"form","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"line","id":"e1","x1":112.0,"y1":70.0,"x2":148.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"v","x":190.0,"y":70.0,"w":70.0,"h":34.0,"text":"validation","tone":"blue","size":10.0,"sub_size":8.5},{"t":"line","id":"e2","x1":228.0,"y1":70.0,"x2":262.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"s","x":312.0,"y":70.0,"w":80.0,"h":34.0,"text":"server","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"cell","id":"h0","x":66.0,"y":56.0,"w":116.0,"h":28.0,"text":"cookie","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"h1","x":196.0,"y":56.0,"w":116.0,"h":28.0,"text":"localStorage","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"h2","x":66.0,"y":100.0,"w":116.0,"h":28.0,"text":"IndexedDB","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"h3","x":196.0,"y":100.0,"w":116.0,"h":28.0,"text":"URL","tone":"blue","size":10.0,"sub_size":8.5}]],"cues":[16.6,26.9]}]},{"title":"Form Elements","sub":"Fields, label, autocomplete","short":"Fields","main":"Every field needs a name and a label.","body":[{"t":"scene","labels":["Fields","name and label","autocomplete"],"captions":["input of various types, textarea, select, checkboxes and radio buttons, fieldset; a button in a form submits it by default — others get type=\"button\"","Every field needs a name (it goes into the data) and a <label for> — this makes the field accessible and enlarges the click area","autocomplete tells the password manager what the field asks for and makes signing in easier"],"frames":[[{"t":"cell","id":"t0","x":54.0,"y":56.0,"w":76.0,"h":26.0,"text":"text","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"t1","x":138.0,"y":56.0,"w":76.0,"h":26.0,"text":"email","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"t2","x":222.0,"y":56.0,"w":76.0,"h":26.0,"text":"number","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"t3","x":306.0,"y":56.0,"w":76.0,"h":26.0,"text":"date","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"t4","x":54.0,"y":100.0,"w":76.0,"h":26.0,"text":"password","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"t5","x":138.0,"y":100.0,"w":76.0,"h":26.0,"text":"checkbox","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"t6","x":222.0,"y":100.0,"w":76.0,"h":26.0,"text":"radio","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"t7","x":306.0,"y":100.0,"w":76.0,"h":26.0,"text":"file","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["<label for=\"email\">Email</label>","<input id=\"email\" name=\"email\"","       type=\"email\" required>"],"hl":[1,2],"lang":"js","size":10.0,"lh":24.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["<input name=\"user\" autocomplete=\"username\">","<input name=\"pw\" type=\"password\"","       autocomplete=\"current-password\">"],"hl":[0,2],"lang":"js","size":9.5,"lh":24.0,"w":340.0}]],"cues":[15.6,26.3]}]},{"title":"Submitting","sub":"FormData and encoding","short":"Submit","main":"Only named, enabled fields go into the set.","body":[{"t":"scene","labels":["Name-value pairs","FormData","Encoding"],"captions":["Only named, enabled fields go into the set; checked checkboxes and radio buttons; a button only if it was the one pressed","FormData builds a form programmatically: append, get, getAll, set, delete; sent via fetch","urlencoded is key=value joined by &; multipart is for files; GET puts data in the address, POST in the body"],"frames":[[{"t":"cell","id":"p0","x":66.0,"y":56.0,"w":100.0,"h":26.0,"text":"name=Ada","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"p1","x":180.0,"y":56.0,"w":100.0,"h":26.0,"text":"age=36","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"p2","x":294.0,"y":56.0,"w":100.0,"h":26.0,"text":"agree=on","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"p3","x":66.0,"y":100.0,"w":100.0,"h":26.0,"text":"disabled ✕","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"p4","x":180.0,"y":100.0,"w":100.0,"h":26.0,"text":"unchecked ✕","tone":"red","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["const fd = new FormData(form);","fd.set('tag', 'a');","fd.append('tag', 'b');","fetch('/api', { method: 'POST', body: fd });"],"hl":[3],"lang":"js","size":9.5,"lh":22.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["urlencoded:  name=%D0%90%D0%B4%D0%B0&age=36","multipart:   --boundary","             Content-Disposition: form-data;","             name=\"photo\"; filename=\"a.png\""],"hl":[0],"lang":"js","size":8.5,"lh":22.0,"w":340.0}]],"cues":[14.5,28.2]}]},{"title":"Validation","sub":"Constraint Validation","short":"Validation","main":"validity can be read from code.","body":[{"t":"scene","labels":["Attributes","ValidityState","Custom messages"],"captions":["required, pattern, min, max, minlength, maxlength and step set the rules; type=email and url are checked automatically","A field has validity with flags: valueMissing, typeMismatch, patternMismatch, tooLong, tooShort, rangeUnderflow, rangeOverflow, stepMismatch","checkValidity and reportValidity, setCustomValidity for your own message; :invalid styles faulty fields; novalidate turns off the built-in check"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["<input type=\"number\" min=\"18\" max=\"99\" required>","<input pattern=\"[0-9]{6}\" minlength=\"6\">"],"hl":[0,1],"lang":"js","size":9.5,"lh":30.0,"w":340.0}],[{"t":"cell","id":"v0","x":66.0,"y":40.0,"w":118.0,"h":24.0,"text":"valueMissing","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"v1","x":196.0,"y":40.0,"w":118.0,"h":24.0,"text":"typeMismatch","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"v2","x":66.0,"y":76.0,"w":118.0,"h":24.0,"text":"patternMismatch","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"v3","x":196.0,"y":76.0,"w":118.0,"h":24.0,"text":"tooShort","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"v4","x":66.0,"y":112.0,"w":118.0,"h":24.0,"text":"rangeUnderflow","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"v5","x":196.0,"y":112.0,"w":118.0,"h":24.0,"text":"stepMismatch","tone":"blue","size":8.5,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["input.setCustomValidity('Name is taken');","input.checkValidity();    // false","input.reportValidity();   // shows the hint","input:invalid { border-color: red; }"],"hl":[0,3],"lang":"js","size":9.5,"lh":22.0,"w":340.0}]],"cues":[12.3,34.3]}]},{"title":"Client and Server","sub":"Messages and focus","short":"Client and server","main":"Client validation is not protection.","body":[{"t":"scene","labels":["Not protection","Messages","Focus and ARIA"],"captions":["Client validation is a convenience, not protection: anyone can send a request bypassing the form, so the server checks everything again","The error stands next to the field and is clear; show it when leaving the field or on submit, not at the first letter","aria-describedby links the message to the field, aria-invalid marks the error; on submit, focus moves to the first wrong field"],"frames":[[{"t":"cell","id":"c","x":90.0,"y":70.0,"w":110.0,"h":34.0,"text":"form\n(client)","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"s","x":270.0,"y":70.0,"w":110.0,"h":34.0,"text":"server\nchecks","tone":"green","size":10.0,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":70.0,"x2":214.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"x","x":180.0,"y":130.0,"w":110.0,"h":24.0,"text":"curl → server","tone":"red","size":9.0,"sub_size":8.5},{"t":"line","id":"e2","x1":180.0,"y1":118.0,"x2":250.0,"y2":90.0,"tone":"red","arrow":true,"width":1.6}],[{"t":"cell","id":"i","x":180.0,"y":50.0,"w":220.0,"h":30.0,"text":"email: ada@","tone":"red","size":10.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":84.0,"text":"Enter the full address: name@domain","tone":"red","size":10.0}],[{"t":"code","id":"c~code","x":20.0,"y":36.0,"lines":["<input id=\"e\" aria-invalid=\"true\"","       aria-describedby=\"e-err\">","<p id=\"e-err\">Enter an address</p>","firstInvalid.focus();"],"hl":[0,1,3],"lang":"js","size":9.5,"lh":22.0,"w":340.0}]],"cues":[11.1,25.8]}]},{"title":"Form State","sub":"Controlled fields, drafts","short":"State","main":"Warn about unsaved changes.","body":[{"t":"scene","labels":["Controlled or not","value and defaultValue","beforeunload"],"captions":["An uncontrolled form keeps values in the DOM, a controlled one in app state and redraws the field on every change","value is the current value, defaultValue is the initial one: their difference shows whether the user changed the data","beforeunload warns about unsaved changes; drafts are saved automatically after a pause in typing"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":120.0,"h":40.0,"text":"DOM keeps\nthe value","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":120.0,"h":40.0,"text":"app\nstate","tone":"yellow","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["const dirty = input.value !== input.defaultValue;","form.reset();   // restores defaultValue"],"hl":[0],"lang":"js","size":9.5,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["window.addEventListener('beforeunload', (e) => {","  if (isDirty()) e.preventDefault();","});","input.addEventListener('input', debounce(saveDraft, 500));"],"hl":[1,3],"lang":"js","size":9.0,"lh":22.0,"w":340.0}]],"cues":[17.1,26.1]}]},{"title":"Cookie","sub":"Set-Cookie and attributes","short":"Cookie","main":"Session goes in HttpOnly cookies.","body":[{"t":"scene","labels":["Set-Cookie","Attributes","document.cookie"],"captions":["The server sets cookies with the Set-Cookie header, and the browser sends them back with every request to the same site","Path and Domain are the scope, Max-Age and Expires the lifetime, Secure means HTTPS only, HttpOnly hides from scripts, SameSite limits sending from other sites","document.cookie shows cookies to scripts; about 4 KB per entry and weight on every request; session ID only as HttpOnly"],"frames":[[{"t":"cell","id":"s","x":90.0,"y":70.0,"w":100.0,"h":34.0,"text":"server","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":100.0,"h":34.0,"text":"browser","tone":"blue","size":11.0,"sub_size":8.5},{"t":"line","id":"e1","x1":140.0,"y1":62.0,"x2":218.0,"y2":62.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":218.0,"y1":80.0,"x2":140.0,"y2":80.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"text","id":"a","x":180.0,"y":48.0,"text":"Set-Cookie","size":9.0,"mono":true},{"t":"text","id":"b2","x":180.0,"y":98.0,"text":"Cookie: …","size":9.0,"mono":true}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["Set-Cookie: sid=abc123;","  Path=/; Max-Age=3600;","  Secure; HttpOnly; SameSite=Lax"],"hl":[2],"lang":"js","size":10.5,"lh":26.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["document.cookie = 'theme=dark; Max-Age=86400';","document.cookie   // 'theme=dark; lang=ru'","// sid with HttpOnly is not visible here"],"hl":[2],"lang":"js","size":9.5,"lh":26.0,"w":340.0}]],"cues":[10.8,30.0]}]},{"title":"Web Storage","sub":"localStorage and sessionStorage","short":"Web Storage","main":"Secrets do not belong there.","body":[{"t":"scene","labels":["Strings","Synchronous and quota","storage event"],"captions":["localStorage lives until the user clears data, sessionStorage until the tab closes; keys and values are strings, objects go through JSON","The methods are synchronous, big volumes slow the page; quota about 5 MB — exceeding it throws QuotaExceededError","The storage event tells other tabs about a change — this syncs theme and sign-out; never store secrets: any script can read them"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["localStorage.setItem('user', JSON.stringify(u));","const u = JSON.parse(localStorage.getItem('user'));","localStorage.removeItem('user');"],"hl":[0,1],"lang":"js","size":9.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["try {","  localStorage.setItem('big', hugeString);","} catch (e) {","  // e.name === 'QuotaExceededError'","}"],"hl":[3],"lang":"js","size":10.0,"lh":22.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":34.0,"text":"tab A\nsetItem","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":110.0,"h":34.0,"text":"tab B\nonstorage","tone":"green","size":9.5,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":70.0,"x2":214.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6}]],"cues":[12.2,31.0]}]},{"title":"IndexedDB","sub":"Transactions and indexes","short":"IndexedDB","main":"Schema changes when version grows.","body":[{"t":"scene","labels":["Stores and indexes","Transactions","Schema versions"],"captions":["IndexedDB keeps objects in stores: the key is a path inside the object, indexes let you search by fields","All operations are inside transactions and asynchronous: you open a request, the result arrives in a handler; thin wrappers like idb are handier","The schema changes when the version grows, in onupgradeneeded; nearby: Cache API, origin private file system and StorageManager.estimate()"],"frames":[[{"t":"cell","id":"s","x":90.0,"y":56.0,"w":120.0,"h":28.0,"text":"store: orders","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"i","x":90.0,"y":100.0,"w":120.0,"h":24.0,"text":"index: byDate","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"r","x":270.0,"y":78.0,"w":130.0,"h":70.0,"text":"{ id: 7,\n  date: …,\n  total: 40 }","tone":"green","size":9.5,"sub_size":8.5},{"t":"line","id":"e","x1":150.0,"y1":56.0,"x2":204.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["const tx = db.transaction('orders', 'readwrite');","tx.objectStore('orders').put(order);","tx.oncomplete = () => done();"],"hl":[1],"lang":"js","size":9.5,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["const req = indexedDB.open('app', 3);","req.onupgradeneeded = (e) => {","  if (e.oldVersion < 3) addIndex();","};"],"hl":[2],"lang":"js","size":9.5,"lh":22.0,"w":340.0}]],"cues":[13.3,31.6]}]},{"title":"URL and History","sub":"pushState and popstate","short":"History","main":"The address is part of app state.","body":[{"t":"scene","labels":["URL and parameters","pushState","popstate"],"captions":["URL parses an address into parts, URLSearchParams reads and correctly encodes query parameters","pushState adds a history entry without a reload, replaceState replaces the current one; state is part of the app address","popstate fires when the user presses back or forward; the part after the hash was used before — it works without server setup"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["const u = new URL(location.href);","u.searchParams.set('page', 2);","u.pathname   // '/catalog'"],"hl":[1],"lang":"js","size":10.0,"lh":24.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["history.pushState({ id: 7 }, '', '/item/7');","history.replaceState(null, '', '/item/7?x=1');"],"hl":[0],"lang":"js","size":9.5,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["window.addEventListener('popstate', (e) => {","  render(location.pathname, e.state);","});"],"hl":[1],"lang":"js","size":10.0,"lh":24.0,"w":340.0}]],"cues":[12.4,27.4]}]},{"title":"Router","sub":"Intercepting clicks","short":"Router","main":"The server returns the main page for any path.","body":[{"t":"scene","labels":["Matching","Intercepting clicks","Server and scroll"],"captions":["A router matches a path to a screen, takes parameters from the address and calls pushState instead of navigating","Do not intercept clicks with modifiers, the middle button, links with target and download, or other sites' addresses","You need scroll restoration on going back and a not-found page; the server returns the main page for any path, or a refresh gives an error"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["'/users/:id'  →  UserPage","'/users/42'   →  { id: '42' }"],"hl":[1],"lang":"js","size":10.5,"lh":30.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["if (e.button !== 0 || e.ctrlKey || e.metaKey) return;","if (a.target || a.hasAttribute('download')) return;","if (a.origin !== location.origin) return;","e.preventDefault(); navigate(a.pathname);"],"hl":[3],"lang":"js","size":9.0,"lh":22.0,"w":340.0}],[{"t":"cell","id":"u","x":90.0,"y":56.0,"w":110.0,"h":28.0,"text":"GET /users/42","tone":"blue","size":9.5,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":56.0,"x2":214.0,"y2":56.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"s","x":270.0,"y":56.0,"w":110.0,"h":28.0,"text":"index.html","tone":"green","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":112.0,"text":"one page for any path","size":9.5}]],"cues":[14.8,30.8]}]},{"title":"Storage Security","sub":"XSS, CSRF, privacy","short":"Security","main":"Page scripts read everything they can reach.","body":[{"t":"scene","labels":["XSS and tokens","Cookies and CSRF","Privacy"],"captions":["Everything in localStorage and IndexedDB is open to any page script: injected code will steal the token","HttpOnly cookies are hidden from scripts, but bring the risk of request forgery: SameSite and tokens; CSP reduces the risk of code injection","Web Crypto encrypts, but the key must still be stored somewhere; privacy laws: consent for non-essential cookies and the right to delete data"],"frames":[[{"t":"cell","id":"t","x":90.0,"y":60.0,"w":110.0,"h":28.0,"text":"token in\nlocalStorage","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"x","x":270.0,"y":60.0,"w":110.0,"h":28.0,"text":"foreign script\n(XSS)","tone":"red","size":9.0,"sub_size":8.5},{"t":"line","id":"e","x1":214.0,"y1":60.0,"x2":146.0,"y2":60.0,"tone":"red","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"reads and sends it","tone":"red","size":10.0}],[{"t":"cell","id":"c","x":90.0,"y":60.0,"w":120.0,"h":30.0,"text":"HttpOnly cookie","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"r","x":270.0,"y":60.0,"w":120.0,"h":30.0,"text":"CSRF risk","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"m","x":180.0,"y":116.0,"w":220.0,"h":26.0,"text":"SameSite=Lax · tokens · CSP","tone":"blue","size":9.5,"sub_size":8.5}],[{"t":"cell","id":"p0","x":66.0,"y":70.0,"w":100.0,"h":34.0,"text":"consent","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"p1","x":180.0,"y":70.0,"w":100.0,"h":34.0,"text":"deletion","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"p2","x":294.0,"y":70.0,"w":100.0,"h":34.0,"text":"minimum","tone":"blue","size":10.5,"sub_size":8.5}]],"cues":[12.1,25.9]}]},{"title":"Summary","sub":"What next","short":"Summary","main":"Next — the network.","body":[{"t":"scene","labels":["Forms","Storage","Next"],"captions":["A form sends name-value pairs, FormData builds them in code; built-in validation is read via validity, the real one is on the server","Cookies carry the session, Web Storage holds strings, IndexedDB objects; the address and history are state, a router maps them to screens","Next — the network: fetch, CORS and WebSocket"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":120.0,"h":30.0,"text":"FormData","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":240.0,"y":60.0,"w":130.0,"h":30.0,"text":"validity","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"c","x":160.0,"y":116.0,"w":190.0,"h":28.0,"text":"server checks everything","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":120.0,"h":30.0,"text":"cookie · storage","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":240.0,"y":60.0,"w":130.0,"h":30.0,"text":"IndexedDB","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"c","x":160.0,"y":116.0,"w":190.0,"h":28.0,"text":"URL · History","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"code","id":"c~code","x":40.0,"y":44.0,"lines":["const res = await fetch('/api/items');","const data = await res.json();"],"hl":[0],"lang":"js","size":10.5,"lh":26.0,"w":290.0},{"t":"text","id":"n","x":180.0,"y":126.0,"text":"chapter 26: the browser network","size":9.5}]],"cues":[13.6,23.4]}]}]}