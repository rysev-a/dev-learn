":56.0,"x2":204.0,"y2":56.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":112.0,"text":"Python swaps the operands","tone":"green","size":10.0}],[{"t":"code","id":"c","x":30.0,"y":50.0,"lines":["sum([v1, v2])","# 0 + v1  →  v1.__radd__(0)","# v1 + v2"],"hl":[1],"lang":"python","size":11.0,"lh":24.0,"w":300.0},{"t":"text","id":"n","x":180.0,"y":126.0,"text":"sum() needs __radd__ with zero","tone":"yellow","size":10.0}]],"cues":[9.7,16.9,26.1]}]},{"title":"In-place operators","sub":"+=, -=, *=","short":"In place","main":"__iadd__ must return self.","body":[{"t":"scene","labels":["+=","List","Tuple","return self"],"captions":["x += y calls x.__iadd__(y); if absent, Python does x = x + y","For a list, += changes the object itself: a second name sees the change","For a tuple, += creates a new object and the old one stays as it was","Your __iadd__ must return self, or the variable gets None"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":100.0,"h":28.0,"text":"x += y","tone":"blue","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":44.0,"w":130.0,"h":24.0,"text":"has __iadd__ → it","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"c","x":270.0,"y":80.0,"w":130.0,"h":24.0,"text":"no → x = x + y","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"line","id":"e1","x1":142.0,"y1":56.0,"x2":204.0,"y2":46.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":142.0,"y1":64.0,"x2":204.0,"y2":78.0,"tone":"yellow","arrow":true,"width":1.6}],[{"t":"code","id":"c~code","x":40.0,"y":44.0,"lines":["a = [1]","b = a","a += [2]","print(b)   # [1, 2]"],"hl":[2,3],"lang":"python","size":11.5,"lh":24.0,"w":260.0}],[{"t":"code","id":"c~code","x":40.0,"y":44.0,"lines":["a = (1,)","b = a","a += (2,)","print(b)   # (1,)"],"hl":[2,3],"lang":"python","size":11.5,"lh":24.0,"w":260.0}],[{"t":"code","id":"c~code","x":30.0,"y":50.0,"lines":["def __iadd__(self, other):","    self.items.extend(other.items)","    return self"],"hl":[2],"lang":"python","size":10.5,"lh":22.0,"w":300.0}]],"cues":[6.1,20.4,27.5]}]},{"title":"Unary and conversions","sub":"-x, abs, int, float","short":"Unary","main":"Looked up on the type, returns a new value.","body":[{"t":"scene","labels":["Unary","Vector","Conversions"],"captions":["Unary operators: -x is __neg__, +x is __pos__, abs(x) is __abs__, ~x is __invert__","Negation reverses the vector, and abs naturally returns the length","Explicit casts: int(), float(), complex() and round() call __int__, __float__, __complex__ and __round__"],"frames":[[{"t":"cell","id":"o0","x":90.0,"y":32.0,"w":80.0,"h":22.0,"text":"-x","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"cell","id":"m0","x":240.0,"y":32.0,"w":100.0,"h":22.0,"text":"__neg__","tone":"green","size":10.0,"sub_size":8.5},{"t":"line","id":"e0","x1":134.0,"y1":32.0,"x2":186.0,"y2":32.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"o1","x":90.0,"y":64.0,"w":80.0,"h":22.0,"text":"+x","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"cell","id":"m1","x":240.0,"y":64.0,"w":100.0,"h":22.0,"text":"__pos__","tone":"green","size":10.0,"sub_size":8.5},{"t":"line","id":"e1","x1":134.0,"y1":64.0,"x2":186.0,"y2":64.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"o2","x":90.0,"y":96.0,"w":80.0,"h":22.0,"text":"abs(x)","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"cell","id":"m2","x":240.0,"y":96.0,"w":100.0,"h":22.0,"text":"__abs__","tone":"green","size":10.0,"sub_size":8.5},{"t":"line","id":"e2","x1":134.0,"y1":96.0,"x2":186.0,"y2":96.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"o3","x":90.0,"y":128.0,"w":80.0,"h":22.0,"text":"~x","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"cell","id":"m3","x":240.0,"y":128.0,"w":100.0,"h":22.0,"text":"__invert__","tone":"green","size":10.0,"sub_size":8.5},{"t":"line","id":"e3","x1":134.0,"y1":128.0,"x2":186.0,"y2":128.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"code","id":"c","x":40.0,"y":48.0,"lines":["v = Vector(3, 4)","-v        # Vector(-3, -4)","abs(v)     # 5.0"],"hl":[1,2],"lang":"python","size":11.5,"lh":24.0,"w":270.0}],[{"t":"cell","id":"a","x":70.0,"y":50.0,"w":100.0,"h":24.0,"text":"int(x)","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":70.0,"y":84.0,"w":100.0,"h":24.0,"text":"float(x)","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"c~cell","x":70.0,"y":118.0,"w":100.0,"h":24.0,"text":"round(x)","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"d","x":250.0,"y":50.0,"w":110.0,"h":24.0,"text":"__int__","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"e","x":250.0,"y":84.0,"w":110.0,"h":24.0,"text":"__float__","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"f","x":250.0,"y":118.0,"w":110.0,"h":24.0,"text":"__round__","tone":"green","size":10.5,"sub_size":8.5}]],"cues":[14.7,22.4]}]},{"title":"__index__","sub":"Exact integer","short":"index","main":"__index__ gives index, slice, hex and range.","body":[{"t":"scene","labels":["List index","Exact integer","Fractions: no"],"captions":["Indexes, slices, hex(), bin() and range() need an integer by nature: they call __index__","So your step number or enum member can go in brackets without extra conversions","Floats and fractions have no __index__: data is lost, so a list can't be indexed by them"],"frames":[[{"t":"code","id":"c","x":40.0,"y":50.0,"lines":["items[Step(2)]","hex(Step(255))","range(Step(3))"],"lang":"python","size":12.0,"lh":26.0,"w":260.0},{"t":"cell","id":"m","x":290.0,"y":78.0,"w":90.0,"h":28.0,"text":"__index__","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"code","id":"c","x":30.0,"y":50.0,"lines":["class Step:","    def __init__(self, n):","        self.n = n","    def __index__(self):","        return self.n"],"hl":[3,4],"lang":"python","size":10.5,"lh":20.0,"w":300.0}],[{"t":"code","id":"c","x":40.0,"y":50.0,"lines":["items[1]      # allowed","items[1.5]    # TypeError","items[Fraction(1, 2)]  # TypeError"],"bad":[1,2],"lang":"python","size":