ated","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":290.0,"y":40.0,"w":100.0,"h":24.0,"text":"204 No Content","tone":"green","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":100.0,"text":"201 + Location: /rooms/7","tone":"muted","size":9.0},{"t":"text","id":"m","x":290.0,"y":100.0,"text":"after deletion","tone":"muted","size":9.0}],[{"t":"cell","id":"a","x":70.0,"y":40.0,"w":100.0,"h":24.0,"text":"404 none","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":40.0,"w":100.0,"h":24.0,"text":"409 conflict","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":290.0,"y":40.0,"w":100.0,"h":24.0,"text":"422 invalid","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":70.0,"y":90.0,"text":"no such room","tone":"muted","size":9.0},{"t":"text","id":"m","x":180.0,"y":90.0,"text":"name taken","tone":"muted","size":9.0},{"t":"text","id":"k","x":290.0,"y":90.0,"text":"password too short","tone":"muted","size":9.0}],[{"t":"cell","id":"a","x":90.0,"y":50.0,"w":130.0,"h":26.0,"text":"HEAD /rooms","tone":"blue","size":10.0,"sub_size":8.5},{"t":"line","id":"e1","x1":156.0,"y1":50.0,"x2":214.0,"y2":50.0,"tone":"muted","arrow":true,"width":1.6},{"t":"cell","id":"b","x":290.0,"y":50.0,"w":120.0,"h":26.0,"text":"like GET, no body","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"c","x":90.0,"y":110.0,"w":130.0,"h":26.0,"text":"PATCH /rooms","tone":"blue","size":10.0,"sub_size":8.5},{"t":"line","id":"e2","x1":156.0,"y1":110.0,"x2":214.0,"y2":110.0,"tone":"muted","arrow":true,"width":1.6},{"t":"cell","id":"d","x":290.0,"y":110.0,"w":120.0,"h":26.0,"text":"405 + Allow","tone":"yellow","size":10.0,"sub_size":8.5}]],"cues":[12.0,24.0]}]},{"title":"nest and merge","sub":"Modular routers","short":"nest/merge","main":"nest mounts a router under a prefix, merge joins routers; fallback answers the unknown.","body":[{"t":"scene","labels":["Modules","nest","merge and fallback"],"captions":["Each module returns its own Router: users, rooms, messages","nest mounts under a prefix; inside, paths start from the module root","merge joins routers at one level; fallback answers the unknown"],"frames":[[{"t":"cell","id":"r","x":180.0,"y":30.0,"w":120.0,"h":26.0,"text":"app()","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a","x":70.0,"y":100.0,"w":100.0,"h":26.0,"text":"users()","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":100.0,"w":100.0,"h":26.0,"text":"rooms()","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":290.0,"y":100.0,"w":100.0,"h":26.0,"text":"messages()","tone":"blue","size":10.0,"sub_size":8.5},{"t":"line","id":"e1","x1":150.0,"y1":44.0,"x2":100.0,"y2":88.0,"tone":"muted","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":180.0,"y1":44.0,"x2":180.0,"y2":88.0,"tone":"muted","arrow":true,"width":1.6},{"t":"line","id":"e3","x1":210.0,"y1":44.0,"x2":260.0,"y2":88.0,"tone":"muted","arrow":true,"width":1.6}],[{"t":"code","id":"c~code","x":10.0,"y":20.0,"lines":["Router::new()","    .nest(\"/api/rooms\", rooms())","    .nest(\"/api/users\", users())","// inside rooms(): route(\"/{id}\", ..) → /api/rooms/{id}"],"hl":[1,2],"lang":"rust","size":8.5,"lh":24.0,"w":340.0}],[{"t":"code","id":"c~code","x":10.0,"y":20.0,"lines":["Router::new()","    .merge(health())","    .nest(\"/api\", api())","    .fallback(not_found)"],"hl":[1,3],"lang":"rust","size":10.0,"lh":26.0,"w":340.0}]],"cues":[13.2,26.3]}]},{"title":"Starting the server","sub":"serve and port 0","short":"Startup","main":"TcpListener and axum::serve start the server; port 0 picks a free one — handy for tests.","body":[{"t":"scene","labels":["Three lines","Port 0","Server is a task"],"captions":["Bind a socket, pass it to serve with the router, wait","Port 0 — the system picks a free one; ask the socket for the address","Each connection is served by its own tokio task"],"frames":[[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["let listener = 