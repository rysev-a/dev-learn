":"b","x":180.0,"y":70.0,"w":70.0,"h":28.0,"text":"Json","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"line","id":"e2","x1":216.0,"y1":70.0,"x2":242.0,"y2":70.0,"tone":"red","arrow":true,"width":1.6},{"t":"cell","id":"c","x":300.0,"y":70.0,"w":100.0,"h":28.0,"text":"400 / 422","tone":"red","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":120.0,"text":"handler not called","tone":"red","size":9.0}]],"cues":[12.2,24.3]}]},{"title":"Path and Query","sub":"Request parameters","short":"Path/Query","main":"Path and Query deserialize parameters via serde: tuples, structs, Option, and defaults.","body":[{"t":"scene","labels":["Path","Query","Errors"],"captions":["One type, a tuple, or a struct: serde parses segments by name","A struct with Option and defaults describes the allowed fields","A non-number where a number is expected — 400 with a reason"],"frames":[[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["Path(id): Path<u32>","Path((room, n)): Path<(u32, u32)>","Path(p): Path<Params>  // struct { room, n }"],"hl":[0,1,2],"lang":"rust","size":9.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["#[derive(Deserialize)]","struct Page {","    #[serde(default = \"ten\")] limit: u32,","    before: Option<u64>,","}","// GET /msgs?limit=5&before=100"],"hl":[2,3],"lang":"rust","size":9.0,"lh":16.0,"w":340.0}],[{"t":"cell","id":"a","x":80.0,"y":50.0,"w":130.0,"h":26.0,"text":"/rooms/abc","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"line","id":"e1","x1":146.0,"y1":50.0,"x2":214.0,"y2":50.0,"tone":"muted","arrow":true,"width":1.6},{"t":"cell","id":"b","x":290.0,"y":50.0,"w":120.0,"h":26.0,"text":"400 Bad Request","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"c~cell","x":80.0,"y":110.0,"w":130.0,"h":26.0,"text":"/msgs?limit=x","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"line","id":"e2","x1":146.0,"y1":110.0,"x2":214.0,"y2":110.0,"tone":"muted","arrow":true,"width":1.6},{"t":"cell","id":"d","x":290.0,"y":110.0,"w":120.0,"