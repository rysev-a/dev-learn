":["Inside out","Steps","Readability"],"captions":["One function's result is another's argument: LOWER(TRIM(x))","Break deep nesting into steps: a subquery or CTE with names","Readability beats brevity"],"frames":[[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["SELECT LOWER(TRIM('  Nova  '));"],"hl":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"a","x":90.0,"y":100.0,"w":110.0,"h":24.0,"text":"TRIM → 'Nova'","tone":"blue","size":9.0,"sub_size":8.5},{"t":"line","id":"e","x1":150.0,"y1":100.0,"x2":170.0,"y2":100.0,"tone":"muted","arrow":true,"width":1.6},{"t":"cell","id":"b","x":270.0,"y":100.0,"w":130.0,"h":24.0,"text":"LOWER → 'nova'","tone":"green","size":9.0,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["WITH t AS (SELECT TRIM(x) AS x FROM s)","SELECT LOWER(x) FROM t;"],"hl":[0,1],"lang":"sql","size":9.5,"lh":14.0,"w":340.0},{"t":"text","id":"n","x":180.0,"y":100.0,"text":"name every step","tone":"green","size":10.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":36.0,"text":"one line:\nunreadable","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":150.0,"h":36.0,"text":"step by step:\ncheck by eye","tone":"green","size":9.5,"sub_size":8.5}]],"cues":[12.3,24.5]}]},{"title":"Summary","sub":"Functions","short":"Summary","main":"Numbers, text, dates: functions run for each row.","body":[{"t":"scene","labels":["Numbers and text","Dates","Next"],"captions":["ABS, ROUND, %, PRINTF: numbers and formatting","DATE, TIME, STRFTIME, JULIANDAY: ISO dates; NULL for a bad string","Next topic: grouping with GROUP BY and HAVING"],"frames":[[{"t":"cell","id":"a","x":65.0,"y":60.0,"w":110.0,"h":30.0,"text":"ABS ROUND %","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":60.0,"w":110.0,"h":30.0,"text":"PRINTF","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":295.0,"y":60.0,"w":110.0,"h":30.0,"text":"CAST typeof","tone":"blue","size":9.5,"sub_size":8.5}],[{"t