est user, and machine.slice.","body":[{"t":"scene","labels":["Socket","polkit","Guest","cgroup"],"captions":["Without polkit the RW socket is root-only, the RO socket is open","With polkit the action org.libvirt.unix.manage; admins usually go to the libvirt group","The guest runs as qemu (Debian and Ubuntu: libvirt-qemu), image permissions matter","The guest scope is under machine.slice; limits: virsh schedinfo, memtune, blkiotune"],"frames":[[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"RW socket: root; RO: everyone","tone":"muted","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"RW socket: root; RO: everyone","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"polkit: org.libvirt.unix.manage","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"RW socket: root; RO: everyone","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"polkit: org.libvirt.unix.manage","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"guest runs as qemu / libvirt-qemu","tone":"yellow","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"RW socket: root; RO: everyone","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"polkit: org.libvirt.unix.manage","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"guest runs as qemu / libvirt-qemu","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":180.0,"y":122.0,"w":280.0,"h":24.0,"text":"machine.slice → machine-qemu…scope","tone":"green","size":9.0,"sub_size":8.5}]],"cues":[8.5,19.9,30.8]}]},{"title":"Domain XML: the head","sub":"Chapter 24 · Python as the control plane","short":