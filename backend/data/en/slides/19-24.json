ostart db01","$ virsh undefine web01   # running: transient"],"hl":[7],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ virsh list --all"," Id   Name    State","------------------------"," 1    web01   running"," -    db01    shut off","$ virsh domstate --reason db01","shut off (destroyed)","$ virsh start db01; virsh autostart db01","$ virsh undefine web01   # running: transient"],"hl":[8],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[9.9,21.6,32.2]}]},{"title":"Pools and volumes","sub":"Chapter 24 · Python as the control plane","short":"Pools","main":"Pool types and the two volume sizes: capacity and allocation.","body":[{"t":"scene","labels":["dir","logical","iscsi","Volume"],"captions":["A dir pool: volumes are files in a directory","A logical pool: an LVM volume group, volumes are logical volumes","iscsi, scsi, mpath: ready devices, no volumes created through libvirt","A volume: capacity is what the guest sees, allocation is what the host uses"],"frames":[[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"dir:\nfiles in a directory","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"dir:\nfiles in a directory","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"logical:\nan LVM group","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"dir:\nfiles in a directory","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"logical:\nan LVM group","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":95.0,"y":110.0,"w":158.0,"h":46.0,"text":"iscsi, scsi, mpath:\nready LUNs","tone":"yellow","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"dir:\nfiles in a directory","tone":"blue","size":9.0,"sub_size":8.5}