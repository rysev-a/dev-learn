,"size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"p","x":180.0,"y":100.0,"w":320.0,"h":28.0,"text":"SEARCH orders USING INDEX idx_orders_cust (cust=?)","tone":"green","size":8.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["EXPLAIN QUERY PLAN","SELECT cust FROM orders WHERE cust = 5;"],"hl":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"p","x":180.0,"y":100.0,"w":320.0,"h":28.0,"text":"SEARCH orders USING COVERING INDEX idx_orders_cust","tone":"green","size":8.5,"sub_size":8.5}]],"cues":[11.7,23.4]}]},{"title":"When an index works","sub":"Equality, range, order","short":"When it works","main":"An index helps with =, ranges, IN, sorting and MIN/MAX.","body":[{"t":"scene","labels":["Equality and IN","Ranges","Sorting and MIN/MAX"],"captions":["Conditions = and IN jump straight to the values","Greater, less and BETWEEN read consecutive leaves","Order is already in the index: ORDER BY needs no sort, MIN and MAX are the first and last leaf"],"frames":[[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["WHERE cust = 5","WHERE cust IN (3, 5, 9)"],"hl":[0,1],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"g","x":180.0,"y":110.0,"w":160.0,"h":26.0,"text":"index helps","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["WHERE total > 50000","WHERE created BETWEEN '2024-05-01' AND '2024-05-31'"],"hl":[0,1],"lang":"sql","size":9.0,"lh":14.0,"w":340.0},{"t":"cell","id":"g","x":180.0,"y":110.0,"w":160.0,"h":26.0,"text":"index helps","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["ORDER BY created","SELECT MAX(total) FROM orders"],"hl":[0,1],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"g","x":180.0,"y":110.0,"w":220.0,"h":26.0,"text":"order is already in the index","tone":"green","size":10.0,"sub_size":8.5}]],"cues":[11.6,23.2]}]},{"title":"Composite indexes","sub":"Column order","short":"Composite","main":"An index on (a, b) helps with a condition on a, or on a and b, but not on b alone.","body":[{"t":"scene","labels":["Value order","Leftmost prefix","Second column only"],"captions":["Index on (cust, created): by cust first, by created among equal ones","A condition on cust, or on cust and created, fully uses the index","A condition on created alone scans the index: the leftmost prefix rule"],"frames":[[{"t":"cell","id":"i-h0","x":135.0,"y":40.0,"w":48.0,"h":18.0,"text":"cust","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"i-h1","x":195.0,"y":40.0,"w":68.0,"h":18.0,"text":"created","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"i-r0c0","x":135.0,"y":60.0,"w":48.0,"h":18.0,"text":"1","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"i-r0c1","x":195.0,"y":60.0,"w":68.0,"h":18.0,"text":"05-01","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"i-r1c0","x":135.0,"y":80.0,"w":48.0,"h":18.0,"text":"1","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"i-r1c1","x":195.0,"y":80.0,"w":68.0,"h":18.0,"text":"05-07","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"i-r2c0","x":135.0,"y":100.0,"w":48.0,"h":18.0,"text":"2","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"i-r2c1","x":195.0,"y":100.0,"w":68.0,"h":18.0,"text":"05-02","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"i-r3c0","x":135.0,"y":120.0,"w":48.0,"h":18.0,"text":"2","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"i-r3c1","x":195.0,"y":120.0,"w":68.0,"h":18.0,"text":"05-09","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"i-r4c0","x":135.0,"y":140.0,"w":48.0,"h":18.0,"text":"3","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"i-r4c1","x":195.0,"y":140.0,"w":68.0,"h":18.0,"text":"05-03","tone":"blue","size":8.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["WHERE cust = 2 AND created > '05-05'"],"hl":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"i-h0","x":135.0,"y":50.0,"w"