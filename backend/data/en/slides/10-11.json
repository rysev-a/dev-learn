{"book":10,"chapter":11,"rubric":"LEARNING RUST / RUST AFTER PYTHON / CHAPTER 11","slides":[{"title":"Mapping table","sub":"Chapter 11 · str ↔ String","short":"Intro","main":"Every Python string operation has a Rust spelling.","body":[{"t":"scene","labels":["Mapping table","What we cover","Goal"],"captions":["Each familiar Python string operation and its Rust form","Indexes, methods, split and join, formatting, chars, Unicode, bytes","After this chapter any text script can be ported to Rust"],"frames":[[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"str","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"&str / String","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a0","x":36.0,"y":66.0,"w":52.0,"h":28.0,"text":"indexes","tone":"blue","size":8.0,"sub_size":8.5},{"t":"cell","id":"a1","x":94.0,"y":66.0,"w":52.0,"h":28.0,"text":"methods","tone":"blue","size":8.0,"sub_size":8.5},{"t":"cell","id":"a2","x":152.0,"y":66.0,"w":52.0,"h":28.0,"text":"split","tone":"blue","size":8.0,"sub_size":8.5},{"t":"cell","id":"a3","x":210.0,"y":66.0,"w":52.0,"h":28.0,"text":"format","tone":"blue","size":8.0,"sub_size":8.5},{"t":"cell","id":"a4","x":268.0,"y":66.0,"w":52.0,"h":28.0,"text":"Unicode","tone":"blue","size":8.0,"sub_size":8.5},{"t":"cell","id":"a5","x":326.0,"y":66.0,"w":52.0,"h":28.0,"text":"bytes","tone":"blue","size":8.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":230.0,"h":34.0,"text":"script.py  →  main.rs","tone":"green","size":12.0,"sub_size":8.5}]],"cues":[12.7,26.1]}]},{"title":"Two types","sub":"&str and String","short":"Types","main":"&str reads, String owns; accept &str, return String.","body":[{"t":"scene","labels":["&str reads","String owns","Conversions"],"captions":["&str is borrowed text: function parameters and slices","String is owned text: struct fields and return values","&s → &str; to_string(), String::from(…), into() → String"],"frames":[[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":220.0,"h":40.0,"text":"fn f(s: &str)","tone":"blue","size":12.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":220.0,"h":40.0,"text":"struct { name: String }","tone":"green","size":11.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"String → &str\n&s","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"&str → String\nto_string()","tone":"green","size":10.0,"sub_size":8.5}]],"cues":[11.4,23.1]}]},{"title":"Length and indexes","sub":"Bytes and chars","short":"Indexes","main":"len counts bytes, no s[0], slices on char boundaries.","body":[{"t":"scene","labels":["len","s[0] and s[-1]","Slices"],"captions":["Python: len(s) counts chars; Rust: len() counts bytes; chars: chars().count()","s[0] ✕; first: s.chars().next(), last: s.chars().last()","Slice &s[a..b] on char boundaries; mid-character panics"],"frames":[[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"len(\"привет\")\n= 6","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"\"привет\".len()\n= 12","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["s[0]            # Python","s.chars().next()   // Option<char>","s.chars().last()   // Option<char>"],"hl":[1,2],"lang":"rust","size":10.0,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["&s[0..4]   // \"пр\"","&s[0..3]   // panic"],"hl":[1],"bad":[1],"lang":"rust","size":12.0,"lh":26.0,"w":340.0}]],"cues":[13.7,26.1]}]},{"title":"Methods","sub":"trim, find, contains","short":"Methods","main":"strip → trim; find → Option.","body":[{"t":"scene","labels":["strip → trim","lower, startswith","find → Option"],"captions":["strip → trim; lstrip → trim_start; rstrip → trim_end","lower, upper → to_lowercase, to_uppercase; startswith, endswith → starts_with, ends_with; in → contains","Python find returns -1; Rust find returns Option<usize>: Some(pos) or None"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["s.strip()      →   s.trim()","s.lstrip()     →   s.trim_start()"],"lang":"rust","size":10.5,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["s.lower()       →   s.to_lowercase()","s.startswith(p) →   s.starts_with(p)","p in s          →   s.contains(p)"],"lang":"rust","size":9.5,"lh":22.0,"w":340.0}],[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"find → -1","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"find → None","tone":"green","size":10.0,"sub_size":8.5}]],"cues":[11.1,28.7]}]},{"title":"split and join","sub":"Parse and glue","short":"split, join","main":"split → iterator + collect; split_once; join on a slice.","body":[{"t":"scene","labels":["split","split_once, lines","join"],"captions":["split → split: an iterator, gathered by collect(); split() with no args → split_whitespace()","splitlines → lines; rsplit; split_once(\"=\") splits at the first match, returns Option","sep.join(list) → slice.join(sep)"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["s.split(\",\")    →   s.split(',').collect::<Vec<_>>()"],"lang":"rust","size":8.5,"lh":26.0,"w":340.0},{"t":"code","id":"d","x":20.0,"y":90.0,"lines":["s.split()      →   s.split_whitespace()"],"lang":"rust","size":9.0,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["\"k=v\".split_once('=')   // Some((\"k\", \"v\"))","text.lines()"],"hl":[0],"lang":"rust","size":9.5,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["\", \".join(words)   # Python","words.join(\", \")   // Rust"],"hl":[1],"lang":"rust","size":11.0,"lh":26.0,"w":340.0}]],"cues":[9.9,28.0]}]},{"title":"Formatting","sub":"f-strings and format!","short":"format!","main":"Same specifiers; checked at build time.","body":[{"t":"scene","labels":["f-string → format!","Specifiers","Build-time check"],"captions":["f\"{x}\" → format!(\"{x}\"); format and print work the same way","{:>8}, {:<8}, {:^8}, {:.2}, {:08.3}, {:?} — nearly the same as in Python","Python checks f-strings at run time, Rust at compile time: a name typo won't build"],"frames":[[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"f\"{x}\"","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"format!(\"{x}\")","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["{:>8}   {:<8}   {:^8}","{:.2}   {:08.3}   {:?}"],"lang":"rust","size":12.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["format!(\"{nme}\")   // ✕ cannot find","// value `nme` in this scope"],"hl":[0],"bad":[0],"lang":"rust","size":11.0,"lh":26.0,"w":340.0}]],"cues":[14.4,25.8]}]},{"title":"Building strings","sub":"push_str and with_capacity","short":"Building","main":"String grows amortized; with_capacity; retain.","body":[{"t":"scene","labels":["join in Python","push_str","with_capacity"],"captions":["Python: s += x in a loop is costly; collect a list and join","Rust: String grows in amortized O(1): push_str in a loop is fast","String::with_capacity(n) allocates once; retain, clear, insert_str edit in place"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["parts = []","for x in data: parts.append(x)","s = \"\".join(parts)"],"hl":[2],"lang":"rust","size":10.5,"lh":22.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let mut s = String::new();","for x in &data { s.push_str(x); }"],"hl":[1],"lang":"rust","size":10.5,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let mut s = String::with_capacity(100);","s.retain(|c| c != ' ');"],"hl":[0,1],"lang":"rust","size":10.5,"lh":26.0,"w":340.0}]],"cues":[11.4,27.6]}]},{"title":"Comparison and sorting","sub":"By UTF-8 bytes","short":"Sorting","main":"Uppercase before lowercase; sort_