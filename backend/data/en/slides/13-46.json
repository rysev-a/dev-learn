    try:","        yield conn","    finally:","        await conn.close()"],"hl":[2,4,6],"lang":"python","size":10.0,"lh":19.0,"w":330.0}],[{"t":"code","id":"c","x":24.0,"y":50.0,"lines":["async with AsyncExitStack() as stack:","    for url in urls:","        c = await stack.enter_async_context(","            connection(url))","# closing is in reverse order"],"hl":[2,3],"lang":"python","size":10.0,"lh":22.0,"w":330.0}]],"cues":[19.1,29.9]}]},{"title":"Generator cleanup","sub":"aclose and aclosing","short":"aclosing","main":"break does not close the generator: do it yourself.","body":[{"t":"scene","labels":["Leaving the loop","aclose","aclosing"],"captions":["break from async for leaves the generator suspended: its finally does not run at once","aclose() throws GeneratorExit at the yield: cleanup happens at once","contextlib.aclosing wraps this in a block: aclose() is called on exit; asyncio.run closes leftovers at shutdown, but don't count on it"],"frames":[[{"t":"code","id":"c","x":24.0,"y":50.0,"lines":["async for x in numbers():","    if x == 2:","        break","# finally inside numbers() has not run yet!"],"hl":[2],"bad":[3],"lang":"python","size":10.5,"lh":24.0,"w":330.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["gen = numbers()","async for x in gen: ...","await gen.aclose()   # cleanup now"],"hl":[2],"lang":"python","size":11.0,"lh":26.0,"w":320.0}],[{"t":"code","id":"c","x":24.0,"y":50.0,"lines":["from contextlib import aclosing","async with aclosing(numbers()) as gen:","    async for x in gen:","        if x == 2:","            break"],"hl":[1],"lang":"python","size":10.5,"lh":24.0,"w":330.0}]],"cues":[13.1,27.1]}]},{"title":"asend and athrow","sub":"Two-way","short":"asend","main":"Same mechanics as plain generators.","body":[{"t":"scene","labels":["asend","athrow","Usually queues"],"captions":["asend(value) sends a value into yield, like send, but must be awaited: await gen.asend(1)","athrow(exc) throws an exception at the yield; aclose() throws 