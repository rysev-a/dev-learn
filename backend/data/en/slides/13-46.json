uted","arrow":true,"width":1.6}]],"cues":[12.1,27.1]}]},{"title":"Async comprehensions","sub":"async for in brackets","short":"Comprehensions","main":"Handy in tests, but all in memory.","body":[{"t":"scene","labels":["async for in a list","With a condition","Cost"],"captions":["[x async for x in source()] builds a list from an async source","A condition and await inside the expression are allowed; only inside an async function","The result is a whole list in memory: laziness is lost; handy in tests"],"frames":[[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["async def main():","    xs = [x async for x in source()]","    return xs"],"hl":[1],"lang":"python","size":11.5,"lh":28.0,"w":320.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["evens = [x async for x in source()","         if x % 2 == 0]","names = [await get(i) for i in ids]"],"hl":[0,1,2],"lang":"python","size":10.5,"lh":28.0,"w":330.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"lazy","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":110.0,"h":30.0,"text":"whole list","tone":"red","size":11.5,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":70.0,"x2":214.0,"y2":70.0,"tone":"red","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":118.0,"text":"all in memory","size":10.0}]],"cues":[14.0,22.0]}]},{"title":"async with","sub":"__aenter__ and __aexit__","short":"async with","main":"Opening and closing may wait.","body":[{"t":"scene","labels":["__aenter__ and __aexit__","Who works this way","Suppression"],"captions":["async with calls the coroutines __aenter__ and __aexit__: both opening and closing may wait","asyncio locks and semaphores, TaskGroup, timeout, network connections, database transactions","Same suppression rules: a true value from __aexit__ swallows the error"],"frames":[[{"t":"code","id":"c","x":24.0,"y":44.0,"lines":["class Conn:","    async def __aenter__(self):","        await self.connect()","        return self"," 