s the same.","body":[{"t":"scene","labels":["translate","rotate","scale","origin"],"captions":["Translate moves the element along the axes, without touching neighbors or changing the layout","Rotate turns the element by a given angle around the reference point","Scale stretches or shrinks the element: it is drawn bigger, while the space it takes stays the same","The reference point decides where the element grows from and what it rotates around: the center by default, but it can be a corner"],"frames":[[{"t":"cell","id":"g","x":100.0,"y":85.0,"w":60.0,"h":44.0,"text":"","tone":"muted","size":9.0,"sub_size":8.5,"dash":true},{"t":"cell","id":"box","x":260.0,"y":85.0,"w":60.0,"h":44.0,"text":"box","tone":"blue","size":10.0,"sub_size":8.5},{"t":"line","id":"e","x1":134.0,"y1":85.0,"x2":226.0,"y2":85.0,"tone":"blue","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":140.0,"text":"translateX(160px)","tone":"blue","size":10.0}],[{"t":"cell","id":"g","x":100.0,"y":85.0,"w":60.0,"h":44.0,"text":"","tone":"muted","size":9.0,"sub_size":8.5,"dash":true},{"t":"path","id":"rot","d":"M 251.95 54.95 L 290.05 76.95 L 268.05 115.05 L 229.95 93.05 Z","tone":"green","width":2.0},{"t":"text","id":"n","x":180.0,"y":140.0,"text":"rotate(30deg)","tone":"green","size":10.0}],[{"t":"cell","id":"g","x":100.0,"y":85.0,"w":60.0,"h":44.0,"text":"","tone":"muted","size":9.0,"sub_size":8.5,"dash":true},{"t":"cell","id":"box","x":260.0,"y":85.0,"w":60.0,"h":44.0,"text":"box","tone":"violet","size":10.0,"sub_size":8.5,"s":1.5},{"t":"text","id":"n","x":180.0,"y":140.0,"text":"scale(1.5): drawn bigger, space unchanged","tone":"violet","size":10.0}],[{"t":"zone","id":"a","x":95.0,"y":85.0,"w":60.0,"h":44.0,"tone":"outline","dash":true},{"t":"zone","id":"a2","x":95.0,"y":85.0,"w":90.0,"h":66.0,"tone":"green"},{"t":"dot","id":"da","x":95.0,"y":85.0,"r":4.0,"text":"","tone":"green","size":10.5},{"t":"zone","id":"c","x":270.0,"y":80.0,"w":60.0,"h":44.0,"tone":"outline","dash":true},{"t":"zone","i