bles","short":"Pitfalls","main":"hosts beats DNS, bad delegation takes the zone down, one NS is one failure, queries are open.","body":[{"t":"scene","labels":["hosts","Delegation","One NS","Open"],"captions":["A hosts entry beats any DNS answer: \"won't update\" for just one person","If the delegation lists a nonexistent server, the zone is down for everyone","You need at least two name servers","Queries travel as plain text: they can be eavesdropped on and forged"],"frames":[[{"t":"cell","id":"h","x":180.0,"y":30.0,"w":280.0,"h":26.0,"text":"hosts on one PC beats DNS","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"d","x":180.0,"y":65.0,"w":280.0,"h":26.0,"text":"delegation to a nonexistent server","tone":"muted","size":9.0,"sub_size":8.5,"o":0.2},{"t":"cell","id":"s","x":180.0,"y":100.0,"w":280.0,"h":26.0,"text":"one NS: one failure kills the domain","tone":"muted","size":9.0,"sub_size":8.5,"o":0.2},{"t":"cell","id":"u","x":180.0,"y":135.0,"w":280.0,"h":26.0,"text":"DNS over UDP: plain text","tone":"muted","size":9.0,"sub_size":8.5,"o":0.2}],[{"t":"cell","id":"h","x":180.0,"y":30.0,"w":280.0,"h":26.0,"text":"hosts on one PC beats DNS","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"d","x":180.0,"y":65.0,"w":280.0,"h":26.0,"text":"delegation to a nonexistent server","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"s","x":180.0,"y":100.0,"w":280.0,"h":26.0,"text":"one NS: one failure kills the domain","tone":"muted","size":9.0,"sub_size":8.5,"o":0.2},{"t":"cell","id":"u","x":180.0,"y":135.0,"w":280.0,"h":26.0,"text":"DNS over UDP: plain text","tone":"muted","size":9.0,"sub_size":8.5,"o":0.2}],[{"t":"cell","id":"h","x":180.0,"y":30.0,"w":280.0,"h":26.0,"text":"hosts on one PC beats DNS","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"d","x":180.0,"y":65.0,"w":280.0,"h":26.0,"text":"delegation to a nonexistent server","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"s","x":180.0,"y":100.0,"w":280.0,"h":26.0,"tex