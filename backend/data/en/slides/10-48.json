ime","HttpOnly, Secure, SameSite; for state-changing requests — CSRF protection","Passwords, tokens and the Authorization header never go to the log"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":26.0,"text":"HTTPS everywhere","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":110.0,"w":130.0,"h":26.0,"text":"ct_eq, not ==","tone":"green","size":10.5,"sub_size":8.5},{"t":"text","id":"n","x":270.0,"y":85.0,"text":"protects against\ntiming attacks","tone":"muted","size":9.0}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["Set-Cookie: session=…; HttpOnly; Secure;","    SameSite=Strict; Max-Age=86400"],"hl":[0,1],"lang":"rust","size":9.0,"lh":30.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["INFO login ok user=anya","INFO header authorization=<hidden>","// never: password=..., token=..."],"hl":[0,1],"lang":"rust","size":9.0,"lh":28.0,"w":340.0}]],"cues":[12.8,25.5]}]},{"title":"JWT or sessions","sub":"Two approaches","short":"JWT","main":"Signed tokens need no DB but cannot be revoked; server sessions can be revoked but need storage.","body":[{"t":"scene","labels":["Signed token","Cost","Our choice"],"captions":["Claims (who and until when) signed with a key; verified without the DB","Cannot be revoked before expiry; role changes apply late","Server sessions: simpler, safer, cut off access instantly"],"frames":[[{"t":"cell","id":"a","x":70.0,"y":70.0,"w":110.0,"h":30.0,"text":"header.payload","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":190.0,"y":70.0,"w":60.0,"h":30.0,"text":".sig","tone":"green","size":11.0,"sub_size":8.5},{"t":"text","id":"n","x":300.0,"y":70.0,"text":"HMAC(key)","tone":"muted","size":9.0}],[{"t":"cell","id":"a","x":90.0,"y":50.0,"w":140.0,"h":26.0,"text":"issued — valid until exp","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":105.0,"w":140.0,"h":26.0,"text":"cannot revoke","tone":"red","size":10.0,"sub_size":8.5},{"t":"text","id":"n"