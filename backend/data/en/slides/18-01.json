M daily active users","Times 20 actions: 200M requests a day","A day has about 86 thousand seconds: ≈ 2,300 requests per second","Peak is 3x the average: size for ≈ 7,000"],"frames":[[{"t":"text","id":"a","x":180.0,"y":70.0,"text":"10 000 000","tone":"blue","size":20.0,"bold":true},{"t":"text","id":"b","x":180.0,"y":100.0,"text":"users per day","size":10.0}],[{"t":"text","id":"a","x":180.0,"y":40.0,"text":"10 000 000","tone":"blue","size":13.0},{"t":"text","id":"m","x":180.0,"y":70.0,"text":"× 20 actions","size":12.0},{"t":"text","id":"b","x":180.0,"y":105.0,"text":"= 200,000,000 per day","tone":"green","size":15.0,"bold":true}],[{"t":"text","id":"a","x":180.0,"y":40.0,"text":"200,000,000 per day","tone":"green","size":12.0},{"t":"text","id":"m","x":180.0,"y":70.0,"text":"÷ 86,400 seconds","size":12.0},{"t":"text","id":"b","x":180.0,"y":105.0,"text":"≈ 2,300 requests/s","tone":"yellow","size":17.0,"bold":true}],[{"t":"bar","id":"avg","x":120.0,"y":130.0,"w":40.0,"hh":25.0,"max":100.0,"tone":"green","text":"average"},{"t":"bar","id":"peak","x":240.0,"y":130.0,"w":40.0,"hh":75.0,"max":100.0,"tone":"red","text":"peak ×3"},{"t":"text","id":"t","x":180.0,"y":150.0,"text":"size for the peak","tone":"red","size":10.0}]],"cues":[9.8,19.6,29.5]}]},{"title":"Reads and writes","sub":"Load ratio","short":"Read/write","main":"There are tens of times more reads than writes: this decides where you need a cache and replicas.","body":[{"t":"scene","labels":["Ratio","Cache","Write","Inverse"],"captions":["In most services reads outnumber writes by an order of magnitude","A read is easy to speed up with a cache and replicas","A write goes to one place and is harder to scale","Metrics and logs are the opposite: almost all writes"],"frames":[[{"t":"bar","id":"r","x":110.0,"y":130.0,"w":50.0,"hh":90.0,"max":100.0,"tone":"blue","text":"read"},{"t":"bar","id":"w","x":230.0,"y":130.0,"w":50.0,"hh":9.0,"max":100.0,"tone":"yellow","text":"write"},{"t":"text","id":"t","x":180.0,"y":150.0,"text":"95% reads · 5% writes","size":10.0}],[{"t":"bar","id":"r","x":110.0,"y":130.0,"w":50.0,"hh":90.0,"max":100.0,"tone":"blue","text":"read"},{"t":"bar","id":"w","x":230.0,"y":130.0,"w":50.0,"hh":9.0,"max":100.0,"tone":"yellow","text":"write"},{"t":"cell","id":"c","x":110.0,"y":40.0,"w":80.0,"h":26.0,"text":"cache + replicas","tone":"green","size":8.5,"sub_size":8.5},{"t":"line","id":"ar","x1":110.0,"y1":52.0,"x2":110.0,"y2":62.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"bar","id":"r","x":110.0,"y":130.0,"w":50.0,"hh":90.0,"max":100.0,"tone":"muted","text":"read"},{"t":"bar","id":"w","x":230.0,"y":130.0,"w":50.0,"hh":9.0,"max":100.0,"tone":"red","text":"write"},{"t":"cell","id":"d","x":230.0,"y":40.0,"w":70.0,"h":26.0,"text":"one database","tone":"red","size":8.5,"sub_size":8.5}],[{"t":"bar","id":"r","x":110.0,"y":130.0,"w":50.0,"hh":8.0,"max":100.0,"tone":"muted","text":"read"},{"t":"bar","id":"w","x":230.0,"y":130.0,"w":50.0,"hh":90.0,"max":100.0,"tone":"yellow","text":"write"},{"t":"text","id":"t","x":180.0,"y":150.0,"text":"metrics, logs: 5% reads","tone":"yellow","size":10.0}]],"cues":[9.4,18.8,28.2]}]},{"title":"Storage and volume","sub":"How much data","short":"Volume","main":"Data volume is records per day times record size times retention.","body":[{"t":"scene","labels":["Records","Size","Per year","With copies"],"captions":["100M new records a day","1 KB each: 100 GB a day","Over a year: about 36 TB","At least three copies: over 100 TB"],"frames":[[{"t":"text","id":"a","x":180.0,"y":75.0,"text":"100 000 000","tone":"blue","size":20.0,"bold":true},{"t":"text","id":"b","x":180.0,"y":105.0,"text":"records per day","size":10.0}],[{"t":"text","id":"a","x":180.0,"y":45.0,"text":"100M × 1 KB","tone":"blue","size":14.0},{"t":"text","id":"b","x":180.0,"y":95.0,"text":"= 100 GB a day","tone":"green","size":17.0,"bold":true}],[{"t":"text","id":"a","x":180.0,"y":45.0,"text":"100 GB × 365","tone":"green","size":14.0},{"t":"text","id":"b","x":180.0,"y":95.0,"text"