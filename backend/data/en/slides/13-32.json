ement","A code object can be stored and run many times; it holds constants, names and instruction bytes","That is how import works: read the file, compile it, run it in the module namespace"],"frames":[[{"t":"code","id":"c","x":24.0,"y":50.0,"lines":["compile('1 + 2', '<expr>', 'eval')","compile(source, 'app.py', 'exec')","compile('x = 1', '<console>', 'single')"],"lang":"python","size":10.5,"lh":26.0,"w":330.0}],[{"t":"code","id":"c","x":30.0,"y":50.0,"lines":["code = compile('x * 2', '<s>', 'eval')","eval(code, {'x': 5})   # 10","eval(code, {'x': 7})   # 14"],"hl":[1,2],"lang":"python","size":10.5,"lh":26.0,"w":320.0}],[{"t":"cell","id":"a","x":56.0,"y":70.0,"w":74.0,"h":30.0,"text":"file.py","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":150.0,"y":70.0,"w":74.0,"h":30.0,"text":"compile","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"cell","id":"c~cell","x":244.0,"y":70.0,"w":74.0,"h":30.0,"text":"code","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"d","x":328.0,"y":70.0,"w":60.0,"h":30.0,"text":"exec","tone":"muted","size":11.0,"sub_size":8.5},{"t":"line","id":"e1","x1":96.0,"y1":70.0,"x2":110.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":190.0,"y1":70.0,"x2":204.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e3","x1":284.0,"y1":70.0,"x2":298.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[11.7,23.6]}]},{"title":"ast.parse","sub":"Parse tree","short":"parse","main":"ast.dump shows the structure of any expression.","body":[{"t":"scene","labels":["String","Tree","Node fields"],"captions":["ast.parse('1 + 2 * 3') parses the expression respecting operator precedence","The root is BinOp(+): Constant(1) on the left, a nested BinOp(*) on the right","Each node has child fields, a lineno and a col_offset; ast.dump(tree, indent=2) prints the structure"],"frames":[[{"t":"code","id":"c","x":50.0,"y":60.0,"lines":["tree = ast.parse('1 + 2 * 3')","print(ast.dump(tree, 