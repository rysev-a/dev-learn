,"lines":["class Calls(ast.NodeVisitor):","    def __init__(self):","        self.names = set()","    def visit_Call(self, node):","        if isinstance(node.func, ast.Name):","            self.names.add(node.func.id)","        self.generic_visit(node)"],"hl":[3,6],"lang":"python","size":9.5,"lh":18.0,"w":340.0}],[{"t":"cell","id":"a","x":70.0,"y":70.0,"w":100.0,"h":30.0,"text":".py file","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":190.0,"y":70.0,"w":90.0,"h":30.0,"text":"tree","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"c~cell","x":310.0,"y":70.0,"w":100.0,"h":30.0,"text":"warnings","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"line","id":"e1","x1":122.0,"y1":70.0,"x2":144.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":236.0,"y1":70.0,"x2":256.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6}]],"cues":[12.9,25.3]}]},{"title":"Transformation","sub":"NodeTransformer","short":"Transformation","main":"A method returns a new node; unparse gives text back.","body":[{"t":"scene","labels":["NodeTransformer","Before and after","unparse"],"captions":["NodeTransformer is like a visitor, but a method returns a new node to replace the old one","Example: replace BinOp(2 * 3) with Constant(6), computing in advance","fix_missing_locations gives new nodes line numbers; ast.unparse (3.9+) returns text, the basis of auto-refactoring"],"frames":[[{"t":"code","id":"c","x":24.0,"y":50.0,"lines":["class Fold(ast.NodeTransformer):","    def visit_BinOp(self, node):","        self.generic_visit(node)","        ...                 # new node","        return ast.Constant(6)"],"hl":[1,4],"lang":"python","size":10.0,"lh":22.0,"w":330.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":120.0,"h":34.0,"text":"a = 2 * 3 + b","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":120.0,"h":34.0,"text":"a = 6 + b","tone":"green","size":11.0,"sub_size":8.5},{"t":"line","id":"e","x1":154.0,"y1":70.0,"x2":206.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["tree = Fold().visit(tree)","ast.fix_missing_locations(tree)","print(ast.unparse(tree))   # a = 6 + b"],"hl":[1,2],"lang":"python","size":10.5,"lh":26.0,"w":320.0}]],"cues":[12.4,28.8]}]},{"title":"Safe calculator","sub":"Node whitelist","short":"Calculator","main":"Relying on grammar beats string filters.","body":[{"t":"scene","labels":["Whitelist","Recursive evaluation","Anything else is an error"],"captions":["Instead of eval, parse into a tree and allow only known nodes: numbers, unary and binary operations","Evaluate recursively by node: the user cannot run foreign code","Call, attribute access, name: any unknown node gives ValueError; grammar beats string filters"],"frames":[[{"t":"cell","id":"a0","x":70.0,"y":56.0,"w":96.0,"h":26.0,"text":"Constant","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"a1","x":180.0,"y":56.0,"w":96.0,"h":26.0,"text":"UnaryOp","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"a2","x":290.0,"y":56.0,"w":96.0,"h":26.0,"text":"BinOp","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"b0","x":70.0,"y":106.0,"w":96.0,"h":26.0,"text":"Call","tone":"red","size":11.0,"sub_size":8.5},{"t":"cell","id":"b1","x":180.0,"y":106.0,"w":96.0,"h":26.0,"text":"Attribute","tone":"red","size":11.0,"sub_size":8.5},{"t":"cell","id":"b2","x":290.0,"y":106.0,"w":96.0,"h":26.0,"text":"Name","tone":"red","size":11.0,"sub_size":8.5}],[{"t":"code","id":"c","x":24.0,"y":44.0,"lines":["def ev(node):","    if isinstance(node, ast.Constant):","        return node.value","    if isinstance(node, ast.BinOp):","        return OPS[type(node.op)](ev(node.left),","                                 ev(node.right))"],"hl":[3,4,5],"lang":"python","size":9.5,"lh":20.0,"w":340.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["calc('2 + 3 * 4')            # 14","calc('__import__(\"os\")')   # ValueError"],"hl":[0],"bad":[1],"lang":"python","size":10.5,"lh":30.0,"w":320.0}]],"cues":[12.4,26.5]}]},{"title":"Code object and function","sub":"__code__","short":"__code__","main":"A function is a wrapper around a code object.","body":[{"t":"scene","labels":["Function is a wrapper","__code__","replace"],"captions":["A function wraps a code object: defaults, closure, name and docstring","The code object f.__code__ runs; it holds co_varnames, co_consts, co_names and the bytes co_code","A code object is immutable, but code.replace(...) makes a copy with changed fields"],"frames":[[{"t":"cell","id":"f","x":180.0,"y":70.0,"w":230.0,"h":100.0,"text":"function","tone":"blue","size":9.0,"sub_size":8.5,"dash":true},{"t":"cell","id":"a","x":120.0,"y":54.0,"w":100.0,"h":24.0,"text":"__defaults__","tone":"muted","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":240.0,"y":54.0,"w":100.0,"h":24.0,"text":"__closure__","tone":"muted","size":9.5,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":94.0,"w":120.0,"h":28.0,"text":"__code__","tone":"green","size":11.0,"sub_size":8.5}],[{"t":"code","id":"c~code","x":30.0,"y":50.0,"lines":["code = f.__code__","code.co_varnames   # ('a', 'b')","code.co_consts     # (None, 2)","code.co_code       # b'\\x95…'"],"hl":[1,2,3],"lang":"python","size":10.5,"lh":24.0,"w":310.0}],[{"t":"code","id":"c~code","x":30.0,"y":56.0,"lines":["new = code.replace(co_name='g')","g = types.FunctionType(new, globals())"],"hl":[0,1],"lang":"python","size":11.0,"lh":28.0,"w":320.0}]],"cues":[9.0,21.5]}]},{"title":"The dis module","sub":"Stack machine","short":"dis","main":"The instruction set changes between versions.","body":[{"t":"scene","labels":["dis.dis","Stack machine","Versions differ"],"captions":["dis.dis(f) prints instructions: source line, offset, operation name, argument","Python runs on a stack machine: loads push values onto the stack, operations pop them","Instructions change between versions: dis is for understanding, not for naming them in code"],"frames":[[{"t":"code","id":"c","x":24.0,"y":44.0,"lines":["def add(a, b):","    return a + b","","  LOAD_FAST   a","  LOAD_FAST   b","  BINARY_OP   +","  RETURN_VALUE"],"hl":[3,4,5,6],"lang":"python","size":10.0,"lh":18.0,"w":330.0}],[{"t":"cell","id":"s0","x":70.0,"y":120.0,"w":56.0,"h":22.0,"text":"","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"s1","x":70.0,"y":94.0,"w":56.0,"h":22.0,"text":"a","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"s2","x":70.0,"y":68.0,"w":56.0,"h":22.0,"text":"b","tone":"green","size":10.5,"sub_size":8.5},{"t":"text","id":"t","x":70.0,"y":148.0,"text":"stack","size":9.5},{"t":"cell","id":"op","x":230.0,"y":94.0,"w":150.0,"h":26.0,"text":"BINARY_OP: 2 → a+b","tone":"yellow","size":8.0,"sub_size":8.5},{"t":"line","id":"e","x1":100.0,"y1":80.0,"x2":156.0,"y2":90.0,"tone":"yellow","arrow":true,"width":1.6}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":28.0,"text":"3.11 · 3.12 · 3.13","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":120.0,"h":28.0,"text":"different commands","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":116.0,"text":"don't rely on names","tone":"yellow","size":10.5}]],"cues":[12.3,28.0]}]},{"title":"What bytecode shows","sub":"Optimizations","short":"Optimizations","main":"Bytecode explains performance.","body":[{"t":"scene","labels":["Constants","for loop","Closures"],"captions":["The compiler folds constants: 2 * 3 becomes 6 before the run","for gets an iterator, then a loop instruction jumps back until it is exhausted","Captured variables load from cells; comprehensions are inlined into the function (3.12+)"],"frames":[[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["def f():","    return 2 * 3","# dis: LOAD_CONST 6"],"hl":[2],"lang":"python","size":11.0,"lh":28.0,"w":300.0}],[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["GET_ITER","FOR_ITER   → end","STORE_FAST x","…body…","JUMP_BACKWARD ↑"],"hl":[1,4],"lang":"python","size":11.0,"lh":