uted","size":9.0}]],"cues":[13.0,26.0]}]},{"title":"Enums","sub":"enum in JSON","short":"enum","main":"Enums in JSON: external tag, internal tag, untagged; the choice affects the format.","body":[{"t":"scene","labels":["By default","tag = \"type\"","Chat event"],"captions":["A variant is an object with a single key: the variant name","Internal tag: a type field with the other fields beside it","The client looks at type and picks a handler"],"frames":[[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["enum Event { Join(String), Leave(String) }","// {\"Join\": \"anya\"}"],"hl":[1],"lang":"rust","size":9.5,"lh":30.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["#[serde(tag = \"type\", rename_all = \"snake_case\")]","enum Event {","    Message { room: u32, text: String },","    Join { user: String },","}"],"hl":[0],"lang":"rust","size":9.0,"lh":18.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["{\"type\": \"message\", \"room\": 3, \"text\": \"hello\"}","{\"type\": \"join\", \"user\": \"anya\"}","{\"type\": \"leave\", \"user\": \"anya\"}"],"hl":[0,1,2],"lang":"rust","size":8.5,"lh":28.0,"w":340.0}]],"cues":[12.4,24.8]}]},{"title":"Validation","sub":"Parse, don't validate","short":"Validation","main":"Better to turn data into a type that cannot be invalid: newtypes and TryFrom.","body":[{"t":"scene","labels":["Checks everywhere","Guarantee type","TryFrom + serde"],"captions":["A name as a string: length must be checked at every use","A newtype is built only from a valid string; an invalid value cannot exist","try_from in a serde attribute rejects a bad name while parsing the body"],"frames":[[{"t":"cell","id":"a","x":70.0,"y":40.0,"w":100.0,"h":24.0,"text":"String","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":70.0,"y":80.0,"w":100.0,"h":24.0,"text":"if len < 3 ..","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":70.0,"y":120.0,"w":100.0,"h":24.0,"text":"if len > 16 ..","tone":"red","size":10.0,"sub_si