 = 5","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"c~cell","x":320.0,"y":100.0,"w":70.0,"h":24.0,"text":"count = 5","tone":"green","size":8.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":140.0,"text":"any(|x| x > 4)  →  true","size":9.0,"mono":true}],[{"t":"code","id":"c","x":14.0,"y":36.0,"lines":["let total = v.iter().fold(0, |acc, x| acc + x);","// 0 → 3 → 4 → 8 → 9 → 14"],"hl":[0],"lang":"rust","size":9.0,"lh":20.0,"w":350.0},{"t":"cell","id":"a0","x":56.0,"y":108.0,"w":30.0,"h":24.0,"text":"0","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"a1","x":90.0,"y":108.0,"w":30.0,"h":24.0,"text":"3","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"a2","x":124.0,"y":108.0,"w":30.0,"h":24.0,"text":"4","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"a3","x":158.0,"y":108.0,"w":30.0,"h":24.0,"text":"8","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"a4","x":192.0,"y":108.0,"w":30.0,"h":24.0,"text":"9","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"a5","x":226.0,"y":108.0,"w":30.0,"h":24.0,"text":"14","tone":"yellow","size":10.0,"sub_size":8.5}]],"cues":[12.9,20.9]}]},{"title":"References in closures","sub":"&&i32, patterns, copied","short":"Types","main":"Patterns |&x| and |(i, x)| take an element apart; copied() gives values.","body":[{"t":"scene","labels":["&&i32","Pattern matching","copied and cloned"],"captions":["iter() yields references, and filter adds one more on top: the closure gets &&i32","|&x| and |(i, x)| take the value apart in the header: an i32 and a pair, no extra stars","copied() and cloned() turn an iterator of references into values; into_iter() takes elements with the vector"],"frames":[[{"t":"code","id":"c","x":14.0,"y":40.0,"lines":["v.iter().filter(|x| **x > 2)","//        x: &&i32  →  **x: i32"],"hl":[0],"lang":"rust","size":10.0,"lh":20.0,"w":340.0}],[{"t":"code","id":"c","x":14.0,"y":36.0,"lines":["v.iter().filter(|&&x| x > 2)","v.iter().enumerate().map(|(i, x)| i as i32 * x)","pairs.iter().map(|&(a, b)| a + b)"],"lang":"rust","size":9.0,"lh":20.0,"w":350.0}],[{"t":"code","id":"c","x":14.0,"y":40.0,"lines":["let w: Vec<i32> = v.iter().copied().collect();","let u: Vec<String> = names.iter().cloned().collect();","for x in v { ... }   // v is moved"],"hl":[2],"lang":"rust","size":8.5,"lh":20.0,"w":350.0}]],"cues":[11.4,25.3]}]},{"title":"Speed","sub":"One loop and SIMD","short":"Speed","main":"No intermediate lists; the sum often becomes SIMD instructions.","body":[{"t":"scene","labels":["One loop","No intermediate lists","Vector instructions"],"captions":["Each adapter is its own struct, the closure call is known at build time: all inlined into one loop","In Python [x*x for ...] builds a list and then sum reads it; here values pass through registers and never land in memory","Sequential slice reads suit the cache, and the sum often becomes SIMD: several elements per instruction"],"frames":[[{"t":"code","id":"c","x":10.0,"y":36.0,"lines":["let mut s = 0;","for &x in v {","    if x % 2 == 0 { s += x * x; }","}"],"lang":"rust","size":9.5,"lh":17.0,"w":190.0},{"t":"text","id":"a","x":215.0,"y":70.0,"text":"≡","size":20.0},{"t":"code","id":"c2","x":232.0,"y":50.0,"lines":["v.iter()",".filter(even)",".map(sq)",".sum()"],"lang":"rust","size":9.5,"lh":16.0,"w":120.0}],[{"t":"cell","id":"a~cell","x":70.0,"y":40.0,"w":100.0,"h":24.0,"text":"Python: a list","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"a2","x":70.0,"y":74.0,"w":100.0,"h":24.0,"text":"[x*x …] in memory","tone":"red","size":8.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":40.0,"w":100.0,"h":24.0,"text":"Rust: a stream","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"b2","x":270.0,"y":74.0,"w":100.0,"h":24.0,"text":"values in registers","tone":"green","size":8.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":126.0,"text":"no memory spent","size":9.5}],[{"t":"cell","id":"a0","x":56.0,"y":50.0,"w":24.0,"h":24.0,"text":"1","tone":"blue"