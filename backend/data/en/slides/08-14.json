probe()","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"ml","x":296.0,"y":152.0,"w":124.0,"h":22.0,"text":"no driver → modprobe","tone":"yellow","size":8.0,"sub_size":8.5}]],"cues":[10.5,17.1,27.9]}]},{"title":"Modules","sub":"lsmod, modprobe, signatures","short":"Modules","main":"modprobe handles dependencies, rmmod handles users, signatures protect.","body":[{"t":"scene","labels":["lsmod","modprobe","rmmod","Signature"],"captions":["lsmod shows loaded modules and their use count","modprobe handles dependencies: what a module needs is loaded first","A busy module cannot be unloaded","The kernel checks the signature; 7.0 brought post-quantum signatures"],"frames":[[{"t":"code","id":"l","x":20.0,"y":30.0,"lines":["Module        Size  Used by","nvme         57344  3","nvme_core    204800  4 nvme","ext4        1081344  2"],"hl":[1],"lang":"plain","size":9.5,"lh":20.0,"w":320.0},{"t":"text","id":"t","x":180.0,"y":130.0,"text":"lsmod: what is loaded and who uses it","tone":"green","size":9.0}],[{"t":"cell","id":"a","x":70.0,"y":66.0,"w":90.0,"h":26.0,"text":"module B","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":230.0,"y":66.0,"w":90.0,"h":26.0,"text":"module A","tone":"green","size":9.0,"sub_size":8.5},{"t":"line","id":"d","x1":118.0,"y1":66.0,"x2":182.0,"y2":66.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"t","x":180.0,"y":120.0,"text":"modprobe A: first B is loaded, since A depends on it","tone":"green","size":8.5},{"t":"text","id":"o","x":70.0,"y":90.0,"text":"1","size":9.0,"mono":true},{"t":"text","id":"o2","x":230.0,"y":90.0,"text":"2","size":9.0,"mono":true}],[{"t":"cell","id":"m","x":100.0,"y":66.0,"w":110.0,"h":28.0,"text":"ext4  Used by 2","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"rm","x":270.0,"y":66.0,"w":110.0,"h":28.0,"text":"rmmod ext4","tone":"red","size":9.0,"sub_size":8.5},{"t":"line","id":"a~line","x1":214.0,"y1":66.0,"x2":214.0,"y2":66.0,"tone":"red","arrow":true,"width":1.6,"o":0.0},{"t":"text","id":"t","x":180.0,"y":120.0,"text":"\"Module is in use\": unloading is forbidden while there are users","tone":"red","size":8.5}],[{"t":"cell","id":"ko","x":70.0,"y":66.0,"w":90.0,"h":26.0,"text":"module.ko","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"sg","x":190.0,"y":66.0,"w":90.0,"h":26.0,"text":"signature","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"ok","x":300.0,"y":66.0,"w":80.0,"h":26.0,"text":"loaded","tone":"green","size":9.0,"sub_size":8.5},{"t":"line","id":"a1","x1":118.0,"y1":66.0,"x2":146.0,"y2":66.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"line","id":"a2","x1":236.0,"y1":66.0,"x2":258.0,"y2":66.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"t","x":180.0,"y":120.0,"text":"kernel 7.0: post-quantum ML-DSA, old SHA-1 removed","tone":"green","size":8.5}]],"cues":[6.3,17.5,24.6]}]},{"title":"Rust in the kernel","sub":"From 6.1 to official status in 7.0","short":"Rust","main":"Rust drivers are already in the kernel, and the experimental status was lifted in 7.0.","body":[{"t":"scene","labels":["Arrival","Drivers","Safety","Status"],"captions":["Rust support arrived in kernel 6.1 as infrastructure","By 6.18 there are real Rust drivers: Binder and Tyr, with Nova in progress","Safe wrappers over C let you write drivers without unsafe","In kernel 7.0 Rust is no longer experimental; it is an official part"],"frames":[[{"t":"cell","id":"a","x":60.0,"y":60.0,"w":80.0,"h":34.0,"text":"6.1\narrived","tone":"green","size":9.0,"sub_size":8.5},{"t":"text","id":"t","x":220.0,"y":60.0,"text":"Rust support added\nto the kernel as infrastructure","size":9.0}],[{"t":"cell","id":"b","x":80.0,"y":54.0,"w":130.0,"h":24.0,"text":"Binder (Android) — 6.18","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"t1","x":80.0,"y":90.0,"w":130.0,"h":24.0,"text":"Tyr: Mali GPU — 6.18","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"n","x":80.0,"y":126.0,"w":130.0,"h":24.0,"text":"Nova: NVIDIA, in progress","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"text","id":"t","x":270.0,"y":90.0,"text":"real\ndrivers\nin Rust","tone":"green","size":9.0}],[{"t":"cell","id":"d","x":80.0,"y":40.0,"w":130.0,"h":24.0,"text":"driver in safe Rust","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"w","x":80.0,"y":80.0,"w":130.0,"h":24.0,"text":"safe wrapper","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"c","x":80.0,"y":120.0,"w":130.0,"h":24.0,"text":"kernel in C (unsafe)","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":80.0,"y1":54.0,"x2":80.0,"y2":68.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"a2","x1":80.0,"y1":94.0,"x2":80.0,"y2":108.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"t","x":270.0,"y":80.0,"text":"ownership and types\ncatch bugs\nat build time","tone":"green","size":9.0}],[{"t":"cell","id":"e","x":90.0,"y":60.0,"w":120.0,"h":28.0,"text":"experimental","tone":"red","size":10.0,"sub_size":8.5,"dash":true,"o":0.4},{"t":"cell","id":"f","x":260.0,"y":60.0,"w":110.0,"h":28.0,"text":"kernel 7.0: official","tone":"green","size":9.5,"sub_size":8.5},{"t":"line","id":"x","x1":150.0,"y1":60.0,"x2":205.0,"y2":60.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"t","x":180.0,"y":110.0,"text":"Rust is a permanent part of the kernel, not an experiment","tone":"green","size":9.0}]],"cues":[15.8,16.8,29.3]}]},{"title":"sysctl","sub":"Parameters without a reboot","short":"sysctl","main":"Change with echo or sysctl, make permanent with a file in /etc/sysctl.d.","body":[{"t":"scene","labels":["Tree","Files","sysctl","Permanent"],"captions":["Kernel parameters look like a tree of files in /proc/sys","You can read and change them with plain cat and echo","sysctl is a handy wrapper over the same files","To make a setting survive a reboot, write it to /etc/sysctl.d"],"frames":[[{"t":"cell","id":"r","x":90.0,"y":30.0,"w":90.0,"h":22.0,"text":"/proc/sys","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"d0","x":50.0,"y":70.0,"w":70.0,"h":22.0,"text":"net/","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"d1","x":140.0,"y":70.0,"w":70.0,"h":22.0,"text":"vm/","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"d2","x":230.0,"y":70.0,"w":70.0,"h":22.0,"text":"kernel/","tone":"muted","size":9.0,"sub_size":8.5},{"t":"line","id":"l0","x1":90.0,"y1":41.0,"x2":50.0,"y2":59.0,"tone":"muted","width":1.6},{"t":"line","id":"l1","x1":90.0,"y1":41.0,"x2":140.0,"y2":59.0,"tone":"muted","width":1.6},{"t":"line","id":"l2","x1":90.0,"y1":41.0,"x2":230.0,"y2":59.0,"tone":"muted","width":1.6},{"t":"cell","id":"p","x":140.0,"y":110.0,"w":180.0,"h":22.0,"text":"vm/dirty_ratio → 20","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":150.0,"text":"kernel parameters are files in the /proc/sys tree","size":9.0}],[{"t":"code","id":"c","x":24.0,"y":40.0,"lines":["cat /proc/sys/vm/dirty_ratio","20","echo 10 > /proc/sys/vm/dirty_ratio"],"hl":[2],"lang":"plain","size":10.0,"lh":22.0,"w":310.0},{"t":"text","id":"t","x":180.0,"y":130.0,"text":"reading and writing are ordinary file commands","tone":"green","size":9.0}],[{"t":"code","id":"c","x":24.0,"y":40.0,"lines":["sysctl vm.dirty_ratio","vm.dirty_ratio = 20","sysctl -w vm.dirty_ratio=10"],"hl":[2],"lang":"plain","size":10.0,"lh":22.0,"w":310.0},{"t":"text","id":"t","x":180.0,"y":130.0,"text":"sysctl is a handy wrapper over the same files","tone":"green","size":9.0}],[{"t":"code","id":"c","x":24.0,"y":40.0,"lines":["/etc/sysctl.d/90-tune.conf","vm.dirty_ratio = 10"],"hl":[1],"lang":"plain","size":10.0,"lh":22.0,"w":310.0},{"t":"text","id":"t","x":180.0,"y":120.0,"text":"set by hand lasts until reboot; in a file, permanent","tone":"yellow","size":8.5}]],"cues":[4.6,15.3,27.5]}]},{"title":"Kernel log","sub":"dmesg, oops, panic, kdump","short":"dmesg and panic","main":"Start your investigation with dmesg; kdump saves memory on a panic.","body":[{"t":"scene","labels":["dmesg","Oops","Panic","kdump"],"captions":["dmesg shows the kernel ring buffer; each entry has a level","Oops is a serious error: the kernel prints registers and stack and kills the culprit","Panic is an error after which it cannot continue","kdump loads a second kernel and saves a memory dump for analysis"],"frames":[[{"t":"code","id":"l","x":14.0,"y":30.0,"lines":["[    0.000] Linux version 7.2 …","[    4.211] nvme0n1: p1 p2","[ 1203.5] EXT4-fs warning: …","[ 1203.6] Out of memory: Killed"],"lang":"plain","size":8.8,"lh":20.0,"w":340.0},{"t":"text","id":"t","x":180.0,"y":130.0,"text":"dmesg: the kernel ring buffer, entries have a level","tone":"green","size":9.0}],[{"t":"code","id":"l","x":14.0,"y":30.0,"lines":["BUG: kernel NULL pointer dereference","RIP: 0010:my_driver_read+0x2a","Call Trace: vfs_read → …"],"hl":[1],"lang":"plain","size":9.5,"lh":22.0,"w":340.0},{"t":"text","id":"t","x":180.0,"y":130.0,"text":"oops: registers and stack, culprit process killed","tone":"yellow","size":9.0}],[{"t":"cell","id":"p","x":180.0,"y":70.0,"w":180.0,"h":40.0,"text":"Kernel panic:\nsystem halt","tone":"red","size":11.0,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":130.0,"text":"unrecoverable error: kernel stops","tone":"red","size":9.0}],[{"t":"cell","id":"k1","x":90.0,"y":66.0,"w":100.0,"h":34.0,"text":"first kernel\n(panic)","tone":"red","size":8.5,"sub_size":8.5},{"t":"cell","id":"k2","x":270.0,"y":66.0,"w":100.0,"h":34.0,"text":"kdump kernel","tone":"green","size":8.5,"sub_size":8.5},{"t":"line","id":"a","x1":142.0,"y1":66.0,"x2":218.0,"y2":66.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"t","x":180.0,"y":120.0,"text":"second kernel saves a dump of the first one's memory","tone":"green","size":8.5}]],"cues":[11.9,20.4,25.1]}]},{"title":"Load and pressure","sub":"load average, vmstat, PSI","short":"Load","main":"Load average is a symptom; vmstat and PSI show the cause.","body":[{"t":"scene","labels":["Load","vmstat","PSI","Analysis"],"captions":["Load average is the average queue length over 1, 5, and 15 minutes","vmstat splits time among queue, disk, and processor","PSI directly measures stalls from lack of processor, memory, and disk","Load 12 on four cores means a queue three times longer than capacity"],"frames":[[{"t":"bar","id":"b1","x":90.0,"y":120.0,"w":40.0,"hh":70.0,"max":80.0,"tone":"red","text":"1 min"},{"t":"bar","id":"b5","x":180.0,"y":120.0,"w":40.0,"hh":45.0,"max":80.0,"tone":"yellow","text":"5 min"},{"t":"bar","id":"b15","x":270.0,"y":120.0,"w":40.0,"hh":30.0,"max":80.0,"tone":"green","text":"15 min"},{"t":"line","id":"cpu","x1":60.0,"y1":96.0,"x2":300.0,"y2":96.0,"tone":"blue","dash":"4 3","width":1.6},{"t":"text","id":"cl","x":330.0,"y":94.0,"text":"cores: 4","tone":"blue","size":8.0},{"t":"text","id":"t","x":180.0,"y":150.0,"text":"load average: how many tasks wait for CPU or disk","size":8.5}],[{"t":"code","id":"v","x":14.0,"y":34.0,"lines":["r  b  swpd  free   si so  bi  bo   us sy id wa","12 0  0     800M   0  0   10  20   88 10 2  0"],"hl":[1],"lang":"plain","size":8.5,"lh":22.0,"w":340.0},{"t":"text","id":"t","x":180.0,"y":120.0,"text":"vmstat breaks it down: queue, swap, disk, CPU","tone":"green","size":8.5}],[{"t":"code","id":"p","x":20.0,"y":34.0,"lines":["cat /proc/pressure/cpu","some avg10=42.1 avg60=30.5","full avg10=0.0"],"hl":[1],"lang":"plain","size":9.5,"lh":22.0,"w":320.0},{"t":"text","id":"t","x":180.0,"y":130.0,"text":"PSI: share of time tasks stood idle without a resource","tone":"green","size":8.5}],[{"t":"cell","id":"a","x":100.0,"y":66.0,"w":130.0,"h":34.0,"text":"load 12 on 4 cores","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":66.0,"w":130.0,"h":34.0,"text":"queue three times longer","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"line","id":"x","x1":166.0,"y1":66.0,"x2":202.0,"y2":66.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"text","id":"t","x":180.0,"y":120.0,"text":"the number gives no cause; check vmstat and PSI","tone":"yellow","size":9.0}]],"cues":[7.7,18.8,30.2]}]},{"title":"perf and tracing","sub":"Samples, tracepoints, kprobe","short":"perf","main":"perf answers where time goes; tracing, what happened.","body":[{"t":"scene","labels":["perf","Stacks","Tracepoints","kprobe"],"captions":["perf takes stack samples and shows where the CPU spends time","The report follows call chains, including kernel functions","Tracepoints are stable places you can attach to","A kprobe hangs on almost any function without recompiling"],"frames":[[{"t":"bar","id":"f1","x":70.0,"y":120.0,"w":40.0,"hh":70.0,"max":80.0,"tone":"red","text":"memcpy"},{"t":"bar","id":"f2","x":150.0,"y":120.0,"w":40.0,"hh":40.0,"max":80.0,"tone":"yellow","text":"hash"},{"t":"bar","id":"f3","x":230.0,"y":120.0,"w":40.0,"hh":20.0,"max":80.0,"tone":"blue","text":"read"},{"t":"bar","id":"f4","x":310.0,"y":120.0,"w":40.0,"hh":8.0,"max":80.0,"tone":"green","text":"other"},{"t":"text","id":"t","x":180.0,"y":148.0,"text":"perf record: stack samples, where time goes","size":8.5}],[{"t":"cell","id":"s0","x":60.0,"y":120.0,"w":110.0,"h":20.0,"text":"main()","tone":"muted","size":8.5,"sub_size":8.5},{"t":"cell","id":"s1","x":110.0,"y":96.0,"w":110.0,"h":20.0,"text":"handle()","tone":"muted","size":8.5,"sub_size":8.5},{"t":"cell","id":"s2","x":160.0,"y":72.0,"w":110.0,"h":20.0,"text":"parse()","tone":"muted","size":8.5,"sub_size":8.5},{"t":"cell","id":"s3","x":210.0,"y":48.0,"w":110.0,"h":20.0,"text":"memcpy()","tone":"red","size":8.5,"sub_size":8.5},{"t":"text","id":"t","x":270.0,"y":70.0,"text":"the report follows stacks,\nincluding inside the kernel","tone":"green","size":8.5}],[{"t":"code","id":"tp","x":20.0,"y":36.0,"lines":["sched:sched_switch","block:block_rq_issue","syscalls:sys_enter_openat"],"lang":"plain","size":10.0,"lh":22.0,"w":320.0},{"t":"text","id":"t","x":180.0,"y":130.0,"text":"tracepoints: stable places to attach","tone":"green","size":9.0}],[{"t":"cell","id":"fn","x":110.0,"y":66.0,"w":140.0,"h":26.0,"text":"vfs_read()","tone":"muted","size":10.0,