.0,"y":60.0,"w":60.0,"h":26.0,"text":"[1]","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"o2","x":218.0,"y":60.0,"w":60.0,"h":26.0,"text":"[2]","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"o3","x":294.0,"y":60.0,"w":60.0,"h":26.0,"text":"[3]","tone":"blue","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"result of task i → index i","size":10.0}]],"cues":[17.9,29.9]}]},{"title":"Cancellation","sub":"AbortController","short":"Cancellation","main":"A promise can't be cancelled, but you can stop listening.","body":[{"t":"scene","labels":["AbortController","Signal in fetch","Timeout and any"],"captions":["A promise can't be cancelled but you can stop listening: a controller issues a signal, abort() triggers it","fetch rejects with AbortError; your own operations subscribe to the signal's abort event and stop","AbortSignal.timeout(ms) is a ready time-based signal, AbortSignal.any combines several"],"frames":[[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["const ac = new AbortController();","start(ac.signal);","ac.abort();   // cancel"],"hl":[0,2],"lang":"js","size":10.5,"lh":24.0,"w":310.0}],[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["try {","  await fetch(url, { signal });","} catch (e) {","  if (e.name === 'AbortError') return;","  throw e;","}"],"hl":[3],"lang":"js","size":10.0,"lh":20.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":44.0,"lines":["fetch(url, { signal: AbortSignal.timeout(5000) });","","const s = AbortSignal.any([a.signal, b.signal]);"],"hl":[0,2],"lang":"js","size":9.0,"lh":22.0,"w":340.0}]],"cues":[15.8,25.1]}]},{"title":"Async iterators","sub":"for await and async function*","short":"for await","main":"The next item is requested on demand.","body":[{"t":"scene","labels":["for await","Paginated loading","Laziness"],"captions":["The for await…of loop waits for each value of the stream in turn","An async function* generator requests a page, yields items and moves on, until the server says \"enough\"","The next page is requested only when the consumer asks for the next item; break stops loading"],"frames":[[{"t":"code","id":"c","x":30.0,"y":50.0,"lines":["for await (const chunk of stream) {","  process(chunk);","}"],"hl":[0],"lang":"js","size":11.0,"lh":26.0,"w":310.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["async function* pages(url) {","  let next = url;","  while (next) {","    const r = await get(next);","    yield* r.items;","    next = r.next;","  }","}"],"hl":[4],"lang":"js","size":10.0,"lh":18.0,"w":330.0}],[{"t":"cell","id":"p0","x":70.0,"y":70.0,"w":70.0,"h":28.0,"text":"page 1","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"p1","x":170.0,"y":70.0,"w":70.0,"h":28.0,"text":"page 2","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"p2","x":270.0,"y":70.0,"w":70.0,"h":28.0,"text":"page 3","tone":"muted","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":118.0,"text":"request on the consumer's demand","size":9.5}]],"cues":[9.4,29.7]}]},{"title":"Other queues","sub":"queueMicrotask, promisify","short":"Queues","main":"Every promise must be handled somewhere.","body":[{"t":"scene","labels":["Queues","promisify","Unhandled"],"captions":["queueMicrotask puts code into microtasks without a promise; setTimeout(0) runs after them; setImmediate in Node runs after the I/O phase","util.promisify turns callback style into promises; many built-in modules already have a promise variant","An unhandled rejection is an error: in Node it ends the process, in the browser it fires an event; handle every promise somewhere"],"frames":[[{"t":"cell","id":"q0","x":180.0,"y":36.0,"w":200.0,"h":28.0,"text":"queueMicrotask","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"q1","x":180.0,"y":74.0,"w":200.0,"h":28.0,"text":"setTimeout(0)","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"cell","id":"q2","x":180.0,"y":112.0,"w":200.0,"h":28.0,"text":"setImmediate","tone":"blue","size":10.5,"sub_size":8.5}],[{"t":"cod