":224.0,"y":70.0,"w":76.0,"h":52.0,"text":"rpm\nlow level","tone":"muted","size":8.5,"sub_size":8.5},{"t":"line","id":"a2","x1":174.0,"y1":70.0,"x2":185.0,"y2":70.0,"tone":"muted","arrow":true,"width":1.6},{"t":"cell","id":"n3","x":313.0,"y":70.0,"w":76.0,"h":52.0,"text":"dnf\nupper","tone":"green","size":8.5,"sub_size":8.5},{"t":"line","id":"a3","x1":263.0,"y1":70.0,"x2":274.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[10.8,19.3,30.7]}]},{"title":"Repositories: two formats","sub":"Chapter 2 · A headless server","short":"Repos","main":"Debian describes a source with fields, the RHEL family with a .repo section.","body":[{"t":"scene","labels":["Source","Suites","Section","Enabled"],"captions":["A .sources file: the Types and URIs fields give kind and address","Suites and Components choose the release and archive areas","A .repo file: a section in square brackets and baseurl","enabled=1 switches the repository on, apt update only refreshes the index"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["# /etc/apt/sources.list.d/debian.sources","Types: deb","URIs: https://deb.debian.org/debian","Suites: bookworm bookworm-updates","Components: main","","# /etc/yum.repos.d/example.repo","[baseos]","baseurl=https://mirror.example/baseos/","enabled=1"],"hl":[1,2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["# /etc/apt/sources.list.d/debian.sources","Types: deb","URIs: https://deb.debian.org/debian","Suites: bookworm bookworm-updates","Components: main","","# /etc/yum.repos.d/example.repo","[baseos]","baseurl=https://mirror.example/baseos/","enabled=1"],"hl":[3,4],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["# /etc/apt/sources.list.d/debian.sources","Types: deb","URIs: https://deb.debian.org/debian","Suites: bookworm bookworm-updates","Components: main","","# /etc/yum.repos.d/example.repo","[baseos]","baseurl=https://mirror.example/baseos/","enabled=1"],"hl":[7,8],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["# /etc/apt/sources.list.d/debian.sources","Types: deb","URIs: https://deb.debian.org/debian","Suites: bookworm bookworm-updates","Components: main","","# /etc/yum.repos.d/example.repo","[baseos]","baseurl=https://mirror.example/baseos/","enabled=1"],"hl":[9],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[12.3,23.4,33.8]}]},{"title":"Signatures and keys","sub":"Chapter 2 · A headless server","short":"Keys","main":"Trust in a package equals trust in the repository key.","body":[{"t":"scene","labels":["Key","Signed-By","gpgcheck","Never"],"captions":["The repository index is signed with its owner's key","Debian: key in /etc/apt/keyrings and the Signed-By field, apt-key is deprecated","RHEL family: gpgcheck=1 in the .repo section, metadata via repo_gpgcheck","Never switch the check off to make it work: it is code running as root"],"frames":[[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"index signed by the owner","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"index signed by the owner","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"Signed-By + /etc/apt/keyrings","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"index signed by the owner","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"Signed-By + /etc/apt/keyrings","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"gpgcheck=1, repo_gpgcheck=1","tone":"green","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"index signed by the owner","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"Signed-By + /etc/apt/keyrings","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"gpgcheck=1, repo_gpgcheck=1","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":180.0,"y":122.0,"w":280.0,"h":24.0,"text":"never disable the check","tone":"red","size":9.0,"sub_size":8.5}]],"cues":[8.5,21.6,33.6]}]},{"title":"Version ordering","sub":"Chapter 2 · A headless server","short":"Versions","main":"Versions compare piece by piece, not as strings.","body":[{"t":"scene","labels":["Numbers","Tilde","Epoch","RPM"],"captions":["Numbers compare as numbers: 1.10 is newer than 1.9","The tilde is less than even the end: 1.0~rc1 is older than 1.0","The epoch beats all: 1:1.0 is newer than 2.0","RPM: epoch:version-release, tilde lowers, caret raises"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["dpkg --compare-versions 1.10 gt 1.9 && echo yes","dpkg --compare-versions 1.0~rc1 lt 1.0 && echo yes","dpkg --compare-versions 1:1.0 gt 2.0 && echo yes","# rpm: [epoch:]version-release","#   ~ lowers, ^ raises"],"hl":[0],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["dpkg --compare-versions 1.10 gt 1.9 && echo yes","dpkg --compare-versions 1.0~rc1 lt 1.0 && echo yes","dpkg --compare-versions 1:1.0 gt 2.0 && echo yes","# rpm: [epoch:]version-release","#   ~ lowers, ^ raises"],"hl":[1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["dpkg --compare-versions 1.10 gt 1.9 && echo yes","dpkg --compare-versions 1.0~rc1 lt 1.0 && echo yes","dpkg --compare-versions 1:1.0 gt 2.0 && echo yes","# rpm: [epoch:]version-release","#   ~ lowers, ^ raises"],"hl":[2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["dpkg --compare-versions 1.10 gt 1.9 && echo yes","dpkg --compare-versions 1.0~rc1 lt 1.0 && echo yes","dpkg --compare-versions 1:1.0 gt 2.0 && echo yes","# rpm: [epoch:]version-release","#   ~ lowers, ^ raises"],"hl":[3,4],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[9.4,21.1,29.3]}]},{"title":"The update cycle","sub":"Chapter 2 · A headless server","short":"Cycle","main":"Refresh the index, read the list, apply.","body":[{"t":"scene","labels":["Index","upgrade","full","dnf"],"captions":["apt update refreshes the index, apt list --upgradable shows the list","apt upgrade never removes packages and leaves such updates alone","apt full-upgrade may remove when the system as a whole needs it","dnf check-update exits 100 if updates exist; --security narrows the choice"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["apt update","apt list --upgradable","apt upgrade        # never removes","apt full-upgrade   # may remove","dnf check-update   # exit 100: updates","dnf upgrade --security"],"hl":[0,1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["apt update","apt list --upgradable","apt upgrade        # never removes","apt full-upgrade   # may remove","dnf check-update   # exit 100: updates","dnf upgrade --security"],"hl":[2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["apt update","apt list --upgradable","apt upgrade        # never removes","apt full-upgrade   # may remove","dnf check-update   # exit 100: updates","dnf upgrade --security"],"hl":[3],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["apt update","apt list --upgradable","apt upgrade        # never removes","apt full-upgrade   # may remove","dnf check-update   # exit 100: updates","dnf upgrade --security"],"hl":[4,5],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[10.1,19.6,28.9]}]},{"title":"Holding versions","sub":"Chapter 2 · A headless server","short":"Hold","main":"A hold postpones an update but creates a debt.","body":[{"t":"scene","labels":["Hold","List","Dependents","Debt"],"captions":["apt-mark hold: the package is neither upgraded nor removed","apt-mark showhold lists all frozen packages","Packages that need a newer version of the frozen one are held back too","In dnf a versionlock plugin does it; write down who and why"],"frames":[[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"apt-mark hold name","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"apt-mark hold name","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"apt-mark showhold","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"apt-mark hold name","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"apt-mark showhold","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"dependents stay as they are","tone":"yellow","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"apt-mark hold name","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"apt-mark showhold","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"dependents stay as they are","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":180.0,"y":122.0,"w":280.0,"h":24.0,"text":"dnf versionlock; note the reason","tone":"red","size":9.0,"sub_size":8.5}]],"cues":[10.0,17.4,29.4]}]},{"title":"Kernels side by side","sub":"Chapter 2 · A headless server","short":"Kernels","main":"Several kernels in /boot, cleanup by rule, a reboot for the new one.","body":[{"t":"scene","labels":["uname -r","Limit","Cleanup","Reboot"],"captions":["Old kernels stay in /boot and the boot menu; uname -r shows the running one","dnf: installonly_limit=3 by defau