ne","id":"a3","x1":263.0,"y1":70.0,"x2":274.0,"y2":70.0,"tone":"red","arrow":true,"width":1.6}]],"cues":[12.0,22.8,35.1]}]},{"title":"Automatic updates","sub":"Chapter 2 · A headless server","short":"Auto","main":"Auto-updates suit servers, but not virtualization hosts.","body":[{"t":"scene","labels":["Debian","RHEL","Mode","VM hosts"],"captions":["unattended-upgrades: security updates only by default","dnf-automatic: configuration in /etc/dnf, runs on a timer","Modes: notify only, download only, or apply","VM hosts: by hand, after putting the host into maintenance"],"frames":[[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"unattended-\nupgrades","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"unattended-\nupgrades","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"dnf-automatic\n+ timer","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"unattended-\nupgrades","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"dnf-automatic\n+ timer","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":95.0,"y":110.0,"w":158.0,"h":46.0,"text":"notify, download,\napply","tone":"yellow","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"unattended-\nupgrades","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"dnf-automatic\n+ timer","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":95.0,"y":110.0,"w":158.0,"h":46.0,"text":"notify, download,\napply","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":265.0,"y":110.0,"w":158.0,"h":46.0,"text":"VM hosts:\nby hand","tone":"green","size":9.0,"sub_size":8.5}]],"cues":[10.2,21.2,29.5]}]},{"title":"Rollback and repo failures","sub":"C