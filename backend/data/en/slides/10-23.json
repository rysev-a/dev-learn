h":28.0,"text":"■","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"q2","x":224.0,"y":70.0,"w":28.0,"h":28.0,"text":"■","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":300.0,"y":70.0,"w":70.0,"h":28.0,"text":"slow\nconsumer","tone":"green","size":8.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":126.0,"text":"queue full — send waits","tone":"yellow","size":9.5}]],"cues":[13.6,24.6]}]},{"title":"Atomics","sub":"Indivisible operations and Ordering","short":"Atomics","main":"fetch_add, compare_exchange; Relaxed/Acquire/Release/SeqCst.","body":[{"t":"scene","labels":["fetch_add","compare_exchange","Ordering"],"captions":["AtomicUsize::fetch_add is a single indivisible instruction (amoadd on RISC-V, lock xadd on x86): no lock needed","compare_exchange writes the new value only if the expected one is there: spinlocks and lock-free counters are built on it","Relaxed — only indivisibility; Acquire/Release link a read to a write (memory barriers); SeqCst — one global order, the most expensive"],"frames":[[{"t":"code","id":"c","x":14.0,"y":40.0,"lines":["static N: AtomicUsize = AtomicUsize::new(0);","N.fetch_add(1, Ordering::Relaxed);","// amoadd.w  zero, a1, (a0)"],"hl":[1],"lang":"rust","size":9.0,"lh":22.0,"w":350.0}],[{"t":"code","id":"c","x":14.0,"y":40.0,"lines":["lock.compare_exchange(false, true,","    Ordering::Acquire, Ordering::Relaxed)","// success: the lock is ours; Err: someone else has it"],"hl":[0,1],"lang":"rust","size":9.0,"lh":22.0,"w":350.0}],[{"t":"cell","id":"o0","x":90.0,"y":40.0,"w":150.0,"h":26.0,"text":"Relaxed","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"o1","x":90.0,"y":76.0,"w":150.0,"h":26.0,"text":"Acquire / Release","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"cell","id":"o2","x":90.0,"y":112.0,"w":150.0,"h":26.0,"text":"SeqCst","tone":"red","size":9.5,"sub_size":8.5},{"t":"text","id":"a","x":270.0,"y":52.0,"text":"cheap","tone":"green","size":9.0},{"t":"text","id":"b","x":270.0,"y":124.0,"text":"expensive","tone":"red","size":9.0}]],"cues":[15.4,31.6]}]},{"title":"Condvar, Barrier, pool","sub":"Coordination","short":"Coordination","main":"Wait for a condition in a loop; a barrier syncs stages; a pool saves threads.","body":[{"t":"scene","labels":["Condvar","Barrier","Thread pool"],"captions":["Condvar puts a thread to sleep until a signal: check the condition in a while loop, because wakeups can be spurious","Barrier makes a group of threads wait for each other before the next stage","Pool: a fixed number of threads take jobs from a shared channel — no cost of creating a thread for every small job"],"frames":[[{"t":"code","id":"c","x":14.0,"y":30.0,"lines":["let (lock, cv) = &*pair;","let mut ready = lock.lock().unwrap();","while !*ready {","    ready = cv.wait(ready).unwrap();","}"],"hl":[2,3],"lang":"rust","size":9.0,"lh":18.0,"w":350.0}],[{"t":"cell","id":"t0","x":70.0,"y":50.0,"w":70.0,"h":22.0,"text":"thread 1","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"t1","x":170.0,"y":62.0,"w":70.0,"h":22.0,"text":"thread 2","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"t2","x":270.0,"y":74.0,"w":70.0,"h":22.0,"text":"thread 3","tone":"blue","size":9.0,"sub_size":8.5},{"t":"line","id":"bar","x1":30.0,"y1":100.0,"x2":330.0,"y2":100.0,"tone":"yellow","width":3.0},{"t":"text","id":"n","x":180.0,"y":126.0,"text":"wait for all at the barrier, then go on","size":9.5}],[{"t":"cell","id":"q","x":70.0,"y":70.0,"w":80.0,"h":36.0,"text":"job\nchannel","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"cell","id":"w0","x":250.0,"y":34.0,"w":100.0,"h":24.0,"text":"worker 1","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"w1","x":250.0,"y":72.0,"w":100.0,"h":24.0,"text":"worker 2","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"w2","x":250.0,"y":110.0,"w":100.0,"h":24.0,"text":"worker 3","tone":"green","size":9.0,"sub_size":8.5},{"t":"line","id":"e0","x1":112.0,"y1":70.0,"x2":200.0,"y2":34.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e1","x1":112.0,"y1":70.0,"x2":200.0,"y2":72.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":112.0,"y1":70.0,"x2":200.0,"y2":110.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[14.0,28.8]}]},{"title":"Split and merge","sub":"chunks_mut and partial sums","short":"Split","main":"Pieces, partial results and a merge — faster than locks.","body":[{"t":"scene","labels":["Cut","Accumulate locally","Merge"],"captions":["The array is cut into non-overlapping pieces: chunks_mut() gives each thread its own mutable slice, and the compiler proves there are no races","Each thread accumulates a partial result in its own variable — no locks and no data exchange","At the end the partial sums are combined: the result is the same in any order of execution"],"frames":[[{"t":"cell","id":"c0","x":44.0,"y":60.0,"w":34.0,"h":26.0,"text":"1","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c1","x":82.0,"y":60.0,"w":34.0,"h":26.0,"text":"2","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c2","x":120.0,"y":60.0,"w":34.0,"h":26.0,"text":"3","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c3","x":158.0,"y":60.0,"w":34.0,"h":26.0,"text":"4","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c4","x":196.0,"y":60.0,"w":34.0,"h":26.0,"text":"5","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"c5","x":234.0,"y":60.0,"w":34.0,"h":26.0,"text":"6","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"c6","x":272.0,"y":60.0,"w":34.0,"h":26.0,"text":"7","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"c7","x":310.0,"y":60.0,"w":34.0,"h":26.0,"text":"8","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"text","id":"a","x":120.0,"y":100.0,"text":"thread 1","tone":"blue","size":9.0},{"t":"text","id":"b","x":270.0,"y":100.0,"text":"thread 2","tone":"yellow","size":9.0}],[{"t":"cell","id":"a~cell","x":90.0,"y":60.0,"w":100.0,"h":26.0,"text":"sum = 10","tone":"blue","size":10.0