.5}]],"cues":[10.5,20.9,32.7]}]},{"title":"Bond modes","sub":"Chapter 21 · oVirt networks","short":"Bond","main":"Seven modes: which need the switch and which do not.","body":[{"t":"scene","labels":["Mode 1","Mode 4","Modes 0/2/3","Modes 5/6"],"captions":["Mode 1, active-backup: the switch needs nothing","Mode 4, 802.3ad: the switch has an LACP group configured","Modes 0, 2, 3 need static aggregation on the switch ports","Modes 5 and 6 need no switch help; 0, 5, 6 are not advised for VM networks"],"frames":[[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"1 active-backup\nno switch needed","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"1 active-backup\nno switch needed","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"4 802.3ad\nLACP required","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"1 active-backup\nno switch needed","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"4 802.3ad\nLACP required","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":95.0,"y":110.0,"w":158.0,"h":46.0,"text":"0, 2, 3\nstatic aggregation","tone":"yellow","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"1 active-backup\nno switch needed","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"4 802.3ad\nLACP required","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":95.0,"y":110.0,"w":158.0,"h":46.0,"text":"0, 2, 3\nstatic aggregation","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":265.0,"y":110.0,"w":158.0,"h":46.0,"text":"5, 6\nno switch needed","tone":"green","size":9.0,"sub_size":8.5}]],"cues":[8.5,18.6,28.9]}]},{"title":"setupNetworks and rollback","sub":"Chapter 2