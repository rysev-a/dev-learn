{"book":10,"chapter":50,"rubric":"LEARNING RUST / CHAT: AXUM, SQLX, TOKIO / CHAPTER 50","slides":[{"title":"Live delivery","sub":"Chapter 50 · WebSocket","short":"Intro","main":"The chat comes alive: the server itself pushes messages to clients over a persistent connection.","body":[{"t":"scene","labels":["Request-response","Persistent connection","Chapter plan"],"captions":["Client asks, server answers; a new message never arrives unasked","Two-way connection: the server pushes events itself","Accepting, fan-out, slow clients, liveness, syncing with the database"],"frames":[[{"t":"cell","id":"a","x":70.0,"y":50.0,"w":80.0,"h":26.0,"text":"client","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":290.0,"y":50.0,"w":80.0,"h":26.0,"text":"server","tone":"blue","size":10.5,"sub_size":8.5},{"t":"line","id":"e1","x1":110.0,"y1":44.0,"x2":250.0,"y2":44.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":250.0,"y1":58.0,"x2":110.0,"y2":58.0,"tone":"muted","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"new message only on request","tone":"red","size":9.0}],[{"t":"cell","id":"a","x":70.0,"y":70.0,"w":80.0,"h":26.0,"text":"client","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":290.0,"y":70.0,"w":80.0,"h":26.0,"text":"server","tone":"blue","size":10.5,"sub_size":8.5},{"t":"line","id":"e1","x1":110.0,"y1":64.0,"x2":250.0,"y2":64.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":250.0,"y1":76.0,"x2":110.0,"y2":76.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":115.0,"text":"server writes whenever it has news","tone":"muted","size":9.0}],[{"t":"cell","id":"a","x":60.0,"y":70.0,"w":76.0,"h":28.0,"text":"accept","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":150.0,"y":70.0,"w":76.0,"h":28.0,"text":"hub","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"c","x":240.0,"y":70.0,"w":76.0,"h":28.0,"text":"lag","tone":"green",