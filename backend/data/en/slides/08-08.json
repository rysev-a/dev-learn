tex owns the data","short":"Rust and Mutex","main":"Rust types make a forgotten lock and a data race impossible.","body":[{"t":"scene","labels":["Discipline","Mistake","Mutex<T>","Guarantee"],"captions":["In C it all rests on discipline: take it, don't touch without it, release it","An early exit without unlock leaves the lock held forever","In Rust the mutex owns the data, and a guard gives access","The guard releases the lock itself; Rust became official in the kernel in 7.0"],"frames":[[{"t":"code","id":"c","x":14.0,"y":40.0,"lines":["spin_lock(&lock);","if (err) return -1;","counter++;","spin_unlock(&lock);"],"hl":[0,3],"lang":"plain","size":8.0,"lh":15.0,"w":170.0},{"t":"text","id":"hc","x":100.0,"y":20.0,"text":"C: discipline","size":8.5},{"t":"text","id":"t","x":180.0,"y":130.0,"text":"take it and don't forget to release","tone":"green","size":9.0}],[{"t":"code","id":"c","x":14.0,"y":40.0,"lines":["spin_lock(&lock);","if (err) return -1;","counter++;","spin_unlock(&lock);"],"hl":[1],"lang":"plain","size":8.0,"lh":15.0,"w":170.0},{"t":"text","id":"hc","x":100.0,"y":20.0,"text":"C: discipline","size":8.5},{"t":"text","id":"t","x":180.0,"y":130.0,"text":"a forgotten unlock on an early exit — a hang","tone":"red","size":9.0}],[{"t":"code","id":"c","x":14.0,"y":40.0,"lines":["spin_lock(&lock);","if (err) return -1;","counter++;","spin_unlock(&lock);"],"lang":"plain","size":8.0,"lh":15.0,"w":170.0},{"t":"code","id":"r","x":196.0,"y":40.0,"lines":["let mut g = m.lock();","*g += 1;","// the guard g releases","// the lock by itself"],"hl":[0,1],"lang":"plain","size":8.0,"lh":15.0,"w":160.0},{"t":"text","id":"hc","x":100.0,"y":20.0,"text":"C: discipline","size":8.5},{"t":"text","id":"hr","x":276.0,"y":20.0,"text":"Rust: type guarantee","tone":"green","size":8.5},{"t":"text","id":"t","x":180.0,"y":130.0,"text":"Mutex<T> owns the data: no way in without a guard","tone":"green","size":9.0}],[{"t":"code","id":"c","x":14.0,"y":40.0,"lines":["spin_lock(&lock);","if (err) return -1;","counter++;","spin_unlock(&lock);"],"lang":"plain","size":8.0,"lh":15.0,"w":170.0},{"t":"code","id":"r","x":196.0,"y":40.0,"lines":["let mut g = m.lock();","*g += 1;","// the guard g releases","// the lock by itself"],"hl":[2,3],"lang":"plain","size":8.0,"lh":15.0,"w":160.0},{"t":"text","id":"hc","x":100.0,"y":20.0,"text":"C: discipline","size":8.5},{"t":"text","id":"hr","x":276.0,"y":20.0,"text":"Rust: type guarantee","tone":"green","size":8.5},{"t":"text","id":"t","x":180.0,"y":130.0,"text":"a data race in safe code does not compile","tone":"green","size":9.0}]],"cues":[9.1,21.4,26.7]}]}]}