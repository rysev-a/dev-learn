thon: None crashes on use; Rust: Option — the compiler demands a check"],"frames":[[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["True + 1     # 2","true + 1     // ✕ error"],"hl":[1],"bad":[1],"lang":"rust","size":13.0,"lh":26.0,"w":300.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":36.0,"text":"if lst: / if 0:","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":36.0,"text":"if !v.is_empty()","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":36.0,"text":"None.x\nAttributeError","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":36.0,"text":"Option<T>\ncheck required","tone":"green","size":9.5,"sub_size":8.5}]],"cues":[8.9,22.7]}]},{"title":"Strings","sub":"Characters and bytes","short":"Strings","main":"len in bytes; bytes ↔ &[u8]; char is a separate type.","body":[{"t":"scene","labels":["Characters or bytes","bytes ↔ &[u8]","char"],"captions":["Python: len(\"привет\") = 6 — characters; Rust: len() = 12 — UTF-8 bytes","Python bytes corresponds to &[u8]; as_bytes and String::from_utf8 convert back and forth","char is a separate type of 4 bytes, not a string of length 1"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":36.0,"text":"len = 6","tone":"muted","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":36.0,"text":"len() = 12\nchars().count() = 6","tone":"green","size":9.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["s.as_bytes()            // &[u8]","String::from_utf8(bytes)   // Result"],"lang":"rust","size":10.5,"lh":26.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":36.0,"text":"char «я»  4 bytes","tone":"blue","size":11.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":36.0,"text":"str «я»  2 bytes","tone":"green","size":11.5,"sub_size":8.5}]],"cues":[10.0,28.5]}]},{"title":"Assignment","sub":"Reference, copy, move","short":"Assignment","main":"b = a in Python is a reference; in Rust it is a copy or a move.","body":[{"t":"scene","labels":["Python: reference","Rust: copy","Rust: move"],"captions":["Python: b = a — both names point to one object; a list change is visible through both","Rust: for simple types (numbers, bool, char) b = a copies the value","For String and Vec, b = a moves ownership: a becomes unusable — more in the ownership chapter"],"frames":[[{"t":"cell","id":"a","x":60.0,"y":70.0,"w":50.0,"h":36.0,"text":"a\n→","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":60.0,"y":118.0,"w":50.0,"h":36.0,"text":"b\n→","tone":"muted","size":9.0,"sub_size":8.5},{"t":"line","id":"e1","x1":86.0,"y1":70.0,"x2":220.0,"y2":90.0,"tone":"muted","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":86.0,"y1":118.0,"x2":220.0,"y2":100.0,"tone":"muted","arrow":true,"width":1.6},{"t":"cell","id":"o","x":270.0,"y":94.0,"w":100.0,"h":40.0,"text":"[1, 2]","tone":"muted","size":12.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":100.0,"y":70.0,"w":56.0,"h":40.0,"text":"a\n5","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":260.0,"y":70.0,"w":56.0,"h":40.0,"text":"b\n5","tone":"green","size":9.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":70.0,"text":"copy","size":10.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let a = String::from(\"x\");","let b = a;     // moved","// a is gone"],"hl":[1],"lang":"rust","size":11.0,"lh":24.0,"w":340.0}]],"cues":[12.3,20.6]}]},{"title":"Typing","sub":"Dynamic and static","short":"Typing","main":"Type on the value vs type on the variable; duck typing and traits.","body":[{"t":"scene","labels":["Dynamic","Static","Duck typing → traits"],"captions":["Python: x = 5; x = \"five\" — the type belongs to the value; annotations are only hints","Rust: the variable's type is fixed at build time and never changes; the compiler infers it","Duck typing: “has the method — fits” becomes traits: a type must declare what it can do"],"frames":[[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["x = 5","x = \"five\"   # allowed","x: int = \"?\"  # not checked"],"lang":"rust","size":12.0,"lh":24.0,"w":300.0}],[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["let x = 5;","// x = \"five\";   ✕ mismatched types"],"hl":[1],"bad":[1],"lang":"rust","size":12.0,"lh":26.0,"w":310.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":36.0,"text":"duck typing\nhas the method?","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":36.0,"text":"trait Speak\nimpl Speak for Dog","tone":"green","size":9.5,"sub_size":8.5}]],"cues":[9.9,26.2]}]},{"title":"Layout","sub":"size_of and alignment","short":"Layout","main":"size_of, padding, repr(C).","body":[{"t":"scene","labels":["size_of","Alignment","repr(C)"],"captions":["std::mem::size_of::<T>() is the size, align_of is the alignment: all known at build time","struct { a: u8, b: u32 } takes 8 bytes, not 5: padding sits between the fields","The compiler may reorder fields; #[repr(C)] fixes the order as in C"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"u8: 1","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"i32: 4","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"f64: 8","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"char: 4","tone":"blue","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":70.0,"y":66.0,"w":40.0,"h":32.0,"text":"u8","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"p","x":134.0,"y":66.0,"w":90.0,"h":32.0,"text":"padding 3","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":266.0,"y":66.0,"w":110.0,"h":32.0,"text":"u32","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["#[repr(C)]","struct Header { a: u8