ax":100.0,"tone":"muted","text":"1"},{"t":"bar","id":"b~bar","x":220.0,"y":120.0,"w":46.0,"hh":52.6,"max":100.0,"tone":"green","text":"5,26"},{"t":"text","id":"l","x":165.0,"y":142.0,"text":"was → now","size":9.0}],[{"t":"bar","id":"a~bar","x":110.0,"y":120.0,"w":46.0,"hh":52.6,"max":100.0,"tone":"green","text":"5,26"},{"t":"bar","id":"b~bar","x":220.0,"y":120.0,"w":46.0,"hh":100.0,"max":100.0,"tone":"yellow","text":"10"},{"t":"text","id":"l","x":165.0,"y":142.0,"text":"S = 10 → S = ∞","size":9.0}]],"cues":[18.9,29.1]}]},{"title":"How to compare","sub":"Frequency misleads","short":"Comparison","main":"A fair comparison is by the running time of real programs.","body":[{"t":"scene","labels":["Frequency and MIPS","Run time","Careful"],"captions":["Frequency and millions of instructions per second mislead: a simple architecture needs more instructions","Only the running time of real programs gives a fair comparison — benchmark suites like SPEC and Geekbench","Measurements are repeated, caches warmed up, variance accounted for; speed on one task doesn't guarantee speed on another"],"frames":[[{"t":"cell","id":"a","x":110.0,"y":66.0,"w":110.0,"h":40.0,"text":"4 GHz\n2M instructions","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":250.0,"y":66.0,"w":110.0,"h":40.0,"text":"3 GHz\n1M instructions","tone":"green","size":9.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":126.0,"text":"the faster one is whoever spent less time","tone":"yellow","size":9.5}],[{"t":"cell","id":"t0","x":70.0,"y":66.0,"w":90.0,"h":34.0,"text":"test 1","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"t1","x":180.0,"y":66.0,"w":90.0,"h":34.0,"text":"test 2","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"t2","x":290.0,"y":66.0,"w":90.0,"h":34.0,"text":"test 3","tone":"blue","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":120.0,"text":"set of real programs","size":10.0}],[{"t":"cell","id":"a","x":110.0,"y":66.0,"w":130.0,"h":34.0,"text":"many runs","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":66.0,"w":130.0,"h":34.0,"text":"variance accounted","tone":"green","size":10.0,"sub_size":8.5}]],"cues":[17.1,26.9]}]},{"title":"Summary","sub":"Processor performance","short":"Summary","main":"Next — virtual memory.","body":[{"t":"scene","labels":["Performance","Hazards","Limits"],"captions":["Time is set by instruction count, cycles per instruction, and frequency; a pipeline brings CPI toward one","Hazards create bubbles; forwarding and reordering remove some, and branch mispredictions are costly","Superscalar is limited by the critical path, Amdahl's law by the remaining share; compare on real tasks"],"frames":[[{"t":"cell","id":"s0","x":66.0,"y":50.0,"w":100.0,"h":40.0,"text":"T = N × CPI / f","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"s1","x":180.0,"y":50.0,"w":100.0,"h":40.0,"text":"pipeline:\nCPI → 1","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"s2","x":294.0,"y":50.0,"w":100.0,"h":40.0,"text":"hazards:\nbubbles, forwarding","tone":"muted","size":8.5,"sub_size":8.5},{"t":"cell","id":"s3","x":66.0,"y":102.0,"w":100.0,"h":40.0,"text":"branch\nprediction","tone":"muted","size":8.5,"sub_size":8.5},{"t":"cell","id":"s4","x":180.0,"y":102.0,"w":100.0,"h":40.0,"text":"superscalar:\ncritical path","tone":"muted","size":8.5,"sub_size":8.5},{"t":"cell","id":"s5","x":294.0,"y":102.0,"w":100.0,"h":40.0,"text":"Amdahl's law\nand benchmarks","tone":"muted","size":8.5,"sub_size":8.5}],[{"t":"cell","id":"s0","x":66.0,"y":50.0,"w":100.0,"h":40.0,"text":"T = N × CPI / f","tone":"muted","size":8.5,"sub_size":8.5},{"t":"cell","id":"s1","x":180.0,"y":50.0,"w":100.0,"h":40.0,"text":"pipeline:\nCPI → 1","tone":"muted","size":8.5,"sub_size":8.5},{"t":"cell","id":"s2","x":294.0,"y":50.0,"w":100.0,"h":40.0,"text":"hazards:\nbubbles, forwarding","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"s3","x":66.0,"y":102.0,"w":100.0,"h":40.0,"text":"branch\npredicti