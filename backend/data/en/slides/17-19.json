encing candidate; operation timeouts add minutes"],"frames":[[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"polling\nthe host","tone":"blue","size":8.5,"sub_size":8.5}],[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"polling\nthe host","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"n1","x":135.0,"y":70.0,"w":76.0,"h":52.0,"text":"a miss:\nretry","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":85.0,"y1":70.0,"x2":96.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6}],[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"polling\nthe host","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"n1","x":135.0,"y":70.0,"w":76.0,"h":52.0,"text":"a miss:\nretry","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":85.0,"y1":70.0,"x2":96.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"cell","id":"n2","x":224.0,"y":70.0,"w":76.0,"h":52.0,"text":"2 failures\n+ 60 s","tone":"violet","size":8.5,"sub_size":8.5},{"t":"line","id":"a2","x1":174.0,"y1":70.0,"x2":185.0,"y2":70.0,"tone":"violet","arrow":true,"width":1.6}],[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"polling\nthe host","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"n1","x":135.0,"y":70.0,"w":76.0,"h":52.0,"text":"a miss:\nretry","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":85.0,"y1":70.0,"x2":96.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"cell","id":"n2","x":224.0,"y":70.0,"w":76.0,"h":52.0,"text":"2 failures\n+ 60 s","tone":"violet","size":8.5,"sub_size":8.5},{"t":"line","id":"a2","x1":174.0,"y1":70.0,"x2":185.0,"y2":70.0,"tone":"violet","arrow":true,"width":1.6},{"t":"cell","id":"n3","x":313.0,"y":70.0,"w":76.0,"h":52.0,"text":"fencing\ncandidate","tone":"green","size":8.5,"sub_size":8.5},{"t":"line","id":"a3","x1":263.0,"y1":70.0,"x2":274.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[9.3,20.4,31.3]}]},{"ti