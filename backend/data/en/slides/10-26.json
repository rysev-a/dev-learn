 #, 0, width, precision, type.","body":[{"t":"scene","labels":["Grammar","Width from an argument","Types"],"captions":["{:[fill][align][sign][#][0][width][.precision][type]}","{:>w$} — width from a named variable; {:.*} — precision from the previous argument","empty — Display, ? — Debug, x X — hex, b — binary, o — octal, e — scientific; # — prefix and pretty"],"frames":[[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["{:*^+#010.3x}","// fill align sign alt zero width .prec type"],"hl":[0],"lang":"rust","size":11.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["println!(\"{:>w$}\", x, w = 8);","println!(\"{:.*}\", 2, 3.14159);   // 3.14"],"lang":"rust","size":9.5,"lh":26.0,"w":340.0}],[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"{}","tone":"blue","size":12.0,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"{:?}","tone":"blue","size":12.0,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"{:x}","tone":"blue","size":12.0,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"{:b}","tone":"blue","size":12.0,"sub_size":8.5}]],"cues":[16.6,30.1]}]},{"title":"Display and Debug","sub":"Formatter","short":"Display","main":"write!, pad, formatter parameters, debug_struct.","body":[{"t":"scene","labels":["write!","pad","Debug helpers"],"captions":["fmt(&self, f: &mut Formatter) -> fmt::Result — write the parts with write!(f, …)","f.pad(\"text\") respects width and alignment; f.width(), f.precision(), f.alternate() — parameters","debug_struct, debug_list, debug_map, debug_tuple give uniform output and work with {:#?}"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {","    write!(f, \"({}, {})\", self.x, self.y)","}"],"hl":[1],"lang":"rust","size":8.5,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["f.pad(\"text\")      // width, alignment","f.alterna