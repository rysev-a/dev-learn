 — tables and colors in the terminal; add when std is not enough"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"regex","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"unicode-","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"encoding_rs","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"serde","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"nom · pest","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"comfy-table","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"colored","tone":"blue","size":10.0,"sub_size":8.5}]],"cues":[10.9,31.3]}]},{"title":"Literals","sub":"Escaping and macros","short":"Literals","main":"Raw and byte strings; concat!, include_str!.","body":[{"t":"scene","labels":["Escaping","Raw and byte","Compile-time macros"],"captions":["\"\\n\\t\\\\\\\"\\u{1F600}\" — escaping; a line ending with \\ continues the literal","r#\"…\"# escapes nothing; b\"…\" — a byte slice &[u8] for protocols","concat!, stringify!, include_str!, env!, file!, line!, module_path! — at build time"],"frames":[[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["\"line\\twith a tab\\nand a newline\"","\"\\u{1F600}\""],"lang":"rust","size":10.5,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["r#\"he said \"yes\"\"#","b\"GET /\"   // &[u8; 5]"],"lang":"rust","size":10.5,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["include_str!(\"data.txt\")","concat!(\"a\", 1, true)"],"lang":"rust","size":10.5,"lh":28.0,"w":340.0}]],"cues":[15.9,36.4]}]},{"title":"Summary","sub":"What next","short":"Summary","main":"Next — I/O and files.","body":[{"t":"scene","labe