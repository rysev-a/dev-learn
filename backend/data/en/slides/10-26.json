lt — size and escaping"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["c.is_alphabetic()   c.is_whitespace()","c.is_ascii_digit()   c.is_uppercase()"],"lang":"rust","size":10.5,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["'f'.to_digit(16)             // Some(15)","char::from_digit(15, 16)      // Some('f')"],"lang":"rust","size":10.0,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["'я'.len_utf8()      // 2","'\\n'.escape_debug()   // \\n"],"lang":"rust","size":11.0,"lh":26.0,"w":340.0}]],"cues":[7.7,28.7]}]},{"title":"Splitting","sub":"The split family","short":"Splitting","main":"splitn, rsplit, split_terminator, split_inclusive, split_once, strip_prefix.","body":[{"t":"scene","labels":["splitn, rsplit","terminator, inclusive","split_once, strip_prefix"],"captions":["split, splitn(n), rsplit, rsplitn(n) — by separator, with a limit, from the end","split_terminator — no empty tail; split_inclusive — separator stays at the end of the piece","split_once → pair; strip_prefix, strip_suffix → Option; matches, match_indices, find, rfind"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["\"a,b,c\".splitn(2, ',')   // \"a\", \"b,c\"","\"a,b,c\".rsplit(',')       // c b a"],"lang":"rust","size":9.5,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["\"a\\nb\\n\".split_terminator('\\n')   // a b","\"a\\nb\".split_inclusive('\\n')      // \"a\\n\", \"b\""],"lang":"rust","size":8.0,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["\"get /x\".strip_prefix(\"get \")   // Some(\"/x\")","\"k=v\".split_once('=')"],"lang":"rust","size":9.0,"lh":26.0,"w":340.0}]],"cues":[19.3,28.7]}]},{"title":"Patterns","sub":"Pattern","short":"Patterns","main":"char, &str, array, closure; trim_matches.","body":[{"t":"scene","labels":["Pattern","Closure","trim_matches"],"captions":["A pattern is a char, &str, [char; N], &[char] or a closure returning bool","s.split(|c: char| c == ',' |