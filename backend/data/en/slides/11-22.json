\nexceeded","tone":"red","size":9.5}],[{"t":"text","id":"ts","x":56.0,"y":16.0,"text":"stack","tone":"muted","size":9.0},{"t":"text","id":"tm","x":190.0,"y":16.0,"text":"microtasks","tone":"muted","size":9.0},{"t":"text","id":"tt","x":306.0,"y":16.0,"text":"tasks","tone":"muted","size":9.0},{"t":"cell","id":"st0","x":56.0,"y":134.0,"w":84.0,"h":22.0,"text":"for (…1e8…)","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"ta0","x":306.0,"y":36.0,"w":84.0,"h":22.0,"text":"click","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"ta1","x":306.0,"y":64.0,"w":84.0,"h":22.0,"text":"timer","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"ta2","x":306.0,"y":92.0,"w":84.0,"h":22.0,"text":"render","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"text","id":"n","x":56.0,"y":160.0,"text":"blocks everything","tone":"red","size":9.0}]],"cues":[15.9,29.1]}]},{"title":"Event loop: tasks","sub":"One task at a time","short":"Tasks","main":"A task is never interrupted: no races inside it.","body":[{"t":"scene","labels":["Task from the queue","Runs to the end","Then the next one"],"captions":["The loop takes one task from the queue (a timer callback, a user event, a network response) and puts it on the stack","A task runs to the end without interruption: no other task's code can intervene, so no races like in threads","After a task come microtasks, then a repaint if needed, and then the next task again"],"frames":[[{"t":"text","id":"ts","x":56.0,"y":16.0,"text":"stack","tone":"muted","size":9.0},{"t":"text","id":"tm","x":190.0,"y":16.0,"text":"microtasks","tone":"muted","size":9.0},{"t":"text","id":"tt","x":306.0,"y":16.0,"text":"tasks","tone":"muted","size":9.0},{"t":"cell","id":"ta0","x":306.0,"y":36.0,"w":84.0,"h":22.0,"text":"onclick","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"ta1","x":306.0,"y":64.0,"w":84.0,"h":22.0,"text":"timer","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"ta2","x":306.0,"y":92.0,"w":84.0,"h":22.0,"