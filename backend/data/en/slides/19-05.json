0,"w":158.0,"h":46.0,"text":"ionice\nclasses 1-3","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":265.0,"y":110.0,"w":158.0,"h":46.0,"text":"chrt\nFIFO / RR","tone":"red","size":9.0,"sub_size":8.5}]],"cues":[10.7,22.6,33.0]}]},{"title":"OOM killer: score and adjustment","sub":"Chapter 5 · Processes and resources","short":"OOM","main":"A memory-based score plus oom_score_adj from -1000 to 1000.","body":[{"t":"scene","labels":["oom_score","oom_score_adj","-1000","Unit"],"captions":["/proc/PID/oom_score: the process's memory, swap and page tables","oom_score_adj is added to the score: from -1000 to +1000","-1000: never chosen at all; +1000 is the first candidate","In a unit: OOMScoreAdjust=-500; without it the service inherits the manager's value"],"frames":[[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"score = RSS + swap + page tables","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"score = RSS + swap + page tables","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"+ oom_score_adj (-1000…1000)","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"score = RSS + swap + page tables","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"+ oom_score_adj (-1000…1000)","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"-1000: excluded from the choice","tone":"green","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"score = RSS + swap + page tables","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"+ oom_score_adj (-1000…1000)","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"-1000: excluded from the choice","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":180.0,"y":122.0,"w":280.0,"h":24.0,"text":"OOMScoreAdjust= in the unit","tone":"yellow","size":9.0,"sub_size":8.5}]],"cues":[9.1,17.1,25.1]}]},{"title":"The killer's traces in the log","sub":"Chapter 5 · Processes and resources","short":"dmesg","main":"Invoked oom-killer, the table, Killed process.","body":[{"t":"scene","labels":["Log","Who asked","Killed","Cgroup"],"captions":["dmesg -T or journalctl -k -b -1: the kernel log","\"X invoked oom-killer\": the process that asked for memory","\"Out of memory: Killed process PID (name) total-vm ... anon-rss ...\"","If a cgroup hit its ceiling, the line begins \"Memory cgroup out of memory\""],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ journalctl -k -b -1 | grep -i oom","java invoked oom-killer: ...","oom-kill:constraint=CONSTRAINT_NONE,...","Out of memory: Killed process 4321 (java)"," total-vm:8123456kB, anon-rss:3912340kB,"," ... oom_score_adj:0","# Memory cgroup out of memory: ..."],"hl":[0],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ journalctl -k -b -1 | grep -i oom","java invoked oom-killer: ...","oom-kill:constraint=CONSTRAINT_NONE,...","Out of memory: Killed process 4321 (java)"," total-vm:8123456kB, anon-rss:3912340kB,"," ... oom_score_adj:0","# Memory cgroup out of memory: ..."],"hl":[1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ journalctl -k -b -1 | grep -i oom","java invoked oom-killer: ...","oom-kill:constraint=CONSTRAINT_NONE,...","Out of memory: Killed process 4321 (java)"," total-vm:8123456kB, anon-rss:3912340kB,"," ... oom_score_adj:0","# Memory cgroup out of memory: ..."],"hl":[2,3,4,5],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ journalctl -k -b -1 | grep -i oom","java invoked oom-killer: ...","oom-kill:constraint=CONSTRAINT_NONE,...","Out of memory: Killed process 4321 (java)"," total-vm:8123456kB, anon-rss:3912340kB,"," ... oom_score_adj:0","# Memory cgroup out of memory: ..."],"hl":[6],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[7.4,16.3,26.9]}]},{"title":"Memory around the killer","sub":"Chapter 5 · Processes and resources","short":"Memory","main":"Overcommit, RSS against VSZ, the available column, swap.","body":[{"t":"scene","labels":["overcommit","RSS and VSZ","available","Swap"],"captions":["vm.overcommit_memory: 0 is heuristic, 1 allows all, 2 is a strict cap","VSZ is address space, RSS is memory really in use","free: look at \"available\", not \"free\"","Swap is headroom, but heavy swapping slows the host"],"frames":[[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"overcommit\n0 / 1 / 2","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"overcommit\n0 / 1 / 2","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"VSZ ≠ RSS\nps and top","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"overcommit\n0 / 1 / 2","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"VSZ ≠ RSS\nps and top","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":95.0,"y":110.0,"w":158.0,"h":46.0,"text":"free:\navailable","tone":"green","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"overcommit\n0 / 1 / 2","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"VSZ ≠ RSS\nps and top","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":95.0,"y":110.0,"w":158.0,"h":46.0,"text":"free:\navailable","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":265.0,"y":110.0,"w":158.0,"h":46.0,"text":"swap a