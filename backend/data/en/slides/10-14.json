{"book":10,"chapter":14,"rubric":"LEARNING RUST / RUST AFTER PYTHON / CHAPTER 14","slides":[{"title":"dict and HashMap","sub":"Chapter 14 · Python → Rust","short":"Intro","main":"Hash map, ordered map, sets.","body":[{"t":"scene","labels":["dict → HashMap","What we compare","Next"],"captions":["Python dict — Rust HashMap; also the ordered BTreeMap and two kinds of sets","Creating, reading, updating, counting, iterating, sets","Last chapter of “Rust after Python”; next — ownership and borrowing"],"frames":[[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"dict","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"HashMap<K, V>","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a0","x":36.0,"y":66.0,"w":64.0,"h":28.0,"text":"create","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"a1","x":108.0,"y":66.0,"w":64.0,"h":28.0,"text":"read","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"a2","x":180.0,"y":66.0,"w":64.0,"h":28.0,"text":"entry","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"a3","x":252.0,"y":66.0,"w":64.0,"h":28.0,"text":"iterate","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"a4","x":324.0,"y":66.0,"w":64.0,"h":28.0,"text":"set","tone":"blue","size":9.5,"sub_size":8.5}],[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":250.0,"h":34.0,"text":"ownership and borrowing →","tone":"yellow","size":11.0,"sub_size":8.5}]],"cues":[13.6,32.2]}]},{"title":"Creating","sub":"new, from, collect","short":"Creating","main":"No literal; Hash + Eq for keys; no f64.","body":[{"t":"scene","labels":["new and insert","from and collect","Keys"],"captions":["No literal: HashMap::new() and insert(key, value)","HashMap::from([(k, v), …]) or collect() from an iterator of pairs","Key: Hash + Eq — numbers, strings, char, tuples; f64 not allowed"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let mut m = HashMap::new();","m.insert(\"a\", 1);","m.insert(\"b\", 2);"],"hl":[1,2],"lang":"rust","size":11.0,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let m = HashMap::from([(\"a\", 1), (\"b\", 2)]);","let n: HashMap<_, _> = pairs.into_iter().collect();"],"lang":"rust","size":8.5,"lh":28.0,"w":340.0}],[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"i32, String, char\n(i32, i32)","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"f64\nVec<…>?","tone":"red","size":10.0,"sub_size":8.5}]],"cues":[13.2,26.4]}]},{"title":"Reading","sub":"get and remove","short":"Reading","main":"get returns Option; [] panics.","body":[{"t":"scene","labels":["d[k] → panic","get → Option","remove and in"],"captions":["d[k] on a missing key — KeyError in Python; m[&k] in Rust — panic: use rarely","m.get(&k) → Option<&V>; fallback — get(&k).copied().unwrap_or(0); get_mut changes in place","k in d → contains_key(&k); d.pop(k) → remove(&k) returns Option"],"frames":[[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"d[\"x\"]\nKeyError","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"m[&\"x\"]\npanic","tone":"red","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["m.get(\"a\")                 // Some(&1)","m.get(\"z\").copied().unwrap_or(0)","if let Some(v) = m.get_mut(\"a\") { *v += 1; }"],"lang":"rust","size":8.5,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["m.contains_key(\"a\")","m.remove(\"a\")   // Option<i32>"],"lang":"rust","size":11.5,"lh":28.0,"w":340.0}]],"cues":[15.8,26.9]}]},{"title":"entry","sub":"Counting words","short":"entry","main":"insert and entry().or_insert; the counter idiom.","body":[{"t":"scene","labels":["insert","entry().or_insert","Counting words"],"captions":["d[k] = v → insert(k, v): on an existing key replaces and returns the old value","entry(k).or_insert(v) inserts only if the key is missing and returns &mut V","Counter and defaultdict(int) → *m.entry(w).or_insert(0) += 1 — one line, one key lookup"],"frames":[[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["m.insert(\"a\", 1);   // None","m.insert(\"a\", 5);   // Some(1)"],"lang":"rust","size":11.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let e = m.entry(\"k\");","let v: &mut i32 = e.or_insert(0);"],"hl":[1],"lang":"rust","size":10.5,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["for w in text.split_whitespace() {","    *counts.entry(w).or_insert(0) += 1;","}"],"hl":[1],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}]],"cues":[12.4,27.9]}]},{"title":"entry in depth","sub":"or_default, and_modify","short":"entry in depth","main":"Grouping in a single lookup.","body":[{"t":"scene","labels":["or_default","and_modify","Grouping"],"captions":["or_default() inserts the default value: 0, an empty vector, an empty string","and_modify(…) changes if the key exists; or_insert_with(…) computes the value lazily","defaultdict(list) → m.entry(k).or_default().push(v) — grouping in one lookup"],"frames":[[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["m.entry(k).or_default();   // 0, [], \"\""],"hl":[0],"lang":"rust","size":11.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["m.entry(k)","    .and_modify(|v| *v += 1)","    .or_insert(1);"],"hl":[1,2],"lang":"rust","size":11.0,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let mut g: HashMap<usize, Vec<&str>> = HashMap::new();","for w in words {","    g.entry(w.len()).or_default().push(w);","}"],"hl":[2],"lang":"rust","size":8.5,"lh":22.0,"w":340.0}]],"cues":[16.8,24.9]}]},{"title":"Iterating","sub":"Order","short":"Iterating","main":"iter, keys, values; order is arbitrary.","body":[{"t":"scene","labels":["items → iter","Order","BTreeMap, IndexMap"],"captions":["items(), keys(), values() → iter(), keys(), values(); iter_mut and values_mut change values","Python remembers insertion order; HashMap is arbitrary and changes from run to run","Need order: sort the keys, use BTreeMap or the indexmap crate"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["for (k, v) in &m { … }","for k in m.keys() { … }","for v in m.values_mut() { *v += 1; }"],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}],[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"insertion order\nPython","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"random\nHashMap","tone":"yellow","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let mut keys: Vec<_> = m.keys().collect();","keys.sort();"],"hl":[1],"lang":"rust","size":10.5,"lh":26.0,"w":340.0}]],"cues":[10.4,25.5]}]},{"title":"Hashing","sub":"Hash, Eq, SipHash","short":"Hashing","main":"Keys can't be changed; SipHash; derive(Hash).","body":[{"t":"scene","labels":["Hash and Eq","SipHash","derive"],"captions":["Python has no mutable keys (list, dict); in Rust a key can't change while it's in the map","The default hash SipHash with a random salt resists attacks; for speed — FxHash from crates","Struct key: #[derive(Hash, PartialEq, Eq)]"],"frames":[[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"list as a key ✕","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"&mut to key ✕\nwhile in map","tone":"red","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"SipHash\nsafer","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"FxHash\nfaster","tone":"yellow","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["#[derive(Hash, PartialEq, Eq)]","struct Pos { x: i32, y: i32 }"],"hl":[0],"lang":"rust","size":11.0,"lh":28.0,"w":340.0}]],"cues":[8.7,27.6]}]},{"title":"Ownership","sub":"Keys and values","short":"Ownership","main":"insert takes; get by &str; clone.","body":[{"t":"scene","labels":["insert takes","get by &str","clone"],"captions":["insert moves the key and value into the map: the string now belongs to it","m: HashMap<String, V> is also searched by &str: m.get(\"key\") — no String created","Need the key outside too — clone(); take the value out via remove or clone it"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let k = String::from(\"a\");","m.insert(k, 1);","// k is no longer available"],"hl":[1,2],"lang":"rust","size":11.0,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["let m: HashMap<String, i32> = …;","m.get(\"a\")   // &str works"],"hl":[1],"lang":"rust","size":10.5,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["m.insert(k.clone(), 1);","let owned = m.remove(\"a\");"],"lang":"rust","size":11.0,"lh":28.0,"w":340.0}]],"cues":[6.4,26.3]}]},{"title":"BTreeMap","sub":"Sorted map","short":"BTreeMap","main":"Order and ranges; when to use which.","body":[{"t":"scene","labels":["Sorted","Ranges","When"],"captions":["BTreeMap keeps pairs in a tree: iteration in ascending key order, logarithmic operations","first_key_value, last_key_value, range(a..b) — range queries (Python: sortedcontainers)","Small data and ordered queries — BTreeMap; millions of entries and exact lookup — HashMap"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"1","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"2","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"3","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"4","tone":"green","size":12.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":118.0,"text":"keys in ascending order","size":10.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["m.first_key_value()   // Some((&1, …))","m.range(2..4)            // keys 2 and 3"],"lang":"rust","size":9.5,"lh":28.0,"w":340.0}],[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"BTreeMap\norder, ranges","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"HashMap\nexact lookup","tone":"blue","size":10.0,"sub_size":8.5}]],"cues":[16.1,24.9]}]},{"title":"Sets","sub":"HashSet, BTreeSet","short":"Sets","main":"Set operations.","body":[{"t":"scene","labels":["HashSet and BTreeSet","Operations","frozenset"],"captions":["set → HashSet, ordered → BTreeSet; insert returns bool: whether the element was added","union, intersection, difference, symmetric_difference — iterators, collected into a new set","No frozenset needed: immutability is just let without mut"],"frames":[[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["let mut s = HashSet::new();","s.insert(3);   // true","s.insert(3);   // false"],"hl":[1,2],"lang":"rust","size":11.0,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["a.union(&b)","a.intersection(&b)","a.difference(&b)","a.symmetric_difference(&b)"],"lang":"rust","size":11.0,"lh":22.0,"w":340.0}],[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"frozenset","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"let s (no mut)","tone":"green","size":10.0,"sub_size":8.5}]],"cues":[10.3,29.0]}]},{"title":"Comprehensions and merging","sub":"collect and extend","short":"Comprehensions","main":"collect into HashMap; extend; sort by value.","body":[{"t":"scene","labels":["Comprehension","update → extend","To a vector"],"captions":["{w: len(w) for w in words} → words.iter().map(|w| (*w, w.len())).collect::<HashMap<_, _>>()","a | b and a.update(b) → a.extend(b): matching keys are replaced; copy — clone()","Sort by value: collect pairs into a Vec and sort_by(|a, b| b.1.cmp(&a.1))"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["words.iter()","    .map(|w| (*w, w.len()))","    .collect::<HashMap<_, _>>()"],"hl":[1,2],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["a.extend(b);   // b tops up a","let c = a.clone();"],"hl":[0],"lang":"rust","size":11.5,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let mut v: Vec<_> = m.into_iter().collect();","v.sort_by(|a, b| b.1.cmp(&a.1));"],"hl":[1],"lang":"rust","size":9.5,"lh":26.0,"w":340.0}]],"cues":[18.1,22.6]}]},{"title":"Performance","sub":"O(1) and capacity","short":"Speed","main":"with_capacity; small sets; profile.","body":[{"t":"scene","labels":["O(1) on average","with_capacity","Small sets"],"captions":["Insert, lookup, remove — constant time on average; without object wrappers faster than Python","The map grows and rehashes like dict; HashMap::with_capacity(n) allocates up front","Up to ten elements a vector of pairs with linear search is often faster: no hashing, all adjacent — profile"],"frames":[[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":240.0,"h":40.0,"text":"insert · get · remove ≈ O(1)","tone":"green","size":12.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["let mut m = HashMap::with_capacity(10_000);"],"hl":[0],"lang":"rust","size":11.0,"lh":28.0,"w":340.0}],[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"≤ 10 elements\nVec<(K, V)>","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"many\nHashMap","tone":"green","size":10.0,"sub_size":8.5}]],"cues":[13.4,31.4]}]},{"title":"Summary","sub":"What's next","short":"Summary","main":"Next — ownership and borrowing.","body":[{"t":"scene","labels":["Remember","Cheat sheet","Next"],"captions":["HashMap: get instead of [], entry for counters and groups, order arbitrary; BTreeMap — sorted","HashSet and BTreeSet: union, intersection, difference; comprehensions → collect; merge → extend","Now the main topic of the language: ownership and borrowing"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"get","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"entry","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"BTreeMap","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"HashSet","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["*m.entry(k).or_insert(0) += 1;","let u: HashSet<_> = a.union(&b).collect();"],"lang":"rust","size":10.0,"lh":26.0,"w":340.0}],[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":250.0,"h":34.0,"text":"ownership · borrowing · lifetimes","tone":"blue","size":10.5,"sub_size":8.5}]],"cues":[10.2,24.9]}]}]}