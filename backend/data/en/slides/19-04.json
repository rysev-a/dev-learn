":[2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["/var/log/app.log {","    weekly","    rotate 3","    compress","    delaycompress","    missingok","    notifempty","}"],"hl":[3,4],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["/var/log/app.log {","    weekly","    rotate 3","    compress","    delaycompress","    missingok","    notifempty","}"],"hl":[5,6],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[4.0,10.4,23.2]}]},{"title":"What is left on disk","sub":"Chapter 4 · A headless server","short":"Copies","main":"Numbers shift and the oldest copy is deleted; a dated variant also exists.","body":[{"t":"scene","labels":["Current","Newest","Older","dateext"],"captions":["app.log: the file being written now","app.log.1: the newest copy, not yet compressed with delaycompress","app.log.2.gz and onward: compressed copies, extras deleted","dateext: a date in the name instead of a number, e.g. app.log-20240305"],"frames":[[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"app.log","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"app.log","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"app.log.1","tone":"yellow","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"app.log","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"app.log.1","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"app.log.2.gz, app.log.3.gz","tone":"green","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"app.log","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"app.log.1","tone":"yellow",