than 32 bits use BigInt"],"frames":[[{"t":"code","id":"c","x":30.0,"y":36.0,"lines":["(2 ** 32 + 5) | 0   // 5","2 ** 31 | 0         // -2147483648","5.9 | 0             // 5"],"hl":[1],"lang":"js","size":10.0,"lh":22.0,"w":320.0}],[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["-1 >>> 0    // 4294967295","-1 >> 0     // -1","3000000000 | 0  // -1294967296"],"hl":[0],"lang":"js","size":10.5,"lh":22.0,"w":310.0}],[{"t":"code","id":"c","x":30.0,"y":30.0,"lines":["const READ = 1, WRITE = 2;","let p = READ | WRITE;","p & WRITE   // 2 — set","p &= ~READ; // remove READ","p ^= WRITE; // toggle"],"hl":[2,3],"lang":"js","size":10.0,"lh":18.0,"w":310.0}]],"cues":[17.6,30.3]}]},{"title":"Number methods","sub":"toFixed, round, Intl","short":"Numbers","main":"toFixed returns a string; keep money in cents.","body":[{"t":"scene","labels":["toFixed","Math.round","Intl"],"captions":["toFixed rounds to a given number of digits, but returns a string, not a number","Math.round rounds halves toward +∞: −2.5 gives −2, 2.5 gives 3; Python differs","Intl.NumberFormat formats numbers and currencies by locale, better than hand-made code"],"frames":[[{"t":"code","id":"c","x":40.0,"y":40.0,"lines":["(3.14159).toFixed(2)  // '3.14'","(1.005).toFixed(2)    // '1.00'","typeof (1).toFixed(0) // 'string'"],"hl":[2],"lang":"js","size":10.5,"lh":22.0,"w":290.0}],[{"t":"code","id":"c","x":50.0,"y":40.0,"lines":["Math.round(2.5)   // 3","Math.round(-2.5)  // -2","Math.round(-2.6)  // -3"],"hl":[1],"lang":"js","size":11.0,"lh":22.0,"w":260.0}],[{"t":"code","id":"c","x":20.0,"y":34.0,"lines":["new Intl.NumberFormat('ru-RU', {","  style: 'currency', currency: 'RUB',","}).format(1234.5)"],"lang":"js","size":10.0,"lh":18.0,"w":330.0},{"t":"cell","id":"o","x":180.0,"y":114.0,"w":160.0,"h":26.0,"text":"1 234,50 ₽","tone":"green","size":11.0,"sub_size":8.5}]],"cues":[8.5,29.6]}]},{"title":"typeof, instanceof, in","sub":"Other operators","short":"Operators","main":"in sees inherited; parentheses beat the precedence table.","body":[{"t":"scene","labels":["instanceof","in and hasOwn","Parentheses"],"captions":["instanceof checks whether an object was created by a given constructor or its descendant","The in operator also sees inherited properties: 'toString' in {} gives true; for own ones use Object.hasOwn","Mixing || and ?? without parentheses is forbidden; use parentheses instead of memorizing precedence"],"frames":[[{"t":"code","id":"c","x":40.0,"y":40.0,"lines":["[] instanceof Array     // true","new Date() instanceof Date","({}) instanceof Array   // false"],"hl":[0],"lang":"js","size":10.5,"lh":22.0,"w":290.0}],[{"t":"code","id":"c","x":30.0,"y":38.0,"lines":["'toString' in {}              // true","Object.hasOwn({}, 'toString')  // false","delete obj.key;   // remove a field"],"hl":[1],"lang":"js","size":10.0,"lh":22.0,"w":320.0}],[{"t":"code","id":"c","x":40.0,"y":40.0,"lines":["a || b ?? c     // SyntaxError","(a || b) ?? c   // allowed","a || (b ?? c)   // allowed"],"hl":[0],"bad":[0],"lang":"js","size":11.0,"lh":22.0,"w":280.0}]],"cues":[10.4,33.1]}]},{"title":"Summary","sub":"What's next","short":"Summary","main":"Next: functions, scope and closures.","body":[{"t":"scene","labels":["Coercion","Comparison","Next"],"captions":["Plus adds or concatenates; the rest is numeric; coerce explicitly: Number, String, Boolean","Compare with ===; for magnitude remember: strings by codes, the rest by numbers; sort with a function","Next: functions, scope and closures, which all of JavaScript stands on"],"frames":[[{"t":"cell","id":"a","x":80.0,"y":56.0,"w":110.0,"h":30.0,"text":"+ : concatenation?","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":220.0,"y":56.0,"w":130.0,"h":30.0,"text":"Number / String","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":140.0,"y":112.0,"w":160.0,"h":30.0,"text":"explicit, not implicit","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":80.0,"y":56.0,"w":100.0,"h":30.0,"text":"===","t