p background work in event.waitUntil, or the browser will put the worker to sleep too early"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["self.addEventListener('fetch', (e) => {","  const { request } = e;","});"],"hl":[0],"lang":"js","size":10.0,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":34.0,"lines":["self.addEventListener('fetch', (e) => {","  e.respondWith(","    caches.match(e.request)","      .then((r) => r || fetch(e.request))","  );","});"],"hl":[1,2,3],"lang":"js","size":9.5,"lh":21.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["e.waitUntil(","  cache.put(e.request, copy)",");"],"hl":[0,2],"lang":"js","size":10.5,"lh":26.0,"w":340.0}]],"cues":[11.9,27.4]}]},{"title":"Cache strategies","sub":"Cache First, Network First, SWR","short":"Strategies","main":"Pick the strategy by resource.","body":[{"t":"scene","labels":["Cache, then network","Network, then cache","Stale + revalidate"],"captions":["Cache First suits files with a hash in the name that never change","Network First suits data that must be fresh, but with no connection, showing something from cache beats nothing","Stale-While-Revalidate suits images and avatars: serve from cache at once, update in the background; never cache error responses"],"frames":[[{"t":"cell","id":"c","x":100.0,"y":70.0,"w":80.0,"h":34.0,"text":"cache","tone":"green","size":11.0,"sub_size":8.5},{"t":"line","id":"a","x1":144.0,"y1":70.0,"x2":196.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"cell","id":"n","x":250.0,"y":70.0,"w":80.0,"h":34.0,"text":"network","tone":"blue","size":11.0,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":116.0,"text":"not cached → go to network","size":10.0}],[{"t":"cell","id":"n","x":100.0,"y":70.0,"w":80.0,"h":34.0,"text":"network","tone":"blue","size":11.0,"sub_size":8.5},{"t":"line","id":"a","x1":144.0,"y1":70.0,"x2":196.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"cell","id":"c","x":250.0,"y":70.0,"w":80.0,"h":34.0,"text":"cache","tone":"green","size":11.0,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":116.0,"text":"offline → use cache","size":10.0}],[{"t":"cell","id":"c","x":90.0,"y":50.0,"w":100.0,"h":30.0,"text":"from cache at once","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"n","x":270.0,"y":50.0,"w":110.0,"h":30.0,"text":"background request","tone":"blue","size":10.0,"sub_size":8.5},{"t":"line","id":"a","x1":312.0,"y1":82.0,"x2":152.0,"y2":112.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"cell","id":"u","x":120.0,"y":120.0,"w":120.0,"h":24.0,"text":"cache updated","tone":"yellow","size":10.0,"sub_size":8.5}]],"cues":[8.0,23.6]}]},{"title":"Cache versions","sub":"Cleanup and precache","short":"Versions","main":"Delete old caches on activate.","body":[{"t":"scene","labels":["Version in the name","Cleanup on activate","Precache"],"captions":["The store name includes the version: app-v1, app-v2, so caches of different versions don't mix","On activation, delete every cache with the same prefix and a different version, or the disk fills up","The bundler generates a file list with revisions: download only what changed, delete what vanished (Workbox)"],"frames":[[{"t":"cell","id":"v0","x":100.0,"y":70.0,"w":120.0,"h":36.0,"text":"app-v1","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"v1","x":260.0,"y":70.0,"w":120.0,"h":36.0,"text":"app-v2","tone":"green","size":11.0,"sub_size":8.5}],[{"t":"cell","id":"o","x":100.0,"y":60.0,"w":120.0,"h":32.0,"text":"app-v1  ✕","tone":"red","size":11.0,"sub_size":8.5},{"t":"cell","id":"n","x":260.0,"y":60.0,"w":120.0,"h":32.0,"text":"app-v2","tone":"green","size":11.0,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":118.0,"text":"caches.delete('app-v1')","size":10.0}],[{"t":"code","id":"c","x":30.0,"y":30.0,"lines":["main.a1f3.js   — unchanged","style.9c2e.css — unchanged","app.77d0.js    — new ↓","old.1b2c.js    — delete ✕"],"hl":[2,3],"lang":"js","size":10.0,"lh":24.0,"w":320.0}]],"cues":[10.4,22.2]}]},{"title":"Offline and the shell","sub":"App Shell and fallback","short":"Offline","main":"Don't replace the API and files with the shell.","body":[{"t":"scene","labels":["App Shell","Navigation","Fallback"],"captions":["The shell is the minimal markup, styles and script that build the interface; it sits in the cache","For navigation requests the worker serves the shell and the page router picks the screen; exceptions are the API and files with extensions","If nothing worked, use a fallback: an \"offline\" page for a document, a placeholder for an image"],"frames":[[{"t":"cell","id":"s","x":180.0,"y":40.0,"w":240.0,"h":26.0,"text":"header · menu (shell)","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":90.0,"w":240.0,"h":48.0,"text":"content loads from cache or network","tone":"blue","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"r0","x":66.0,"y":70.0,"w":70.0,"h":32.0,"text":"/","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"r1","x":142.0,"y":70.0,"w":70.0,"h":32.0,"text":"/profile","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"r2","x":218.0,"y":70.0,"w":70.0,"h":32.0,"text":"/api/x ✕","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"r3","x":294.0,"y":70.0,"w":70.0,"h":32.0,"text":"/logo.png ✕","tone":"red","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"f0","x":180.0,"y":56.0,"w":270.0,"h":30.0,"text":"document → offline.html","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"f1","x":180.0,"y":100.0,"w":270.0,"h":30.0,"text":"image → placeholder.svg","tone":"yellow","size":10.0,"sub_size":8.5}]],"cues":[8.9,21.6]}]},{"title":"Messages and updates","sub":"clients and BroadcastChannel","short":"Updates","main":"Reload only once.","body":[{"t":"scene","labels":["Clients","New version","BroadcastChannel"],"captions":["The worker walks the open tabs with clients.matchAll and sends them messages","The page spots a waiting worker, shows an \"Update\" button, asks for skipWaiting on click and reloads onc