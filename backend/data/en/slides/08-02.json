","x":90.0,"y":70.0,"w":40.0,"h":28.0,"text":"ls","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"w1","x":140.0,"y":70.0,"w":40.0,"h":28.0,"text":"-l","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"w2","x":214.0,"y":70.0,"w":60.0,"h":28.0,"text":"a.txt","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"cell","id":"w3","x":282.0,"y":70.0,"w":60.0,"h":28.0,"text":"b.txt","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":120.0,"text":"the shell expanded the asterisk into a file list","tone":"yellow","size":9.5}],[{"t":"cell","id":"w0","x":90.0,"y":70.0,"w":40.0,"h":28.0,"text":"ls","tone":"green","size":11.0,"sub":"argv[0]","sub_size":8.5},{"t":"cell","id":"w1","x":140.0,"y":70.0,"w":40.0,"h":28.0,"text":"-l","tone":"green","size":11.0,"sub":"argv[1]","sub_size":8.5},{"t":"cell","id":"w2","x":214.0,"y":70.0,"w":60.0,"h":28.0,"text":"a.txt","tone":"green","size":11.0,"sub":"argv[2]","sub_size":8.5},{"t":"cell","id":"w3","x":282.0,"y":70.0,"w":60.0,"h":28.0,"text":"b.txt","tone":"green","size":11.0,"sub":"argv[3]","sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":120.0,"text":"the program gets a ready argument array","tone":"green","size":9.5}]],"cues":[10.7,15.7,24.4]}]},{"title":"fork and exec","sub":"How any program is started","short":"fork and exec","main":"fork copies the process, exec swaps the program in the copy, wait waits for the end.","body":[{"t":"scene","labels":["Shell","fork","exec","wait"],"captions":["The shell wants to run ls, but it will not replace itself","fork creates a nearly exact copy of the process with a new pid","exec replaces the copy's code and data with the ls program","The parent waits in wait for the end and collects the exit code"],"frames":[[{"t":"cell","id":"p","x":70.0,"y":70.0,"w":100.0,"h":40.0,"text":"shell\npid 100","tone":"green","size":9.5,"sub_size":8.5},{"t":"text","id":"op","x":180.0,"y":130.0,"text":"","tone":"yellow","size":9.5},{"t":"text","id":"op0","x":180.0,"y":1