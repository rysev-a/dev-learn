{"book":19,"chapter":7,"rubric":"PROCESSES AND RESOURCES / CHAPTER 7","slides":[{"title":"What a namespace is","sub":"Chapter 7 · Processes and resources","short":"Idea","main":"A container: ordinary processes plus namespaces plus cgroups.","body":[{"t":"scene","labels":["Processes","Namespaces","cgroup","Container"],"captions":["The kernel has no «container» object, only ordinary processes","Namespaces give them a trimmed view of resources","Control groups limit consumption, the previous chapter","Together they are a container, no magic"],"frames":[[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"ordinary processes","tone":"muted","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"ordinary processes","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"own view of resources: namespaces","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"ordinary processes","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"own view of resources: namespaces","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"resource limits: cgroups","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"ordinary processes","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"own view of resources: namespaces","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"resource limits: cgroups","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":180.0,"y":122.0,"w":280.0,"h":24.0,"text":"together = a container","tone":"green","size":9.0,"sub_size":8.5}]],"cues":[11.2,20.1,30.0]}]},{"title":"Eight types","sub":"Chapter 7 · Proce