","x":270.0,"y":70.0,"w":130.0,"h":30.0,"text":"bottleneck","tone":"green","size":11.5,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":70.0,"x2":204.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"cell","id":"a","x":70.0,"y":70.0,"w":100.0,"h":28.0,"text":"algorithms","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":70.0,"w":90.0,"h":28.0,"text":"cache, I/O","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"c","x":290.0,"y":70.0,"w":100.0,"h":28.0,"text":"vectorization","tone":"blue","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"tests","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":130.0,"h":30.0,"text":"comments","tone":"green","size":11.0,"sub_size":8.5}]],"cues":[10.0,17.9,28.8]}]}]}