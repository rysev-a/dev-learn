l","id":"a","x":90.0,"y":60.0,"w":120.0,"h":30.0,"text":"x in list  O(n)","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":30.0,"text":"x in set  O(1)","tone":"green","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":112.0,"text":"a thousand items → a million","size":10.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":120.0,"h":30.0,"text":"bisect  O(log n)","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":30.0,"text":"Counter  1 pass","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":108.0,"w":120.0,"h":26.0,"text":"deque, not list[0]","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"O(n²)","tone":"red","size":14.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":110.0,"h":30.0,"text":"O(n)","tone":"green","size":14.0,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":70.0,"x2":214.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":118.0,"text":"× 1000","tone":"green","size":14.0}]],"cues":[11.5,26.2]}]},{"title":"Built-in tools","sub":"C beats a loop","short":"Built-ins","main":"sum, join and comprehensions.","body":[{"t":"scene","labels":["C functions","Comprehensions","join"],"captions":["sum, min, max, sorted, any, all are written in C and beat equivalent loops","A comprehension beats a loop with append; a generator expression builds no list","''.join(parts) beats adding strings in a loop; itertools and collections are ready fast tools"],"frames":[[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["total = sum(x for x in xs)   # fast","total = 0","for x in xs: total += x   # slower"],"hl":[0],"lang":"python","size":10.5,"lh":28.0,"w":330.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["squares = [x * x for x in xs]","# faster than","# for x in xs: out.append(x * x)"],"hl":[0],"lang":"python","size":11.0,"lh":28.0,"w":320.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["text = ''.join(parts)      # one pass","# s += part in a loop — many copies"],"hl":[0],"lang":"python","size":11.0,"lh":30.0,"w":330.0}]],"cues":[10.2,20.9]}]},{"title":"Caching","sub":"cache and lru_cache","short":"Cache","main":"A cache costs memory and risks staleness.","body":[{"t":"scene","labels":["Exponential","@cache","Careful"],"captions":["fib(n) = fib(n-1) + fib(n-2) recomputes the same things: the number of calls grows exponentially","@functools.cache remembers results of a pure function: calls now equal the number of n values — linear","A cache costs memory and risks stale values: limit its size, don't cache functions with side effects"],"frames":[[{"t":"cell","id":"t","x":180.0,"y":30.0,"w":50.0,"h":22.0,"text":"f(5)","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"a","x":120.0,"y":66.0,"w":50.0,"h":22.0,"text":"f(4)","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":240.0,"y":66.0,"w":50.0,"h":22.0,"text":"f(3)","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":90.0,"y":102.0,"w":50.0,"h":22.0,"text":"f(3)","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"d","x":150.0,"y":102.0,"w":50.0,"h":22.0,"text":"f(2)","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"e","x":210.0,"y":102.0,"w":50.0,"h":22.0,"text":"f(2)","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"f","x":270.0,"y":102.0,"w":50.0,"h":22.0,"text":"f(1)","tone":"red","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":144.0,"text":"the same thing — again","tone":"red","size":10.0}],[{"t":"code","id":"c~code","x":30.0,"y":56.0,"lines":["@functools.cache","def fib(n):","    return n if n < 2 else fib(n-1) + fib(n-2)"],"hl":[0],"lang":"python","size":10.5,"lh":28.0,"w":330.0}],[{"t":"code","id":"c~code","x":30.0,"y":56.0,"lines":["@lru_cache(maxsize=1024)    # bounded","def load(key): ...","load.cache_clear()          # reset"],"hl":[0,2],"lang":"python","size":10.5,"lh":28.0,"w":330.0}]],"cues":[14.6,23.5]}]},{"title":"Input and output","sub":"Buffer, batches, concurrency","short":"I/O","main":"Often matters more than computation.","body":[{"t":"scene","labels":["Buffer","N+1","Concurrently"],"captions":["Buffered line-by-line reading is efficient, byte by byte is not; write in big chunks","N+1: a query per record; replace with a single batch query","Run independent network requests concurrently with asyncio; first check the profile for waiting"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"byte by byte","tone":"red","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":130.0,"h":30.0,"text":"big blocks","tone":"green","size":11.0,"sub_size":8.5}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["for user in users:","    db.get(user.id)       # N queries","db.get_many(ids)           # 1 query"],"hl":[1,2],"lang":"python","size":11.0,"lh":28.0,"w":320.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["results = await asyncio.gather(","    *(fetch(u) for u in urls))"],"hl":[0,1],"lang":"python","size":11.5,"lh":30.0,"w":320.0}]],"cues":[9.1,25.4]}]},{"title":"Vectorization","sub":"NumPy and compilers","short":"Vectorization","main":"The loop runs in C.","body":[{"t":"scene","labels":["Python loop","Vectorization","When to use"],"captions":["A Python loop over a million numbers — every step goes through the interpreter","NumPy and pandas run the operation on a whole array: the loop runs in C, tens to hundreds of times faster","Numba, Cython, C and Rust extensions, PyPy — when the profile shows one small hot spot"],"frames":[[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["out = []","for x in data:          # 1,000,000 times","    out.append(x * 2 + 1)"],"hl":[1],"lang":"python","size":11.5,"lh":28.0,"w":320.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["import numpy as np","arr = np.asarray(data)","out = arr * 2 + 1       # loop — in C"],"hl":[2],"lang":"pyt