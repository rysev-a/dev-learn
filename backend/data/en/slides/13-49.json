unter() — a monotonic high-resolution clock for rough estimates","timeit runs the code many times and turns off the garbage collector while measuring","Repeat the series and take the minimum: it has the least noise; compare on the same data"],"frames":[[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["t0 = time.perf_counter()","work()","dt = time.perf_counter() - t0"],"hl":[0,2],"lang":"python","size":11.5,"lh":26.0,"w":320.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["import timeit","timeit.timeit('sum(range(1000))',","              number=10_000)"],"hl":[1,2],"lang":"python","size":11.5,"lh":26.0,"w":320.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["times = timeit.repeat(stmt, repeat=5, number=1000)","best = min(times)   # less noise"],"hl":[1],"lang":"python","size":10.5,"lh":30.0,"w":330.0}]],"cues":[10.2,28.6]}]},{"title":"Microbenchmark traps","sub":"What distorts results","short":"Traps","main":"Look at the share in the profile.","body":[{"t":"scene","labels":["Constants","Caches","Scale"],"captions":["The compiler computes constant expressions ahead of time — you measured nothing","Processor and interpreter caches make the second run faster than the first","A 20% gain in a function taking 2% of the time speeds the program up by 0.4% — look at the profile share"],"frames":[[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["timeit('2 ** 20')   # = LOAD_CONST","# measured nothing"],"bad":[0],"lang":"python","size":11.5,"lh":28.0,"w":300.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"1st run","tone":"red","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":110.0,"h":30.0,"text":"2nd faster","tone":"green","size":11.0,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":70.0,"x2":214.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":120.0,"h":30.0,"text":"share 2%","tone":"muted","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":130.0,"