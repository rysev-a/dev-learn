"Iterator","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"From","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"Default","tone":"blue","size":10.5,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["use std::collections::HashMap;","use std::fs;","use std::time::Duration;"],"lang":"rust","size":11.0,"lh":26.0,"w":340.0}]],"cues":[12.6,24.1]}]},{"title":"Module map","sub":"What lies where","short":"Modules","main":"Data, I/O, system modules.","body":[{"t":"scene","labels":["Data","I/O","System"],"captions":["std::collections, std::string, std::vec, std::option, std::result, std::iter","std::io, std::fs, std::path, std::net","std::thread, std::sync, std::time, std::env, std::process, std::mem, std::rc, std::cell"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"collections","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"string","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"option","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"iter","tone":"blue","size":8.5,"sub_size":8.5}],[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"io","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"fs","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"path","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"net","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"thread","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"sync","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"time","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"process","tone":"yellow","size":9.5,"sub_size":8.5}]],"cues":[12.8,28.4]}]},{"title":"Option","sub":"Combinators","short":"Option","main":"map, and_then, filter, unwrap_or*, ok_or, take.","body":[{"t":"scene","labels":["map and and_then","unwrap_or…","ok_or, take"],"captions":["map applies a function to the value inside; and_then chains operations returning Option; filter","unwrap_or, unwrap_or_else (lazy), unwrap_or_default; as_ref and as_mut — Option<&T>","ok_or(err) → Result; take() pulls the value out, leaving None; copied and cloned — from Option<&T>"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["x.map(|v| v + 1)","x.and_then(|v| v.checked_mul(2))","x.filter(|v| *v > 0)"],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["x.unwrap_or(0)","x.unwrap_or_else(|| compute())","x.unwrap_or_default()"],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["x.ok_or(\"none\")        // Result","x.take()               // None remains","v.first().copied()"],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}]],"cues":[12.8,29.0]}]},{"title":"Result","sub":"Combinators","short":"Result","main":"map_err, and_then, ok, ?, From.","body":[{"t":"scene","labels":["map_err","ok() and err()","? and From"],"captions":["map_err transforms the error; and_then chains; or_else substitutes another Result","ok() makes an Option from a Result, ok_or — the other way; unwrap_or_default; expect(\"msg\") — only in examples","The ? operator returns the error upward and applies From: different error types merge"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["r.map_err(|e| e.to_string())","r.and_then(next_step)","r.or_else(fallback)"],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["r.ok()               // Option<T>","r.unwrap_or_default()","r.expect(\"file must exist\")"],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["fn f() -> Result<i32, MyError> {","    let n: i32 = s.parse()?;   // From<ParseIntError>","    Ok(n)","}"],"hl":[1],"lang":"rust","size":9.0,"lh":22.0,"w":340.0}]],"cues":[14.8,31.9]}]},{"title":"Method names","sub":"as_, to_, into_","short":"Names","main":"Prefixes and suffixes tell cost and ownership.","body":[{"t":"scene","labels":["as_, to_, into_","is_, try_","_mut"],"captions":["as_ — cheap reference to reference; to_ — new value (maybe expensive); into_ — takes ownership","is_ asks a question (bool); try_ may fail and returns Result or Option","The _mut suffix — mutable version: iter_mut, get_mut; the cost is visible in the name"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"as_str","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"to_string","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"into_iter","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"is_empty","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"try_from","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"is_ok","tone":"blue","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["v.iter()       // &T","v.iter_mut()   // &mut T","v.into_iter()  // T"],"lang":"rust","size":11.0,"lh":24.0,"w":340.0}]],"cues":[11.0,25.1]}]},{"title":"std::mem","sub":"swap, replace, take","short":"mem","main":"Pull a value out of &mut; sizes.","body":[{"t":"scene","labels":["swap","replace and take","size_of, drop"],"captions":["mem::swap(&mut a, &mut b) swaps without copying","replace(&mut x, new) returns the old one; take(&mut x) leaves Default — pull out of &mut","size_of and align_of — sizes; drop — free early; forget — almost never"],"frames":[[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["std::mem::swap(&mut a, &mut b);"],"hl":[0],"lang":"rust","size":11.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let old = mem::replace(&mut s, new_s);","let items = mem::take(&mut self.items);"],"lang":"rust","size":9.5,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["mem::size_of::<T>()","drop(x);   // ahead of time"],"lang":"rust","size":11.5,"lh":28.0,"w":340.0}]],"cues":[16.4,26.7]}]},{"title":"std::cmp","sub":"Comparison","short":"cmp","main":"min, max, clamp, Ordering, then, Reverse.","body":[{"t":"scene","labels":["min, max, clamp","Ordering and then","Reverse"],"captions":["cmp::min(a, b), cmp::max, x.clamp(lo, hi) — for any ordered values","Ordering: Less, Equal, Greater; a.cmp(&b).then(c.cmp(&d)) — comparing by several fields","Reverse flips the order: descending sort and a min-heap; f64 — total_cmp"],"frames":[[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["cmp::max(3, 7)","x.clamp(0, 10)"],"lang":"rust","size":12.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["a.age.cmp(&b.age)","    .then(a.name.cmp(&b.name))"],"hl":[1],"lang":"rust","size":11.0,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["v.sort_by_key(|x| Reverse(*x));","xs.sort_by(|a, b| a.total_cmp(b));"],"lang":"rust","size":10.0,"lh":26.0,"w":340.0}]],"cues":[9.6,24.0]}]},{"title":"std::convert","sub":"From, Into, AsRef","short":"convert","main":"One shape for conversions; FromStr and Display.","body":[{"t":"scene","labels":["From and Into","AsRef","FromStr"],"captions":["Implement From<A> for B — you get Into for free: let b: B = a.into();","fn f(p: impl AsRef<str>) and impl Into<String> — accept any form of string","FromStr gives \"…\".parse::<T>() for your type; Display gives to_string()"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["impl From<Celsius> for Kelvin { … }","let k: Kelvin = c.into();"],"hl":[1],"lang":"rust","size":10.0,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["fn open(p: impl AsRef<Path>) { … }","fn name(s: impl Into<String>) { … }"],"lang":"rust","size":10.0,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["impl FromStr for Point { … }","let p: Point = \"1,2\".parse().unwrap();"],"hl":[1],"lang":"rust","size":9.5,"lh":26.0,"w":340.0}]],"cues":[11.1,30.0]}]},{"title":"std::iter","sub":"Iterator constructors","short":"iter","main":"once, repeat, successors, from_fn; adapters and consumers.","body":[{"t":"scene","labels":["once, repeat, empty","successors, from_fn","Adapters and consumers"],"captions":["iter::once(x), repeat(x), empty() — small building blocks","successors(Some(1), |&x| Some(x * 2)) — a “next from previous” sequence; from_fn calls a closure on every step","chain, zip, cycle, skip, take, step_by — adapters; sum, product, count, last, min, max, fold, collect — consumers"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"once","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"repeat","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"empty","tone":"blue","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["iter::successors(Some(1), |&x| Some(x * 2))","    .take(5)   // 1 2 4 8 16"],"hl":[0],"lang":"rust","size":8.5,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["a.iter().chain(b.iter()).zip(c.iter())","    .skip(1).take(3).sum::<i32>()"],"lang":"rust","size":9.0,"lh":26.0,"w":340.0}]],"cues":[20.2,25.1]}]},{"title":"env, process, docs","sub":"Environment","short":"Environment","main":"args, var, exit, Command; rustup doc.","body":[{"t":"scene","labels":["env","process","Docs"],"captions":["env::args() — command-line arguments, env::var(\"HOME\") — environment variables","process::exit(code) ends the program; Command::new(\"ls\") launches other programs","rustup doc opens the docs locally; doc.rust-lang.org/std has search; its examples run as tests"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let args: Vec<String> = env::args().collect();","let home = env::var(\"HOME\");"],"lang":"rust","size":9.0,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["process::exit(1);","Command::new(\"ls\").arg(\"-l\").status()"],"lang":"rust","size":10.0,"lh":26.0,"w":340.0}],[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":240.0,"h":34.0,"text":"$ rustup doc --std","tone":"yellow","size":11.5,"sub_size":8.5}]],"cues":[16.4,31.2]}]},{"title":"Summary","sub":"What's next","short":"Summary","main":"Next — collections.","body":[{"t":"scene","labels":["Remember","Tools","Next"],"captions":["core, alloc, std; the prelude; method names hint at cost and ownership","Option and Result — combinators; mem, cmp, convert, iter — daily modules","Next chapter — collections: Vec, VecDeque, HashMap, BTreeMap, BinaryHeap and choosing between them"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"core","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"alloc","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"std","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"prelude","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"Option","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"mem","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"cmp","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"iter","tone":"blue","size":10.5,"sub_size":8.5}],[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":250.0,"h":34.0,"text":"Vec · VecDeque · HashMap · BTreeMap · BinaryHeap","tone":"blue","size":8.5,"sub_size":8.5}]],"cues":[11.6,25.1]}]}]}