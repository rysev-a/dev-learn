,"y":76.0,"text":"hinted\nhandoff","size":9.5}]],"cues":[6.1,20.6]}]},{"title":"Time","sub":"Clocks and Lamport","short":"Time","main":"Don't trust clocks: logical clocks set the order.","body":[{"t":"scene","labels":["Clocks lie","Lamport clock","Hybrid clocks"],"captions":["Clocks drift and sometimes jump backwards: timestamps can't reliably tell which write is newer","Lamport: +1 on send; on receive max(own, received) + 1, so a cause has the smaller number","Hybrid clocks combine physical time and a logical counter; Spanner waits out the clock error"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":100.0,"h":28.0,"text":"node A\n10:00:00.000","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":100.0,"h":28.0,"text":"node B\n10:00:00.250","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":120.0,"text":"drift 250 ms","tone":"red","size":9.5}],[{"t":"line","id":"al","x1":46.0,"y1":50.0,"x2":346.0,"y2":50.0,"tone":"muted","width":1.2},{"t":"text","id":"an","x":20.0,"y":50.0,"text":"A","size":9.0,"mono":true},{"t":"line","id":"bl","x1":46.0,"y1":110.0,"x2":346.0,"y2":110.0,"tone":"muted","width":1.2},{"t":"text","id":"bn","x":20.0,"y":110.0,"text":"B","size":9.0,"mono":true},{"t":"cell","id":"a1","x":100.0,"y":50.0,"w":30.0,"h":22.0,"text":"1","tone":"blue","size":8.0,"sub_size":8.5},{"t":"cell","id":"a2","x":160.0,"y":50.0,"w":44.0,"h":22.0,"text":"2 send","tone":"green","size":8.0,"sub_size":8.5},{"t":"cell","id":"b1","x":230.0,"y":110.0,"w":78.0,"h":22.0,"text":"max(0,2)+1=3","tone":"green","size":8.0,"sub_size":8.5},{"t":"cell","id":"b2","x":310.0,"y":110.0,"w":30.0,"h":22.0,"text":"4","tone":"blue","size":8.0,"sub_size":8.5},{"t":"line","id":"e","x1":168.0,"y1":60.0,"x2":224.0,"y2":100.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":28.0,"text":"(physical, counter)","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":104.0,"w