 copy","short":"Linearizability","main":"The strongest guarantee; the price is latency and unavailability.","body":[{"t":"scene","labels":["One copy","Write completed","Price"],"captions":["Linearizability: the system behaves as one copy, and each operation takes effect instantly between its start and end","Write completed: any read that started later must see it","A strong guarantee needs node coordination: latency and unavailability during a partition"],"frames":[[{"t":"cell","id":"r","x":180.0,"y":76.0,"w":100.0,"h":40.0,"text":"one\nvariable","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"a","x":70.0,"y":40.0,"w":66.0,"h":28.0,"text":"client 1","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":70.0,"y":112.0,"w":66.0,"h":28.0,"text":"client 2","tone":"blue","size":9.0,"sub_size":8.5},{"t":"line","id":"e1","x1":104.0,"y1":46.0,"x2":130.0,"y2":66.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":104.0,"y1":106.0,"x2":130.0,"y2":86.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"line","id":"c1l","x1":46.0,"y1":50.0,"x2":346.0,"y2":50.0,"tone":"muted","width":1.2},{"t":"text","id":"c1n","x":20.0,"y":50.0,"text":"W","size":9.0,"mono":true},{"t":"line","id":"c2l","x1":46.0,"y1":110.0,"x2":346.0,"y2":110.0,"tone":"muted","width":1.2},{"t":"text","id":"c2n","x":20.0,"y":110.0,"text":"R","size":9.0,"mono":true},{"t":"cell","id":"w","x":110.0,"y":50.0,"w":56.0,"h":22.0,"text":"write 5","tone":"green","size":8.0,"sub_size":8.5},{"t":"cell","id":"r","x":250.0,"y":110.0,"w":56.0,"h":22.0,"text":"read → 5","tone":"green","size":8.0,"sub_size":8.5},{"t":"text","id":"n","x":190.0,"y":146.0,"text":"read after write sees 5","tone":"green","size":9.5}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"strict\nguarantee","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":110.0,"h":30.0,"text":"latency and\nunavailability","tone":"red","size":9.5,"sub_size":8.5},{"t":"line","id"