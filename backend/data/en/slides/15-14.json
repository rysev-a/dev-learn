":140.0,"h":26.0,"text":"GET /items?page=2","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"r","x":270.0,"y":40.0,"w":140.0,"h":26.0,"text":"items[…], next: 3","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"v","x":90.0,"y":85.0,"w":140.0,"h":26.0,"text":"/v2/orders","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"text","id":"t2","x":270.0,"y":85.0,"text":"version in the path","tone":"yellow","size":9.0},{"t":"cell","id":"k","x":90.0,"y":130.0,"w":140.0,"h":26.0,"text":"Idempotency-Key: 7f3a","tone":"red","size":8.5,"sub_size":8.5},{"t":"text","id":"t3","x":270.0,"y":130.0,"text":"retry → same result","tone":"red","size":9.0}],[{"t":"cell","id":"l","x":90.0,"y":40.0,"w":140.0,"h":26.0,"text":"GET /items?page=2","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"r","x":270.0,"y":40.0,"w":140.0,"h":26.0,"text":"items[…], next: 3","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"v","x":90.0,"y":85.0,"w":140.0,"h":26.0,"text":"/v2/orders","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"text","id":"t2","x":270.0,"y":85.0,"text":"version in the path","tone":"yellow","size":9.0},{"t":"cell","id":"k","x":90.0,"y":130.0,"w":140.0,"h":26.0,"text":"Idempotency-Key: 7f3a","tone":"red","size":8.5,"sub_size":8.5},{"t":"text","id":"t3","x":270.0,"y":130.0,"text":"retry → same result","tone":"red","size":9.0},{"t":"text","id":"t4","x":180.0,"y":160.0,"text":"response lost: no duplicate","tone":"green","size":8.5}]],"cues":[14.6,18.0,31.8]},{"t":"note","text":"POST is not idempotent, so the key matters most for it."}]},{"title":"Tokens and limits","sub":"Who and how often","short":"Tokens and limits","main":"Bearer token, 401 and 403, a token bucket with 429 and Retry-After, exponential backoff.","body":[{"t":"scene","labels":["Token","401 and 403","Limits","Retries"],"captions":["The client sends a bearer token in the Authorization header","No token: 401; a token but no rights: 403","A token bucket limits the rate: empty means 429 and Ret