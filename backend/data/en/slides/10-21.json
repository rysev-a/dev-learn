:"green","size":9.5}],[{"t":"cell","id":"a","x":80.0,"y":60.0,"w":110.0,"h":34.0,"text":"Borrowed(&str)","tone":"green","size":9.0,"sub_size":8.5},{"t":"line","id":"e","x1":138.0,"y1":60.0,"x2":218.0,"y2":60.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"text","id":"t","x":180.0,"y":44.0,"text":".to_mut()","size":9.0,"mono":true},{"t":"cell","id":"b","x":290.0,"y":60.0,"w":110.0,"h":34.0,"text":"Owned(String)","tone":"yellow","size":9.0,"sub_size":8.5}],[{"t":"code","id":"c~code","x":14.0,"y":36.0,"lines":["fn clean(s: &str) -> Cow<str> {","    if s.contains('\\t') {","        Cow::Owned(s.replace('\\t', \" \"))","    } else {","        Cow::Borrowed(s)","    }","}"],"hl":[2,4],"lang":"rust","size":9.0,"lh":16.0,"w":350.0}]],"cues":[9.8,28.6]}]},{"title":"Sizes and mem::replace","sub":"What lies on the stack","short":"Sizes","main":"8 bytes for plain pointers, 16 for fat ones; replace and take help without copies.","body":[{"t":"scene","labels":["Pointer sizes","Rc block","mem::replace"],"captions":["&T, Box<T>, Rc<T>, Arc<T> — 8 bytes each; &[T], &str, &dyn Trait, Box<dyn Trait> — 16; Option<Rc<T>> is no bigger than Rc<T>","Rc<T> points to a heap block: the strong counter, the weak counter and the value itself","mem::replace and mem::take pull a value out from behind &mut, leaving a replacement — no copies and no unsafe"],"frames":[[{"t":"bar","id":"b0","x":50.0,"y":120.0,"w":34.0,"hh":40.0,"max":100.0,"tone":"blue","text":"8"},{"t":"text","id":"l0","x":50.0,"y":142.0,"text":"&T","size":7.5,"mono":true},{"t":"bar","id":"b1","x":116.0,"y":120.0,"w":34.0,"hh":40.0,"max":100.0,"tone":"blue","text":"8"},{"t":"text","id":"l1","x":116.0,"y":142.0,"text":"Box<T>","size":7.5,"mono":true},{"t":"bar","id":"b2","x":182.0,"y":120.0,"w":34.0,"hh":40.0,"max":100.0,"tone":"blue","text":"8"},{"t":"text","id":"l2","x":182.0,"y":142.0,"text":"Rc<T>","size":7.5,"mono":true},{"t":"bar","id":"b3","x":248.0,"y":120.0,"w":34.0,"hh":80.0,"max":100.0,"tone":"yellow","text":"16"},{"t":"t