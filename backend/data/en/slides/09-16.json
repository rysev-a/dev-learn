:true,"width":1.6},{"t":"line","id":"a3","x1":180.0,"y1":107.0,"x2":180.0,"y2":123.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[11.8,23.6]}]},{"title":"Changing and dropping","sub":"No OR REPLACE","short":"Changing","main":"In SQLite you change a view with DROP VIEW and CREATE VIEW again.","body":[{"t":"scene","labels":["No OR REPLACE","In a transaction","Migration file"],"captions":["SQLite has no ALTER VIEW or CREATE OR REPLACE","Drop and create again — in one transaction, so nobody notices a gap","Keep the definition in a migration file — easier to edit from there"],"frames":[[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["CREATE OR REPLACE VIEW v AS …;","ALTER VIEW v …;"],"bad":[0,1],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"e","x":180.0,"y":110.0,"w":240.0,"h":26.0,"text":"not supported in SQLite","tone":"red","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["BEGIN;","DROP VIEW IF EXISTS v;","CREATE VIEW v AS SELECT …;","COMMIT;"],"hl":[1,2],"lang":"sql","size":10.0,"lh":13.0,"w":340.0}],[{"t":"cell","id":"f","x":70.0,"y":70.0,"w":120.0,"h":30.0,"text":"views/v.sql","tone":"green","size":10.0,"sub_size":8.5},{"t":"line","id":"e~line","x1":130.0,"y1":70.0,"x2":170.0,"y2":70.0,"tone":"muted","arrow":true,"width":1.6},{"t":"cell","id":"db","x":260.0,"y":70.0,"w":140.0,"h":30.0,"text":"database","tone":"blue","size":10.0,"sub_size":8.5}]],"cues":[11.2,22.4]}]},{"title":"Writing via VIEW","sub":"Read-only","short":"Writing","main":"In SQLite views are read-only; writing goes through INSTEAD OF triggers.","body":[{"t":"scene","labels":["Read-only","INSTEAD OF","Other DBMSs"],"captions":["INSERT and UPDATE on a view fail in SQLite","An INSTEAD OF trigger intercepts the operation and runs commands on the tables","Simple single-table views in other DBMSs are updated automatically"],"frames":[[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["INSERT INTO v_customer_totals VALUES (…);"],"bad":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"e","x":180.0,"y":100.0,"w":260.0,"h":26.0,"text":"cannot modify v — it is a view","tone":"red","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["CREATE TRIGGER v_ins INSTEAD OF INSERT","ON v BEGIN","  INSERT INTO customers (name) VALUES (NEW.name);","END;"],"hl":[0,2],"lang":"sql","size":9.0,"lh":13.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":40.0,"text":"simple view:\nauto-update","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":150.0,"h":40.0,"text":"JOIN and GROUP BY:\nimpossible","tone":"red","size":9.0,"sub_size":8.5}]],"cues":[12.9,25.7]}]},{"title":"Speed","sub":"Inlining","short":"Speed","main":"A query to a VIEW expands into a query to the tables: indexes work.","body":[{"t":"scene","labels":["Inlining","Condition inside","Aggregates"],"captions":["A query to a view expands into a query to the tables — indexes work","A condition from the outer query is usually pushed inside and cuts work","With GROUP BY or a window inside, pushdown doesn't always work — check the plan"],"frames":[[{"t":"cell","id":"a","x":70.0,"y":70.0,"w":100.0,"h":34.0,"text":"SELECT …\nFROM v","tone":"blue","size":9.5,"sub_size":8.5},{"t":"line","id":"e","x1":122.0,"y1":70.0,"x2":138.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"b","x":250.0,"y":70.0,"w":160.0,"h":34.0,"text":"query to tables\nwith their indexes","tone":"green","size":9.0,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["SELECT * FROM v_orders WHERE cust = 5;"],"hl":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"g","x":180.0,"y":100.0,"w":280.0,"h":26.0,"text":"→ WHERE cust = 5 inside the plan","tone":"green","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["EXPLAIN QUERY PLAN","SELECT * FROM v_totals WHERE cust = 5;"],"hl":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"text","id":"n","x":180.0,"y":100.0,"text":"check the plan of a VIEW query","tone":"yellow","size":10.0}]],"cues":[12.1,24.3]}]},{"title":"Limitations","sub":"Keep in mind","short":"Limits","main":"A star in a VIEW is dangerous; changing tables can break a view.","body":[{"t":"scene","labels":["Star","Broken reference","ORDER BY inside"],"captions":["SELECT * expands at creation: a new table column won't appear in the view","Renamed or dropped a column — querying the VIEW gives an error","ORDER BY inside a view is usually pointless: the caller sets the order"],"frames":[[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["CREATE VIEW v AS SELECT * FROM t;","ALTER TABLE t ADD COLUMN extra …;"],"hl":[0],"lang":"sql","size":9.5,"lh":14.0,"w":340.0},{"t":"cell","id":"e","x":180.0,"y":100.0,"w":250.0,"h":26.0,"text":"extra won't appear in v","tone":"yellow","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["ALTER TABLE t DROP COLUMN old;","SELECT * FROM v;"],"bad":[1],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"e","x":180.0,"y":100.0,"w":250.0,"h":26.0,"text":"no such column: old","tone":"red","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["CREATE VIEW v AS SELECT … ORDER BY name;"],"bad":[0],"lang":"sql","size":9.5,"lh":14.0,"w":340.0},{"t":"text","id":"n","x":180.0,"y":100.0,"text":"write ORDER BY in the VIEW query","tone":"yellow","size":10.0}]],"cues":[12.4,24.8]}]},{"title":"Practice","sub":"Conventions","short":"Practice","main":"Prefix in the name, explicit columns, query text in a migration file.","body":[{"t":"scene","labels":["Names","Explicit columns","Don't overuse"],"captions":["Prefix v_ and a meaningful name: v_active_customers, v_revenue_by_month","List columns explicitly and give clear aliases","If a query is needed once — a CTE is enough, no view needed"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":150.0,"h":28.0,"text":"v_active_customers","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":150.0,"h":28.0,"text":"v_revenue_by_month","tone":"green","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"name shows it's not a table","size":9.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["CREATE VIEW v_orders AS","SELECT o.id, o.created, c.name AS customer,","       o.total","FROM orders o JOIN customers c ON c.id = o.cust;"],"hl":[1,2],"lang":"sql","size":9.5,"lh":13.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":36.0,"text":"one-off:\nWITH (CTE)","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":150.0,"h":36.0,"text":"reused:\nVIEW","tone":"green","size":10.0,"sub_size":8.5}]],"cues":[12.5,25.0]}]},{"title":"What next","sub":"Part summary: \"SQL basics\"","short":"Next","main":"You have the whole SQL toolkit; next — how databases work inside.","body":[{"t":"scene","labels":["Queries","Data and structure","Next"],"captions":["SELECT, WHERE, ORDER BY, GROUP BY, JOIN, subqueries, CTE, windows","INSERT, UPDATE, DELETE, transactions, CREATE, ALTER, indexes, views","Next — how it all works inside: storage, transactions, optimizer"],"frames":[[{"t":"cell","id":"a","x":65.0,"y":50.0,"w":110.0,"h":26.0,"text":"SELECT WHERE","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":50.0,"w":110.0,"h":26.0,"text":"GROUP BY HAVING","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"c","x":295.0,"y":50.0,"w":110.0,"h":26.0,"text":"JOIN","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"d","x":122.0,"y":96.0,"w":110.0,"h":26.0,"text":"subqueries CTE","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"e","x":238.0,"y":96.0,"w":110.0,"h":26.0,"text":"windows","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":65.0,"y":50.0,"w":110.0,"h":26.0,"text":"INSERT UPDATE","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":50.0,"w":110.0,"h":26.0,"text":"transactions","