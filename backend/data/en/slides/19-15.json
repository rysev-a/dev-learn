,26.1]}]},{"title":"ext4 and XFS","sub":"Chapter 15 · Storage","short":"ext4/XFS","main":"Both journal; they differ in inodes, tools, and resizing.","body":[{"t":"scene","labels":["ext4","XFS","ext4: inodes","XFS: inodes"],"captions":["ext4: usually the default on Debian and Ubuntu; tune2fs, e2fsck","XFS: usually the default in the RHEL family; xfs_admin, xfs_repair","ext4: the inode count is set at mkfs, 5% of blocks reserved for root","XFS: inodes are created as needed, capped by imaxpct"],"frames":[[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"ext4\nDebian/Ubuntu","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"ext4\nDebian/Ubuntu","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"XFS\nRHEL family","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"ext4\nDebian/Ubuntu","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"XFS\nRHEL family","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":95.0,"y":110.0,"w":158.0,"h":46.0,"text":"inodes fixed\nat mkfs","tone":"yellow","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"ext4\nDebian/Ubuntu","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"XFS\nRHEL family","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":95.0,"y":110.0,"w":158.0,"h":46.0,"text":"inodes fixed\nat mkfs","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":265.0,"y":110.0,"w":158.0,"h":46.0,"text":"inodes grow,\nup to imaxpct","tone":"green","size":9.0,"sub_size":8.5}]],"cues":[8.9,18.2,27.7]}]},{"title":"Growing and shrinking","sub":"Chapter 15 · Storage","short":"Resize","main":"Grow the partition, then the FS; shrink the FS, then the par