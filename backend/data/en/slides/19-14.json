ode","id":"c","x":20.0,"y":24.0,"lines":["network:","  version: 2","  renderer: networkd","  ethernets:","    enp1s0:","      addresses: [10.0.0.5/24]","      routes:","        - {to: default, via: 10.0.0.1}","      nameservers: {addresses: [1.1.1.1]}"],"hl":[1,2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["network:","  version: 2","  renderer: networkd","  ethernets:","    enp1s0:","      addresses: [10.0.0.5/24]","      routes:","        - {to: default, via: 10.0.0.1}","      nameservers: {addresses: [1.1.1.1]}"],"hl":[3,4,5],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["network:","  version: 2","  renderer: networkd","  ethernets:","    enp1s0:","      addresses: [10.0.0.5/24]","      routes:","        - {to: default, via: 10.0.0.1}","      nameservers: {addresses: [1.1.1.1]}"],"hl":[6,7],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["network:","  version: 2","  renderer: networkd","  ethernets:","    enp1s0:","      addresses: [10.0.0.5/24]","      routes:","        - {to: default, via: 10.0.0.1}","      nameservers: {addresses: [1.1.1.1]}"],"hl":[8],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[10.2,19.8,30.2]}]},{"title":"File merge order","sub":"Chapter 14 · Linux networking","short":"Merging","main":"A same-name file is shadowed, the others go by name and add up.","body":[{"t":"scene","labels":["Shadowing","Order","Rules","Strings"],"captions":["The same name in /run shadows /etc, and /etc shadows /lib","Different names go by name order, the directory does not matter","Scalars are overwritten, lists concatenated, mappings merged","Names compare as strings: 10-x comes before 9-y"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["/lib/netplan/00-base.yaml","/etc/netplan/50-cloud-init.yaml","/etc/netplan/60-extra.yaml","/run/netplan/60-extra.yaml","  -> /run file wins, /etc one is gone","scalar: the later value wins","list: [A] + [B] = [A, B]","mapping: merged key by key","'10-x' sorts before '9-y'"],"hl":[2,3,4],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["/lib/netplan/00-base.yaml","/etc/netplan/50-cloud-init.yaml","/etc/netplan/60-extra.yaml","/run/netplan/60-extra.yaml","  -> /run file wins, /etc one is gone","scalar: the later value wins","list: [A] + [B] = [A, B]","mapping: merged key by key","'10-x' sorts before '9-y'"],"hl":[0,1,2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["/lib/netplan/00-base.yaml","/etc/netplan/50-cloud-init.yaml","/etc/netplan/60-extra.yaml","/run/netplan/60-extra.yaml","  -> /run file wins, /etc one is gone","scalar: the later value wins","list: [A] + [B] = [A, B]","mapping: merged key by key","'10-x' sorts before '9-y'"],"hl":[5,6,7],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["/lib/netplan/00-base.yaml","/etc/netplan/50-cloud-init.yaml","/etc/netplan/60-extra.yaml","/run/netplan/60-extra.yaml","  -> /run file wins, /etc one is gone","scalar: the later value wins","list: [A] + [B] = [A, B]","mapping: merged key by key","'10-x' sorts before '9-y'"],"hl":[8],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[10.3,21.8,32.7]}]},{"title":"netplan try: a safe change","sub":"Chapter 14 · Linux networking","short":"try","main":"Apply, wait for confirmation, otherwise roll back.","body":[{"t":"scene","labels":["try","Timer","Yes","No"],"captions":["netplan try applies the configuration and waits for confirmation","It waits 120 seconds by default, --timeout changes it","Confirmed in time: the new setup stays","Not confirmed or the session dropped: roll back to the old"],"frames":[[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"netplan\ntry","tone":"blue","size":8.5,"sub_size":8.5}],[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"t