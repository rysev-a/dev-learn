"w":58.0,"h":18.0,"text":"Peter","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"t-r1c1","x":138.0,"y":90.0,"w":54.0,"h":18.0,"text":"1","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"t-r1c2","x":226.0,"y":90.0,"w":118.0,"h":18.0,"text":"Olga/Peter","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"t-r2c0","x":80.0,"y":110.0,"w":58.0,"h":18.0,"text":"Sergey","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"t-r2c1","x":138.0,"y":110.0,"w":54.0,"h":18.0,"text":"2","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"t-r2c2","x":226.0,"y":110.0,"w":118.0,"h":18.0,"text":"Peter/Sergey","tone":"green","size":8.5,"sub_size":8.5}]],"cues":[11.8,23.6]}]},{"title":"Loop protection","sub":"UNION and a stop condition","short":"Protection","main":"UNION instead of UNION ALL and a stop condition guard against endless recursion.","body":[{"t":"scene","labels":["A cycle in data","Depth condition","UNION"],"captions":["If an employee reports to himself through a chain of managers, the recursion is endless","Depth condition: WHERE lvl < 20 — a guaranteed stop","UNION instead of UNION ALL drops repeats — the recursion stops by itself"],"frames":[[{"t":"cell","id":"a","x":110.0,"y":70.0,"w":70.0,"h":26.0,"text":"A → B","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":250.0,"y":70.0,"w":70.0,"h":26.0,"text":"B → A","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"line","id":"e1","x1":150.0,"y1":62.0,"x2":214.0,"y2":62.0,"tone":"red","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":214.0,"y1":80.0,"x2":150.0,"y2":80.0,"tone":"red","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":120.0,"text":"a circle: never ends","tone":"red","size":10.0}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["…","SELECT … FROM tree t JOIN emp e","  ON e.boss = t.id WHERE t.lvl < 20"],"hl":[2],"lang":"sql","size":10.0,"lh":14.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":36.0,"text":"UNION ALL:\nm