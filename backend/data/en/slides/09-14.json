[[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["WITH good AS (","  SELECT * FROM orders","  WHERE status IN ('paid', 'shipped')",")"],"hl":[0,3],"lang":"sql","size":10.0,"lh":13.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["WITH good AS (…),","sums AS (","  SELECT cust, SUM(total) AS s","  FROM good GROUP BY cust",")"],"hl":[1,4],"lang":"sql","size":10.0,"lh":13.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["WITH good AS (…), sums AS (…)","SELECT c.name, s.s","FROM sums s JOIN customers c","  ON c.id = s.cust;"],"hl":[1,2,3],"lang":"sql","size":10.0,"lh":13.0,"w":340.0},{"t":"cell","id":"g-h0","x":140.0,"y":100.0,"w":58.0,"h":18.0,"text":"name","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-h1","x":205.0,"y":100.0,"w":68.0,"h":18.0,"text":"s","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-r0c0","x":140.0,"y":120.0,"w":58.0,"h":18.0,"text":"Anna","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-r0c1","x":205.0,"y":120.0,"w":68.0,"h":18.0,"text":"84700","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-r1c0","x":140.0,"y":140.0,"w":58.0,"h":18.0,"text":"Boris","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-r1c1","x":205.0,"y":140.0,"w":68.0,"h":18.0,"text":"55400","tone":"green","size":8.5,"sub_size":8.5}]],"cues":[12.7,25.4]}]},{"title":"CTE vs subquery","sub":"Which is better","short":"CTE vs subquery","main":"A CTE reads better than a subquery and can be referenced many times.","body":[{"t":"scene","labels":["Subquery","CTE","Twice"],"captions":["Subquery in FROM: read inside out, the text can't be reused","CTE: a name and top-to-bottom order","One expression is used several times; a subquery would be written twice"],"frames":[[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["SELECT * FROM (","  SELECT cust, SUM(total) AS s","  FROM orders GROUP BY cust) AS t","WHERE s > 50000;"],"hl":[1,2],"lang":"sql","size":10.0,"lh":13.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["WITH t AS (","  SELECT cust, SUM(total) AS s","  FROM orders GROUP BY cust)","SELECT * FROM t WHERE s > 50000;"],"hl":[3],"lang":"sql","size":10.0,"lh":13.0,"w":340.0}],[{"t":"cell","id":"t","x":180.0,"y":60.0,"w":100.0,"h":28.0,"text":"WITH t AS (…)","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"a","x":80.0,"y":110.0,"w":120.0,"h":26.0,"text":"FROM t  (use 1)","tone":"blue","size":8.0,"sub_size":8.5},{"t":"cell","id":"b","x":280.0,"y":110.0,"w":120.0,"h":26.0,"text":"JOIN t  (use 2)","tone":"blue","size":8.0,"sub_size":8.5},{"t":"line","id":"e1","x1":150.0,"y1":74.0,"x2":110.0,"y2":98.0,"tone":"muted","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":210.0,"y1":74.0,"x2":250.0,"y2":98.0,"tone":"muted","arrow":true,"width":1.6}]],"cues":[12.5,25.0]}]},{"title":"Reuse","sub":"One expression, twice","short":"Reuse","main":"One CTE can be used several times — e.g. to compare a value with the average.","body":[{"t":"scene","labels":["Totals","Average of the same totals","Above average"],"captions":["First compute the total for each customer — once","From the same expression, compute the average per customer: 49,400","Only customers with a total above average remain"],"frames":[[{"t":"cell","id":"g-h0","x":135.0,"y":50.0,"w":48.0,"h":18.0,"text":"cust","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-h1","x":200.0,"y":50.0,"w":78.0,"h":18.0,"text":"s","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-r0c0","x":135.0,"y":70.0,"w":48.0,"h":18.0,"text":"1","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-r0c1","x":200.0,"y":70.0,"w":78.0,"h":18.0,"text":"84700","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-r1c0","x":135.0,"y":90.0,"w":48.0,"h":18.0,"text":"2","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-r1c1","x":200.0,"y":90.0,"w":78.0,"h":18.0,"text":"59300","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-r2c0","x":135.0,"y":110.0,"w":48.0,