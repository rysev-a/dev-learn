ize":8.5},{"t":"cell","id":"g-r2c1","x":195.0,"y":136.0,"w":48.0,"h":18.0,"text":"1","tone":"blue","size":8.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["SELECT * FROM t","WHERE n >= 2 ORDER BY cust DESC;"],"hl":[1],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"g-h0","x":145.0,"y":76.0,"w":48.0,"h":18.0,"text":"cust","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-h1","x":195.0,"y":76.0,"w":48.0,"h":18.0,"text":"n","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-r0c0","x":145.0,"y":96.0,"w":48.0,"h":18.0,"text":"2","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-r0c1","x":195.0,"y":96.0,"w":48.0,"h":18.0,"text":"2","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-r1c0","x":145.0,"y":116.0,"w":48.0,"h":18.0,"text":"1","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"g-r1c1","x":195.0,"y":116.0,"w":48.0,"h":18.0,"text":"2","tone":"green","size":8.5,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":36.0,"text":"GROUP BY … HAVING\none formula","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":150.0,"h":36.0,"text":"CTE + WHERE\ntwo simple steps","tone":"green","size":9.5,"sub_size":8.5}]],"cues":[11.5,22.9]}]},{"title":"Recursive CTE","sub":"A query refers to itself","short":"Recursive","main":"A recursive CTE: a starting part UNION ALL a recursive part.","body":[{"t":"scene","labels":["Two parts","Repeat","Stop"],"captions":["The starting part gives the first rows, the recursive part the next ones from those obtained","The database repeats the recursive part while it returns new rows","When there are no new rows, the recursion ends"],"frames":[[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["WITH RECURSIVE r(n) AS (","  SELECT 1            -- start","  UNION ALL","  SELECT n + 1 FROM r WHERE n < 5",")"],"hl":[1,3],"lang":"sql","size":10.0,"lh":13.0,"w":340.0}],[{"t":"cell","id":"n1","x":90.0,"y":80.0,"w"