,"hl":[2,3],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["# 1 flush / quiesce the application","lvcreate -s -L 2G -n bk vg0/data","mount -o ro,nouuid /dev/vg0/bk /mnt/bk","rsync -a /mnt/bk/ /backup/data/","umount /mnt/bk; lvremove -y vg0/bk"],"hl":[4],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[8.4,17.6,27.9]}]},{"title":"restic and borg","sub":"Chapter 20 · Storage","short":"restic","main":"A repository, chunks without repeats, a snapshot per run.","body":[{"t":"scene","labels":["init","backup","snapshots","Key"],"captions":["init creates the repository: chunks are stored once and encrypted","backup takes a snapshot of the given directories","snapshots lists ID, time, host, and paths","The password is the key: without it the data is unreadable, store it apart"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["restic -r /srv/repo init","restic -r /srv/repo backup /srv/data","restic -r /srv/repo snapshots","ID        Time                 Host  Paths","40dc1520  2026-11-02 02:00:11  web1  /srv/data"],"hl":[0],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["restic -r /srv/repo init","restic -r /srv/repo backup /srv/data","restic -r /srv/repo snapshots","ID        Time                 Host  Paths","40dc1520  2026-11-02 02:00:11  web1  /srv/data"],"hl":[1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["restic -r /srv/repo init","restic -r /srv/repo backup /srv/data","restic -r /srv/repo snapshots","ID        Time                 Host  Paths","40dc1520  2026-11-02 02:00:11  web1  /srv/data"],"hl":[2,3,4],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["restic -r /srv/repo init","restic -r /srv/repo backup /srv/data","restic -r /srv/repo snapshots","ID        Time                 Host  Paths","40dc1520  2026-11-02 02:00:11  web1  /srv/data"],"hl":[0],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[11.2,19.4,26.5]}]},{"title":"Retention policy","sub":"Chapter 20 · Storage","short":"Retention","main":"forget with --keep-*, then prune; borg has prune and compact.","body":[{"t":"scene","labels":["Dry run","Rules","Space","borg"],"captions":["--dry-run shows what stays and what goes","The newest snapshot in each of the last N periods with snapshots","forget unlinks snapshots, --prune frees the space","borg prune skips the already kept, compact returns the space"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["restic forget --dry-run \\","  --keep-daily 7 --keep-weekly 4 \\","  --keep-monthly 6 --prune","borg prune --keep-daily 7 --list","borg compact"],"hl":[0],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["restic forget --dry-run \\","  --keep-daily 7 --keep-weekly 4 \\","  --keep-monthly 6 --prune","borg prune --keep-daily 7 --list","borg compact"],"hl":[1,2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["restic forget --dry-run \\","  --keep-daily 7 --keep-weekly 4 \\","  --keep-monthly 6 --prune","borg prune --keep-daily 7 --list","borg compact"],"hl":[2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["restic forget --dry-run \\","  --keep-daily 7 --keep-weekly 4 \\","  --keep-monthly 6 --prune","borg prune --keep-daily 7 --list","borg compact"],"hl":[3,4],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[7.2,18.8,27.7]}]},{"title":"Consistency and VMs","sub":"Chapter 20 · Storage","short":"Consistency","main":"A database dump, a failed dump fails the backup, a VM disk snapshot.","body":[{"t":"scene","labels":["Dump","Failure","VM","oVirt"],"captions":["Copy a database with its own tool, not as files on the fly","A failed dump must fail the backup, not yield an empty file","For a VM: snapshot the disk, copy, merge the snapshot","oVirt: the backup interface reads disks without stopping the VM"],"frames":[[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"dump the database\nwith its own tool","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"dump the database\nwith its own tool","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"failed dump =\nfailed backup","tone":"red","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"dump the database\nwith its own tool","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"failed dump =\nfailed backup","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":95.0,"y":110.0,"w":158.0,"h":46.0,"text":"VM: snapshot disk,\ncopy, merge","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"dump the database\nwith its own tool","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"failed dump =\nfailed backup","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":95.0,"y":110.0,"w":158.0,"h":46.0,"text":"VM: snapshot disk,\ncopy, merge","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":265.0,"y":110.0,"w":158.0,"h":46.0,"text":"oVirt: backup API,\nVM keeps running","tone":"green","size":9.0,"sub_size":8.5}]],"cues":[10.0,20.3,29.4]}]},{"title":"Restore test and schedule","sub":"Chapter 20 · Storage","short":"Test","main":"Restore, compare sums, time it, catch silence.","body":[{"t":"scene","labels":["Restore","Compare","Time it","Timer"],"captions":["Restore into an empty directory, not over live data","Compare checksums with the manifest taken at backup time","Write down the time: it is the real RTO","A timer with Persistent=true and an alert on missing messages"],"frames":[[{"t":"cel