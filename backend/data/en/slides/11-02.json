ze":8.5},{"t":"line","id":"e","x1":168.0,"y1":76.0,"x2":200.0,"y2":76.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["fs.readFile('a.txt', (err, data) => {","  console.log(data.length);","});","console.log('this first');"],"hl":[0,3],"lang":"js","size":10.0,"lh":20.0,"w":330.0}]],"cues":[21.9,26.0]}]},{"title":"Why JavaScript","sub":"Clean slate, closures, events","short":"Why JS","main":"JavaScript had no blocking libraries and already had an event model.","body":[{"t":"scene","labels":["Clean slate","Closures","Event model"],"captions":["First, the language had no blocking-I/O libraries: everything was written asynchronously from the start","Second, closures and functions as values kept callbacks short","Third, browser developers were used to events: a click, a load, a response — and V8 was the fastest engine"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":34.0,"text":"no blocking\nlibraries","tone":"green","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":270.0,"y":70.0,"text":"asynchronous\nfrom the start","size":11.0}],[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["server.on('request', (req, res) => {","  res.end('hello');","});"],"hl":[0],"lang":"js","size":10.0,"lh":22.0,"w":310.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":110.0,"h":28.0,"text":"click","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":98.0,"w":110.0,"h":28.0,"text":"load","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c~cell","x":270.0,"y":60.0,"w":110.0,"h":28.0,"text":"request","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"d","x":270.0,"y":98.0,"w":110.0,"h":28.0,"text":"data","tone":"green","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":140.0,"text":"browser → server: the same model","size":9.5}]],"cues":[14.7,28.5]}]},{"title":"npm and require","sub":"The package ecosystem","short":"npm","main":"A package manager and modules created the biggest ecosystem.","body":[{"t":"scene","labels":["npm, 2010","require","node_modules"],"captions":["In 2010 Isaac Schlueter released the npm package manager — and the ecosystem exploded","CommonJS modules: require loads a file, module.exports hands out what is needed","Every package lives in node_modules, dependencies install recursively — handy, but the trees grow"],"frames":[[{"t":"cell","id":"y","x":80.0,"y":60.0,"w":52.0,"h":22.0,"text":"2010","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"n","x":220.0,"y":60.0,"w":160.0,"h":30.0,"text":"npm install","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":110.0,"text":"hundreds of thousands of packages in a few years","size":9.5}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["// math.js","module.exports = { add };","","// app.js","const { add } = require('./math');"],"hl":[1,4],"lang":"js","size":10.0,"lh":20.0,"w":330.0}],[{"t":"cell","id":"a","x":180.0,"y":30.0,"w":110.0,"h":22.0,"text":"app","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":110.0,"y":70.0,"w":90.0,"h":22.0,"text":"express","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"c~cell","x":250.0,"y":70.0,"w":90.0,"h":22.0,"text":"lodash","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"d","x":70.0,"y":110.0,"w":60.0,"h":22.0,"text":"qs","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"e","x":150.0,"y":110.0,"w":70.0,"h":22.0,"text":"cookie","tone":"blue","size":9.0,"sub_size":8.5},{"t":"line","id":"e1","x1":150.0,"y1":40.0,"x2":130.0,"y2":58.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":210.0,"y1":40.0,"x2":230.0,"y2":58.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e3","x1":90.0,"y1":82.0,"x2":76.0,"y2":98.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e4","x1":130.0,"y1":82.0,"x2":150.0,"y2":98.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[17.3,31.6]}]},{"title":"Discontent","sub":"Joyent and rare releases","