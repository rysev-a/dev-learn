"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n~text","x":180.0,"y":118.0,"text":"January — August 2015","tone":"muted","size":9.5}]],"cues":[16.8,35.9]}]},{"title":"Split and foundation","sub":"Node.js Foundation, 2015","short":"Foundation","main":"The fork's pressure made Joyent open up governance.","body":[{"t":"scene","labels":["Fear of a split","Pressure on Joyent","Node.js Foundation"],"captions":["Some feared a split: two incompatible servers and double work for package authors","Others welcomed the pressure on Joyent — and it worked","In February 2015 Joyent and sponsors announced the Node.js Foundation under the Linux Foundation: governance was opening up"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":100.0,"h":36.0,"text":"Node.js\npackages","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":100.0,"h":36.0,"text":"io.js\npackages","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":70.0,"text":"×","tone":"red","size":22.0}],[{"t":"cell","id":"j","x":90.0,"y":70.0,"w":100.0,"h":36.0,"text":"Joyent","tone":"red","size":10.5,"sub_size":8.5},{"t":"line","id":"e","x1":140.0,"y1":70.0,"x2":214.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"i","x":270.0,"y":70.0,"w":100.0,"h":36.0,"text":"io.js","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":52.0,"text":"pressure","size":9.5}],[{"t":"cell","id":"f","x":180.0,"y":36.0,"w":200.0,"h":28.0,"text":"Node.js Foundation","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"s0","x":60.0,"y":100.0,"w":70.0,"h":24.0,"text":"IBM","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"s1","x":140.0,"y":100.0,"w":70.0,"h":24.0,"text":"Microsoft","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"s2","x":220.0,"y":100.0,"w":70.0,"h":24.0,"text":"PayPal","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"s3","x":300.0,"y":100.0,"w":70.0,"h":24.0,"text":"Intel","tone":"blue","size":9.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":144.0,"text":"under the Linux Foundation","tone":"muted","size":9.5}]],"cues":[13.9,29.9]}]},{"title":"Reunion","sub":"Node.js 4.0, September 2015","short":"Node 4.0","main":"The fork “lost” the name but won the ideas.","body":[{"t":"scene","labels":["The vote","Node.js 4.0","Version numbers"],"captions":["In May 2015 the io.js technical committee voted to merge with Node.js under the foundation","In September Node.js 4.0 came out: the io.js codebase, its semver and a new V8 — under the Node.js name","Numbers jumped from 0.12 straight to 4: the threes were taken by io.js"],"frames":[[{"t":"cell","id":"a","x":70.0,"y":60.0,"w":52.0,"h":22.0,"text":"May","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"v","x":220.0,"y":60.0,"w":200.0,"h":30.0,"text":"io.js TC vote","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"decision — to merge","size":10.0}],[{"t":"cell","id":"a","x":90.0,"y":50.0,"w":100.0,"h":26.0,"text":"Node.js 0.12","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":100.0,"w":100.0,"h":26.0,"text":"io.js 3.x","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"line","id":"e1","x1":140.0,"y1":62.0,"x2":224.0,"y2":80.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":140.0,"y1":90.0,"x2":224.0,"y2":84.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"cell","id":"c","x":290.0,"y":76.0,"w":110.0,"h":34.0,"text":"Node.js 4.0\nSeptember 2015","tone":"green","size":9.5,"sub_size":8.5}],[{"t":"cell","id":"v0","x":60.0,"y":70.0,"w":56.0,"h":28.0,"text":"0.10","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"v1","x":140.0,"y":70.0,"w":56.0,"h":28.0,"text":"0.12","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"v2","x":220.0,"y":70.0,"w":56.0,"h":28.0,"text":"4","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"v3","x":300.0,"y":70.0,"w":56.0,"h":28.0,"text":"5","tone":"blue","size":11.0,"sub_size":8.5},{"t":"text","id":"t","x":220.0,"y":114.0,"text":"1, 2, 3 — were io.js's","tone":"yellow","size":9.5}]],"cues":[14.1,30.1]}]},{"title":"Lessons","sub":"Fork, governance, foundation","short":"Lessons","main":"A fork is not a war but a tool.","body":[{"t":"scene","labels":["A fork is a tool","Governance is product","Foundation"],"captions":["A fork is a tool, not a war: the ability to copy the code forces the owner to change","Open rules and regular releases are part of the product: without them a project loses developers","A neutral foundation helps companies trust a project; so it was with LibreOffice, MariaDB, Jenkins"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":34.0,"text":"code copy","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":70.0,"x2":224.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"b","x":290.0,"y":70.0,"w":110.0,"h":34.0,"text":"owner\nchanges","tone":"green","size":9.5,"sub_size":8.5}],[{"t":"cell","id":"p0","x":70.0,"y":70.0,"w":90.0,"h":30.0,"text":"rules","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"p1","x":180.0,"y":70.0,"w":90.0,"h":30.0,"text":"releases","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"p2","x":290.0,"y":70.0,"w":90.0,"h":30.0,"text":"contributors","tone":"blue","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":126.0,"text":"without this developers leave","tone":"red","size":9.5}],[{"t":"cell","id":"f0","x":70.0,"y":56.0,"w":96.0,"h":28.0,"text":"LibreOffice","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"f1","x":180.0,"y":56.0,"w":96.0,"h":28.0,"text":"MariaDB","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"f2","x":290.0,"y":56.0,"w":96.0,"h":28.0,"text":"Jenkins","tone":"green","size":9.5,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":106.0,"text":"OpenOffice · MySQL · Hudson","tone":"muted","size":9.5},{"t":"cell","id":"o","x":180.0,"y":140.0,"w":200.0,"h":24.0,"text":"OpenJS Foundation, 2019","tone":"yellow","size":9.5,"sub_size":8.5}]],"cues":[14.6,26.7]}]},{"title":"Node.js today","sub":"LTS and built-ins","short":"Today","main":"Even versions are LTS; fetch and tests are already built in.","body":[{"t":"scene","labels":["Releases","Built in","Closer to the browser"],"captions":["A major version ships twice a year; even ones get long-term support (LTS), odd ones are short-lived","The platform absorbed what once needed packages: fetch, a test runner, file watching, web streams","Modern Node.js is closer to the browser: the same code increasingly runs in both environments"],"frames":[[{"t":"cell","id":"v0","x":70.0,"y":70.0,"w":60.0,"h":30.0,"text":"20","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"v1","x":144.0,"y":70.0,"w":60.0,"h":30.0,"text":"21","tone":"muted","size":12.0,"sub_size":8.5},{"t":"cell","id":"v2","x":218.0,"y":70.0,"w":60.0,"h":30.0,"text":"22","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"v3","x":292.0,"y":70.0,"w":60.0,"h":30.0,"text":"23","tone":"muted","size":12.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":116.0,"text":"even — LTS, odd — short","size":9.5}],[{"t":"cell","id":"f0","x":74.0,"y":54.0,"w":120.0,"h":28.0,"text":"fetch","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"f1","x":214.0,"y":54.0,"w":120.0,"h":28.0,"text":"node:test","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"f2","x":74.0,"y":98.0,"w":120.0,"h":28.0,"text":"--watch","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"f3","x":214.0,"y":98.0,"w":120.0,"h":28.0,"text":"Web Streams","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"b","x":90.0,"y":70.0,"w":110.0,"h":36.0,"text":"browser","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"n~cell","x":270.0,"y":70.0,"w":110.0,"h":36.0,"text":"Node.js","tone":"green","size":10.5,"sub_size":8.5},{"t":"line","id":"e1","x1":146.0,"y1":62.0,"x2":214.0,"y2":62.0,"tone":"g