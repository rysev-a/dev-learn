"id":"e1","x1":180.0,"y1":118.0,"x2":180.0,"y2":94.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":180.0,"y1":68.0,"x2":180.0,"y2":44.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"code","id":"c~code","x":10.0,"y":20.0,"lines":["list.addEventListener(\"click\", (e) => {","  const row = e.target.closest(\"li\");","  if (row) select(row.dataset.id);","});"],"hl":[0,1,2],"lang":"js","size":9.0,"lh":24.0,"w":340.0}],[{"t":"code","id":"c~code","x":10.0,"y":20.0,"lines":["function Button({ onPress }) {","  return h(\"button\", { onClick: () => onPress(42) }, \"OK\");","}"],"hl":[1],"lang":"js","size":9.5,"lh":30.0,"w":340.0}]],"cues":[12.7,25.5]}]},{"title":"Context","sub":"provide and inject","short":"Context","main":"Context hands a value to any descendant, skipping the components in between.","body":[{"t":"scene","labels":["Cross-cutting value","provide / inject","Swap in tests"],"captions":["Theme, language, user are needed at any depth: do not pass them through every level","An ancestor provides a value by key; a descendant gets the nearest one up the tree","Another provider, another dependency: a service becomes a stub in a test"],"frames":[[{"t":"cell","id":"a","x":180.0,"y":30.0,"w":70.0,"h":26.0,"text":"App","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":80.0,"w":70.0,"h":26.0,"text":"Layout","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":130.0,"w":70.0,"h":26.0,"text":"Button","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":290.0,"y":80.0,"text":"theme\nneeded here ↓","size":9.5}],[{"t":"code","id":"c~code","x":10.0,"y":20.0,"lines":["provide(\"theme\", \"dark\");        // in App","const theme = inject(\"theme\");   // in Button"],"hl":[0,1],"lang":"js","size":10.0,"lh":30.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":36.0,"text":"prod: provide(api,\nrealApi)","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":7