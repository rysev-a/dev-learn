e,"width":1.6},{"t":"line","id":"e2","x1":210.0,"y1":54.0,"x2":236.0,"y2":88.0,"tone":"muted","arrow":true,"width":1.6}]],"cues":[12.2,24.3]}]},{"title":"State","sub":"Where to keep it","short":"State","main":"Keep state in the lowest common ancestor of the components that need it.","body":[{"t":"scene","labels":["Local","Lift to ancestor","Global"],"captions":["Needed by one component: it stays inside","Needed by two: lift to the nearest common ancestor, pass down a value and a function","Too far apart: context or a shared store; needless global state hurts debugging"],"frames":[[{"t":"cell","id":"a","x":180.0,"y":40.0,"w":70.0,"h":26.0,"text":"Dropdown","tone":"green","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":90.0,"text":"open: boolean, kept inside only","size":10.0}],[{"t":"cell","id":"p","x":180.0,"y":30.0,"w":70.0,"h":26.0,"text":"Parent\nstate","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"a","x":110.0,"y":100.0,"w":70.0,"h":26.0,"text":"A","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":250.0,"y":100.0,"w":70.0,"h":26.0,"text":"B","tone":"blue","size":9.5,"sub_size":8.5},{"t":"line","id":"e1","x1":150.0,"y1":44.0,"x2":124.0,"y2":88.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":210.0,"y1":44.0,"x2":236.0,"y2":88.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"cell","id":"s","x":180.0,"y":30.0,"w":70.0,"h":26.0,"text":"store","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"a","x":70.0,"y":110.0,"w":70.0,"h":26.0,"text":"A","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":110.0,"w":70.0,"h":26.0,"text":"B","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"c","x":290.0,"y":110.0,"w":70.0,"h":26.0,"text":"C","tone":"blue","size":9.5,"sub_size":8.5},{"t":"line","id":"e1","x1":160.0,"y1":44.0,"x2":90.0,"y2":98.0,"tone":"muted","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":180.0,"y1":44.0,"x2":180.0,"y2":98.0,"tone":"muted","arrow":tru