one":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"r-r3c1","x":215.0,"y":120.0,"w":48.0,"h":18.0,"text":"0","tone":"green","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":36.0,"text":"one subquery per row:\n4 rows → 4 counts","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":280.0,"y":70.0,"w":120.0,"h":36.0,"text":"JOIN + GROUP BY:\none pass","tone":"green","size":9.0,"sub_size":8.5}]],"cues":[12.6,25.2]}]},{"title":"ANY and ALL","sub":"Compare with all","short":"ANY and ALL","main":"SQLite has no ANY and ALL: replace them with MAX, MIN or EXISTS.","body":[{"t":"scene","labels":["Greater than all","Greater than some","Empty set"],"captions":["x > ALL (…) in SQLite is written as x > (SELECT MAX(…) …)","x > ANY (…) is x > (SELECT MIN(…) …)","On an empty set MAX gives NULL, but by the standard ALL is true: a difference"],"frames":[[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["price > ALL (SELECT price …)   -- standard","price > (SELECT MAX(price) …)   -- SQLite"],"hl":[1],"lang":"sql","size":9.5,"lh":14.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["price > ANY (SELECT price …)   -- standard","price > (SELECT MIN(price) …)   -- SQLite"],"hl":[1],"lang":"sql","size":9.5,"lh":14.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":40.0,"text":"ALL over empty:\ntrue","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":150.0,"h":40.0,"text":"MAX of empty: NULL\ncomparison unknown","tone":"yellow","size":9.0,"sub_size":8.5}]],"cues":[11.4,22.9]}]},{"title":"Subquery or JOIN","sub":"Choosing a form","short":"Subquery or JOIN","main":"The same task is often solved by a JOIN or a subquery — choose for readability.","body":[{"t":"scene","labels":["Is there any","Columns of both","Metric per row"],"captions":["A \"is there any\" question — IN or EXISTS: the query reads like a sentence","Need columns of both tables — JOIN","One metric per row — subquery in SELECT"],"frames":[[{"t":"cell","id":"a","x":180.0,"y":40.0,"w":280.0,"h":26.0,"text":"customers who have orders","tone":"blue","size":9.5,"sub_size":8.5},{"t":"code","id":"c","x":20.0,"y":74.0,"lines":["WHERE EXISTS (SELECT 1 FROM orders …)"],"hl":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0}],[{"t":"cell","id":"a","x":180.0,"y":40.0,"w":280.0,"h":26.0,"text":"customer and their order total","tone":"blue","size":9.5,"sub_size":8.5},{"t":"code","id":"c","x":20.0,"y":74.0,"lines":["FROM customers c JOIN orders o ON …"],"hl":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0}],[{"t":"cell","id":"a","x":180.0,"y":40.0,"w":280.0,"h":26.0,"text":"customer and their order count","tone":"blue","size":9.5,"sub_size":8.5},{"t":"code","id":"c","x":20.0,"y":74.0,"lines":["SELECT name, (SELECT COUNT(*) …)"],"hl":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0}]],"cues":[11.5,23.0]}]},{"title":"Subqueries in modifications","sub":"UPDATE and DELETE","short":"In modifications","main":"A subquery in UPDATE and DELETE chooses which rows to change and with what.","body":[{"t":"scene","labels":["UPDATE","DELETE","SELECT first"],"captions":["In UPDATE the value comes from a subquery: recompute an order total from its items","In DELETE the condition uses a subquery: customers with no orders","First run the same subquery as a SELECT and see what would be affected"],"frames":[[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["UPDATE orders SET total =","  (SELECT SUM(qty * price)","   FROM order_items","   WHERE order_id = orders.id);"],"hl":[1,2,3],"lang":"sql","size":10.0,"lh":13.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["DELETE FROM customers","WHERE id NOT IN (SELECT cust FROM orders","                WHERE cust IS NOT NULL);"],"hl":[1,2],"lang":"sql","size":9.5,"lh":14.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["-- check","SELECT * FROM customers","WHERE id NOT IN (SELECT cust FROM orders …);"],"hl":[1,2],"lang":"sql","size":9.5,"lh":14.0,"w":340.0},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"make sure these are the right rows","tone":"green","size":9.5}]],"cues":[11.6,23.2]}]},{"title":"Common mistakes","sub":"What to check","short":"Mistakes","main":"Check the subquery's row count and gaps; an alias in FROM is required.","body":[{"t":"scene","labels":["Many rows","Many columns","No alias"],"captions":["A scalar subquery returned several rows: SQLite takes the first, other databases raise an error","A subquery in IN must return a single column","A subquery in FROM without an alias is an error in many databases"],"frames":[[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":280.0,"h":36.0,"text":"= (SELECT price FROM products)\n→ 5 rows, first taken","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"check the row count","size":9.5}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["WHERE id IN (SELECT id, name FROM t)"],"bad":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"e","x":180.0,"y":100.0,"w":280.0,"h":28.0,"text":"sub-select returns 2 columns","tone":"red","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["SELECT * FROM (SELECT 1 AS x);"],"bad":[0],"lang":"sql","size":10.0,"lh":14.0,"w":340.0},{"t":"cell","id":"e","x":180.0,"y":100.0,"w":220.0,"h":28.0,"text":"alias needed: … ) AS t","tone":"yellow","size":9.5,"sub_size":8.5}]],"cues":[12.0,24.1]}]},{"title":"Summary","sub":"Subqueries","short":"Summary","main":"Scalar, list, EXISTS, correlated, derived table.","body":[{"t":"scene","labels":["Kinds","Choice","Next"],"captions":["Scalar, list for IN, EXISTS, correlated, derived table","NOT IN is dangerous because of NULL — better NOT EXISTS","Next topic — changing data: INSERT, UPDATE, DELETE"],"frames":[[{"t":"cell","id":"a","x":65.0,"y":60.0,"w":110.0,"h":28.0,"text":"scalar","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":60.0,"w":110.0,"h":28.0,"text":"IN (list)","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"c","x":295.0,"y":60.0,"w":110.0,"h":28.0,"text":"EXISTS","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"d","x":100.0,"y":104.0,"w":140.0,"h":28.0,"text":"correlated","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"e","x":260.0,"y":104.0,"w":140.0,"h":28.0,"text":"in FROM (table)","tone":"green","size":9.5,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":36.0,"text":"NOT IN + NULL\n→ empty","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":150.0,"h":36.0,"text":"NOT EXISTS\n→ reliable","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c~code","x":20.0,"y":40.0,"lines":["INSERT INTO t …;","UPDATE t SET …;","DELETE FROM t …;"],"hl":[0,1,2],"lang":"sql","size":11.0,"lh":17.0,"w":340.0},{"t":"line","id":"a~line","x1":180.0,"y1":120.0,"x2":180.0,"y2":132.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[12.6,25.2]}]}]}