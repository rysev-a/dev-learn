{"book":17,"chapter":25,"rubric":"OVIRT: RUNNING AND OPERATING / CHAPTER 25","slides":[{"title":"The upgrade order","sub":"Chapter 25 · oVirt operations","short":"Order","main":"Backup, engine, hosts one by one, then compatibility versions.","body":[{"t":"scene","labels":["Backup","Engine","Hosts","Versions"],"captions":["First a backup of the engine: engine-backup","Then upgrade the engine itself: engine-setup","Hosts one at a time: maintenance, update, back to service","Last the compatibility version: cluster, then data center"],"frames":[[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"1 · engine-backup: engine backup","tone":"muted","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"1 · engine-backup: engine backup","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"2 · engine-setup: upgrade the engine","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"1 · engine-backup: engine backup","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"2 · engine-setup: upgrade the engine","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"3 · hosts one by one via Maintenance","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"1 · engine-backup: engine backup","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"2 · engine-setup: upgrade the engine","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"3 · hosts one by one via Maintenance","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":180.0,"y":122.0,"w":280.0,"h":24.0,"text":"4 · cluster version, then data center","tone":"green","size":9.0,"sub_size":8.5}]],"cues":[9.4,19.1,31.6]}]},{"title":"Ordering rules","sub":"Chapter 25 · oVirt operations","short":"Rules","main":"Engine not older than hosts, no skipped steps, version only up.","body":[{"t":"scene","labels":["Engine","Steps","Upward","Order"],"captions":["The engine is newer than hosts or equal: an old one will not understand new ones","Versions are climbed step by step, not jumped","The compatibility version only goes up, no way back","Clusters first, then the data center; VMs pick it up after a restart"],"frames":[[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"engine newer or\nequal to hosts","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"engine newer or\nequal to hosts","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"no skipped versions\nstep by step","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"engine newer or\nequal to hosts","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"no skipped versions\nstep by step","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":95.0,"y":110.0,"w":158.0,"h":46.0,"text":"version only up\nno way back","tone":"yellow","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":95.0,"y":50.0,"w":158.0,"h":46.0,"text":"engine newer or\nequal to hosts","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":265.0,"y":50.0,"w":158.0,"h":46.0,"text":"no skipped versions\nstep by step","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":95.0,"y":110.0,"w":158.0,"h":46.0,"text":"version only up\nno way back","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":265.0,"y":110.0,"w":158.0,"h":46.0,"text":"cluster first,\nthen data center","tone":"green","size":9.0,"sub_size":8.5}]],"cues":[13.3,20.7