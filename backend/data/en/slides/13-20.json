 bypassed"],"bad":[4],"lang":"python","size":9.5,"lh":18.0,"w":320.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":110.0,"h":30.0,"text":"dict (in C)","tone":"red","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":260.0,"y":60.0,"w":130.0,"h":30.0,"text":"UserDict (in Python)","tone":"green","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":120.0,"text":"the second honors your overrides","tone":"green","size":10.0}],[{"t":"code","id":"c","x":24.0,"y":50.0,"lines":["class Upper(dict):","    def __missing__(self, key):","        self[key] = key.upper()","        return self[key]","d = Upper(); d['a']   # 'A'"],"hl":[1,2,3],"lang":"python","size":10.0,"lh":20.0,"w":320.0}]],"cues":[13.0,32.8]}]},{"title":"__call__","sub":"Object as a function","short":"call","main":"Unlike a function, an object remembers state.","body":[{"t":"scene","labels":["Object as a function","State","callable"],"captions":["__call__ lets you call an instance with parentheses","Unlike a function, an object keeps state: call counter, cache, configurable factor","callable(x) tells whether a value can be called; functions, classes, methods are called alike"],"frames":[[{"t":"code","id":"c","x":24.0,"y":44.0,"lines":["class Multiplier:","    def __init__(self, k):","        self.k = k","    def __call__(self, x):","        return x * self.k","triple = Multiplier(3); triple(5)"],"hl":[3,4],"lang":"python","size":9.5,"lh":18.0,"w":320.0}],[{"t":"code","id":"c","x":30.0,"y":46.0,"lines":["counter = Counter()","counter()   # 1","counter()   # 2","counter()   # 3"],"lang":"python","size":11.5,"lh":24.0,"w":200.0},{"t":"cell","id":"s","x":280.0,"y":70.0,"w":70.0,"h":36.0,"text":"count\n3","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"c0","x":56.0,"y":56.0,"w":56.0,"h":24.0,"text":"len","tone":"green","size":8.0,"sub_size":8.5},{"t":"cell","id":"c1","x":118.0,"y":56.0,"w":56.0,"h":24.0,"text":"Point","tone":"green","size":8.0,"sub_size":8.5},{"t":"cell","id":"c2","x":180.0,"y