 SET qty = qty + excluded.qty;"],"hl":[1,2],"lang":"sql","size":10.0,"lh":16.0,"w":340.0},{"t":"text","id":"n","x":180.0,"y":100.0,"text":"no key 7 — insert, exists — update","tone":"green","size":9.5}]],"cues":[17.4,24.4]}]},{"title":"Execution order","sub":"Summary","short":"Summary","main":"FROM → WHERE → GROUP BY → HAVING → SELECT → ORDER BY → LIMIT.","body":[{"t":"scene","labels":["Logical order","Consequences","Summary"],"captions":["We write SELECT first, but logically it runs differently: FROM and JOIN, WHERE, GROUP BY, HAVING, SELECT, ORDER BY, LIMIT","Hence the rules: no aggregate in WHERE, no SELECT alias in WHERE","Tables, keys, constraints, joins and grouping are the basis for transactions, indexes and distributed databases"],"frames":[[{"t":"cell","id":"b0","x":28.0,"y":76.0,"w":47.0,"h":30.0,"text":"FROM","tone":"blue","size":6.5,"sub_size":8.5},{"t":"cell","id":"b1","x":79.0,"y":76.0,"w":47.0,"h":30.0,"text":"WHERE","tone":"blue","size":6.5,"sub_size":8.5},{"t":"cell","id":"b2","x":130.0,"y":76.0,"w":47.0,"h":30.0,"text":"GROUP BY","tone":"blue","size":6.5,"sub_size":8.5},{"t":"cell","id":"b3","x":181.0,"y":76.0,"w":47.0,"h":30.0,"text":"HAVING","tone":"blue","size":6.5,"sub_size":8.5},{"t":"cell","id":"b4","x":232.0,"y":76.0,"w":47.0,"h":30.0,"text":"SELECT","tone":"green","size":6.5,"sub_size":8.5},{"t":"cell","id":"b5","x":283.0,"y":76.0,"w":47.0,"h":30.0,"text":"ORDER BY","tone":"blue","size":6.5,"sub_size":8.5},{"t":"cell","id":"b6","x":334.0,"y":76.0,"w":47.0,"h":30.0,"text":"LIMIT","tone":"blue","size":6.5,"sub_size":8.5},{"t":"line","id":"e0","x1":48.0,"y1":76.0,"x2":56.0,"y2":76.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e1","x1":99.0,"y1":76.0,"x2":107.0,"y2":76.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":150.0,"y1":76.0,"x2":158.0,"y2":76.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e3","x1":201.0,"y1":76.0,"x2":209.0,"y2":76.0,"tone":"green","arrow":true,"width":1.6},{"t":"line",