.0,"h":28.0,"text":"database","tone":"blue","size":9.0,"sub_size":8.5},{"t":"line","id":"e","x1":118.0,"y1":56.0,"x2":246.0,"y2":56.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n","x":240.0,"y":120.0,"text":"TTL = 300 ± random 30 s","size":9.0,"mono":true}]],"cues":[15.6,28.2]}]},{"title":"Missing keys and avalanche","sub":"Penetration and avalanche","short":"Penetration","main":"Cache \"not found\"; warm up and throttle.","body":[{"t":"scene","labels":["Nonexistent keys","Negative caching and Bloom","Avalanche"],"captions":["Requests for keys that do not exist always miss the cache and hit the database every time","Remember \"no such key\" briefly; for huge key spaces put a Bloom filter before the cache","If the whole cache dies or many entries expire at once, all load hits the database: spread, warm-up, degradation"],"frames":[[{"t":"cell","id":"c","x":60.0,"y":76.0,"w":80.0,"h":28.0,"text":"id=999999","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"k","x":190.0,"y":76.0,"w":56.0,"h":28.0,"text":"cache ✕","tone":"muted","size":9.0,"sub_size":8.5},{"t":"cell","id":"d","x":310.0,"y":76.0,"w":74.0,"h":28.0,"text":"database: none","tone":"red","size":9.0,"sub_size":8.5},{"t":"line","id":"e1","x1":100.0,"y1":76.0,"x2":160.0,"y2":76.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":220.0,"y1":76.0,"x2":272.0,"y2":76.0,"tone":"red","arrow":true,"width":1.6}],[{"t":"cell","id":"f","x":70.0,"y":76.0,"w":90.0,"h":28.0,"text":"Bloom: \"no\"","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"k","x":220.0,"y":76.0,"w":100.0,"h":28.0,"text":"cache: \"no\" 60 s","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"d","x":330.0,"y":76.0,"w":40.0,"h":28.0,"text":"database","tone":"muted","size":9.0,"sub_size":8.5},{"t":"line","id":"e","x1":116.0,"y1":76.0,"x2":170.0,"y2":76.0,"tone":"muted","arrow":true,"dash":"3 3","width":1.6}],[{"t":"bar","id":"a","x":110.0,"y":130.0,"w":60.0,"hh":10.0,"max":100.0,"tone":"green","text":""},{"t":"bar","id":"b","x":250.0,"y":130.0,"w":60.0,"hh":90.0,"max":100.0,"tone":"red","text":""},{"t":"text","id":"l1","x":110.0,"y":150.0,"text":"with cache","size":9.0},{"t":"text","id":"l2","x":250.0,"y":150.0,"text":"cache down","size":9.0},{"t":"text","id":"t","x":180.0,"y":14.0,"text":"database load","size":9.0}]],"cues":[17.0,24.3]}]},{"title":"Metrics","sub":"Hit ratio","short":"Metrics","main":"Measure the hit ratio; a cache can be harmful.","body":[{"t":"scene","labels":["Hit ratio","Average latency","When harmful"],"captions":["Main indicator is the hit ratio; also cache latency, evictions, memory and the most frequent keys","Average latency = hit·t_cache + (1 − hit)·t_DB: at 90% hits, database load drops tenfold","Data nearly unique per request: the cache never hits and only adds latency"],"frames":[[{"t":"bar","id":"a","x":110.0,"y":130.0,"w":60.0,"hh":90.0,"max":100.0,"tone":"green","text":"90 %"},{"t":"bar","id":"b","x":250.0,"y":130.0,"w":60.0,"hh":30.0,"max":100.0,"tone":"red","text":"30 %"},{"t":"text","id":"l1","x":110.0,"y":150.0,"text":"healthy","size":9.0},{"t":"text","id":"l2","x":250.0,"y":150.0,"text":"useless","size":9.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["hit = 0.9;  t_cache = 1 ms;  t_DB = 20 ms","avg = 0.9 · 1 + 0.1 · 20 = 2.9 ms","DB load: × 0.1"],"hl":[1],"lang":"sql","size":10.0,"lh":22.0,"w":330.0}],[{"t":"cell","id":"a~cell","x":90.0,"y":60.0,"w":130.0,"h":26.0,"text":"unique requests","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"b~cell","x":90.0,"y":100.0,"w":130.0,"h":26.0,"text":"hit ratio ≈ 0","tone":"red","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":290.0,"y":80.0,"text":"cache = only\nlatency","size":10.0}]],"cues":[15.6,26.1]}]},{"title":"Distributed cache","sub":"Ring and L1/L2","short":"Cluster","main":"The database is the source of truth; the system survives without a cache.","body":[{"t":"scene","labels":["Ring","Two-level","No cache"],"captions":["Keys are spread over nodes by consistent hashing; losing a node means a spike of misses","L1 in the process (seconds, hottest) and shared L2 (minutes): faster, less network; hot keys are copied to several nodes","The database is the source of truth: the system must survive without the cache, at least at reduced load"],"frames":[[{"t":"cell","id":"n0","x":60.0,"y":76.0,"w":60.0,"h":28.0,"text":"N1","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"n1","x":140.0,"y":76.0,"w":60.0,"h":28.0,"text":"N2","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"n2","x":220.0,"y":76.0,"w":60.0,"h":28.0,"text":"N3","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"n3","x":300.0,"y":76.0,"w":60.0,"h":28.0,"text":"N4","tone":"blue","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":126.0,"text":"node N3 down: 1/4 of keys will miss","size":9.5}],[{"t":"cell","id":"c","x":60.0,"y":76.0,"w":70.0,"h":28.0,"text":"process\nL1","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"k","x":190.0,"y":76.0,"w":70.0,"h":28.0,"text":"shared\nL2","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"d","x":310.0,"y":76.0,"w":70.0,"h":28.0,"text":"database","tone":"blue","size":9.0,"sub_size":8.5},{"t":"line","id":"e1","x1":96.0,"y1":76.0,"x2":154.0,"y2":76.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":226.0,"y1":76.0,"x2":274.0,"y2":76.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"cell","id":"c","x":90.0,"y":76.0,"w":80.0,"h":28.0,"text":"application","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"k","x":190.0,"y":76.0,"w":56.0,"h":28.0,"text":"cache ✕","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"d","x":300.0,"y":76.0,"w":66.0,"h":28.0,"text":"database","tone":"green","size":9.0,"sub_size":8.5},{"t":"line","id":"e","x1":132.0,"y1":90.0,"x2":262.0,"y2":90.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":126.0,"text":"throttling and degradation","size":9.5}]],"cues":[15.4,27.1]}]},{"title":"Summa