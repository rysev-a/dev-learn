n","FOR UPDATE SKIP LOCKED: workers take different jobs and don't interfere"],"frames":[[{"t":"code","id":"c","x":10.0,"y":14.0,"lines":["let mut tx = pool.begin().await?;","query(\"INSERT INTO rooms ..\").execute(&mut *tx).await?;","query(\"INSERT INTO members ..\").execute(&mut *tx).await?;","tx.commit().await?;"],"hl":[0,3],"lang":"rust","size":8.5,"lh":22.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["let mut tx = pool.begin().await?;","do_work(&mut tx).await?;     // Err → return","// tx dropped without commit → ROLLBACK"],"hl":[1,2],"lang":"rust","size":9.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["SELECT id FROM jobs","WHERE done = false","ORDER BY id LIMIT 1","FOR UPDATE SKIP LOCKED"],"hl":[3],"lang":"rust","size":9.5,"lh":24.0,"w":340.0}]],"cues":[13.0,25.9]}]},{"title":"Migrations","sub":"Schema under control","short":"Migrations","main":"Migrations are numbered SQL files; applied ones are never edited, new ones are added.","body":[{"t":"scene","labels":["Files","Version table","Don't edit"],"captions":["Numbered SQL files: 0001_users.sql, 0002_rooms.sql …","A service table remembers applied ones; a run brings the database up to date","Never change an applied migration: a schema fix is a new migration"],"frames":[[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["migrations/","  0001_users.sql","  0002_rooms.sql","  0003_messages.sql"],"hl":[1,2,3],"lang":"rust","size":10.5,"lh":26.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":50.0,"w":140.0,"h":24.0,"text":"_migrations","tone":"blue","size":10.5,"sub_size":8.5},{"t":"text","id":"n","x":270.0,"y":50.0,"text":"1, 2 applied","tone":"muted","size":9.0},{"t":"cell","id":"b","x":90.0,"y":100.0,"w":140.0,"h":24.0,"text":"0003_…sql","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"line","id":"e","x1":156.0,"y1":100.0,"x2":220.0,"y2":100.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"c~cell","x":290.0,"y":100.0,"w":100.0,"h":24.0,"text":"apply","tone"