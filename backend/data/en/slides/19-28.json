6,","  .userspace_addr = (uintptr_t)mem };","ioctl(vm, KVM_SET_USER_MEMORY_REGION, &r);"],"hl":[2],"lang":"c","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["mem = mmap(NULL, 4096, PROT_READ|PROT_WRITE,","           MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);","memcpy(mem, prog, len);","struct kvm_userspace_memory_region r = {","  .slot = 0, .guest_phys_addr = 0,","  .memory_size = 4096,","  .userspace_addr = (uintptr_t)mem };","ioctl(vm, KVM_SET_USER_MEMORY_REGION, &r);"],"hl":[3,4,5,6],"lang":"c","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["mem = mmap(NULL, 4096, PROT_READ|PROT_WRITE,","           MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);","memcpy(mem, prog, len);","struct kvm_userspace_memory_region r = {","  .slot = 0, .guest_phys_addr = 0,","  .memory_size = 4096,","  .userspace_addr = (uintptr_t)mem };","ioctl(vm, KVM_SET_USER_MEMORY_REGION, &r);"],"hl":[7],"lang":"c","size":9.0,"lh":13.0,"w":320.0}]],"cues":[8.9,15.3,25.8]}]},{"title":"The vCPU and the kvm_run area","sub":"Chapter 28 · C and the kernel","short":"vCPU","main":"KVM_CREATE_VCPU and an mmap of the area sized by KVM_GET_VCPU_MMAP_SIZE.","body":[{"t":"scene","labels":["Processor","Size","Mapping","Why"],"captions":["KVM_CREATE_VCPU on the machine descriptor, number 0","Ask the kernel for the area size on the system fd","mmap of the processor descriptor, offset 0","The size is larger than sizeof: port data lies beyond the structure"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["int vcpu = ioctl(vm, KVM_CREATE_VCPU, 0);","int sz = ioctl(kvm, KVM_GET_VCPU_MMAP_SIZE, 0);","run = mmap(NULL, sz, PROT_READ|PROT_WRITE,","           MAP_SHARED, vcpu, 0);","/* not sizeof(*run): I/O data is beyond it */"],"hl":[0],"lang":"c","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["int vcpu = ioctl(vm, KVM_CREATE_VCPU, 0);","int sz = ioctl(kvm, KVM_GET_VCPU_MMAP_SIZE, 0);","run = mmap(NULL, sz, PROT_READ|PROT_WRITE,","           MAP_SHARED, vcpu, 0);","/* not sizeof(*run): I/O data is beyond it */"],"hl":[1],"lang":"c","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["int vcpu = ioctl(vm, KVM_CREATE_VCPU, 0);","int sz = ioctl(kvm, KVM_GET_VCPU_MMAP_SIZE, 0);","run = mmap(NULL, sz, PROT_READ|PROT_WRITE,","           MAP_SHARED, vcpu, 0);","/* not sizeof(*run): I/O data is beyond it */"],"hl":[2,3],"lang":"c","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["int vcpu = ioctl(vm, KVM_CREATE_VCPU, 0);","int sz = ioctl(kvm, KVM_GET_VCPU_MMAP_SIZE, 0);","run = mmap(NULL, sz, PROT_READ|PROT_WRITE,","           MAP_SHARED, vcpu, 0);","/* not sizeof(*run): I/O data is beyond it */"],"hl":[4],"lang":"c","size":9.0,"lh":13.0,"w":320.0}]],"cues":[10.3,20.1,28.6]}]},{"title":"The KVM_RUN loop","sub":"Chapter 28 · C and the kernel","short":"Loop","main":"Run, decode exit_reason, handle, repeat; EINTR is not a failure.","body":[{"t":"scene","labels":["Run","Reason","IO","HLT"],"captions":["KVM_RUN returns 0 when the guest exited; EINTR: call again","The reason is in run->exit_reason","KVM_EXIT_IO: port, size, data at data_offset","KVM_EXIT_HLT is the end; the rest is trouble or MMIO"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["for (;;) {","  if (ioctl(vcpu, KVM_RUN, 0) < 0) {","    if (errno == EINTR) continue;","    return -errno; }","  switch (run->exit_reason) {","  case KVM_EXIT_IO: /* run + io.data_offset */","  case KVM_EXIT_HLT: return 0;","  default: return -EIO; } }"],"hl":[0,1,2,3],"lang":"c","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["for (;;) {","  if (ioctl(vcpu, KVM_RUN, 0) < 0) {","    if (errno == EINTR) continue;","    return -errno; }","  switch (run->exit_reason) {","  case KVM_EXIT_IO: /* run + io.data_offset */","  case KVM_EXIT_HLT: return 0;","  default: return -EIO; } }"],"hl":[4],"lang":"c","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["for (;;) {","  if (ioctl(vcpu, KVM_RUN, 0) < 0) {","    if (errno == EINTR) continue;","    return -errno; }","  switch (run->exit_reason) {","  case KVM_EXIT_IO: /* run + io.data_offset */","  case KVM_EXIT_HLT: return 0;","  default: return -EIO; } }"],"hl":[5],"lang":"c","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["for (;;) {","  if (ioctl(vcpu, KVM_RUN, 0) < 0) {","    if (errno == EINTR) continue;","    return -errno; }","  switch (run->exit_reason) {","  case KVM_EXIT_IO: /* run + io.data_offset */","  case KVM_EXIT_HLT: return 0;","  default: return -EIO; } }"],"hl":[6,7],"lang":"c","size":9.0,"lh":13.0,"w":320.0}]],"cues":[12.9,20.2,30.0]}]},{"title":"The tiny guest","sub":"Chapter 28 · C and the kernel","short":"Guest","main":"One page, a program, output to a port and a halt; in the lab the guest is a toy.","body":[{"t":"scene","labels":["Page","Program","Port","Halt"],"captions":["One page of guest memory at address 0","The program: real-mode code or the lab's toy","An OUT to a port gives KVM_EXIT_IO, the monitor reads the byte","HLT gives KVM_EXIT_HLT: the monitor ends the loop"],"frames":[[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"a page of guest memory","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"a page of guest memory","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"program: real mode / toy","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"a page of guest memory","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"program: real mode / toy","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"OUT to a port → KVM_EXIT_IO","tone":"yellow","size":9.0,"sub_size":8.5