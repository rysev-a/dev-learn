"sub_size":8.5},{"t":"cell","id":"b3","x":62.0,"y":94.0,"w":106.0,"h":26.0,"text":"Hashable","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b4","x":180.0,"y":94.0,"w":106.0,"h":26.0,"text":"SupportsInt","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b5","x":298.0,"y":94.0,"w":106.0,"h":26.0,"text":"SupportsIndex","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["def total(items: Iterable[int]) -> int:","    return sum(items)","total([1, 2]) · total((1, 2)) · total(range(3))"],"hl":[0],"lang":"python","size":10.5,"lh":26.0,"w":330.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":28.0,"text":"input: Iterable","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":28.0,"text":"output: list[int]","tone":"green","size":10.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":112.0,"text":"accept widely, return precisely","size":10.0}]],"cues":[10.6,26.4]}]},{"title":"TypeVar","sub":"Linking input and output","short":"TypeVar","main":"T links the argument type to the result type.","body":[{"t":"scene","labels":["Link lost","TypeVar","bound"],"captions":["Writing \"accepts a sequence of anything, returns anything\" loses the link between input and output","T = TypeVar('T'): takes Sequence[T], returns T - a list of numbers gives a number, strings give a string","TypeVar can be restricted: bound=... sets an upper limit on allowed types"],"frames":[[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["def first(items: Sequence[Any]) -> Any:","    return items[0]","# result is Any: type lost"],"hl":[2],"bad":[2],"lang":"python","size":10.5,"lh":26.0,"w":320.0}],[{"t":"code","id":"c","x":24.0,"y":44.0,"lines":["T = TypeVar('T')","def first(items: Sequence[T]) -> T:","    return items[0]","first([1, 2])    # int","first(['a'])      # str"],"hl":[1,3,4],"lang":"python","size":10.5,"lh":22.0,"w":330.0}],[{"t":"code","id":"c","x":24.0,"y":50.0,"lines":["T = TypeVar('T', bound=Comparable)","def biggest(items: list[T]) -> T:","    return max(items)"],"hl":[0],"lang":"python","size":10.5,"lh":26.0,"w":330.0}]],"cues":[16.1,29.9]}]},{"title":"Generic classes","sub":"Generic and new syntax","short":"Generic","main":"Stack[int] is a stack of ints; in 3.12 - class Stack[T].","body":[{"t":"scene","labels":["Generic[T]","Stack[int]","New syntax"],"captions":["The class inherits Generic[T] and describes a container of elements of type T","Stack[int] is a stack of ints; the checker forbids pushing a string","Python 3.12: type parameters right in brackets - class Stack[T] and def first[T](...)"],"frames":[[{"t":"code","id":"c","x":24.0,"y":44.0,"lines":["class Stack(Generic[T]):","    def __init__(self):","        self._items: list[T] = []","    def push(self, x: T) -> None: ...","    def pop(self) -> T: ..."],"hl":[0],"lang":"python","size":10.5,"lh":22.0,"w":330.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["s: Stack[int] = Stack()","s.push(1)       # ok","s.push('a')     # check error"],"hl":[2],"bad":[2],"lang":"python","size":11.0,"lh":26.0,"w":310.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["class Stack[T]:","    def pop(self) -> T: ...","","def first[T](items: Sequence[T]) -> T: ..."],"hl":[0,3],"lang":"python","size":11.0,"lh":26.0,"w":330.0}]],"cues":[17.1,26.8]}]},{"title":"Variance","sub":"Invariance and covariance","short":"Variance","main":"list[int] is not list[object].","body":[{"t":"scene","labels":["Invariance","Covariance","Contravariance"],"captions":["list[int] is not list[object]: otherwise a string could get into a list of ints through the second name","Sequence[int] fits where Sequence[object] is expected: an immutable sequence only gives values out","One that accepts values is contravariant; with the new syntax the checker works out variance itself"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"list[int]","tone":"blue","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","