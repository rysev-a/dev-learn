{"book":13,"chapter":41,"rubric":"PYTHON AS A FIRST LANGUAGE / CLASS DESIGN / CHAPTER 41","slides":[{"title":"Type hints","sub":"Not checked at run time","short":"Hints","main":"Hints are read by editors and checkers.","body":[{"t":"scene","labels":["Run","Checker","For people"],"captions":["Python runs f('5') even if x: int is written - hints are not checked at run time","mypy and pyright read hints and find errors before running","The editor suggests methods and parameters - hints help people too"],"frames":[[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["def double(x: int) -> int:","    return x * 2","double('5')   # '55', no error"],"hl":[2],"lang":"python","size":11.0,"lh":26.0,"w":310.0}],[{"t":"cell","id":"a","x":70.0,"y":70.0,"w":80.0,"h":30.0,"text":"code","tone":"blue","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":70.0,"w":90.0,"h":30.0,"text":"mypy","tone":"yellow","size":12.0,"sub_size":8.5},{"t":"cell","id":"c~cell","x":300.0,"y":70.0,"w":100.0,"h":30.0,"text":"error before run","tone":"red","size":8.5,"sub_size":8.5},{"t":"line","id":"e1","x1":112.0,"y1":70.0,"x2":134.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":226.0,"y1":70.0,"x2":248.0,"y2":70.0,"tone":"red","arrow":true,"width":1.6}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"p.","tone":"blue","size":13.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":56.0,"w":110.0,"h":22.0,"text":"move()","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"c~cell","x":270.0,"y":84.0,"w":110.0,"h":22.0,"text":"x, y","tone":"green","size":10.5,"sub_size":8.5},{"t":"line","id":"e1","x1":146.0,"y1":66.0,"x2":214.0,"y2":58.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":146.0,"y1":74.0,"x2":214.0,"y2":82.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[14.1,26.6]}]},{"title":"Protocol","sub":"Structural subtyping","short":"Protocol","main":"Any object with the right methods fits.","body":[{"t":"scene","labels":["Describing a shape","No inheritance","Unlike ABC"],"captions":["Protocol lists the needed methods: «Closeable» is anything with close()","A file, socket, connection and your class fit - no common ancestor needed","Abstract classes require inheritance, protocols do not"],"frames":[[{"t":"code","id":"c","x":30.0,"y":50.0,"lines":["class Closeable(Protocol):","    def close(self) -> None: ...","","def shutdown(x: Closeable):","    x.close()"],"hl":[0,1,3],"lang":"python","size":11.0,"lh":22.0,"w":310.0}],[{"t":"cell","id":"o0","x":56.0,"y":112.0,"w":84.0,"h":26.0,"text":"file","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"o1","x":156.0,"y":112.0,"w":84.0,"h":26.0,"text":"socket","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"o2","x":256.0,"y":112.0,"w":84.0,"h":26.0,"text":"your class","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"p","x":180.0,"y":40.0,"w":140.0,"h":28.0,"text":"Closeable","tone":"yellow","size":12.0,"sub_size":8.5},{"t":"line","id":"e0","x1":56.0,"y1":98.0,"x2":140.0,"y2":54.0,"tone":"green","arrow":true,"dash":"3 3","width":1.6},{"t":"line","id":"e1","x1":156.0,"y1":98.0,"x2":180.0,"y2":54.0,"tone":"green","arrow":true,"dash":"3 3","width":1.6},{"t":"line","id":"e2","x1":256.0,"y1":98.0,"x2":220.0,"y2":54.0,"tone":"green","arrow":true,"dash":"3 3","width":1.6}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":110.0,"h":28.0,"text":"ABC","tone":"blue","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":100.0,"w":110.0,"h":28.0,"text":"Protocol","tone":"yellow","size":12.0,"sub_size":8.5},{"t":"cell","id":"c~cell","x":270.0,"y":60.0,"w":130.0,"h":28.0,"text":"inheritance needed","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"d","x":270.0,"y":100.0,"w":130.0,"h":28.0,"text":"inheritance not needed","tone":"yellow","size":9.0,"sub_size":8.5}]],"cues":[13.3,25.3]}]},{"title":"runtime_checkable","sub":"Run-time check","short":"runtime","main":"Only method names are checked.","body":[{"