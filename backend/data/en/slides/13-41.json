.0,"lines":["class Cache(Protocol):","    def get(self, k): ...","    def put(self, k, v): ..."],"hl":[0],"lang":"python","size":11.0,"lh":26.0,"w":300.0}],[{"t":"cell","id":"a","x":70.0,"y":70.0,"w":90.0,"h":30.0,"text":"library","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"p","x":180.0,"y":70.0,"w":70.0,"h":30.0,"text":"Cache","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"cell","id":"c~cell","x":300.0,"y":70.0,"w":90.0,"h":30.0,"text":"your class","tone":"green","size":10.5,"sub_size":8.5},{"t":"line","id":"e1","x1":116.0,"y1":70.0,"x2":144.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":260.0,"y1":70.0,"x2":216.0,"y2":70.0,"tone":"green","arrow":true,"dash":"3 3","width":1.6}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":120.0,"h":28.0,"text":"production: Redis","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":100.0,"w":120.0,"h":28.0,"text":"test: dict","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"p","x":270.0,"y":80.0,"w":100.0,"h":34.0,"text":"Cache","tone":"yellow","size":12.0,"sub_size":8.5},{"t":"line","id":"e1","x1":154.0,"y1":60.0,"x2":224.0,"y2":74.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":154.0,"y1":100.0,"x2":224.0,"y2":88.0,"tone":"blue","arrow":true,"width":1.6}]],"cues":[11.9,21.0]}]},{"title":"Common mistakes","sub":"What to avoid","short":"Mistakes","main":"Fix the code, do not switch checks off.","body":[{"t":"scene","labels":["isinstance and generics","Signatures at run time","type: ignore"],"captions":["isinstance(x, list[int]) is not allowed: TypeError - check isinstance(x, list)","@runtime_checkable does not check signatures; input hints that are too narrow are a common mistake","\"# type: ignore\" on every second line devalues the check - better fix the code or refine the annotations"],"frames":[[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["isinstance(x, list[int])","# TypeError: isinstance() argument 2","# cannot be 