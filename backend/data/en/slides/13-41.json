 int","","nick: str | None = None"],"hl":[0,4],"lang":"python","size":11.0,"lh":24.0,"w":320.0}]],"cues":[12.5,28.1]}]},{"title":"overload","sub":"Stubs for the checker","short":"overload","main":"overload is for hints, singledispatch is for behavior.","body":[{"t":"scene","labels":["Stubs","Implementation","Not to be confused with singledispatch"],"captions":["@overload - several stubs with different signatures: str gives str, list gives list","There is one real implementation that sorts out the arguments; only it runs at run time","For real dispatch by type use functools.singledispatch: the first is a hint, the second is behavior"],"frames":[[{"t":"code","id":"c","x":24.0,"y":44.0,"lines":["@overload","def first(x: str) -> str: ...","@overload","def first(x: list[int]) -> int: ..."],"lang":"python","size":10.5,"lh":22.0,"w":330.0}],[{"t":"code","id":"c","x":24.0,"y":44.0,"lines":["def first(x):","    return x[0]   # the one real one","","# stubs exist only for the checker"],"hl":[0,1],"lang":"python","size":11.0,"lh":24.0,"w":320.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"overload","tone":"blue","size":11.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":130.0,"h":30.0,"text":"singledispatch","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"text","id":"n","x":90.0,"y":110.0,"text":"hint","size":10.0},{"t":"text","id":"m","x":270.0,"y":110.0,"text":"behavior","size":10.0}]],"cues":[14.1,25.6]}]},{"title":"Checkers","sub":"Any and object","short":"mypy and pyright","main":"Turn strictness on in parts.","body":[{"t":"scene","labels":["Gradually","Any and object","In change checks"],"captions":["You can annotate only part of the code: the rest is Any; strictness is turned on in parts","Any turns checks off, object allows only common operations; \"# type: ignore\" - rarely and with an explanation","Run mypy or pyright in the automatic check of every change - then hints pay off"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":70.0,