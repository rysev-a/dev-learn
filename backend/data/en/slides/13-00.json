xt":"Python supports all three","tone":"green","size":10.0}]],"cues":[11.7,34.8]}]},{"title":"Why Python","sub":"Readability, popularity, batteries","main":"Reads like English, is popular and comes with a rich library.","body":[{"t":"scene","labels":["Readability","Popularity","Batteries"],"captions":["Python reads almost like English: fewer symbols, and required indentation keeps code tidy","It ranks near the top for popularity: textbooks, a community and libraries for any case","The standard library has files, time, networking, text: batteries included"],"frames":[[{"t":"code","id":"code","x":14.0,"y":40.0,"lines":["for name in names:","    if name.startswith(\"A\"):","        print(name)"],"lang":"python","size":9.0,"lh":17.0,"w":160.0},{"t":"code","id":"d","x":186.0,"y":36.0,"lines":["for (i = 0; i < n; i++) {","  if (names[i][0] == 'A') {","    printf(\"%s\\n\", names[i]);","  }","}"],"lang":"c","size":7.5,"lh":14.0,"w":170.0}],[{"t":"bar","id":"b0","x":60.0,"y":124.0,"w":38.0,"hh":92.0,"max":100.0,"tone":"green","text":""},{"t":"text","id":"l0","x":60.0,"y":144.0,"text":"Python","size":8.5,"mono":true},{"t":"bar","id":"b1","x":140.0,"y":124.0,"w":38.0,"hh":78.0,"max":100.0,"tone":"blue","text":""},{"t":"text","id":"l1","x":140.0,"y":144.0,"text":"JavaScript","size":8.5,"mono":true},{"t":"bar","id":"b2","x":220.0,"y":124.0,"w":38.0,"hh":64.0,"max":100.0,"tone":"blue","text":""},{"t":"text","id":"l2","x":220.0,"y":144.0,"text":"Java","size":8.5,"mono":true},{"t":"bar","id":"b3","x":300.0,"y":124.0,"w":38.0,"hh":56.0,"max":100.0,"tone":"blue","text":""},{"t":"text","id":"l3","x":300.0,"y":144.0,"text":"C","size":8.5,"mono":true},{"t":"text","id":"t","x":180.0,"y":18.0,"text":"rough popularity","size":9.0}],[{"t":"cell","id":"m0","x":70.0,"y":48.0,"w":96.0,"h":28.0,"text":"files","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"m1","x":180.0,"y":48.0,"w":96.0,"h":28.0,"text":"time","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"m2","x":290.