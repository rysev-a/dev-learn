ze":8.5}],[{"t":"cell","id":"a","x":100.0,"y":40.0,"w":140.0,"h":28.0,"text":"if … else","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":100.0,"y":80.0,"w":140.0,"h":28.0,"text":"for … in …","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"cell","id":"c","x":100.0,"y":120.0,"w":140.0,"h":28.0,"text":"while …","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"text","id":"n","x":280.0,"y":80.0,"text":"choice\nand repeat","size":10.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":120.0,"h":34.0,"text":"def area(r): …","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":130.0,"h":34.0,"text":"class Dog: …","tone":"blue","size":10.0,"sub_size":8.5},{"t":"text","id":"t1","x":90.0,"y":108.0,"text":"function","size":9.0},{"t":"text","id":"t2","x":270.0,"y":108.0,"text":"class","size":9.0}]],"cues":[12.5,23.8]}]},{"title":"Variables and types","sub":"Name and value","main":"A variable is a name for a value; the type defines allowed operations.","body":[{"t":"scene","labels":["Name and value","Value types","Collections"],"captions":["A variable is a name that holds a value: age = 34 creates a number, and the name age points to it","Types: integers, floats, strings, logical «true» and «false»; the type defines allowed operations","Collections: a list holds a sequence, a dictionary links keys to values, a set holds unique elements"],"frames":[[{"t":"cell","id":"v","x":80.0,"y":66.0,"w":70.0,"h":36.0,"text":"age\n","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"x","x":240.0,"y":66.0,"w":70.0,"h":36.0,"text":"34","tone":"yellow","size":14.0,"sub_size":8.5},{"t":"line","id":"e","x1":118.0,"y1":66.0,"x2":202.0,"y2":66.0,"tone":"green","arrow":true,"width":1.6},{"t":"code","id":"code","x":14.0,"y":118.0,"lines":["age = 34"],"lang":"python","size":10.5,"lh":16.0,"w":120.0}],[{"t":"cell","id":"t0","x":52.0,"y":66.0,"w":78.0,"h":44.0,"text":"34\nint","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"t1","x":13