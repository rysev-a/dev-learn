4.0,"w":300.0}],[{"t":"code","id":"c","x":24.0,"y":48.0,"lines":["class Positive:","    def __get__(self, obj, objtype):","        ...","    def __set__(self, obj, value):","        ..."],"hl":[1,3],"lang":"python","size":10.5,"lh":20.0,"w":310.0}],[{"t":"cell","id":"o","x":56.0,"y":70.0,"w":70.0,"h":30.0,"text":"order\n.price","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c~cell","x":160.0,"y":70.0,"w":70.0,"h":30.0,"text":"Order\n(class)","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"d","x":280.0,"y":70.0,"w":100.0,"h":30.0,"text":"Positive\n__get__","tone":"green","size":10.0,"sub_size":8.5},{"t":"line","id":"e1","x1":94.0,"y1":70.0,"x2":124.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":196.0,"y1":70.0,"x2":228.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[13.3,22.4]}]},{"title":"Data and non-data","sub":"Access priority","short":"Priority","main":"A data descriptor outranks the instance dict.","body":[{"t":"scene","labels":["First","Second","Third"],"captions":["A data descriptor (has __set__ or __delete__) outranks all: reads and writes go through it","Then the instance dict obj.__dict__","A non-data descriptor (only __get__) and a plain class value come last, so a method can be shadowed on an instance"],"frames":[[{"t":"cell","id":"a","x":180.0,"y":36.0,"w":240.0,"h":28.0,"text":"1. data descriptor","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":76.0,"w":240.0,"h":28.0,"text":"2. obj.__dict__","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":116.0,"w":240.0,"h":28.0,"text":"3. non-data / class value","tone":"muted","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":180.0,"y":36.0,"w":240.0,"h":28.0,"text":"1. data descriptor","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":76.0,"w":240.0,"h":28.0,"text":"2. obj.__dict__","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":116.0,"w":240.0,"h":28.0,"text":"3. non-data / class value","tone":"muted","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":180.0,"y":36.0,"w":240.0,"h":28.0,"text":"1. data descriptor","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":76.0,"w":240.0,"h":28.0,"text":"2. obj.__dict__","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":116.0,"w":240.0,"h":28.0,"text":"3. non-data / class value","tone":"green","size":10.0,"sub_size":8.5}]],"cues":[10.4,24.8]}]},{"title":"Functions are descriptors","sub":"Where self comes from","short":"Where self comes from","main":"function.__get__ returns a bound method.","body":[{"t":"scene","labels":["Via instance","Bound method","Via class","Others"],"captions":["obj.method: the class holds a plain function, and it has __get__","func.__get__(obj, cls) returns a bound method: it remembers obj and passes it first, hence self","Via the class the function is returned as is: Cls.method is a plain function","classmethod passes the class, staticmethod passes nothing; both are descriptors too"],"frames":[[{"t":"code","id":"c","x":70.0,"y":50.0,"lines":["obj.method","# → type(obj).method.__get__(obj, type(obj))"],"lang":"python","size":11.0,"lh":26.0,"w":300.0}],[{"t":"cell","id":"f","x":70.0,"y":70.0,"w":80.0,"h":30.0,"text":"function","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"m","x":280.0,"y":70.0,"w":120.0,"h":30.0,"text":"bound method\n(obj remembered)","tone":"green","size":9.0,"sub_size":8.5},{"t":"line","id":"e","x1":112.0,"y1":70.0,"x2":218.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":56.0,"text":"__get__","size":10.0}],[{"t":"code","id":"c","x":60.0,"y":56.0,"lines":["Cls.method","# a plain function: we pass self ourselves","Cls.method(obj)"],"lang":"python","size":11.0,"lh":24.0,"w":300.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":110.0,"h":28.0,"text":"classmethod","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":100.0,"w":110.0,"h":28.0,"text":"staticmethod","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"cell","id":"c~cell","x":260.0,"y":60.0,"w":110.0,"h":28.0,"text":"will pass cls","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"d","x":260.0,"y":100.0,"w":110.0,"h":28.0,"text":"won't pass","tone":"muted","size":10.0,"sub_size":8.5},{"t":"line","id":"e1","x1":146.0,"y1":60.0,"x2":202.0,"y2":60.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":146.0,"y1":100.0,"x2":202.0,"y2":100.0,"tone":"muted","arrow":true,"width":1.6}]],"cues":[6.7,17.6,33.1]}]},{"title":"Own descriptor","sub":"Validation in one place","short":"Own descriptor","main":"__set_name__ tells the field name.","body":[{"t":"scene","labels":["Validator class","__set_name__","Usage"],"captions":["A data descriptor describes \"number is positive\" once and fits any field","__set_name__ runs at class creation and tells the field name the descriptor sits under","Fields take one line, and the check lives in one place"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["class Positive:","    def __set__(self, obj, value):","        if value <= 0:","            raise ValueError","        obj.__dict__[self.name] = value","    def __get__(self, obj, objtype=None):","        return obj.__dict__[self.name]"],"hl":[1,2,3,4],"lang":"python","size":9.5,"lh":17.0,"w":320.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["def __set_name__(self, owner, name):","    self.name = name","# Order: price = Positive()","#   → name = 'price'"],"hl":[0,1],"lang":"python","size":10.5,"lh":24.0,"w":310.0}],[{"t":"code","id":"c","x":30.0,"y":46.0,"lines":["class Order:","    price = Positive()","    qty = Positive()","o = Order(); o.price = 5","o.qty = -1     # ValueError"],"hl":[3],"bad":[4],"lang":"python","size":10.5,"lh":22.0,"w":300.0}]],"cues":[12.1,23.6]}]},{"title":"Where to store the value","sub":"The main trap","short":"Storage","main":"One descriptor per class: store values in the instance.","body":[{"t":"scene","labels":["Shared value","Bug","In the instance"],"captions":["A descriptor belongs to the class, not the instance: one for all","Store the value in the descriptor and one order changes another's price","Store it in the instance: in obj.__dict__ or an underscore attribute"],"frames":[[{"t":"cell","id":"d","x":180.0,"y":40.0,"w":110.0,"h":28.0,"text":"Positive()","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"cell","id":"a","x":100.0,"y":112.0,"w":80.0,"h":28.0,"text":"order A","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":260.0,"y":112.0,"w":80.0,"h":28.0,"text":"order B","tone":"blue","size":10.5,"sub_size":8.5},{"t":"line","id":"e1","x1":150.0,"y1":54.0,"x2":120.0,"y2":98.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":210.0,"y1":54.0,"x2":240.0,"y2":98.0,"tone":"yellow","arrow":true,"width":1.6}],[{"t":"cell","id":"d","x":180.0,"y":40.0,"w":150.0,"h":28.0,"text":"self.value = 5","tone":"red","size":11.0,"sub_size":8.5},{"t":"cell","id":"a","x":100.0,"y":112.0,"w":80.0,"h":28.0,"text":"A.price → 5","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":260.0,"y":112.0,"w":80.0,"h":28.0,"text":"B.price → 5","tone":"red","size":9.0,"sub_size":8.5},{"t":"line","id":"e1","x1":150.0,"y1":54.0,"x2":120.0,"y2":98.0,"tone":"red","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":210.0,"y1":54.0,"x2":240.0,"y2":98.0,"tone":"red","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":148.0,"text":"shared state for all","tone":"red","size":9.5}],[{"t":"cell","id":"d","x":180.0,"y":40.0,"w":110.0,"h":28.0,"text":"Positive()","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"cell","id":"a","x":100.0,"y":112.0,"w":90.0,"h":34.0,"text":"A.__dict__\nprice=5","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":260.0,"y":112.0,"w":90.0,"h":34.0,"text":"B.__dict__\nprice=9","tone":"green","size":9.0,"sub_size":8.5},{"t":"line","id":"e1","x1":150.0,"y1":54.0,"x2":120.0,"y2":92.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":210.0,"y1":54.0,"x2":240.0,"y2":92.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[13.9,20.4]}]},{"title":"cached_property","sub":"A lazy value","short":"cached_property","main":"The result lands in __dict__ and displaces the descriptor.","body":[{"t":"scene","labels":["First time","In the dict","Second time"],"captions":["@cached_property is a non-data descriptor: on first access the function computes the value","The result is written to obj.__dict__ under the same name","Lookup then finds it in the dict before the descriptor, no rerun; del obj.attr resets the cache"],"frames":[[{"t":"code","id":"c","x":24.0,"y":44.0,"lines":["from functools import cached_property","class Report:","    @cached_property","    def total(self):","        return heavy()"],"hl":[2,3,4],"lang":"python","size":10.0,"lh":20.0,"w":320.0}],[{"t":"cell","id":"d","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"total()\ncomputed","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"o","x":270.0,"y":70.0,"w":120.0,"h":34.0,"text":"r.__dict__\n{'total': 42}","tone":"green","size":9.5,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":70.0,"x2":208.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"cell","id":"o","x":180.0,"y":56.0,"w":150.0,"h":34.0,"text":"r.__dict__\n{'total': 42}","tone":"green","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"r.total comes from the dict, heavy() isn't called","size":10.0}]],"cues":[14.7,26.6]}]},{"title":"Lookup order","sub":"The full picture","short":"Lookup order","main":"Class → dict → class → __getattr__.","body":[{"t":"scene","labels":["Class and MRO","Dict","Class value","Fallback"],"captions":["First look for the name in the class and its parents; a data descriptor decides at once","Otherwise check obj.__dict__","Otherwise a non-data descriptor or plain class value","Found nowhere: __getattr__ (if any), then AttributeError"],"frames":[[{"t":"cell","id":"a","x":180.0,"y":30.0,"w":230.0,"h":24.0,"text":"1. type(obj).__mro__: data descriptor","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":64.0,"w":230.0,"h":24.0,"text":"2. obj.__dict__","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":98.0,"w":230.0,"h":24.0,"text":"3. non-data / class value","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"d","x":180.0,"y":132.0,"w":230.0,"h":24.0,"text":"4. __getattr__ → AttributeError","tone":"muted","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":180.0,"y":30.0,"w":230.0,"h":24.0,"text":"1. type(obj).__mro__: data descriptor","tone":"muted","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":64.0,"w":230.0,"h":24.0,"text":"2. obj.__dict__","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":98.0,"w":230.0,"h":24.0,"text":"3. non-data / class value","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"d","x":180.0,"y":132.0,"w":230.0,"h":24.0,"text":"4. __getattr__ → AttributeError","tone":"muted","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":180.0,"y":30.0,"w":230.0,"h":24.0,"text":"1. type(obj).__mro__: data descriptor","tone":"muted","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":64.0,"w":230.0,"h":24.0,"text":"2. obj.__dict__","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":98.0,"w":230.0,"h":24.0,"text":"3. non-data / class value","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"d","x":180.0,"y":132.0,"w":230.0,"h":24.0,"text":"4. __getattr__ → AttributeError","tone":"muted","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":180.0,"y":30.0,"w":230.0,"h":24.0,"text":"1. type(obj).__mro__: data descriptor","tone":"muted","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":64.0,"w":230.0,"h":24.0,"text":"2. obj.__dict__","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":180.0,"y":98.0,"w":230.0,"h":24.0,"text":"3. non-data / class value","tone":"muted","size":10.0,"sub_size":8.5},{"t":"cell","id":"d","x":180.0,"y":132.0,"w":230.0,"h":24.0,"text":"4. __getattr__ → AttributeError","tone":"yellow","size":10.0,"sub_size":8.5}]],"cues":[7.4,19.2,29.1]}]},{"title":"__slots__","sub":"Memory instead of a dict","short":"slots","main":"Fixed fields without __dict__.","body":[{"t":"scene","labels":["A dict for each","__slots__","Rigidity"],"captions":["By default each object has an attribute dict: flexible, but costs memory","__slots__ = ('x', 'y') reserves space for those fields, no dict; fields are member descriptors","The price is rigidity: no new attributes, and a subclass without slots gets the dict back"],"frames":[[{"t":"cell","id":"o","x":90.0,"y":70.0,"w":100.0,"h":34.0,"text":"Point","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"d","x":250.0,"y":70.0,"w":130.0,"h":34.0,"text":"__dict__\n{'x': 1, 'y': 2}","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"line","id":"e","x1":142.0,"y1":70.0,"x2":182.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6}],[{"t":"code","id":"c","x":24.0,"y":40.0,"lines":["class Point:","    __slots__ = ('x', 'y')","    def __init__(self, x, y):","        self.x = x","        self.y = y"],"hl":[1],"lang":"python","size":10.5,"lh":20.0,"w":300.0},{"t":"cell","id":"s","x":280.0,"y":128.0,"w":120.0,"h":24.0,"text":"fields x, y only","tone":"green","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":30.0,"y":50.0,"lines":["p = Point(1, 2)","p.z = 3     # AttributeError","p.__dict__  # AttributeError"],"bad":[1,2],"lang":"python","size":11.0,"lh":26.0,"w":300.0}]],"cues":[8.4,23.9]}]},{"title":"When slots are needed","sub":"Millions of objects","short":"When slots","main":"Measure first, optimize later.","body":[{"t":"scene","labels":["Millions of objects","dataclass","Measure first"],"captions":["Millions of light objects (points, tree nodes, events): slots cut memory 