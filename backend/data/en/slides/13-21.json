{"book":13,"chapter":21,"rubric":"PYTHON AS A FIRST LANGUAGE / THE DATA MODEL / CHAPTER 21","slides":[{"title":"One mechanism","sub":"Where methods and properties come from","short":"One mechanism","main":"property, methods and slots work through descriptors.","body":[{"t":"scene","labels":["Familiar things","One mechanism","Descriptors"],"captions":["property, methods, classmethod, staticmethod, __slots__: seemingly different things","All work through one mechanism: attribute access is delegated to an object in the class","This mechanism is descriptors, and it explains, e.g., where self comes from"],"frames":[[{"t":"cell","id":"b0","x":62.0,"y":48.0,"w":100.0,"h":26.0,"text":"property","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"b1","x":180.0,"y":48.0,"w":100.0,"h":26.0,"text":"methods","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"b2","x":298.0,"y":48.0,"w":100.0,"h":26.0,"text":"classmethod","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"b3","x":62.0,"y":88.0,"w":100.0,"h":26.0,"text":"staticmethod","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"b4","x":180.0,"y":88.0,"w":100.0,"h":26.0,"text":"__slots__","tone":"blue","size":10.5,"sub_size":8.5}],[{"t":"cell","id":"b0","x":62.0,"y":48.0,"w":100.0,"h":26.0,"text":"property","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"b1","x":180.0,"y":48.0,"w":100.0,"h":26.0,"text":"methods","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"b2","x":298.0,"y":48.0,"w":100.0,"h":26.0,"text":"classmethod","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"b3","x":62.0,"y":88.0,"w":100.0,"h":26.0,"text":"staticmethod","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"b4","x":180.0,"y":88.0,"w":100.0,"h":26.0,"text":"__slots__","tone":"green","size":10.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":132.0,"text":"one mechanism","tone":"green","size":10.0}],[{"t":"cell","id":"d","x":180.0,"y":60.0,"w":190.0,"h":34.0,"text":"des