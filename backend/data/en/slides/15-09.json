"t2","x":300.0,"y":85.0,"text":"RST","tone":"red","size":12.0},{"t":"text","id":"t3","x":300.0,"y":120.0,"text":"silence","tone":"yellow","size":12.0},{"t":"text","id":"t4","x":300.0,"y":150.0,"text":"with always closes","tone":"green","size":8.5}]],"cues":[11.6,19.8,28.4]},{"t":"note","text":"Leaked sockets kill a server in a week."}]},{"title":"Thread per Client","sub":"The simplest server","short":"Thread per client","main":"A thread per client is simple and reliable for hundreds of connections, but heavy for tens of thousands.","body":[{"t":"scene","labels":["First","Second","Third","Cost"],"captions":["The main thread accepts a connection and starts a thread for the client","Next client, next thread; blocking does not bother the others","The code is simple and straightforward","But each thread drags a stack and switches: tens of thousands of clients is too much"],"frames":[[{"t":"cell","id":"l","x":50.0,"y":85.0,"w":60.0,"h":26.0,"text":"accept","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"c0","x":300.0,"y":40.0,"w":60.0,"h":24.0,"text":"client 1","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"c1","x":300.0,"y":85.0,"w":60.0,"h":24.0,"text":"client 2","tone":"blue","size":9.0,"sub_size":8.5,"o":0.2},{"t":"cell","id":"c2","x":300.0,"y":130.0,"w":60.0,"h":24.0,"text":"client 3","tone":"blue","size":9.0,"sub_size":8.5,"o":0.2},{"t":"line","id":"a0","x1":82.0,"y1":85.0,"x2":268.0,"y2":40.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"a1","x1":82.0,"y1":85.0,"x2":268.0,"y2":85.0,"tone":"muted","width":1.6,"o":0.2},{"t":"line","id":"a2","x1":82.0,"y1":85.0,"x2":268.0,"y2":130.0,"tone":"muted","width":1.6,"o":0.2}],[{"t":"cell","id":"l","x":50.0,"y":85.0,"w":60.0,"h":26.0,"text":"accept","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"c0","x":300.0,"y":40.0,"w":60.0,"h":24.0,"text":"client 1","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"c1","x":300.0,"y":85.0,"w":60.0,"h":24.0,"text":"client 2","tone":