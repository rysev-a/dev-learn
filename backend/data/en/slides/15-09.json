, 80))","s.sendall(b'GET / HTTP/1.0\\r\\n\\r\\n')","data = s.recv(4096)","s.close()"],"hl":[4],"lang":"python","size":8.5,"lh":13.0,"w":200.0},{"t":"text","id":"t","x":300.0,"y":70.0,"text":"sendall","tone":"green","size":13.0}],[{"t":"code","id":"c","x":40.0,"y":30.0,"lines":["import socket","","s = socket.socket()","s.connect((host, 80))","s.sendall(b'GET / HTTP/1.0\\r\\n\\r\\n')","data = s.recv(4096)","s.close()"],"hl":[6],"lang":"python","size":8.5,"lh":13.0,"w":200.0},{"t":"text","id":"t","x":300.0,"y":70.0,"text":"close","tone":"green","size":13.0}]],"cues":[6.6,15.7,25.2]},{"t":"note","text":"Always close the socket, preferably with with."}]},{"title":"TCP Server","sub":"bind, listen, accept","short":"TCP Server","main":"The server binds a socket and listens; accept returns a new socket for each client.","body":[{"t":"scene","labels":["bind","listen","accept","Loop"],"captions":["bind attaches the socket to an address and port","listen switches to waiting mode; the number is the queue length","accept blocks until someone connects and returns the client's new socket","The listening socket stays and accepts the next ones"],"frames":[[{"t":"code","id":"c","x":30.0,"y":30.0,"lines":["srv = socket.socket()","srv.bind(('0.0.0.0', 8080))","srv.listen(50)","","while True:","    conn, addr = srv.accept()","    ...  # talk to the client","    conn.close()"],"hl":[1],"lang":"python","size":8.5,"lh":13.0,"w":200.0}],[{"t":"code","id":"c","x":30.0,"y":30.0,"lines":["srv = socket.socket()","srv.bind(('0.0.0.0', 8080))","srv.listen(50)","","while True:","    conn, addr = srv.accept()","    ...  # talk to the client","    conn.close()"],"hl":[2],"lang":"python","size":8.5,"lh":13.0,"w":200.0},{"t":"text","id":"t","x":300.0,"y":60.0,"text":"queue of\nwaiting","tone":"yellow","size":9.0}],[{"t":"code","id":"c","x":30.0,"y":30.0,"lines":["srv = socket.socket()","srv.bind(('0.0.0.0', 8080))","srv.listen(50)","","while True:","    conn, addr = srv.accept()","    ...  # talk to the client","    conn.close()"],"hl":[5],"lang":"python","size":8.5,"lh":13.0,"w":200.0},{"t":"text","id":"t","x":300.0,"y":60.0,"text":"queue of\nwaiting","tone":"yellow","size":9.0},{"t":"text","id":"t3","x":300.0,"y":120.0,"text":"accept gives a\nNEW socket\nfor the client","tone":"green","size":9.0}],[{"t":"code","id":"c","x":30.0,"y":30.0,"lines":["srv = socket.socket()","srv.bind(('0.0.0.0', 8080))","srv.listen(50)","","while True:","    conn, addr = srv.accept()","    ...  # talk to the client","    conn.close()"],"hl":[5],"lang":"python","size":8.5,"lh":13.0,"w":200.0},{"t":"text","id":"t","x":300.0,"y":60.0,"text":"queue of\nwaiting","tone":"yellow","size":9.0},{"t":"text","id":"t3","x":300.0,"y":120.0,"text":"accept gives a\nNEW socket\nfor the client","tone":"green","size":9.0}]],"cues":[9.8,14.2,27.6]},{"t":"note","text":"The number in listen is the length of the queue of unaccepted connections."}]},{"title":"A Stream, Not Messages","sub":"The recv trap","short":"Byte stream","main":"recv returns whatever has piled up: you must invent message boundaries yourself.","body":[{"t":"scene","labels":["Three writes","In one piece","In chunks","Boundaries"],"captions":["Three writes of 100 bytes","The reader may get it all at once","Or in parts: exactly as much as has piled up","An empty result is the end; message boundaries you must invent yourself"],"frames":[[{"t":"cell","id":"w0","x":60.0,"y":30.0,"w":50.0,"h":18.0,"text":"100 B","tone":"blue","size":8.0,"sub_size":8.5},{"t":"cell","id":"w1","x":120.0,"y":30.0,"w":50.0,"h":18.0,"text":"100 B","tone":"blue","size":8.0,"sub_size":8.5},{"t":"cell","id":"w2","x":180.0,"y":30.0,"w":50.0,"h":18.0,"text":"100 B","tone":"blue","size":8.0,"sub_size":8.5},{"t":"text","id":"t1","x":270.0,"y":30.0,"text":"3 × send","tone":"blue","size":9.5}],[{"t":"cell","id":"w0","x":60.0,"y":30.0,"w":50.0,"h":18.0,"text":"100 B","tone":"blue","size":8.0,"sub_size":8.5},{"t":"cell","id":"w1","x":120.0,"y":30.0,"w":50.0,"h":18.0,"text":"1