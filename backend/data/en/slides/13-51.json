{"book":13,"chapter":51,"rubric":"PYTHON AS A FIRST LANGUAGE / PROJECTS AND TOOLING / CHAPTER 51","slides":[{"title":"What quality is","sub":"Read more than written","short":"Quality","main":"Quality is habits and automatic checks.","body":[{"t":"scene","labels":["Read more than written","Made of small things","What we cover"],"captions":["Code is read more than written and changed more than read: good code is clear, tested and safe to change","Quality is not heroics at the end, but small habits and automatic checks on every change","Style and checks, tests, docs, errors, principles and patterns, refactoring"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"write","tone":"blue","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":110.0,"h":30.0,"text":"read ×10","tone":"green","size":12.0,"sub_size":8.5}],[{"t":"cell","id":"h0","x":50.0,"y":70.0,"w":46.0,"h":26.0,"text":"✓","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"h1","x":102.0,"y":70.0,"w":46.0,"h":26.0,"text":"✓","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"h2","x":154.0,"y":70.0,"w":46.0,"h":26.0,"text":"✓","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"h3","x":206.0,"y":70.0,"w":46.0,"h":26.0,"text":"✓","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"h4","x":258.0,"y":70.0,"w":46.0,"h":26.0,"text":"✓","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"h5","x":310.0,"y":70.0,"w":46.0,"h":26.0,"text":"✓","tone":"green","size":12.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":116.0,"text":"every change passes the checks","size":10.5}],[{"t":"cell","id":"b0","x":62.0,"y":54.0,"w":104.0,"h":26.0,"text":"style","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"b1","x":180.0,"y":54.0,"w":104.0,"h":26.0,"text":"tests","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"b2","x":298.0,"y":54.0,"w":104.0,"h":26.0,"text":"docs","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell",