o to the table","size":9.5}],[{"t":"cell","id":"i","x":110.0,"y":76.0,"w":170.0,"h":30.0,"text":"index (customer_id, status)","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"t","x":310.0,"y":76.0,"w":70.0,"h":30.0,"text":"table","tone":"muted","size":9.0,"sub_size":8.5,"o":0.35},{"t":"text","id":"n","x":180.0,"y":116.0,"text":"COVERING INDEX: no table needed","tone":"green","size":9.5}],[{"t":"bar","id":"a","x":110.0,"y":130.0,"w":50.0,"hh":40.0,"max":100.0,"tone":"blue","text":"narrow"},{"t":"bar","id":"b","x":250.0,"y":130.0,"w":50.0,"hh":90.0,"max":100.0,"tone":"yellow","text":"wide"},{"t":"text","id":"t~text","x":180.0,"y":14.0,"text":"index size","size":9.0}]],"cues":[15.5,26.9]}]},{"title":"Selectivity","sub":"Partial indexes","short":"Selectivity","main":"The more a condition filters out, the more useful the index.","body":[{"t":"scene","labels":["Low selectivity","High","Partial index"],"captions":["An index on gender (2 values) filters out half the table — almost useless","An index on a unique number filters out all but one row — ideal","Partial index WHERE status = 'new' stores only the needed share of rows: compact and fast"],"frames":[[{"t":"bar","id":"a","x":120.0,"y":130.0,"w":60.0,"hh":50.0,"max":100.0,"tone":"red","text":"50 %"},{"t":"text","id":"l","x":120.0,"y":150.0,"text":"by gender","size":9.0},{"t":"text","id":"t","x":180.0,"y":14.0,"text":"share of rows we read","size":9.0}],[{"t":"bar","id":"a","x":120.0,"y":130.0,"w":60.0,"hh":4.0,"max":100.0,"tone":"green","text":"0,0001 %"},{"t":"text","id":"l","x":120.0,"y":150.0,"text":"by number","size":9.0},{"t":"text","id":"t","x":180.0,"y":14.0,"text":"share of rows we read","size":9.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["CREATE INDEX idx_new ON orders (created)","  WHERE status = 'new';"],"hl":[1],"lang":"sql","size":10.5,"lh":18.0,"w":320.0},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"only 1% of rows in the index","tone":"green","size":9.5}]],"cues":[13.3,30.1]}]},{"title":"Cost of indexes","sub":"Writes and space","short":"Cost","main":"Every index slows down writes and takes up space.","body":[{"t":"scene","labels":["Writes","Space","Redundant indexes"],"captions":["Every insert and update touches all the table's indexes: writes get slower","Indexes take space (sometimes more than the table) and compete for cache memory","An index on a is redundant if there is already one on (a, b); drop unused indexes"],"frames":[[{"t":"cell","id":"w","x":60.0,"y":76.0,"w":70.0,"h":28.0,"text":"INSERT","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"t","x":190.0,"y":40.0,"w":70.0,"h":22.0,"text":"table","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"i1","x":190.0,"y":76.0,"w":70.0,"h":22.0,"text":"index 1","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"i2","x":190.0,"y":112.0,"w":70.0,"h":22.0,"text":"index 2","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"i3","x":300.0,"y":76.0,"w":70.0,"h":22.0,"text":"index 3","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"line","id":"e1","x1":96.0,"y1":70.0,"x2":154.0,"y2":44.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":96.0,"y1":76.0,"x2":154.0,"y2":76.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e3","x1":96.0,"y1":82.0,"x2":154.0,"y2":108.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e4","x1":226.0,"y1":76.0,"x2":264.0,"y2":76.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"bar","id":"a","x":110.0,"y":130.0,"w":60.0,"hh":40.0,"max":100.0,"tone":"blue","text":"table"},{"t":"bar","id":"b","x":250.0,"y":130.0,"w":60.0,"hh":80.0,"max":100.0,"tone":"yellow","text":"indexes"}],[{"t":"cell","id":"a~cell","x":90.0,"y":60.0,"w":120.0,"h":26.0,"text":"idx (a)","tone":"red","size":10.0,"sub_size":8.5,"o":0.6},{"t":"cell","id":"b~cell","x":90.0,"y":100.0,"w":120.0,"h":26.0,"text":"idx (a, b)","tone":"green","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":280.0,"y":80.0,"text":"(a) — left prefix\nof (a, b): redundant","size":9.0}]],"cues":[12.6,21.3]}]},{"title":"Sorting and pagination","sub":"Keyset","short":"Pagination","main":"OFFSET reads extra rows; keyset costs the same everywhere.","body":[{"t":"scene","labels":["ORDER BY via an index","OFFSET","Keyset"],"captions":["If the index order matches ORDER BY, the database reads rows already sorted, with no temporary sort","OFFSET 100000 reads and discards all the previous rows: deep pages are slow","Keyset: remember the last key and ask for rows \"after it\" — the index costs the same on any page"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["CREATE INDEX i ON orders (created);","SELECT * FROM orders","ORDER BY created LIMIT 10;"],"hl":[2],"lang":"sql","size":10.5,"lh":18.0,"w":320.0},{"t":"text","id":"n","x":180.0,"y":120.0,"text":"no USE TEMP B-TREE FOR ORDER BY","tone":"green","size":9.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["SELECT * FROM orders","ORDER BY created LIMIT 10 OFFSET 100000;"],"hl":[1],"lang":"sql","size":10.5,"lh":18.0,"w":320.0},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"read 100,010 rows, return 10","tone":"red","size":9.5}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["SELECT * FROM orders","WHERE (created, id) > (:last_created, :last_id)","ORDER BY created, id LIMIT 10;"],"hl":[1],"lang":"sql","size":9.5,"lh":18.0,"w":330.0},{"t":"text","id":"n","x":180.0,"y":118.0,"text":"cost does not depend on the page number","tone":"green","size":9.5}]],"cues":[13.7,25.9]}]},{"title":"Joins","sub":"Nested loop, hash, merge","short":"JOIN","main":"Index foreign keys: joins become cheap.","body":[{"t":"scene","labels":["Nested loops","With an index","Hash and merge"],"captions":["Nested loops without an index: a full scan on the right for every left row, cost is the product","With an index on the join column, each right-side lookup is a few pages; that is why foreign keys are indexed","For large sets: hash join (hash table on the smaller side) or merging sorted inputs"],"frames":[[{"t":"cell","id":"a","x":70.0,"y":60.0,"w":70.0,"h":40.0,"text":"orders\n1 000","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":290.0,"y":60.0,"w":70.0,"h":40.0,"text":"items\n5 000","tone":"blue","size":10.0,"sub_size":8.5},{"t":"line","id":"e1","x1":100.0,"y1":52.0,"x2":254.0,"y2":52.0,"tone":"red","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":100.0,"y1":68.0,"x2":254.0,"y2":68.0,"tone":"red","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":112.0,"text":"1,000 × 5,000 comparisons","tone":"red","size":9.5}],[{"t":"cell","id":"a","x":70.0,"y":60.0,"w":70.0,"h":40.0,"text":"orders\n1 000","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":290.0,"y":60.0,"w":70.0,"h":40.0,"text":"items\nindex order_id","tone":"green","size":9.0,"sub_size":8.5},{"t":"line","id":"e1","x1":100.0,"y1":60.0,"x2":254.0,"y2":60.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":112.0,"text":"1,000 × a few pages","tone":"green","size":9.5}],[{"t":"cell","id":"h","x":80.0,"y":60.0,"w":100.0,"h":36.0,"text":"hash join:\nhash the smaller","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"m","x":280.0,"y":60.0,"w":100.0,"h":36.0,"text":"merge join:\nboth sorted","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":116.0,"text":"chosen by sizes and indexes","size":9.5}]],"cues":[9.6,29.6]}]},{"title":"Other indexes","sub":"hash, GIN, GiST, BRIN","short":"Others","main":"B-tree by default; the rest are for specific data.","body":[{"t":"scene","labels":["For equality and text","For geometry and blocks","Choice"],"captions":["Hash — fast exact-value lookup, no ranges; GIN — words, arrays, JSONB, full-text search","GiST — geometry and nearest neighbors; BRIN — min and max per large block, for naturally ordered data","B-tree by default; take others when the nature of the data requires it"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":50.0,"w":110.0,"h":28.0,"text":"has