","x":180.0,"y":130.0,"w":320.0,"h":24.0,"text":"cost: writes and space","tone":"red","size":9.0,"sub_size":8.5}],[{"t":"code","id":"c~code","x":20.0,"y":40.0,"lines":["EXPLAIN QUERY PLAN","SELECT ...;","-- SEARCH ... USING INDEX  ✓","-- SCAN ...                ✗"],"hl":[2],"lang":"sql","size":10.5,"lh":18.0,"w":320.0}],[{"t":"cell","id":"p","x":100.0,"y":70.0,"w":100.0,"h":30.0,"text":"pages","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"w","x":270.0,"y":70.0,"w":100.0,"h":30.0,"text":"WAL log","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"line","id":"e","x1":152.0,"y1":70.0,"x2":218.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[14.1,28.3]}]}]}