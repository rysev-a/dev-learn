e":11.0,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":70.0,"x2":210.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}],[{"t":"code","id":"c","x":40.0,"y":56.0,"lines":["class D(B, C): ...","# B before C"],"hl":[1],"lang":"python","size":12.0,"lh":30.0,"w":280.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":60.0,"h":24.0,"text":"X","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":60.0,"w":60.0,"h":24.0,"text":"Y","tone":"green","size":12.0,"sub_size":8.5},{"t":"line","id":"e","x1":120.0,"y1":60.0,"x2":150.0,"y2":60.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":112.0,"text":"X before Y — everywhere","size":10.5}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["class A: ...","class B(A): ...","class C(A, B): ...","# TypeError: Cannot create a consistent","# method resolution order (MRO)"],"hl":[2],"bad":[2,3,4],"lang":"python","size":10.5,"lh":22.0,"w":320.0}]],"cues":[7.8,19.9,26.6]}]},{"title":"super()","sub":"Next in MRO","short":"super","main":"super is not the parent, but the next in order.","body":[{"t":"scene","labels":["Not the \"parent\"","Next in MRO","Double call"],"captions":["super() is not the \"parent\": it takes the next class in the MRO of the object's own type","Object D(B, C): super() inside B passes control not to A, but to C — as in the order for D","Calling the parent by name A.f(self) in a diamond runs the common ancestor twice"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":110.0,"h":30.0,"text":"super()","tone":"yellow","size":13.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":130.0,"h":30.0,"text":"not the parent!","tone":"red","size":11.0,"sub_size":8.5}],[{"t":"cell","id":"m0","x":54.0,"y":70.0,"w":66.0,"h":28.0,"text":"D","tone":"green","size":12.0,"sub_size":8.5},{"t":"cell","id":"m1","x":138.0,"y":70.0,"w":66.0,"h":28.0,"text":"B","tone":"yellow","size":12.0,"sub_size":8.5},{"t":"cell","id":"m2","x":222.0,"y":70.0,"w":66.0,"h":28.0,"text":"C","t