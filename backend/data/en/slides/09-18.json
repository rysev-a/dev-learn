{"book":9,"chapter":18,"rubric":"DATABASES / MODEL AND RELIABILITY / CHAPTER 18","slides":[{"title":"Transfer and ACID","sub":"Chapter 18 · Transactions","short":"Introduction","main":"A transaction runs a group of operations as one whole.","body":[{"t":"scene","labels":["Transfer","Failure midway","ACID"],"captions":["A transfer is two operations: debit the sender and credit the recipient","If the server fails between them, 100 rubles vanish; a concurrent transfer can overwrite someone's change","A transaction runs a group of operations as one whole; its properties are ACID"],"frames":[[{"t":"cell","id":"a","x":70.0,"y":60.0,"w":90.0,"h":40.0,"text":"account A\n100","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":290.0,"y":60.0,"w":90.0,"h":40.0,"text":"account B\n50","tone":"blue","size":11.0,"sub_size":8.5},{"t":"line","id":"e","x1":120.0,"y1":60.0,"x2":238.0,"y2":60.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":50.0,"text":"30 ₽","size":10.0},{"t":"text","id":"m","x":180.0,"y":120.0,"text":"debit A  +  credit B","size":9.5}],[{"t":"cell","id":"a","x":70.0,"y":60.0,"w":90.0,"h":40.0,"text":"account A\n70","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":290.0,"y":60.0,"w":90.0,"h":40.0,"text":"account B\n50","tone":"red","size":11.0,"sub_size":8.5},{"t":"line","id":"e","x1":120.0,"y1":60.0,"x2":238.0,"y2":60.0,"tone":"red","arrow":true,"dash":"3 3","width":1.6},{"t":"cell","id":"x","x":180.0,"y":110.0,"w":130.0,"h":24.0,"text":"failure: 30 ₽ lost","tone":"red","size":9.5,"sub_size":8.5}],[{"t":"cell","id":"a","x":70.0,"y":40.0,"w":100.0,"h":26.0,"text":"Atomicity","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":70.0,"y":76.0,"w":100.0,"h":26.0,"text":"Consistency","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"i","x":70.0,"y":112.0,"w":100.0,"h":26.0,"text":"Isolation","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"d","x":70.0,"y":148.0,"w":100.0,"h"