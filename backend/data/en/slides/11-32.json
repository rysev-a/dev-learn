":"js","size":9.5,"lh":19.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["\"dependencies\":    { \"zod\": \"^3.22.0\" },","\"devDependencies\": { \"vite\": \"^5.0.0\" },","\"peerDependencies\":{ \"react\": \">=18\" }"],"hl":[0,1,2],"lang":"js","size":8.5,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["\"type\": \"module\",","\"exports\": {","  \".\": \"./dist/index.js\"","}"],"hl":[0,1,2],"lang":"js","size":10.0,"lh":22.0,"w":340.0}]],"cues":[12.5,25.0]}]},{"title":"Semantic versions","sub":"major.minor.patch","short":"semver","main":"MAJOR breaks compatibility, MINOR adds features, PATCH fixes bugs.","body":[{"t":"scene","labels":["Three numbers","Prerelease","Trust"],"captions":["MAJOR — breaks compatibility, MINOR — new features, PATCH — fixes","1.0.0-beta.2 < 1.0.0; +build info is ignored when comparing","The convention works while authors follow it — don't trust it fully"],"frames":[[{"t":"cell","id":"a","x":70.0,"y":70.0,"w":100.0,"h":44.0,"text":"2\nMAJOR","tone":"red","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":70.0,"w":100.0,"h":44.0,"text":"5\nMINOR","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"cell","id":"c","x":290.0,"y":70.0,"w":100.0,"h":44.0,"text":"1\nPATCH","tone":"green","size":11.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":36.0,"text":"1.0.0-beta.2","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"text","id":"l","x":180.0,"y":70.0,"text":"<","size":16.0},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":150.0,"h":36.0,"text":"1.0.0","tone":"green","size":11.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":36.0,"text":"patch broke the API?\nhappens","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":150.0,"h":36.0,"text":"lock file and tests —\nyour safety net","tone":"green","size":9.5,"sub_size":8.5}]],"cues":[12.9,25.8]}]},{"title":"Version ranges","sub":"^ ~ >= x","short":"Ranges","main":"^1.2.3 = ≥1.2.3 <2.0.0; ~1.2.3 = ≥1.2.3 <1.3.0; for 0.x the caret is stricter.","body":[{"t":"scene","labels":["Caret","Tilde","Zero versions"],"captions":["^1.2.3 → from 1.2.3 up to 2.0.0 (excluded): any update within the major","~1.2.3 → from 1.2.3 up to 1.3.0: patches only","^0.2.3 → only 0.2.x; ^0.0.3 → only 0.0.3: while the version is zero, anything may break"],"frames":[[{"t":"cell","id":"a","x":60.0,"y":80.0,"w":70.0,"h":28.0,"text":"1.2.3","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":80.0,"w":150.0,"h":28.0,"text":"1.2.4 … 1.9.0","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":300.0,"y":80.0,"w":70.0,"h":28.0,"text":"2.0.0 ✗","tone":"red","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":60.0,"y":80.0,"w":70.0,"h":28.0,"text":"1.2.3","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":80.0,"w":150.0,"h":28.0,"text":"1.2.4 … 1.2.99","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":300.0,"y":80.0,"w":70.0,"h":28.0,"text":"1.3.0 ✗","tone":"red","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":150.0,"h":28.0,"text":"^0.2.3 = >=0.2.3 <0.3.0","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":100.0,"w":150.0,"h":28.0,"text":"^0.0.3 = =0.0.3","tone":"green","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":290.0,"y":80.0,"text":"0.x is unstable","tone":"yellow","size":10.0}]],"cues":[13.1,26.2]}]},{"title":"Dependency resolution","sub":"Tree and hoisting","short":"Tree","main":"The manager builds a tree: shared versions are hoisted, conflicts are nested.","body":[{"t":"scene","labels":["Tree","Hoisting","Nesting on conflict"],"captions":["Each package has its own dependencies, and they have theirs — a tree","Shared versions are hoisted to the root node_modules: one copy for all","Incompatible versions are nested in the node_modules of the package that needs them"],"frames":[[{"t":"cell","id":"tr","x":180.0,"y":30.0,"w":70.0,"h":22.0,"text":"app","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"ta","x":110.0,"y":74.0,"w":56.0,"h":22.0,"text":"a","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"tb","x":250.0,"y":74.0,"w":56.0,"h":22.0,"text":"b","tone":"blue","size":10.0,"sub_size":8.5},{"t":"line","id":"te1","x1":160.0,"y1":42.0,"x2":120.0,"y2":62.0,"tone":"muted","arrow":true,"width":1.6},{"t":"line","id":"te2","x1":200.0,"y1":42.0,"x2":240.0,"y2":62.0,"tone":"muted","arrow":true,"width":1.6},{"t":"cell","id":"x","x":110.0,"y":138.0,"w":56.0,"h":20.0,"text":"x@1","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"y","x":250.0,"y":138.0,"w":56.0,"h":20.0,"text":"x@1","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"line","id":"e3","x1":110.0,"y1":118.0,"x2":110.0,"y2":128.0,"tone":"muted","arrow":true,"width":1.6},{"t":"line","id":"e4","x1":250.0,"y1":118.0,"x2":250.0,"y2":128.0,"tone":"muted","arrow":true,"width":1.6}],[{"t":"cell","id":"r","x":180.0,"y":40.0,"w":160.0,"h":28.0,"text":"app/node_modules","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"a","x":110.0,"y":100.0,"w":50.0,"h":22.0,"text":"a","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":100.0,"w":50.0,"h":22.0,"text":"b","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"x","x":250.0,"y":100.0,"w":60.0,"h":22.0,"text":"x@1","tone":"green","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":140.0,"text":"one copy of x@1 for a and b","size":9.5}],[{"t":"cell","id":"r","x":120.0,"y":40.0,"w":200.0,"h":28.0,"text":"node_modules: a, b, x@1","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"n~cell","x":280.0,"y":100.0,"w":130.0,"h":40.0,"text":"b/node_modules/x@2\n(b needs it)","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"line","id":"e","x1":200.0,"y1":54.0,"x2":250.0,"y2":84.0,"tone":"muted","arrow":true,"width":1.6}]],"cues":[12.5,25.0]}]},{"title":"Lock file","sub":"Reproducibility","short":"Lock file","main":"The lock fi