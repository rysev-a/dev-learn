.0,"w":54.0,"h":26.0,"text":"04","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"cell","id":"b1","x":116.0,"y":60.0,"w":54.0,"h":26.0,"text":"03","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b2","x":172.0,"y":60.0,"w":54.0,"h":26.0,"text":"02","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b3","x":228.0,"y":60.0,"w":54.0,"h":26.0,"text":"01","tone":"blue","size":9.5,"sub_size":8.5},{"t":"text","id":"a","x":60.0,"y":100.0,"text":"address 0","size":9.0,"mono":true},{"t":"text","id":"b","x":276.0,"y":100.0,"text":"address 3","size":9.0,"mono":true},{"t":"text","id":"n","x":180.0,"y":130.0,"text":"lowest byte at the lowest address","size":9.5}],[{"t":"cell","id":"b0","x":60.0,"y":60.0,"w":54.0,"h":26.0,"text":"01","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"cell","id":"b1","x":116.0,"y":60.0,"w":54.0,"h":26.0,"text":"02","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"b2","x":172.0,"y":60.0,"w":54.0,"h":26.0,"text":"03","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"b3","x":228.0,"y":60.0,"w":54.0,"h":26.0,"text":"04","tone":"green","size":9.5,"sub_size":8.5},{"t":"text","id":"a","x":60.0,"y":100.0,"text":"address 0","size":9.0,"mono":true},{"t":"text","id":"b","x":276.0,"y":100.0,"text":"address 3","size":9.0,"mono":true},{"t":"text","id":"n","x":180.0,"y":130.0,"text":"highest byte at the lowest address","size":9.5}],[{"t":"code","id":"c","x":10.0,"y":30.0,"lines":["uint32_t swap32(uint32_t x) {","    return x >> 24 | (x >> 8 & 0xFF00) |","           (x << 8 & 0xFF0000) | x << 24;","}"],"hl":[1,2],"lang":"c","size":9.0,"lh":20.0,"w":345.0}]],"cues":[15.1,28.7]}]},{"title":"Access to representation","sub":"Aliasing and memcpy","short":"memcpy","main":"A different representation: copy the bytes.","body":[{"t":"scene","labels":["Reading bytes is fine","Pointer casts","memcpy"],"captions":["A pointer to unsigned char may look at any object: that is how you read a representation byte by byte","float through an int * breaks strict aliasing: the optimizer may assume no overlap and emit wrong code","Safe: memcpy into a variable of the right type (the compiler makes it one instruction) or a union"],"frames":[[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["float f = 1.0f;","unsigned char *p = (unsigned char *)&f;","// p[0..3] are the bytes of the number"],"hl":[1],"lang":"c","size":9.5,"lh":22.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["float f = 1.0f;","int bits = *(int *)&f;   // ✕ UB"],"bad":[1],"lang":"c","size":11.0,"lh":26.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["uint32_t bits;","memcpy(&bits, &f, sizeof bits);   // ✓","union { float f; uint32_t u; } v = { f };"],"hl":[1,2],"lang":"c","size":9.5,"lh":24.0,"w":340.0}]],"cues":[12.8,25.9]}]},{"title":"Alignment","sub":"Padding in structs","short":"Alignment","main":"Fields from large to small; packed is costly.","body":[{"t":"scene","labels":["Padding","Field order","packed"],"captions":["The compiler inserts padding between fields and a tail at the end, so every field and array element stays aligned","Large-to-small order shrinks a struct: {char, int, char} is 12 bytes, {int, char, char} is 8","The packed attribute removes padding, but access is slower, and on some processors impossible"],"frames":[[{"t":"cell","id":"a","x":70.0,"y":70.0,"w":36.0,"h":26.0,"text":"char","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"p","x":120.0,"y":70.0,"w":60.0,"h":26.0,"text":"padding","tone":"muted","size":8.5,"sub_size":8.5},{"t":"cell","id":"b","x":200.0,"y":70.0,"w":60.0,"h":26.0,"text":"int","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"c","x":260.0,"y":70.0,"w":40.0,"h":26.0,"text":"char","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"t","x":322.0,"y":70.0,"w":40.0,"h":26.0,"text":"tail","tone":"muted","size":8.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":116.0,"text":"sizeof = 12","size":10.0,"mono":true}],[{"t":"code","id":"c~code","x":10.0,"y":30.0,"lines":["struct a { char c; int i; char d; };   // 12","struct b { int i; char c, d; };      //  8","alignof(int)        // 4","offsetof(struct a, d)   // 8"],"hl":[1],"lang":"c","size":9.0,"lh":22.0,"w":345.0}],[{"t":"code","id":"c~code","x":20.0,"y":40.0,"lines":["struct __attribute__((packed)) p {","    char c; int i;","};   // 5 bytes, i at offset 1"],"hl":[0],"lang":"c","size":10.0,"lh":22.0,"w":330.0}]],"cues":[19.2,29.6]}]},{"title":"Bit operations","sub":"Masks and shifts","short":"Bits","main":"A shift by the type width or more is UB.","body":[{"t":"scene","labels":["Operations","Masks","Risky shifts"],"captions":["& | ^ ~ << >>: shifting left by n multiplies by 2ⁿ, right divides by 2ⁿ","Set a bit: x |= 1u << n; clear: x &= ~(1u << n); test: (x >> n) & 1","Shifting by the type width or more, or a negative value left, is UB; signed right shift is not guaranteed"],"frames":[[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["0b1100 & 0b1010   // 0b1000","0b1100 | 0b1010   // 0b1110","0b1100 ^ 0b1010   // 0b0110","1u << 5            // 32"],"lang":"c","size":10.0,"lh":22.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["x |=  1u << n;","x &= ~(1u << n);","int on = (x >> n) & 1;"],"lang":"c","size":11.0,"lh":24.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["1u << 32;      // ✕ UB","-1 << 1;        // ✕ UB","x >> 31;        // signed: depends"],"bad":[0,1],"lang":"c","size":10.0,"lh":24.0,"w":320.0}]],"cues":[12.4,26.6]}]},{"title":"Bit tricks","sub":"x & (x − 1)","short":"Tricks","main":"Built-in popcount, clz, ctz beat hand-made loops.","body":[{"t":"scene","labels":["x & (x − 1)","x & −x","Built-in functions"],"captions":["x & (x − 1) clears the lowest set bit: counting ones takes as many steps as there are ones, a power of two is a test for zero","x & −x isolates the lowest set bit; rounding to a power of two is a cascade of ORs and shifts","__builtin_popcount, __builtin_clz and __builtin_ctz become one instruction: better than hand-made loops"],"frames":[[{"t":"code","id":"c","x":10.0,"y":36.0,"lines":["int is_pow2(unsigned x) {","    return x && !(x & (x - 1));","}"],"hl":[1],"lang":"c","size":10.0,"lh":22.0,"w":340.0},{"t":"text","id":"n","x":180.0,"y":118.0,"text":"0b0110 & 0b0101 = 0b0100","size":9.5,"mono":true}],[{"t":"code","id":"c","x":10.0,"y":30.0,"lines":["unsigned low = x & -x;   // 0b0110 → 0b0010","x--; x |= x >> 1; x |= x >> 2;","x |= x >> 4; x |= x >> 8; x |= x >> 16;","x++;   // up to a power of two"],"hl":[0,3],"lang":"c","size":8.5,"lh":22.0,"w":345.0}],[{"t":"code","id":"c","x":10.0,"y":40.0,"lines":["__builtin_popcount(x)   // number of ones","__builtin_clz(x)        // leading zeros","__builtin_ctz(x)        // trailing zeros"],"lang":"c","size":10.0,"lh":24.0,"w":340.0}]],"cues":[14.9,30.4]}]},{"title":"Bit-fields","sub":"What is undefined","short":"Fields","main":"For protocols and registers, use masks and shifts.","body":[{"t":"scene","labels":["Struct fields","What is undefined","Masks instead of fields"],"captions":["struct { unsigned a : 3, b : 5; }: fields of set width, handy for flags inside one program","Order within a byte, crossing word boundaries, and plain-field signedness are implementation-defined","For files, protocols and registers write masks and shifts explicitly: independent of the compiler"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["struct flags {","    unsigned ready : 1;","    unsigned mode  : 3;","};"],"hl":[1,2],"lang":"c","size":10.5,"lh":20.0,"w":320.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":100.0,"h":28.0,"text":"a (3 bits)","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":210.0,"y":60.0,"w":100.0,"h":28.0,"text":"b (5 bits)","tone":"blue","size":9.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"which end of the byte holds a is up to the compiler","tone":"red","size":9.5}],[{"t":"code","id":"c","x":10.0,"y":40.0,"lines":["#define MODE_MASK 0x0E","#define MODE_SHIFT 1","mode = 