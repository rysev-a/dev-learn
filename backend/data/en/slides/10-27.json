40.0,"lines":["let mut ch = Command::new(\"cat\")","    .stdin(Stdio::piped()).spawn()?;","ch.wait()?;"],"hl":[1],"lang":"rust","size":10.0,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["std::process::exit(2);"],"lang":"rust","size":12.0,"lh":28.0,"w":340.0}]],"cues":[10.7,25.3]}]},{"title":"Binary data","sub":"Byte order","short":"Binary","main":"from_le_bytes, byteorder, serde.","body":[{"t":"scene","labels":["from_le_bytes","byteorder","serde"],"captions":["u32::from_le_bytes(buf) and from_be_bytes: the format sets the byte order","byteorder crate: rdr.read_u32::<LittleEndian>()?; bytes and codecs for protocols","Don't write structs as raw bytes: serde with JSON, bincode, MessagePack is portable across platforms"],"frames":[[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["let n = u32::from_le_bytes([2, 1, 0, 0]);   // 258"],"hl":[0],"lang":"rust","size":10.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["let n = rdr.read_u32::<LittleEndian>()?;"],"hl":[0],"lang":"rust","size":10.5,"lh":28.0,"w":340.0}],[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"raw bytes\nof structs ✕","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"serde\nJSON, bincode","tone":"green","size":10.0,"sub_size":8.5}]],"cues":[11.6,26.8]}]},{"title":"Summary","sub":"What's next","short":"Summary","main":"Next: time, numbers, memory.","body":[{"t":"scene","labels":["Remember","Cheat sheet","Next"],"captions":["Read and Write; BufReader and BufWriter; fs in one line; Path and PathBuf; io::Error with a kind","Seek, Command, explicit byte order; generic code is tested on Cursor and Vec<u8>","Next chapter: time, numbers and memory: Duration, Instant, num, mem"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"Read","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"Write","tone":"green