{"book":10,"chapter":27,"rubric":"LEARNING RUST / THE STANDARD LIBRARY / CHAPTER 27","slides":[{"title":"Read and Write","sub":"Chapter 27 · io","short":"Intro","main":"One interface for file, socket, memory; io::Result.","body":[{"t":"scene","labels":["Read and Write","One interface","io::Result"],"captions":["Sources of bytes are Read, sinks are Write","File, socket, stdin, slice and vector share one interface, so code is tested on in-memory data","Every operation returns io::Result: errors are handled like any others"],"frames":[[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"Read\nsource","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"Write\nsink","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"File","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"TcpStream","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"stdin","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"&[u8]","tone":"blue","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["fn f() -> io::Result<()> {","    let s = fs::read_to_string(\"a\")?;","    Ok(())","}"],"hl":[1],"lang":"rust","size":10.0,"lh":22.0,"w":340.0}]],"cues":[12.1,25.3]}]},{"title":"Read","sub":"Sources","short":"Read","main":"read, read_to_string, read_exact, take, chain, Cursor.","body":[{"t":"scene","labels":["read","read_to_string, read_exact","take, chain, Cursor"],"captions":["read(&mut buf) fills the buffer and returns a byte count; 0 means end of stream","read_to_string and read_to_end read it all; read_exact fills a buffer exactly","take(n) limits, chain joins; Cursor is a source with a position over a vector; &[u8] is Read itself"],"frames":[[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["let n = r.read(&mut buf)?;","// n == 0 → end of stream"],"hl":[0],"lang":"rust","size":11.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let mut s = String::new();","r.read_to_string(&mut s)?;","r.read_exact(&mut buf4)?;"],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let mut c = Cursor::new(b\"hello\".to_vec());","let mut first = c.by_ref().take(2);"],"lang":"rust","size":9.5,"lh":28.0,"w":340.0}]],"cues":[11.7,24.4]}]},{"title":"Write","sub":"Sinks","short":"Write","main":"write_all, flush, Vec<u8>, write!.","body":[{"t":"scene","labels":["write_all","flush","Vec<u8> and write!"],"captions":["write(&buf) returns how many were written; write_all repeats until all is sent","flush pushes buffered data to the sink; call it before reading a reply","Vec<u8> is Write: you can \"print\" into it; write! and writeln! work with any Write; eprintln! goes to stderr"],"frames":[[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["w.write_all(b\"hello\")?;"],"hl":[0],"lang":"rust","size":12.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["print!(\"> \");","io::stdout().flush()?;"],"hl":[1],"lang":"rust","size":12.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let mut buf: Vec<u8> = Vec::new();","writeln!(buf, \"x = {}\", 5)?;","let s = String::from_utf8(buf)?;"],"hl":[1],"lang":"rust","size":10.0,"lh":24.0,"w":340.0}]],"cues":[11.4,27.4]}]},{"title":"Buffering","sub":"BufReader and BufWriter","short":"Buffers","main":"Fewer system calls; read_line, lines.","body":[{"t":"scene","labels":["System calls","BufReader","BufWriter"],"captions":["Each unbuffered read and write is a system call; small pieces are costly","BufReader reads big and hands out parts; BufRead: read_line, lines, read_until","BufWriter copies into a buffer and writes in a batch, flushing on drop; LineWriter goes by lines"],"frames":[[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"1 byte = 1 call","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"8 KB buffer","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let f = File::open(\"log.txt\")?;","for line in BufReader::new(f).lines() { }"],"hl":[1],"lang":"rust","size":10.0,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let mut out = BufWriter::new(stdout().lock());","for i in 0..1_000_000 { writeln!(out, \"{}\", i)?; }"],"lang":"rust","size":8.5,"lh":28.0,"w":340.0}]],"cues":[8.9,23.6]}]},{"title":"stdin and stdout","sub":"Standard streams","short":"stdin","main":"read_line, lock, fast output, flush.","body":[{"t":"scene","labels":["read_line","lock and lines","Fast output"],"captions":["stdin().read_line(&mut s) appends a line with its \"\\n\"; trim() removes it","stdin().lock() gives BufRead: for line in stdin.lock().lines() is fast input","Many lines: stdout().lock() in a BufWriter; a prompt without \"\\n\" needs flush"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let mut s = String::new();","io::stdin().read_line(&mut s)?;","let n: i32 = s.trim().parse()?;"],"hl":[1],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["for line in io::stdin().lock().lines() {","    let line = line?;","}"],"hl":[0],"lang":"rust","size":10.5,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["let out = io::stdout();","let mut w = BufWriter::new(out.lock());"],"lang":"rust","size":10.5,"lh":28.0,"w":340.0}]],"cues":[11.9,22.4]}]},{"title":"Files","sub":"std::fs","short":"Files","main":"fs::*, OpenOptions, directories.","body":[{"t":"scene","labels":["In one line","OpenOptions","Directories"],"captions":["fs::read_to_string, fs::write, fs::read, fs::copy, fs::rename, fs::remove_file","File::open, File::create, OpenOptions::new().append(true).create(true).open(…) for fine control","create_dir_all, read_dir, metadata: directories and info; a file closes itself on Drop"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let s = fs::read_to_string(\"a.txt\")?;","fs::write(\"b.txt\", s)?;"],"lang":"rust","size":10.5,"lh":28.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let f = OpenOptions::new()","    .append(true).create(true)","    .open(\"log.txt\")?;"],"hl":[1],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["fs::create_dir_all(\"a/b/c\")?;","for e in fs::read_dir(\".\")? { }"],"lang":"rust","size":10.5,"lh":28.0,"w":340.0}]],"cues":[22.5,23.5]}]},{"title":"Paths","sub":"Path and PathBuf","short":"Paths","main":"join, parent, extension; display.","body":[{"t":"scene","labels":["Path and PathBuf","Methods","Not always Unicode"],"captions":["Path is a reference to a path, PathBuf is the owning version, like &str and String","join, parent, file_name, file_stem, extension, with_extension, components, is_absolute, exists","File names in the OS are bytes, not always Unicode: print with path.display()"],"frames":[[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"Path\n(&str)","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"PathBuf\n(String)","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["let p = Path::new(\"/a/b.txt\");","p.parent()      // Some(\"/a\")","p.extension()   // Some(\"txt\")"],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["println!(\"{}\", p.display());","p.to_str()   // Option<&str>"],"lang":"rust","size":11.0,"lh":28.0,"w":340.0}]],"cues":[12.9,30.6]}]},{"title":"Errors","sub":"io::Error","short":"Errors","main":"ErrorKind, ?, Box<dyn Error>, anyhow.","body":[{"t":"scene","labels":["ErrorKind","?","Box<dyn Error>"],"captions":["io::Error carries an OS code and a kind: NotFound, PermissionDenied, AlreadyExists, UnexpectedEof, Interrupted","The ? operator passes it up; at the top level fn main() -> Result<(), Box<dyn Error>>","Box<dyn Error> takes any error; anyhow adds context; for people, a clear message, not a panic"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["match File::open(p) {","    Err(e) if e.kind() == ErrorKind::NotFound => { }","    …","}"],"hl":[1],"lang":"rust","size":9.0,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["fn main() -> Result<(), Box<dyn Error>> {","    let s = fs::read_to_string(\"a\")?;","    Ok(())","}"],"hl":[0],"lang":"rust","size":9.5,"lh":24.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["fs::read(p).with_context(|| format!(\"reading {}\", p))?;"],"lang":"rust","size":9.0,"lh":28.0,"w":340.0}]],"cues":[13.1,26.0]}]},{"title":"Seek","sub":"Random access","short":"Seek","main":"SeekFrom, set_len, sync_all, memmap2.","body":[{"t":"scene","labels":["Seek","SeekFrom","Size and sync"],"captions":["Seek: jump to any position, for offset tables, databases, a log tail","SeekFrom::Start(n), End(−n), Current(±n); File and Cursor implement Seek","set_len resizes a file, sync_all flushes data to disk; for gigabytes, memory mapping (memmap2)"],"frames":[[{"t":"cell","id":"b0","x":50.0,"y":66.0,"w":46.0,"h":32.0,"text":"0","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b1","x":102.0,"y":66.0,"w":46.0,"h":32.0,"text":"10","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b2","x":154.0,"y":66.0,"w":46.0,"h":32.0,"text":"20","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b3","x":206.0,"y":66.0,"w":46.0,"h":32.0,"text":"30","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"cell","id":"b4","x":258.0,"y":66.0,"w":46.0,"h":32.0,"text":"40","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b5","x":310.0,"y":66.0,"w":46.0,"h":32.0,"text":"50","tone":"blue","size":11.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["f.seek(S