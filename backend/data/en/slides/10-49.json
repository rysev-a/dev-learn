{"book":10,"chapter":49,"rubric":"LEARNING RUST / CHAT: AXUM, SQLX, TOKIO / CHAPTER 49","slides":[{"title":"Chat API","sub":"Chapter 49 · Rooms and messages","short":"Intro","main":"Building the core chat API: rooms, members, posting messages and paginated history.","body":[{"t":"scene","labels":["Operations","Message id","Predictability"],"captions":["Rooms, members, posting and paginated history","Monotonic id: live delivery layers on top, history reads from anywhere","A small set of clear operations with exact permissions"],"frames":[[{"t":"cell","id":"a","x":70.0,"y":50.0,"w":100.0,"h":26.0,"text":"rooms","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":50.0,"w":100.0,"h":26.0,"text":"members","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"c","x":290.0,"y":50.0,"w":100.0,"h":26.0,"text":"messages","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"d","x":180.0,"y":110.0,"w":160.0,"h":26.0,"text":"history","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"cell","id":"a","x":60.0,"y":70.0,"w":56.0,"h":28.0,"text":"#41","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":126.0,"y":70.0,"w":56.0,"h":28.0,"text":"#42","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"c","x":192.0,"y":70.0,"w":56.0,"h":28.0,"text":"#43","tone":"blue","size":11.0,"sub_size":8.5},{"t":"cell","id":"d","x":258.0,"y":70.0,"w":56.0,"h":28.0,"text":"#44","tone":"green","size":11.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":120.0,"text":"id only grows","tone":"muted","size":9.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":130.0,"h":30.0,"text":"exact rights","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":250.0,"y":70.0,"w":130.0,"h":30.0,"text":"exact codes","tone":"green","size":10.5,"sub_size":8.5}]],"cues":[12.9,25.9]}]},{"title":"Resources","sub":"Routes and methods","short":"Resources","main":"Resources: /rooms, /rooms/{id}/members, /rooms/{id}/messages; methods express actions and i