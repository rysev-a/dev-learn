one":"blue","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":280.0,"y":80.0,"text":"then INSERT","tone":"muted","size":9.0}],[{"t":"code","id":"c~code","x":10.0,"y":20.0,"lines":["\"привет\".len()           = 12   // bytes","\"привет\".chars().count() = 6    // chars"],"hl":[1],"lang":"rust","size":9.5,"lh":36.0,"w":340.0}],[{"t":"code","id":"c~code","x":10.0,"y":20.0,"lines":["INSERT INTO messages (room_id, author_id, text)","VALUES ($1, $2, $3)","RETURNING id, created_at"],"hl":[2],"lang":"rust","size":9.5,"lh":28.0,"w":340.0}]],"cues":[12.4,24.8]}]},{"title":"History","sub":"Pagination","short":"History","main":"History runs from newest to oldest with the before cursor and limit; limit has an upper cap.","body":[{"t":"scene","labels":["Cursor before","Cap on limit","next_before"],"captions":["Take id < before, newest first; the query uses the index","limit defaults to 20, at most 100","The response has the next-page cursor; no messages — no field"],"frames":[[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["WHERE room_id = $1 AND id < $2","ORDER BY id DESC LIMIT $3"],"hl":[0,1],"lang":"rust","size":10.0,"lh":34.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":26.0,"text":"?limit=500","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"line","id":"e","x1":156.0,"y1":60.0,"x2":214.0,"y2":60.0,"tone":"muted","arrow":true,"width":1.6},{"t":"cell","id":"b","x":290.0,"y":60.0,"w":130.0,"h":26.0,"text":"limit = 100","tone":"green","size":10.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"a client cannot pull the table","tone":"muted","size":9.0}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["{ \"items\": [ {id: 42}, {id: 41}, {id: 40} ],","  \"next_before\": 40 }","-- empty → no next_before field"],"hl":[1],"lang":"rust","size":9.5,"lh":28.0,"w":340.0}]],"cues":[13.0,26.0]}]},{"title":"Catch-up reading","sub":"after and WebSockets","short":"after","main":"The after parameter reads \"everything newer than N\" oldest first; that is how a client catches up after a drop.","body":[{"t":"scene","labels":["Drop","after","Two paths"],"captions":["The connection drops — the client misses messages","?after=N: everything newer than N, oldest first","WebSocket is the fast path, the after request is the safety net; one format"],"frames":[[{"t":"cell","id":"a","x":60.0,"y":70.0,"w":56.0,"h":26.0,"text":"#41","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":126.0,"y":70.0,"w":56.0,"h":26.0,"text":"#42","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"c","x":192.0,"y":70.0,"w":56.0,"h":26.0,"text":"#43","tone":"red","size":10.5,"sub_size":8.5},{"t":"cell","id":"d","x":258.0,"y":70.0,"w":56.0,"h":26.0,"text":"#44","tone":"red","size":10.5,"sub_size":8.5},{"t":"text","id":"n","x":225.0,"y":115.0,"text":"missed","tone":"red","size":9.0}],[{"t":"code","id":"c~code","x":10.0,"y":20.0,"lines":["GET /rooms/7/messages?after=42","-- #43, #44, … oldest to newest"],"hl":[0],"lang":"rust","size":10.0,"lh":36.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":50.0,"w":130.0,"h":26.0,"text":"WebSocket: now","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":100.0,"w":130.0,"h":26.0,"text":"after=N: catch up","tone":"blue","size":10.0,"sub_size":8.5},{"t":"line","id":"e1","x1":156.0,"y1":50.0,"x2":214.0,"y2":70.0,"tone":"muted","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":156.0,"y1":100.0,"x2":214.0,"y2":80.0,"tone":"muted","arrow":true,"width":1.6},{"t":"cell","id":"c","x":290.0,"y":75.0,"w":110.0,"h":30.0,"text":"one format","tone":"green","size":10.0,"sub_size":8.5}]],"cues":[11.5,23.0]}]},{"title":"Idempotency","sub":"Resending","short":"Idempotency","main":"A client idempotency key: repeating the same send returns the message already created, not a duplicate.","body":[{"t":"scene","labels":["Lost response","Key","Same result"],"captions":["The response never arrived and the client retried: without protection there are two messages","Idempotency-Key header + UNIQUE (room_id, author_id, client_id)","First time 201, repeat — success with the same body, no duplicate"],"frames":[[{"t":"cell","id":"a","x":70.0,"y":70.0,"w":80.0,"h":28.0,"text":"POST","tone":"blue","size":11.0,"sub_size":8.5},{"t":"line","id":"e1","x1":110.0,"y1":70.0,"x2":154.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"b","x":190.0,"y":70.0,"w":70.0,"h":28.0,"text":"response ✗","tone":"red","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":290.0,"y":70.0,"w":80.0,"h":28.0,"text":"retry","tone":"yellow","size":10.5,"sub_size":8.5}],[{"t":"code","id":"c~code","x":10.0,"y":20.0,"lines":["Idempotency-Key: 5f1c-…","UNIQUE (room_id, author_id, client_id)"],"hl":[0,1],"lang":"rust","size":10.0,"lh":34.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":50.0,"w":130.0,"h":26.0,"text":"1st: 201, id=44","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":100.0,"w":130.0,"h":26.0,"text":"retry: 200, id=44","tone":"green","size":10.5,"sub_size":8.5},{"t":"text","id":"n","x":280.0,"y":75.0,"text":"one row","tone":"muted","size":9.0}]],"cues":[12.4,24.8]}]},{"title":"Unread","sub":"Read marker","short":"Unread","main":"A member stores last_read; the unread count is the messages newer than it; the marker never decreases.","body":[{"t":"scene","labels":["last_read","GREATEST","One query"],"captions":["A member stores the last read number; unread is everything newer","The marker never decreases: a late request cannot roll back progress","Counters for all rooms in one query, not N queries"],"frames":[[{"t":"cell","id":"a","x":60.0,"y":70.0,"w":56.0,"h":28.0,"text":"#40","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"b","x":126.0,"y":70.0,"w":56.0,"h":28.0,"text":"#41","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"c","x":192.0,"y":70.0,"w":56.0,"h":28.0,"text":"#42","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"cell","id":"d","x":258.0,"y":70.0,"w":56.0,"h":28.0,"text":"#43","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"text","id":"n","x":226.0,"y":115.0,"text":"last_read = 41 → unread 2","tone":"muted","size":9.0}],[{"t":"code","id":"c~code","x":10.0,"y":20.0,"lines":["UPDATE members","SET last_read = GREATEST(last_read, $3)","WHERE room_id = $1 AND user_id = $2"],"hl":[1],"lang":"rust","size":9.5,"lh":28.0,"w":340.0}],[{"t":"code","id":"c~code","x":10.0,"y":20.0,"lines":["SELECT r.id, COUNT(m.id) FILTER (WHERE m.id > mb.last_read)","FROM members mb JOIN rooms r ON r.id = mb.room_id","LEFT JOIN messages m ON m.room_id = r.id GROUP BY r.id"],"hl":[0],"lang":"rust","size":8.0,"lh":24.0,"w":340.0}]],"cues":[12.7,25.3]}]},{"title":"Editing and deleting","sub":"Soft delete","short":"Editing","main":"Only the author edits; the author or the room owner deletes; deletion is soft, the text is hidden.","body":[{"t":"scene","labels":["Editing","Deleting","Rights in the query"],"captions":["Only the author edits; edited_at shows the text was changed","Author or owner; the row stays, history shows a placeholder","The rights condition is in the UPDATE itself; 403 vs 404 — a second query"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":130.0,"h":30.0,"text":"PATCH /messages/42","tone":"blue","size":10.0,"sub_size":8.5},{"t":"line","id":"e","x1":156.0,"y1":70.0,"x2":214.0,"y2":70.0,"tone":"muted","arrow":true,"width":1.6},{"t":"cell","id":"b","x":290.0,"y":70.0,"w":130.0,"h":30.0,"text":"edited_at = now()","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":50.0,"w":130.0,"h":26.0,"text":"was: «hello»","tone":"blue","size":10.0,"sub_size":8.5},{"t":"line","id":"e","x1":156.0,"y1":50.0,"x2":214.0,"y2":50.0,"tone":"muted","arrow":true,"width":1.6},{"t":"cell","id":"b","x":290.0,"y":50.0,"w":130.0,"h":26.0,"text":"deleted = true","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":290.0,"y":100.0,"w":130.0,"h":26.0,"text":"[message deleted]","tone":"green","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c~code",