"size":8.0}],[{"t":"code","id":"c","x":20.0,"y":25.0,"lines":[" 1  192.168.0.1     0.5 ms"," 2  10.1.1.1         3.1 ms"," 3  *  *  *"," 4  203.0.113.9    58.0 ms"," 5  198.51.100.40  60.2 ms"],"hl":[3],"lang":"plain","size":8.5,"lh":13.0,"w":240.0},{"t":"text","id":"t1","x":300.0,"y":60.0,"text":"","size":8.0},{"t":"text","id":"n4","x":180.0,"y":120.0,"text":"forward and return paths may differ: normal","tone":"green","size":8.0}]],"cues":[10.4,21.8,27.4]},{"t":"note","text":"Forward and return paths may differ."}]},{"title":"ip and ss","sub":"The host itself","short":"ip and ss","main":"ip shows interfaces and routes, ss shows listening ports; a service on 127.0.0.1 is unreachable from outside.","body":[{"t":"scene","labels":["Listening","Trap","ip","States"],"captions":["ss shows which ports the server listens on and on which addresses","A service on 127.0.0.1 is unreachable from outside, yet works locally","ip shows interfaces, addresses, and routes: start with it","Connection states hint at other problems"],"frames":[[{"t":"code","id":"c","x":20.0,"y":25.0,"lines":["$ ss -ltn","LISTEN 127.0.0.1:80","LISTEN 0.0.0.0:22"],"hl":[1],"lang":"plain","size":8.5,"lh":13.0,"w":200.0},{"t":"text","id":"t1","x":240.0,"y":38.0,"text":"← local only!","tone":"red","size":8.5,"anchor":"start"}],[{"t":"code","id":"c","x":20.0,"y":25.0,"lines":["$ ss -ltn","LISTEN 127.0.0.1:80","LISTEN 0.0.0.0:22"],"hl":[1],"lang":"plain","size":8.5,"lh":13.0,"w":200.0},{"t":"text","id":"t1","x":240.0,"y":38.0,"text":"← local only!","tone":"red","size":8.5,"anchor":"start"},{"t":"text","id":"t2","x":180.0,"y":90.0,"text":"outside: refused; on the machine: works","tone":"yellow","size":9.0}],[{"t":"code","id":"c","x":20.0,"y":25.0,"lines":["$ ss -ltn","LISTEN 127.0.0.1:80","LISTEN 0.0.0.0:22"],"hl":[1],"lang":"plain","size":8.5,"lh":13.0,"w":200.0},{"t":"text","id":"t1","x":240.0,"y":38.0,"text":"← local only!","tone":"red","size":8.5,"anchor":"start"},{"t":"text","id":"t2","x":180.0,"y":90.0,"text":"outside: refused; on the machine: works","tone":"yellow","size":9.0},{"t":"text","id":"t3","x":180.0,"y":115.0,"text":"ip addr · ip route · ip link: port, address, gateway","tone":"blue","size":9.0}],[{"t":"code","id":"c","x":20.0,"y":25.0,"lines":["$ ss -ltn","LISTEN 127.0.0.1:80","LISTEN 0.0.0.0:22"],"hl":[1],"lang":"plain","size":8.5,"lh":13.0,"w":200.0},{"t":"text","id":"t1","x":240.0,"y":38.0,"text":"← local only!","tone":"red","size":8.5,"anchor":"start"},{"t":"text","id":"t2","x":180.0,"y":90.0,"text":"outside: refused; on the machine: works","tone":"yellow","size":9.0},{"t":"text","id":"t3","x":180.0,"y":115.0,"text":"ip addr · ip route · ip link: port, address, gateway","tone":"blue","size":9.0},{"t":"text","id":"t4","x":180.0,"y":140.0,"text":"ss -tn: lots of SYN-RECV is an attack; TIME-WAIT is frequent connections","tone":"green","size":8.5}]],"cues":[13.1,18.2,30.9]},{"t":"note","text":"Connection states hint at attacks and leaks."}]},{"title":"dig, curl, openssl","sub":"Application layer","short":"dig, curl, openssl","main":"dig is DNS, curl -v is HTTP, openssl s_client is TLS; a refusal and silence are different diagnoses.","body":[{"t":"scene","labels":["dig","curl","openssl","nc"],"captions":["dig shows what the resolver answered and via which path","curl -v shows the whole HTTP exchange: codes, headers, redirects, timing","openssl s_client shows the certificate chain, expiry, TLS versions","nc tells a refusal from silence: RST or nothing"],"frames":[[{"t":"cell","id":"a0","x":180.0,"y":28.0,"w":320.0,"h":28.0,"text":"dig: what the resolver answered","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"a1","x":180.0,"y":64.0,"w":320.0,"h":28.0,"text":"curl -v: request, response, codes, handshake times","tone":"green","size":8.5,"sub_size":8.5,"o":0.2},{"t":"cell","id":"a2","x":180.0,"y":100.0,"w":320.0,"h":28.0,"text":"openssl s_client: cert chain, expiry, TLS version","tone":"blue","size":8.5,"sub_size":8.5,"o":0.2},{"t":"cell","id":"a3