8.5},{"t":"line","id":"a2","x1":174.0,"y1":70.0,"x2":185.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"cell","id":"n3","x":313.0,"y":70.0,"w":76.0,"h":52.0,"text":"ok /\nchanged","tone":"green","size":8.5,"sub_size":8.5},{"t":"line","id":"a3","x1":263.0,"y1":70.0,"x2":274.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[11.3,21.6,32.0]}]},{"title":"A key pair","sub":"Chapter 1 · A headless server","short":"Keys","main":"ed25519, a passphrase, the agent, and the fingerprint.","body":[{"t":"scene","labels":["keygen","copy-id","agent","Fingerprint"],"captions":["ssh-keygen by default creates a short, reliable ed25519","ssh-copy-id puts the public half on the server","ssh-agent holds the unlocked key, one passphrase entry is enough","ssh-keygen -l shows the fingerprint to compare"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ ssh-keygen -t ed25519 -C ann@laptop","$ ssh-copy-id ann@srv","$ eval \"$(ssh-agent)\" && ssh-add","$ ssh-keygen -lf ~/.ssh/id_ed25519.pub","256 SHA256:7n39CWy8II...bq6cA ann@laptop"],"hl":[0],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ ssh-keygen -t ed25519 -C ann@laptop","$ ssh-copy-id ann@srv","$ eval \"$(ssh-agent)\" && ssh-add","$ ssh-keygen -lf ~/.ssh/id_ed25519.pub","256 SHA256:7n39CWy8II...bq6cA ann@laptop"],"hl":[1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ ssh-keygen -t ed25519 -C ann@laptop","$ ssh-copy-id ann@srv","$ eval \"$(ssh-agent)\" && ssh-add","$ ssh-keygen -lf ~/.ssh/id_ed25519.pub","256 SHA256:7n39CWy8II...bq6cA ann@laptop"],"hl":[2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$ ssh-keygen -t ed25519 -C ann@laptop","$ ssh-copy-id ann@srv","$ eval \"$(ssh-agent)\" && ssh-add","$ ssh-keygen -lf ~/.ssh/id_ed25519.pub","256 SHA256:7n39CWy8II...bq6cA ann@laptop"],"hl":[3,4],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[9.4,17.3,28.3]}]},{"title":"authorized_keys","sub":"Chapter 1 · A headless server","short":"Options","main":"A key line with options, and directory permissions.","body":[{"t":"scene","labels":["Line","from","command","Modes"],"captions":["A line: options, type, key in base64, comment","from limits the addresses the key works from","command with restrict gives the key one command and nothing more","Directory 700, file 600; otherwise StrictModes rejects the key"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["ssh-ed25519 AAAAC3Nz...Ue ann@laptop","from=\"10.0.0.0/8\",no-pty ssh-ed25519 AAAA..","command=\"/bin/backup\",restrict ssh-ed25519 AAAA..","chmod 700 ~/.ssh","chmod 600 ~/.ssh/authorized_keys"],"hl":[0],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["ssh-ed25519 AAAAC3Nz...Ue ann@laptop","from=\"10.0.0.0/8\",no-pty ssh-ed25519 AAAA..","command=\"/bin/backup\",restrict ssh-ed25519 AAAA..","chmod 700 ~/.ssh","chmod 600 ~/.ssh/authorized_keys"],"hl":[1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["ssh-ed25519 AAAAC3Nz...Ue ann@laptop","from=\"10.0.0.0/8\",no-pty ssh-ed25519 AAAA..","command=\"/bin/backup\",restrict ssh-ed25519 AAAA..","chmod 700 ~/.ssh","chmod 600 ~/.ssh/authorized_keys"],"hl":[2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["ssh-ed25519 AAAAC3Nz...Ue ann@laptop","from=\"10.0.0.0/8\",no-pty ssh-ed25519 AAAA..","command=\"/bin/backup\",restrict ssh-ed25519 AAAA..","chmod 700 ~/.ssh","chmod 600 ~/.ssh/authorized_keys"],"hl":[3,4],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[7.6,15.1,25.9]}]},{"title":"sshd_config: first value","sub":"Chapter 1 · A headless server","short":"sshd_config","main":"The first value found wins, even against Match.","body":[{"t":"scene","labels":["Include","First","Match","sshd -T"],"captions":["Include of the sshd_config.d directory is at the top, its files come first","The first value wins: PasswordAuthentication no","Match lasts until the next Match, but the no above it is stronger","sshd -T with -C shows the result for a given connection"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["Include /etc/ssh/sshd_config.d/*.conf","PermitRootLogin no","PasswordAuthentication no","Match User backup","    PasswordAuthentication yes","$ sshd -T -C user=backup,host=h,addr=10.1.2.3"],"hl":[0],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["Include /etc/ssh/sshd_config.d/*.conf","PermitRootLogin no","PasswordAuthentication no","Match User backup","    PasswordAuthentication yes","$ sshd -T -C user=backup,host=h,addr=10.1.2.3"],"hl":[1,2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["Include /etc/ssh/sshd_config.d/*.conf","PermitRootLogin no","PasswordAuthentication no","Match User backup","    PasswordAuthentication yes","$ sshd -T -C user=backup,host=h,addr=10.1.2.3"],"hl":[3,4],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["Include /etc/ssh/sshd_config.d/*.conf","PermitRootLogin no","PasswordAuthentication no","Match User backup","    PasswordAuthentication yes","$ sshd -T -C user=backup,host=h,addr=10.1.2.3"],"hl":[5],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[12.0,19.6,30.2]}]},{"title":"The client ssh_config","sub":"Chapter 1 · A headless server","short":"ssh_config","main":"Host blocks: specific above, general below, ProxyJump instead of key forwarding.","body":[{"t":"scene","labels":["Specific","Bastion","General","Result"],"captions":["A specific block goes higher: its values are taken first","ProxyJump routes the connection through a bastion, no key is forwarded","Host * at the very bottom gives the defaults","IdentityFile values pile up in a list, IdentitiesOnly cuts extra keys"],"frames":[[{"t":"code","id":"c","x":20.0,"y":2