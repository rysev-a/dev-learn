,"w":76.0,"h":52.0,"text":"tmux new\n-s work","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"n1","x":135.0,"y":70.0,"w":76.0,"h":52.0,"text":"Ctrl-b d\ndetach","tone":"violet","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":85.0,"y1":70.0,"x2":96.0,"y2":70.0,"tone":"violet","arrow":true,"width":1.6},{"t":"cell","id":"n2","x":224.0,"y":70.0,"w":76.0,"h":52.0,"text":"tmux ls\nlist","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"line","id":"a2","x1":174.0,"y1":70.0,"x2":185.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6}],[{"t":"cell","id":"n0","x":46.0,"y":70.0,"w":76.0,"h":52.0,"text":"tmux new\n-s work","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"n1","x":135.0,"y":70.0,"w":76.0,"h":52.0,"text":"Ctrl-b d\ndetach","tone":"violet","size":8.5,"sub_size":8.5},{"t":"line","id":"a1","x1":85.0,"y1":70.0,"x2":96.0,"y2":70.0,"tone":"violet","arrow":true,"width":1.6},{"t":"cell","id":"n2","x":224.0,"y":70.0,"w":76.0,"h":52.0,"text":"tmux ls\nlist","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"line","id":"a2","x1":174.0,"y1":70.0,"x2":185.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6},{"t":"cell","id":"n3","x":313.0,"y":70.0,"w":76.0,"h":52.0,"text":"attach -t\nreturn","tone":"green","size":8.5,"sub_size":8.5},{"t":"line","id":"a3","x1":263.0,"y1":70.0,"x2":274.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[7.7,17.2,26.9]}]},{"title":"sudo and sudoers","sub":"Chapter 1 · A headless server","short":"sudo","main":"The last matching entry wins; edit only through visudo.","body":[{"t":"scene","labels":["Group","NOPASSWD","Deny","visudo"],"captions":["The admin group: sudo in Debian and Ubuntu, wheel in the RHEL family","The NOPASSWD tag drops the password prompt for the listed commands","An exclamation mark excludes a command; the last entry decides","visudo -c checks the syntax; sudoers.d files with a dot are not read"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["%sudo ALL=(ALL:ALL) ALL","ann ALL=(r