es, Pin, async blocks and async fn in traits"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"poll","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"Pending","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"wake","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"Waker","tone":"green","size":10.5,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["block_on  = poll + park","timer     = thread + flag + wake","executor  = queue + wake"],"lang":"rust","size":10.5,"lh":24.0,"w":340.0}],[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":230.0,"h":34.0,"text":"Pin · state machines · async fn","tone":"blue","size":12.0,"sub_size":8.5}]],"cues":[13.3,25.8]}]}]}