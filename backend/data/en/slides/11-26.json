,"size":10.5,"lh":22.0,"w":240.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":130.0,"h":28.0,"text":"connection dropped","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":60.0,"w":130.0,"h":28.0,"text":"Last-Event-ID: 43","tone":"green","size":9.5,"sub_size":8.5},{"t":"line","id":"e","x1":156.0,"y1":60.0,"x2":204.0,"y2":60.0,"tone":"blue","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":116.0,"text":"server resends what was missed","size":10.0}]],"cues":[14.4,20.9]}]},{"title":"Network Layer","sub":"Queue, rollback, deduplication","short":"Layer","main":"Show errors like a human.","body":[{"t":"scene","labels":["Offline and queue","Optimistic updates","Deduplication and errors"],"captions":["The app watches online/offline and queues requests during an outage","An optimistic update shows the result at once and rolls it back on error","Duplicate requests are merged, responses cached with a clear lifetime, errors shown humanely; that is how React Query and SWR work"],"frames":[[{"t":"cell","id":"q0","x":70.0,"y":56.0,"w":40.0,"h":24.0,"text":"№1","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"q1","x":120.0,"y":56.0,"w":40.0,"h":24.0,"text":"№2","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"q2","x":170.0,"y":56.0,"w":40.0,"h":24.0,"text":"№3","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"n","x":280.0,"y":56.0,"w":90.0,"h":28.0,"text":"no network","tone":"red","size":10.0,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":110.0,"text":"queue sends on online","size":10.0}],[{"t":"cell","id":"a","x":70.0,"y":70.0,"w":100.0,"h":34.0,"text":"shown at once","tone":"green","size":10.0,"sub_size":8.5},{"t":"line","id":"e","x1":124.0,"y1":70.0,"x2":176.0,"y2":70.0,"tone":"blue","arrow":true,"width":1.6},{"t":"cell","id":"b","x":240.0,"y":70.0,"w":100.0,"h":34.0,"text":"error → rollback","tone":"red","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"k0","x":66.0,"y":70.0,"w":104.0,"h":34.0,"text":"