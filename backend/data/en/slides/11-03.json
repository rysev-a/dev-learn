xt":"Chrome\nauto-update","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":110.0,"h":34.0,"text":"Edge\n→ Chromium, 2020","tone":"green","size":9.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":124.0,"text":"no more “oldest browser”","size":9.5}]],"cues":[19.8,32.1]}]},{"title":"Babel","sub":"New syntax into old","short":"Babel","main":"Write tomorrow's language today.","body":[{"t":"scene","labels":["Parsing","Transform","Polyfills"],"captions":["Babel (2014, Sebastian McKenzie, originally “6to5”): code is parsed into a tree, then all work happens on the tree","An arrow becomes a function, a class a constructor function, let becomes var; rules plug in as plugins and presets","Missing objects (Promise) are filled by core-js polyfills; the target browsers are set by a browserslist file"],"frames":[[{"t":"cell","id":"t","x":70.0,"y":70.0,"w":90.0,"h":30.0,"text":"code","tone":"blue","size":10.5,"sub_size":8.5},{"t":"line","id":"e1","x1":116.0,"y1":70.0,"x2":150.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"p","x":190.0,"y":70.0,"w":70.0,"h":30.0,"text":"parse","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"line","id":"e2","x1":226.0,"y1":70.0,"x2":260.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"a","x":310.0,"y":70.0,"w":90.0,"h":30.0,"text":"tree (AST)","tone":"green","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c","x":10.0,"y":40.0,"lines":["const f = (x) => x * 2;"],"hl":[0],"lang":"js","size":10.5,"lh":18.0,"w":340.0},{"t":"text","id":"a~text","x":180.0,"y":78.0,"text":"↓ Babel","tone":"yellow","size":10.0},{"t":"code","id":"d","x":10.0,"y":96.0,"lines":["var f = function (x) {","  return x * 2;","};"],"lang":"js","size":10.5,"lh":16.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":110.0,"h":28.0,"text":"Promise","tone":"red","size":10.5,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":60.0,"x2":214.0,"y2":60.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"b","x":290.0,"y":60.0,"w":110.0,"h":28.0,"text":"core-js","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"c~cell","x":180.0,"y":112.0,"w":240.0,"h":28.0,"text":"browserslist: > 0.5%, last 2 versions","tone":"blue","size":9.0,"sub_size":8.5}]],"cues":[13.2,31.9]}]},{"title":"webpack and others","sub":"Everything is a module","short":"webpack","main":"Bundlers grew “JavaScript fatigue”.","body":[{"t":"scene","labels":["webpack","Rollup and Parcel","left-pad, 2016"],"captions":["webpack (Tobias Koppers): everything is a module — scripts, styles, images; loaders, code splitting, hot module replacement","Rollup (2015) focused on ES modules and tree shaking — removing unused code; Parcel (2017) — zero configuration","In March 2016 the eleven-line left-pad package was pulled from npm — and builds worldwide broke"],"frames":[[{"t":"cell","id":"f0","x":50.0,"y":56.0,"w":56.0,"h":26.0,"text":"JS","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"f1","x":116.0,"y":56.0,"w":56.0,"h":26.0,"text":"CSS","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"f2","x":182.0,"y":56.0,"w":56.0,"h":26.0,"text":"img","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"f3","x":248.0,"y":56.0,"w":56.0,"h":26.0,"text":"fonts","tone":"blue","size":10.0,"sub_size":8.5},{"t":"line","id":"e0","x1":50.0,"y1":70.0,"x2":182.0,"y2":100.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e1","x1":116.0,"y1":70.0,"x2":194.0,"y2":100.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":182.0,"y1":70.0,"x2":206.0,"y2":100.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e3","x1":248.0,"y1":70.0,"x2":218.0,"y2":100.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"w","x":200.0,"y":112.0,"w":130.0,"h":32.0,"text":"webpack","tone":"yellow","size":11.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":56.0,"w":110.0,"h":28.0,"text":"Rollup","tone":"yellow","size":11.0,"sub_size":8.5},{"t":"text","id":"a1","x":90.0,"y":82.0,"text":"tree shaking","size":9.5},{"t":"cell","id":"b","x":270.0,"y":56.0,"w":110.0,"h":28.0,"text":"Parcel","tone":"blue","size":11.0,"sub_size":8.5},{"t":"text","id":"b1","x":270.0,"y":82.0,"text":"zero config","size":9.5},{"t":"text","id":"n","x":180.0,"y":132.0,"text":"2015 · 2017","tone":"muted","size":9.5}],[{"t":"cell","id":"a","x":90.0,"y":56.0,"w":110.0,"h":28.0,"text":"left-pad\n11 lines","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":56.0,"w":110.0,"h":28.0,"text":"hundreds of\npackages","tone":"blue","size":9.5,"sub_size":8.5},{"t":"line","id":"e","x1":146.0,"y1":56.0,"x2":214.0,"y2":56.0,"tone":"red","arrow":true,"width":1.6},{"t":"text","id":"n","x":180.0,"y":118.0,"text":"March 2016: removed — all broke","tone":"red","size":10.0}]],"cues":[17.8,39.1]}]},{"title":"Fast tools","sub":"TypeScript, esbuild, Vite","short":"Fast","main":"Bundlers in Go and Rust, while CSS absorbed part of the preprocessors.","body":[{"t":"scene","labels":["TypeScript","esbuild, SWC, Vite","CSS absorbed part"],"captions":["Microsoft's TypeScript (2012) added static types on top of JavaScript; frameworks (React, Vue, Angular) — components and a virtual tree","esbuild (Go, 2020), SWC (Rust), Vite (Evan You): native browser modules in dev, fast builds in other languages","CSS gained variables, grid and nested rules — part of what preprocessors offered became part of the language"],"frames":[[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["function add(a: number, b: number) {","  return a + b;","}"],"hl":[0],"lang":"js","size":10.5,"lh":22.0,"w":310.0},{"t":"text","id":"n","x":180.0,"y":126.0,"text":"types are erased at build","size":9.5}],[{"t":"cell","id":"a","x":70.0,"y":56.0,"w":90.0,"h":28.0,"text":"esbuild","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":56.0,"w":80.0,"h":28.0,"text":"SWC","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"cell","id":"c~cell","x":290.0,"y":56.0,"w":90.0,"h":28.0,"text":"Vite","tone":"green","size":10.5,"sub_size":8.5},{"t":"text","id":"a1","x":70.0,"y":84.0,"text":"Go","tone":"muted","size":9.0},{"t":"text","id":"b1","x":180.0,"y":84.0,"text":"Rust","tone":"muted","size":9.0},{"t":"text","id":"c1","x":290.0,"y":84.0,"text":"ESM in dev","tone":"muted","size":9.0}],[{"t":"code","id":"c","x":30.0,"y":36.0,"lines":[":root { --main: #36c; }",".nav {","  a { color: var(--main); }","}"],"hl":[0,2],"lang":"js","size":10.5,"lh":20.0,"w":300.0},{"t":"text","id":"n","x":180.0,"y":128.0,"text":"variables and nesting — in CSS itself","size":9.5}]],"cues":[19.3,27.4]}]},{"title":"Summary","sub":"What next","short":"Summary","main":"The history is done: now the language itself.","body":[{"t":"scene","labels":["Why slow","Why fast","Next"],"captions":["A committee split and old browsers held the language back for ten years; ES5 gave strict mode, JSON and array methods","ES6 brought the whole modern language; then came yearly releases, auto-updating browsers, Babel, bundlers and preprocessors","The history is done: now the language itself — the first program, values and operators"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":120.0,"h":30.0,"text":"TC39 split","tone":"red","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":240.0,"y":60.0,"w":130.0,"h":30.0,"text":"old browsers","tone":"red","size":10.5,"sub_size":8.5},{"t":"cell","id":"c","x":160.0,"y":116.0,"w":150.0,"h":28.0,"text":"ES5: strict, JSON","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":120.0,"h":30.0,"text":"ES6 → yearly","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":240.0,"y":60.0,"w":130.0,"h":30.0,"text":"Babel + bundlers","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":160.0,"y":116.0,"w":150.0,"h":28.0,"text":"auto-update","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c~code","x":40.0,"y":44.0,"lines":["console.log('Hello, world!');"],"hl":[0],"lang":"js","size":12.0,"lh":22.0,"w":270.0},{"t":"text","id":"n","x":180.0,"y":118.0,"text":"chapter 4: the first program","size":10.0}]],"cues":[14.9,20.0]}]}]}