.0,"text":"cancelled","tone":"red","size":9.0},{"t":"cell","id":"b","x":90.0,"y":112.0,"w":100.0,"h":28.0,"text":"ES3.1","tone":"green","size":11.0,"sub_size":8.5},{"t":"line","id":"e1","x1":140.0,"y1":112.0,"x2":224.0,"y2":112.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"c","x":280.0,"y":112.0,"w":100.0,"h":28.0,"text":"ES5","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"h","x":280.0,"y":50.0,"w":120.0,"h":28.0,"text":"Harmony","tone":"yellow","size":11.0,"sub_size":8.5}]],"cues":[11.0,30.6]}]},{"title":"Old browsers","sub":"IE6–IE8 and syntax","short":"Old browsers","main":"The oldest browser set the speed of the language.","body":[{"t":"scene","labels":["New syntax","The whole file dies","IE6–IE8"],"captions":["A new feature is unfamiliar syntax: a browser that doesn't know it sees an error","A SyntaxError breaks the whole file: not a single line of the script runs","IE6 and IE7 stayed on computers for years — the oldest browser set the pace"],"frames":[[{"t":"code","id":"c","x":40.0,"y":50.0,"lines":["const f = (x) => x * 2;"],"hl":[0],"lang":"js","size":13.0,"lh":22.0,"w":280.0},{"t":"text","id":"n","x":180.0,"y":110.0,"text":"new syntax","size":10.5}],[{"t":"cell","id":"b","x":100.0,"y":70.0,"w":130.0,"h":40.0,"text":"old browser","tone":"muted","size":10.0,"sub_size":8.5},{"t":"line","id":"e","x1":166.0,"y1":70.0,"x2":216.0,"y2":70.0,"tone":"red","arrow":true,"width":1.6},{"t":"cell","id":"e1","x":290.0,"y":70.0,"w":130.0,"h":40.0,"text":"SyntaxError\nscript not run","tone":"red","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"i0","x":70.0,"y":70.0,"w":90.0,"h":34.0,"text":"IE6","tone":"red","size":12.0,"sub_size":8.5},{"t":"cell","id":"i1","x":180.0,"y":70.0,"w":90.0,"h":34.0,"text":"IE7","tone":"red","size":12.0,"sub_size":8.5},{"t":"cell","id":"i2","x":290.0,"y":70.0,"w":90.0,"h":34.0,"text":"IE8","tone":"red","size":12.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":124.0,"text":"no arrows or classes","size":10.0}]],"cues":[13.9,28.4]}]},{"title":"ES5","sub":"Strict mode, JSON, array methods","short":"ES5","main":"ES5 — the base everyone relied on until the turning point.","body":[{"t":"scene","labels":["Strict mode and JSON","Array methods","Objects and bind"],"captions":["December 2009: strict mode forbids implicit globals; the built-in JSON object appears","forEach, map, filter, reduce — what used to be written as polyfills","Object.keys and Object.create, getters and setters, Function.prototype.bind; IE9 supported ES5, IE8 did not"],"frames":[[{"t":"code","id":"c","x":40.0,"y":40.0,"lines":["'use strict';","x = 5;   // ReferenceError","JSON.parse(text);"],"hl":[0,2],"bad":[1],"lang":"js","size":11.5,"lh":22.0,"w":280.0}],[{"t":"cell","id":"f0","x":70.0,"y":56.0,"w":110.0,"h":28.0,"text":"forEach","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"f1","x":200.0,"y":56.0,"w":110.0,"h":28.0,"text":"map","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"f2","x":70.0,"y":100.0,"w":110.0,"h":28.0,"text":"filter","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"f3","x":200.0,"y":100.0,"w":110.0,"h":28.0,"text":"reduce","tone":"green","size":11.0,"sub_size":8.5}],[{"t":"code","id":"c","x":30.0,"y":36.0,"lines":["Object.keys(o)","Object.create(proto)","Object.defineProperty(o, k, d)","fn.bind(ctx)"],"lang":"js","size":10.5,"lh":22.0,"w":300.0}]],"cues":[23.1,28.6]}]},{"title":"CoffeeScript","sub":"Transpilation","short":"CoffeeScript","main":"A language can be improved “from outside” by compiling to JavaScript.","body":[{"t":"scene","labels":["CoffeeScript, 2009","Compilation","Ideas return"],"captions":["Jeremy Ashkenas released CoffeeScript: short syntax, arrows, classes — all compiled to plain JS","A language can be improved “from outside” without waiting for browsers; such compilers were called transpilers","Arrows, classes, destructuring and rest parameters later entered the standard; Dart and TypeScript followed"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["square = (x) -> x * x","","class Dog","  speak: -> 'woof'"],"lang":"js","size":11.5,"lh":20.0,"w":320.0}],[{"t":"cell","id":"a","x":80.0,"y":70.0,"w":110.0,"h":34.0,"text":"CoffeeScript","tone":"blue","size":10.5,"sub_size":8.5},{"t":"line","id":"e","x1":136.0,"y1":70.0,"x2":224.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"b","x":290.0,"y":70.0,"w":110.0,"h":34.0,"text":"JavaScript","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":54.0,"text":"compiler","size":9.5}],[{"t":"cell","id":"f0","x":70.0,"y":56.0,"w":110.0,"h":28.0,"text":"=>","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"f1","x":200.0,"y":56.0,"w":110.0,"h":28.0,"text":"class","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"f2","x":70.0,"y":96.0,"w":110.0,"h":28.0,"text":"[a, b] = x","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"f3","x":200.0,"y":96.0,"w":110.0,"h":28.0,"text":"...rest","tone":"green","size":11.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":140.0,"text":"from CoffeeScript to the standard","size":9.5}]],"cues":[20.4,25.4]}]},{"title":"Modules and builds","sub":"CommonJS, Browserify, Grunt, Gulp","short":"Build","main":"This is how bundlers and automation tools were born.","body":[{"t":"scene","labels":["Module formats","Browserify","Grunt and Gulp"],"captions":["CommonJS (require) is synchronous and unfit for browsers; AMD and RequireJS loaded modules asynchronously, UMD worked in both","In 2011 Browserify let you write for the browser in the Node.js style: it finds every require and joins the files","Grunt (2012) described tasks in a config, Gulp (2013) in code and streams; they concatenated, minified and checked files"],"frames":[[{"t":"cell","id":"f0","x":70.0,"y":56.0,"w":96.0,"h":30.0,"text":"CommonJS","tone":"green","size":10.5,"sub_size":8.5},{"t":"cell","id":"f1","x":180.0,"y":56.0,"w":96.0,"h":30.0,"text":"AMD","tone":"blue","size":10.5,"sub_size":8.5},