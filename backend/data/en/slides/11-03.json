efixer"],"frames":[[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":[".nav a { color: #36c; }",".nav a:hover { color: #139; }",".nav li { color: #36c; }",".nav ul { margin: 0; }"],"lang":"js","size":10.0,"lh":20.0,"w":330.0},{"t":"text","id":"n","x":180.0,"y":130.0,"text":"repeats and manual syncing","tone":"red","size":9.5}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["$main: #36c;",".nav {","  a { color: $main;","    &:hover { color: darken($main, 10%); } }","}"],"hl":[0,3],"lang":"js","size":10.0,"lh":19.0,"w":330.0}],[{"t":"cell","id":"a","x":60.0,"y":70.0,"w":80.0,"h":34.0,"text":"SCSS","tone":"blue","size":11.0,"sub_size":8.5},{"t":"line","id":"e1","x1":102.0,"y1":70.0,"x2":136.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"b","x":180.0,"y":70.0,"w":70.0,"h":34.0,"text":"Sass","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"line","id":"e2","x1":218.0,"y1":70.0,"x2":252.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"c~cell","x":300.0,"y":70.0,"w":80.0,"h":34.0,"text":"CSS","tone":"green","size":11.0,"sub_size":8.5}]],"cues":[14.6,33.5]}]},{"title":"ES2015 (ES6)","sub":"The biggest update","short":"ES6","main":"The whole modern language shipped in one package.","body":[{"t":"scene","labels":["June 2015","What came in","Modules and promises"],"captions":["ES2015 is the biggest update in the language's history; the work took six years after ES5","let and const, arrows, classes, template strings, destructuring, default parameters, rest and spread","Iterators and generators, symbols, Map and Set, promises and — at last — standard modules"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":52.0,"h":22.0,"text":"2009","tone":"muted","size":10.0,"sub_size":8.5},{"t":"line","id":"e","x1":130.0,"y1":70.0,"x2":220.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"t","x":175.0,"y":54.0,"text":"6 years","size":10.0},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":52.0,"h":22.0,"text":"2015","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":118.0,"text":"the whole modern language in one release","size":9.5}],[{"t":"cell","id":"f0","x":62.0,"y":54.0,"w":106.0,"h":28.0,"text":"let / const","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"f1","x":180.0,"y":54.0,"w":106.0,"h":28.0,"text":"=>","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"f2","x":298.0,"y":54.0,"w":106.0,"h":28.0,"text":"class","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"f3","x":62.0,"y":98.0,"w":106.0,"h":28.0,"text":"`templates`","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"f4","x":180.0,"y":98.0,"w":106.0,"h":28.0,"text":"{ a, b } = o","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"f5","x":298.0,"y":98.0,"w":106.0,"h":28.0,"text":"...spread","tone":"green","size":9.5,"sub_size":8.5}],[{"t":"cell","id":"f0","x":62.0,"y":54.0,"w":106.0,"h":28.0,"text":"iterators","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"f1","x":180.0,"y":54.0,"w":106.0,"h":28.0,"text":"generators","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"f2","x":298.0,"y":54.0,"w":106.0,"h":28.0,"text":"Symbol","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"f3","x":62.0,"y":98.0,"w":106.0,"h":28.0,"text":"Map / Set","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"f4","x":180.0,"y":98.0,"w":106.0,"h":28.0,"text":"Promise","tone":"yellow","size":9.5,"sub_size":8.5},{"t":"cell","id":"f5","x":298.0,"y":98.0,"w":106.0,"h":28.0,"text":"import / export","tone":"yellow","size":9.5,"sub_size":8.5}]],"cues":[6.0,30.8]}]},{"title":"TC39 and yearly releases","sub":"Stages and evergreen","short":"TC39","main":"Editions by year, browsers update themselves.","body":[{"t":"scene","labels":["Proposal stages","Yearly releases","Evergreen browsers"],"captions":["A proposal goes through stages: idea, formal proposal, draft, candidate; at stage 4 at least two browsers implement it","Editions are named by year: ES201