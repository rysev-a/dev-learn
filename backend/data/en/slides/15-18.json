 steps\npeer + key → tunnel address → routes","tone":"red","size":8.5,"sub_size":8.5,"o":0.2}],[{"t":"cell","id":"i0","x":180.0,"y":28.0,"w":320.0,"h":28.0,"text":"IPsec\nnetwork-layer standard: office links","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"i1","x":180.0,"y":64.0,"w":320.0,"h":28.0,"text":"OpenVPN\ntunnel over TLS: flexible, everywhere","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"i2","x":180.0,"y":100.0,"w":320.0,"h":28.0,"text":"WireGuard\npeer keys, UDP, compact, silent when idle","tone":"green","size":8.5,"sub_size":8.5,"o":0.2},{"t":"cell","id":"i3","x":180.0,"y":136.0,"w":320.0,"h":28.0,"text":"setup steps\npeer + key → tunnel address → routes","tone":"red","size":8.5,"sub_size":8.5,"o":0.2}],[{"t":"cell","id":"i0","x":180.0,"y":28.0,"w":320.0,"h":28.0,"text":"IPsec\nnetwork-layer standard: office links","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"i1","x":180.0,"y":64.0,"w":320.0,"h":28.0,"text":"OpenVPN\ntunnel over TLS: flexible, everywhere","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"i2","x":180.0,"y":100.0,"w":320.0,"h":28.0,"text":"WireGuard\npeer keys, UDP, compact, silent when idle","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"i3","x":180.0,"y":136.0,"w":320.0,"h":28.0,"text":"setup steps\npeer + key → tunnel address → routes","tone":"red","size":8.5,"sub_size":8.5,"o":0.2}],[{"t":"cell","id":"i0","x":180.0,"y":28.0,"w":320.0,"h":28.0,"text":"IPsec\nnetwork-layer standard: office links","tone":"yellow","size":8.5,"sub_size":8.5},{"t":"cell","id":"i1","x":180.0,"y":64.0,"w":320.0,"h":28.0,"text":"OpenVPN\ntunnel over TLS: flexible, everywhere","tone":"blue","size":8.5,"sub_size":8.5},{"t":"cell","id":"i2","x":180.0,"y":100.0,"w":320.0,"h":28.0,"text":"WireGuard\npeer keys, UDP, compact, silent when idle","tone":"green","size":8.5,"sub_size":8.5},{"t":"cell","id":"i3","x":180.0,"y":136.0,"w":320.0,"h":28.0,"text":"setup steps\npeer + key → tunnel address → routes","t