.0,"tone":"green","width":3.0},{"t":"line","id":"l2","x1":195.0,"y1":85.0,"x2":264.0,"y2":85.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"t1","x":100.0,"y":55.0,"text":"ssh -J bastion\nalice@10.0.2.5","tone":"green","size":8.0,"mono":true},{"t":"text","id":"t3","x":180.0,"y":135.0,"text":"-L: remote service on a local port","tone":"yellow","size":8.5}],[{"t":"cell","id":"c","x":40.0,"y":85.0,"w":54.0,"h":28.0,"text":"client","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"j","x":160.0,"y":85.0,"w":66.0,"h":28.0,"text":"bastion","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"zone","id":"in","x":300.0,"y":85.0,"w":100.0,"h":110.0,"tone":"outline","label":"internal network"},{"t":"cell","id":"s","x":300.0,"y":85.0,"w":66.0,"h":28.0,"text":"server","tone":"green","size":9.0,"sub_size":8.5},{"t":"line","id":"l1","x1":68.0,"y1":85.0,"x2":126.0,"y2":85.0,"tone":"green","width":3.0},{"t":"line","id":"l2","x1":195.0,"y1":85.0,"x2":264.0,"y2":85.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"t1","x":100.0,"y":55.0,"text":"ssh -J bastion\nalice@10.0.2.5","tone":"green","size":8.0,"mono":true},{"t":"text","id":"t3","x":180.0,"y":135.0,"text":"-L: remote service on a local port","tone":"yellow","size":8.5},{"t":"text","id":"t4","x":180.0,"y":155.0,"text":"anyone with a login can use the tunnel","tone":"red","size":8.5}]],"cues":[5.6,18.2,30.9]},{"t":"note","text":"Internal servers are not published outside."}]},{"title":"VPN tunnel","sub":"Packet in a packet","short":"Tunnel","main":"A private-network packet is packed into UDP between the gateways' public addresses and unpacked at the other end.","body":[{"t":"scene","labels":["Original packet","Packing","Unpacking","What is visible"],"captions":["A packet addressed to another office's private network","It is packed whole into a new packet between the gateways' public addresses","At the other end it is unpacked and goes on as an ordinary one","An observer sees only two public addresses 