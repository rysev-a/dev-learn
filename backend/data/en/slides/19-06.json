{"book":19,"chapter":6,"rubric":"PROCESSES AND RESOURCES / CHAPTER 6","slides":[{"title":"Why groups","sub":"Chapter 6 · Processes and resources","short":"Why","main":"A group gives a whole service accounting and a limit, not just one process.","body":[{"t":"scene","labels":["Problem","Neighbours","Group","Who is in"],"captions":["One process can eat memory, processor or disk","Neighbours suffer; per-process limits do not hold a whole service","A control group: a tree of processes with accounting and limits","A service, a container and a libvirt VM each live in their own group"],"frames":[[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"one process ate resources","tone":"red","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"one process ate resources","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"neighbours suffer","tone":"yellow","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"one process ate resources","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"neighbours suffer","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"group: accounting + limit","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"one process ate resources","tone":"red","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"neighbours suffer","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"group: accounting + limit","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":180.0,"y":122.0,"w":280.0,"h":24.0,"text":"service, container, VM","tone":"green","size":9.0,"sub_size":8.5}]],"cues":[7.3,17.8,28.0]}]},{"title":"Version 2: one tree","