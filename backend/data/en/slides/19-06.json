],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["mkdir /sys/fs/cgroup/demo","cat /sys/fs/cgroup/cgroup.controllers","cpuset cpu io memory pids","echo +memory > cgroup.subtree_control","echo $$ > demo/cgroup.procs"],"hl":[1,2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["mkdir /sys/fs/cgroup/demo","cat /sys/fs/cgroup/cgroup.controllers","cpuset cpu io memory pids","echo +memory > cgroup.subtree_control","echo $$ > demo/cgroup.procs"],"hl":[3],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["mkdir /sys/fs/cgroup/demo","cat /sys/fs/cgroup/cgroup.controllers","cpuset cpu io memory pids","echo +memory > cgroup.subtree_control","echo $$ > demo/cgroup.procs"],"hl":[4],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[8.1,17.4,28.2]}]},{"title":"Two rules","sub":"Chapter 6 · Processes and resources","short":"Rules","main":"Enable top-down; a group with processes does not distribute resources.","body":[{"t":"scene","labels":["Parent","Top-down","No processes","Root"],"captions":["A child has a controller only if the parent enabled it","The list is built from the top down, level by level","A non-root group distributes to children only with no processes of its own","The root group is exempt from the rule"],"frames":[[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"parent enabled the controller","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"parent enabled the controller","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"enable top-down","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"parent enabled the controller","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"enable top-down","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"no processes: may distribute","tone":"yellow","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"parent enabled the controller","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"enable top-down","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"no processes: may distribute","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":180.0,"y":122.0,"w":280.0,"h":24.0,"text":"root: the exception","tone":"green","size":9.0,"sub_size":8.5}]],"cues":[9.2,17.9,30.5]}]},{"title":"CPU: weight and ceiling","sub":"Chapter 6 · Processes and resources","short":"CPU","main":"cpu.weight divides under shortage, cpu.max always cuts.","body":[{"t":"scene","labels":["Ceiling","Quota","Weight","Throttling"],"captions":["cpu.max defaults to max 100000: no ceiling","50000 100000 means half a CPU; 200000 100000 means two","cpu.weight from 1 to 10000, default 100, acts in a dispute","cpu.stat: nr_throttled and throttled_usec grow once the quota is spent"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["cat cpu.max","max 100000","echo '50000 100000' > cpu.max","echo 200 > cpu.weight","grep throttled cpu.stat","nr_throttled 37","throttled_usec 1840221"],"hl":[0,1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["cat cpu.max","max 100000","echo '50000 100000' > cpu.max","echo 200 > cpu.weight","grep throttled cpu.stat","nr_throttled 37","throttled_usec 1840221"],"hl":[2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["cat cpu.max","max 100000","echo '50000 100000' > cpu.max","echo 200 > cpu.weight","grep throttled cpu.stat","nr_throttled 37","throttled_usec 1840221"],"hl":[3],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["cat cpu.max","max 100000","echo '50000 100000' > cpu.max","echo 200 > cpu.weight","grep throttled cpu.stat","nr_throttled 37","throttled_usec 1840221"],"hl":[4,5,6],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[7.8,17.9,28.7]}]},{"title":"Memory: high, max, low","sub":"Chapter 6 · Processes and resources","short":"Memory","main":"high throttles, max runs the OOM killer, events counts.","body":[{"t":"scene","labels":["low/high","max","oom","group"],"captions":["low: reclaimed despite protection; high: processes throttled","max: how many times memory.max was hit","oom: allocation failed; oom_kill: processes killed","oom_group_kill: the whole group was killed"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["cat memory.events","low 0","high 120","max 14","oom 3","oom_kill 2","oom_group_kill 0"],"hl":[1,2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["cat memory.events","low 0","high 120","max 14","oom 3","oom_kill 2","oom_group_kill 0"],"hl":[3],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["cat memory.events","low 0","high 120","max 14","oom 3","oom_kill 2","oom_group_kill 0"],"hl":[4,5],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["cat memory.events","low 0","high 120","max 14","oom 3","oom_kill 2","oom_group_kill 0"],"hl":[6],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[12.2,19.9,30.1]}]},{"title":"Disk and task count","sub":"Chapter 6 · Processes and resources","short":"IO and PID","main":"io.max cuts a disk by MAJ:MIN, pids.max guards against a fork bomb.","body":[{"t":"scene","labels":["io.max","io.weight","pids.max","current"],"captions":["io.max: MAJ:MIN and the pairs rbps, wbps, riops, wiops","io.weight: weight 1-10000, default 100","pids.max: ceiling on the number of tasks in the group","pids.current: how many tasks there are now"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["echo '8:16 rbps=2097152 wiops=120' > io.max","echo 'default 200' > io.weight","echo 100 > pids.max","cat pids.current"],"hl":[0],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["echo '8:16 rbps=2097152 wiops=120' > io.max","echo 'default 200' > io.weight","echo 100 > pids.max","cat pids.current"],"hl":[1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["echo '8:16 rbps=2097152 wiops=120' > io.max","echo 'default 200' > io.weight","echo 100 > pids.max","cat pids.current"],"hl":[2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["echo '8:16 rbps=2097152 wiops=120' > io.max","echo 'default 200' > io.weight","echo 100 > pids.max","cat pids.current"],"hl":[3],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[11.2,19.0,30.0]}]},{"title":"Slices and the tree","sub":"Chapter 6 · Processes and resources","short":"Slices","main":"Root, system, user, machine: every service has its own group.","body":[{"t":"scene","labels":["Root","system","user/machine","libvirt"],"captions":["-.slice: the root of the slice tree; systemd-cgls prints it","system.slice: by default all services","user.slice for sessions, machine.slice for VMs and containers","libvirt puts a guest into machine-qemu...scope inside machine.slice"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["Control group /:","-.slice","├─system.slice","│ ├─sshd.service","│ │ └─812 sshd: /usr/sbin/sshd -D","│ └─cron.service","├─user.slice","└─machine.slice","  └─machine-qemu\\x2d1\\x2dvm1.scope"],"hl":[0,1],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["Control group /:","-.slice","├─system.slice","│ ├─sshd.service","│ │ └─812 sshd: /usr/sbin/sshd -D","│ └─cron.service","├─user.slice","└─machine.slice","  └─machine-qemu\\x2d1\\x2dvm1.scope"],"hl":[2,3,4,5],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["Control group /:","-.slice","├─system.slice","│ ├─sshd.service","│ │ └─812 sshd: /usr/sbin/sshd -D","│ └─cron.service","├─user.slice","└─machine.slice","  └─machine-qemu\\x2d1\\x2dvm1.scope"],"hl":[6,7],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["Control group /:","-.slice","├─system.slice","│ ├─sshd.service","│ │ └─812 sshd: /usr/sbin/sshd -D","│ └─cron.service","├─user.slice","└─machine.slice","  └─machine-qemu\\x2d1\\x2dvm1.scope"],"hl":[8],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[10.2,16.7,27.2]}]},{"title":"Unit properties and files","sub":"Chapter 6 · Processes and resources","short":"Properties","main":"CPUQuota turns into cpu.max; set-property and systemd-run apply it.","body":[{"t":"scene","labels":["CPU","Memory","IO and PID","Commands"],"captions":["CPUQuota=50% writes 50000 100000 into cpu.max","MemoryHigh and MemoryMax go to memory.high and memory.max","IOWeight and TasksMax go to io.weight and pids.max","set-property stores (--runtime: until reboot); systemd-run --scope for one run"],"frames":[[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["CPUQuota=50%   cpu.max 50000 100000","MemoryHigh=1G  memory.high","MemoryMax=2G   memory.max","IOWeight=200   io.weight","TasksMax=100   pids.max","systemctl set-property a.service MemoryMax=2G","systemd-run --scope -p MemoryMax=1G cmd"],"hl":[0],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["CPUQuota=50%   cpu.max 50000 100000","MemoryHigh=1G  memory.high","MemoryMax=2G   memory.max","IOWeight=200   io.weight","TasksMax=100   pids.max","systemctl set-property a.service MemoryMax=2G","systemd-run --scope -p MemoryMax=1G cmd"],"hl":[1,2],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["CPUQuota=50%   cpu.max 50000 100000","MemoryHigh=1G  memory.high","MemoryMax=2G   memory.max","IOWeight=200   io.weight","TasksMax=100   pids.max","systemctl set-property a.service MemoryMax=2G","systemd-run --scope -p MemoryMax=1G cmd"],"hl":[3,4],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["CPUQuota=50%   cpu.max 50000 100000","MemoryHigh=1G  memory.high","MemoryMax=2G   memory.max","IOWeight=200   io.weight","TasksMax=100   pids.max","systemctl set-property a.service MemoryMax=2G","systemd-run --scope -p MemoryMax=1G cmd"],"hl":[5,6],"lang":"plain","size":9.0,"lh":13.0,"w":320.0}]],"cues":[7.3,16.6,24.7]}]},{"title":"The effective limit","sub":"Chapter 6 · Processes and resources","short":"Limit","main":"The tightest limit on the path to the root wins.","body":[{"t":"scene","labels":["Slice","Service","Result","Diagnosis"],"captions":["The slice has MemoryMax=2G","The service inside it has MemoryMax=10G","2G applies, and to the slice as a whole","max and oom grow in memory.events: the group limit; check the kernel log"],"frames":[[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"slice: MemoryMax=2G","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"slice: MemoryMax=2G","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"service: MemoryMax=10G","tone":"violet","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"slice: MemoryMax=2G","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"service: MemoryMax=10G","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"result: 2G for all","tone":"green","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"n0","x":180.0,"y":26.0,"w":280.0,"h":24.0,"text":"slice: MemoryMax=2G","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"n1","x":180.0,"y":58.0,"w":280.0,"h":24.0,"text":"service: MemoryMax=10G","tone":"violet","size":9.0,"sub_size":8.5},{"t":"cell","id":"n2","x":180.0,"y":90.0,"w":280.0,"h":24.0,"text":"result: 2G for all","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"n3","x":180.0,"y":122.0,"w":280.0,"h":24.0,"text":"events: max, oom grow","tone":"yellow","size":9.0,"sub_size":8.5}]],"cues":[6.0,15.0,23.9]}]}]}