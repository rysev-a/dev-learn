EN '?'","     ELSE 'other' END"],"hl":[1],"lang":"sql","size":10.0,"lh":13.0,"w":340.0},{"t":"text","id":"n","x":290.0,"y":100.0,"text":"NULL = 'Moscow'\nnot true","tone":"yellow","size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":36.0,"text":"CASE in 5 queries","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"line","id":"e","x1":168.0,"y1":70.0,"x2":192.0,"y2":70.0,"tone":"muted","arrow":true,"width":1.6},{"t":"cell","id":"b","x":280.0,"y":70.0,"w":150.0,"h":36.0,"text":"VIEW or CTE\nwith one CASE","tone":"green","size":9.5,"sub_size":8.5}]],"cues":[12.0,24.0]}]},{"title":"Summary","sub":"Conditions in queries","short":"Summary","main":"CASE is the main tool of conditional logic in SQL.","body":[{"t":"scene","labels":["Forms","Uses","Next"],"captions":["Searched and simple CASE, ELSE, branch order, IIF","Categories, sorting, conditional aggregates, pivot tables, UPDATE","Next topic — built-in functions: strings, numbers and dates"],"frames":[[{"t":"cell","id":"a","x":65.0,"y":60.0,"w":110.0,"h":30.0,"text":"searched","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":60.0,"w":110.0,"h":30.0,"text":"simple","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":295.0,"y":60.0,"w":110.0,"h":30.0,"text":"IIF","tone":"blue","size":10.0,"sub_size":8.5}],[{"t":"cell","id":"a","x":65.0,"y":50.0,"w":110.0,"h":26.0,"text":"categories","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":180.0,"y":50.0,"w":110.0,"h":26.0,"text":"ORDER BY","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"c","x":295.0,"y":50.0,"w":110.0,"h":26.0,"text":"SUM(CASE)","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"d","x":122.0,"y":96.0,"w":110.0,"h":26.0,"text":"pivots","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"e","x":238.0,"y":96.0,"w":110.0,"h":26.0,"text":"UPDATE","tone":"green","size":9.5,"sub_size":8.5}],[{"t":"code","id":"c~code","x":20.0,"y":40.0,"lines":["ROUND(x, 2)","DATE('now')