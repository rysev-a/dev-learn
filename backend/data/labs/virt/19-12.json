  "tasks": [
    {
      "id": "virt-sim-net-nat",
      "title": "Доска сети: сеть контейнера своими руками, NAT",
      "statement": "Повторите то, что делает Docker для контейнера: пространство имён, пара veth, мост с адресом шлюза, маршрут по умолчанию в контейнере, пересылка пакетов в хосте и правило masquerade. Доска трассирует пинг шаг за шагом и показывает, где он обрывается. Пять сценариев: собрать сеть с нуля, найти недостающее правило masquerade, найти выключенную пересылку (ip_forward), найти отсутствующий маршрут по умолчанию и опубликовать порт контейнера правилом DNAT. Упражнение решено, когда решены все сценарии.",
      "hint": "Пакет для другой сети уходит на шлюз; шлюз должен пересылать пакеты и иметь ногу в сети назначения. Внешняя сеть не знает частных адресов: без masquerade ответ не вернётся. Опубликовать порт можно только правилом DNAT, которое указывает на хост внутри.",
      "spec": {
        "sim": "net_board",
        "scenarios": [
          {
            "id": "build",
            "title": "A container network from nothing",
            "story": "The host has an uplink eth0 to the internet. The namespace ns1 is empty. Build what Docker builds for a container: a veth pair, a bridge with the address 10.0.2.x of the container network, the address and the default route in the container, forwarding in the host and a masquerade rule.",
            "goal": "ns1 pings the host and the internet, and every interface has a link",
            "hint": "Work from the container outwards: the container end gets an address of the container network and the default route, the host end becomes a port of the bridge, the bridge holds the gateway address. Then the host must forward packets and replace the source address.",
            "palette": [
              "veth",
              "bridge",
              "nat"
            ],
            "max_nodes": 14,
            "start": {
              "nodes": [
                {
                  "id": "host",
                  "kind": "netns",
                  "name": "host",
                  "x": 70.0,
                  "y": 60.0
                },
                {
                  "id": "ns1",
                  "kind": "netns",
                  "name": "ns1",
                  "x": 70.0,
                  "y": 140.0
                },
                {
                  "id": "net",
                  "kind": "external",
                  "name": "internet",
                  "x": 670.0,
                  "y": 60.0
                },
                {
                  "id": "eth0",
                  "kind": "eth",
                  "name": "eth0",
                  "x": 190.0,
                  "y": 60.0,
                  "params": {
                    "net": "a"
                  }
                }
              ],
              "edges": [
                {
                  "from": "host",
                  "to": "eth0"
                },
                {
                  "from": "eth0",
                  "to": "net"
                }
              ]
            },
            "goals": [
              {
                "kind": "ping",
                "from": "ns1",
                "to": "host"
              },
              {
                "kind": "ping",
                "from": "ns1",
                "to": "net"
              },
              {
                "kind": "healthy"
              }
            ]
          },
