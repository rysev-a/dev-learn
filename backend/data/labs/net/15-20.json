            "id": "g1",
            "text": "Контейнер c2 пингует внешний хост (192.168.0.30)",
            "ping": {
              "from": "c2",
              "to": "@ext"
            }
          },
          {
            "id": "g2",
            "text": "Клиент открывает веб c1 через узел: 192.168.0.5:8080",
            "tcp": {
              "from": "pc",
              "to": "@host.eth0",
              "port": 8080
            }
          },
          {
            "id": "g3",
            "text": "Порт 80 узла снаружи закрыт",
