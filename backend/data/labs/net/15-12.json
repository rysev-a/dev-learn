    {
      "id": "n12-h2",
      "title": "Много файлов и большая задержка",
      "statement": "Страница из 41 файла загружается с далёкого сервера (RTT около 120 мс) по HTTP/1.1: браузер получает ресурсы по шесть штук, и каждая «волна» стоит целого круга. Выполните на ПК `pageload https://www.example.org/` — в таблице видно, сколько заняла бы загрузка по каждой версии. Включите на сервере протокол, который отдаёт все ресурсы одним соединением параллельно, и уложите загрузку в 1,3 секунды.",
      "hint": "На сервере: переключатель «протокол» в карточке — HTTP/2, или `web protocol h2`. HTTP/3 здесь не нужен: потерь на канале нет.",
      "spec": {
        "tools": {
          "fw": true,
          "http": true
        },
        "start": {
          "devices": [
            {
              "id": "pc",
              "kind": "host",
              "name": "Браузер (ПК)",
              "x": 70,
              "y": 180,
              "ifaces": [
                {
                  "name": "eth0",
                  "mac": "28:28:00:00:01:9a",
                  "ip": "10.0.0.10",
                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [
                {
                  "dst": "0.0.0.0/0",
                  "via": "10.0.0.1",
                  "dev": null
                }
              ],
              "forward": false,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [],
              "locked": false,
              "drop_private": false,
              "hosts": {
                "www.example.org": "10.0.1.10"
              }
            },
            {
              "id": "r1",
              "kind": "router",
              "name": "Маршрутизатор",
              "x": 310,
              "y": 180,
              "ifaces": [
                {
                  "name": "eth0",
                  "mac": "28:28:00:00:01:9b",
                  "ip": "10.0.0.1",
                  "prefix": 24,
                  "up": true
                },
                {
                  "name": "eth1",
                  "mac": "28:28:00:00:01:9c",
                  "ip": "10.0.1.1",
                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [],
              "forward": true,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [],
              "locked": false,
              "drop_private": false
            },
            {
              "id": "web",
              "kind": "server",
              "name": "Сайт",
              "x": 560,
              "y": 180,
              "ifaces": [
                {
                  "name": "eth0",
                  "mac": "28:28:00:00:01:9d",
