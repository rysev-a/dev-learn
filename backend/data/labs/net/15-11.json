            "id": "g1",
            "text": "Старый адрес даёт 301 с Location: /new-page",
            "http": {
              "from": "pc",
              "url": "http://www.example.org/old-page",
              "status": 301,
              "header": {
                "location": "/new-page"
              }
            }
          },
          {
            "id": "g2",
            "text": "curl -L доходит до /new-page с кодом 200 за два запроса",
            "http": {
              "from": "pc",
              "url": "http://www.example.org/old-page",
              "follow": true,
              "status": 200,
              "hops": 2,
              "final_url": "/new-page"
            }
          }
        ],
        "solution": [
          {
            "op": "cmd",
            "dev": "web",
            "line": "web redirect /old-page 301 /new-page"
          }
        ]
      }
    },
    {
      "id": "n11-cache",
      "title": "Кэш: статика надолго, личное — никогда",
