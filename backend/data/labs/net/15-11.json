                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [],
              "forward": false,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [
                {
                  "proto": "tcp",
                  "port": 80
                }
              ],
              "locked": false,
              "drop_private": false,
              "http": {
                "routes": [
                  {
                    "path": "/",
                    "status": 200,
                    "body": "<h1>Главная</h1>"
                  },
                  {
                    "path": "/new-page",
                    "status": 200,
                    "body": "<h1>Новая страница</h1>"
