                },
                {
                  "name": "p4",
                  "mac": "28:28:00:00:01:86",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [],
              "forward": false,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [],
              "locked": false,
              "drop_private": false
            },
            {
              "id": "web",
              "kind": "server",
              "name": "Веб-сервер",
              "x": 520,
              "y": 180,
              "ifaces": [
                {
                  "name": "eth0",
                  "mac": "28:28:00:00:01:87",
