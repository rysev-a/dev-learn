              "hosts": {
                "www.example.org": "192.168.0.20"
              }
            },
            {
              "id": "sw",
              "kind": "switch",
              "name": "Коммутатор",
              "x": 250,
              "y": 180,
              "ifaces": [
                {
                  "name": "p1",
                  "mac": "28:28:00:00:01:83",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                },
                {
                  "name": "p2",
                  "mac": "28:28:00:00:01:84",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                },
                {
                  "name": "p3",
                  "mac": "28:28:00:00:01:85",
                  "ip": null,
                  "prefix": 24,
