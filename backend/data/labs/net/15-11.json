    {
      "id": "n11-404",
      "title": "Страница не найдена",
      "statement": "Ссылка «О нас» ведёт на /about, но сервер отвечает 404 Not Found. Откройте терминал браузера (ПК) и выполните `curl -v http://www.example.org/about`: в стартовой строке ответа виден код. Добавьте на веб-сервере маршрут /about с кодом 200 и текстом, содержащим слово «About».",
      "hint": "На сервере: `web route /about 200 About us page` или форма «+ маршрут» (путь /about, код 200, текст). Затем снова curl.",
      "spec": {
        "tools": {
          "http": true
        },
        "start": {
          "devices": [
            {
              "id": "pc",
              "kind": "host",
              "name": "Браузер (ПК)",
              "x": 80,
              "y": 180,
              "ifaces": [
                {
                  "name": "eth0",
                  "mac": "28:28:00:00:01:7c",
                  "ip": "192.168.0.10",
                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [],
              "forward": false,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [],
              "locked": false,
              "drop_private": false,
              "hosts": {
                "www.example.org": "192.168.0.20"
              }
            },
            {
              "id": "sw",
              "kind": "switch",
              "name": "Коммутатор",
              "x": 250,
              "y": 180,
              "ifaces": [
                {
                  "name": "p1",
                  "mac": "28:28:00:00:01:7d",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                },
                {
                  "name": "p2",
                  "mac": "28:28:00:00:01:7e",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                },
                {
                  "name": "p3",
                  "mac": "28:28:00:00:01:7f",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                },
                {
                  "name": "p4",
                  "mac": "28:28:00:00:01:80",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [],
              "forward": false,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [],
              "locked": false,
              "drop_private": false
            },
            {
              "id": "web",
              "kind": "server",
              "name": "Веб-сервер",
              "x": 520,
              "y": 180,
              "ifaces": [
                {
                  "name": "eth0",
                  "mac": "28:28:00:00:01:81",
                  "ip": "192.168.0.20",
                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [],
              "forward": false,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [
                {
                  "proto": "tcp",
                  "port": 80
                }
              ],
              "locked": false,
              "drop_private": false,
              "http": {
                "routes": [
                  {
                    "path": "/",
                    "status": 200,
                    "body": "<h1>Главная</h1>"
                  }
                ]
              }
            }
          ],
          "links": [
            {
              "a": "pc:eth0",
              "b": "sw:p1",
              "km": 0.01,
              "mbps": 1000
            },
            {
              "a": "web:eth0",
              "b": "sw:p2",
              "km": 0.01,
              "mbps": 1000
            }
          ]
        },
        "goals": [
          {
            "id": "g1",
            "text": "GET /about возвращает 200",
            "http": {
              "from": "pc",
              "url": "http://www.example.org/about",
              "status": 200,
              "body_includes": "About"
            }
          },
          {
            "id": "g2",
            "text": "Главная по-прежнему доступна",
            "http": {
              "from": "pc",
              "url": "http://www.example.org/",
              "status": 200
            }
          }
        ],
        "solution": [
          {
            "op": "cmd",
            "dev": "web",
            "line": "web route /about 200 About us page"
          }
        ]
      }
    },
    {
      "id": "n11-redirect",
      "title": "Постоянный редирект",
      "statement": "Страница /old-page переехала на /new-page, но по старому адресу сейчас 404, и поисковики теряют ссылки. Настройте на сервере постоянное перенаправление 301 со старого адреса на новый. Проверьте двумя способами: `curl -I` показывает 301 и заголовок Location, а `curl -L` доходит до итоговой страницы.",
      "hint": "`web redirect /old-page 301 /new-page` или форма с кодом 301 и адресом назначения в последнем поле.",
      "spec": {
        "tools": {
          "http": true
        },
        "start": {
          "devices": [
            {
              "id": "pc",
              "kind": "host",
