          "links": [
            {
              "a": "pc1:eth0",
              "b": "r1:eth0",
              "km": 0.01,
              "mbps": 1000
            },
            {
              "a": "r1:eth1",
              "b": "srv:eth0",
              "km": 0.01,
              "mbps": 1000
            }
          ]
        },
        "goals": [
          {
            "id": "g1",
            "text": "ПК пингует сервер",
            "ping": {
              "from": "pc1",
              "to": "@srv"
