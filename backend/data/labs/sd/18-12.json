    {
      "id": "sd12-push-queue",
      "title": "Рассылка постов через очередь",
      "statement": "У сервиса небольшие аудитории (10 подписчиков у автора), поэтому выбран push: каждый пост рассылается в ленты. При 400 постах в секунду это 4000 записей в ленты — всё сразу база не выдержит. Пропустите запись через очередь с обработчиками: база L загружена не выше 80%, очередь разбирается после 10-секундного пика не дольше 45 секунд. Режим ленты — push.",
      "hint": "Обработчики определяют темп записи в базу: два обработчика M — 800 в секунду (53% базы L). Отставание: (4000 − 800) / 800 × 10 = 40 с.",
      "spec": {
        "workload": {"static_rps": 0, "read_rps": 500, "write_rps": 400, "data_gb": 200, "hot_set": 0.2, "spike_sec": 10, "fanout": 10},
        "palette": ["lb", "app", "queue", "worker", "db"],
        "start": {
          "nodes": [
            {"id": "users", "kind": "clients", "name": "Пользователи", "x": 70, "y": 235, "params": {}},
            {"id": "lb", "kind": "lb", "name": "Балансировщик", "x": 520, "y": 235, "params": {"instances": 2, "layer": "L4"}},
            {"id": "app", "kind": "app", "name": "Сервер приложения", "x": 670, "y": 235, "params": {"breaker": false, "deploy": "all", "feed": "push", "idempotency": false, "instances": 5, "pricing": "ondemand", "retries": 0, "sessions": "external", "size": "M", "weight": 1, "zone": "single"}},
            {"id": "db", "kind": "db", "name": "База данных", "x": 1120, "y": 235, "params": {"engine": "sql", "failover": false, "replicas": 0, "shard_key": "hash", "shards": 1, "size": "L", "sync": "async", "zone": "single"}}
          ],
          "edges": [{"from": "users", "to": "lb"}, {"from": "lb", "to": "app"}, {"from": "app", "to": "db"}]
        },
        "goals": [
          {"type": "link", "from": "app", "to": "queue"},
          {"type": "param", "kind": "app", "key": "feed", "op": "==", "value": "push"},
          {"type": "util", "kind": "db", "max": 0.8},
          {"type": "lag", "max": 45}
        ],
        "solution": {
          "nodes": [
            {"id": "users", "kind": "clients", "name": "Пользователи", "x": 70, "y": 235, "params": {}},
            {"id": "lb", "kind": "lb", "name": "Балансировщик", "x": 520, "y": 235, "params": {"instances": 2, "layer": "L4"}},
            {"id": "app", "kind": "app", "name": "Сервер приложения", "x": 670, "y": 235, "params": {"breaker": false, "deploy": "all", "feed": "push", "idempotency": false, "instances": 5, "pricing": "ondemand", "retries": 0, "sessions": "external", "size": "M", "weight": 1, "zone": "single"}},
            {"id": "queue", "kind": "queue", "name": "Очередь", "x": 820, "y": 235, "params": {"dlq": false, "partitions": 1}},
            {"id": "worker", "kind": "worker", "name": "Обработчик", "x": 970, "y": 235, "params": {"idempotent": false, "instances": 2, "pricing": "ondemand", "size": "M", "zone": "single"}},
            {"id": "db", "kind": "db", "name": "База данных", "x": 1120, "y": 235, "params": {"engine": "sql", "failover": false, "replicas": 0, "shard_key": "hash", "shards": 1, "size": "L", "sync": "async", "zone": "single"}}
          ],
          "edges": [{"from": "users", "to": "lb"}, {"from": "lb", "to": "app"}, {"from": "app", "to": "db"}, {"from": "app", "to": "queue"}, {"from": "queue", "to": "worker"}, {"from": "worker", "to": "db"}]
        },
        "show": ["app.feed"]
      }
