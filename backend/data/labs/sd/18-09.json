    {
      "id": "sd09-limiter-attack",
      "title": "Ограничитель от атаки",
      "statement": "Обычно сервис получает около 1500 запросов в секунду, но сейчас идёт атака: 6000. Серверы приложения (три M — 2100 запросов) перегружены. Поставьте ограничитель на входе и подберите предел: серверы загружены не больше чем на 95%, а до сервиса доходит не меньше 28% запросов (иначе вместе с атакой вы режете своих).",
      "hint": "Ограничитель ставится между балансировщиком и серверами: lb → ограничитель → сервер. Предел от 1700 до 1995: 6000 × 0,28 ≈ 1680, 2100 × 0,95 ≈ 1995.",
      "spec": {
        "workload": {"static_rps": 0, "read_rps": 5000, "write_rps": 1000, "data_gb": 20, "hot_set": 0.2},
        "palette": ["lb", "limiter", "app", "db"],
        "start": {
          "nodes": [
            {"id": "users", "kind": "clients", "name": "Пользователи", "x": 70, "y": 235, "params": {}},
            {"id": "lb", "kind": "lb", "name": "Балансировщик", "x": 520, "y": 235, "params": {"instances": 2, "layer": "L4"}},
            {"id": "app", "kind": "app", "name": "Сервер приложения", "x": 670, "y": 235, "params": {"breaker": false, "deploy": "all", "feed": "pull", "idempotency": false, "instances": 3, "pricing": "ondemand", "retries": 0, "sessions": "external", "size": "M", "weight": 1, "zone": "single"}},
            {"id": "db", "kind": "db", "name": "База данных", "x": 1120, "y": 235, "params": {"engine": "sql", "failover": false, "replicas": 0, "shard_key": "hash", "shards": 1, "size": "L", "sync": "async", "zone": "single"}}
          ],
          "edges": [{"from": "users", "to": "lb"}, {"from": "lb", "to": "app"}, {"from": "app", "to": "db"}]
        },
        "goals": [
          {"type": "has", "kind": "limiter"},
          {"type": "util", "kind": "app", "max": 0.95},
          {"type": "success", "min": 0.28}
        ],
        "solution": {
          "nodes": [
            {"id": "users", "kind": "clients", "name": "Пользователи", "x": 70, "y": 235, "params": {}},
            {"id": "lb", "kind": "lb", "name": "Балансировщик", "x": 520, "y": 235, "params": {"instances": 2, "layer": "L4"}},
            {"id": "limiter", "kind": "limiter", "name": "Ограничитель", "x": 370, "y": 235, "params": {"limit": 1800}},
            {"id": "app", "kind": "app", "name": "Сервер приложения", "x": 670, "y": 235, "params": {"breaker": false, "deploy": "all", "feed": "pull", "idempotency": false, "instances": 3, "pricing": "ondemand", "retries": 0, "sessions": "external", "size": "M", "weight": 1, "zone": "single"}},
            {"id": "db", "kind": "db", "name": "База данных", "x": 1120, "y": 235, "params": {"engine": "sql", "failover": false, "replicas": 0, "shard_key": "hash", "shards": 1, "size": "L", "sync": "async", "zone": "single"}}
          ],
          "edges": [{"from": "users", "to": "lb"}, {"from": "lb", "to": "limiter"}, {"from": "limiter", "to": "app"}, {"from": "app", "to": "db"}]
        }
      }
    },
