    {
      "id": "sd05-write-shards",
      "title": "Упёрлись в запись",
      "statement": "Сервис принимает 1500 записей в секунду, а база S тянет 200, M — 600, L — 1500 (в обрез). Реплики запись не ускорят. Разрежьте данные на шарды (параметр «Шарды» у базы): загрузка не выше 80%, стоимость не больше $1600 в месяц.",
      "hint": "Записи делятся между шардами поровну (при хеше). Четыре шарда M: по 375 записей на шард — 63%. Столько же стоят десять шардов S, но M проще.",
      "spec": {
        "workload": {"static_rps": 0, "read_rps": 500, "write_rps": 1500, "data_gb": 400, "hot_set": 0.2},
        "palette": ["lb", "app", "db"],
        "start": {
          "nodes": [
            {"id": "users", "kind": "clients", "name": "Пользователи", "x": 70, "y": 235, "params": {}},
            {"id": "lb", "kind": "lb", "name": "Балансировщик", "x": 520, "y": 235, "params": {"instances": 2, "layer": "L4"}},
            {"id": "app", "kind": "app", "name": "Сервер приложения", "x": 670, "y": 235, "params": {"breaker": false, "deploy": "all", "feed": "pull", "idempotency": false, "instances": 4, "pricing": "ondemand", "retries": 0, "sessions": "external", "size": "M", "weight": 1, "zone": "single"}},
            {"id": "db", "kind": "db", "name": "База данных", "x": 1120, "y": 235, "params": {"engine": "sql", "failover": false, "replicas": 0, "shard_key": "hash", "shards": 1, "size": "M", "sync": "async", "zone": "single"}}
          ],
          "edges": [{"from": "users", "to": "lb"}, {"from": "lb", "to": "app"}, {"from": "app", "to": "db"}]
        },
        "goals": [
          {"type": "capacity", "max": 0.8},
          {"type": "success", "min": 0.99},
          {"type": "cost", "max": 1600}
        ],
        "solution": {
          "nodes": [
            {"id": "users", "kind": "clients", "name": "Пользователи", "x": 70, "y": 235, "params": {}},
            {"id": "lb", "kind": "lb", "name": "Балансировщик", "x": 520, "y": 235, "params": {"instances": 2, "layer": "L4"}},
            {"id": "app", "kind": "app", "name": "Сервер приложения", "x": 670, "y": 235, "params": {"breaker": false, "deploy": "all", "feed": "pull", "idempotency": false, "instances": 4, "pricing": "ondemand", "retries": 0, "sessions": "external", "size": "M", "weight": 1, "zone": "single"}},
            {"id": "db", "kind": "db", "name": "База данных", "x": 1120, "y": 235, "params": {"engine": "sql", "failover": false, "replicas": 0, "shard_key": "hash", "shards": 4, "size": "M", "sync": "async", "zone": "single"}}
          ],
          "edges": [{"from": "users", "to": "lb"}, {"from": "lb", "to": "app"}, {"from": "app", "to": "db"}]
        }
      }
    },
    {
