            {"id": "db", "kind": "db", "name": "База данных", "x": 1120, "y": 157, "params": {"engine": "sql", "failover": false, "replicas": 0, "shard_key": "range", "shards": 3, "size": "L", "sync": "async", "zone": "single"}},
