    {
      "id": "sd11-ws-gateway",
      "title": "Шлюзы WebSocket",
      "statement": "Чат получает 90 000 одновременных соединений, а обычные запросы (история) идут через балансировщик. Один шлюз WebSocket держит 15 000 соединений. Добавьте шлюзы между пользователями и серверами приложения, свяжите их и подберите число экземпляров так, чтобы шлюзы были загружены не больше чем на 80%.",
      "hint": "Пользователи → шлюз WebSocket → сервер приложения. Для 90 000 соединений понадобится восемь экземпляров (67–75%).",
      "spec": {
        "workload": {"static_rps": 0, "read_rps": 300, "write_rps": 50, "data_gb": 20, "hot_set": 0.2, "connections": 90000, "msg_per_conn": 0.005},
        "palette": ["lb", "ws", "app", "db"],
        "start": {
          "nodes": [
            {"id": "users", "kind": "clients", "name": "Пользователи", "x": 70, "y": 235, "params": {}},
            {"id": "lb", "kind": "lb", "name": "Балансировщик", "x": 520, "y": 235, "params": {"instances": 2, "layer": "L4"}},
            {"id": "app", "kind": "app", "name": "Сервер приложения", "x": 670, "y": 235, "params": {"breaker": false, "deploy": "all", "feed": "pull", "idempotency": false, "instances": 4, "pricing": "ondemand", "retries": 0, "sessions": "external", "size": "M", "weight": 1, "zone": "single"}},
            {"id": "db", "kind": "db", "name": "База данных", "x": 1120, "y": 235, "params": {"engine": "sql", "failover": false, "replicas": 0, "shard_key": "hash", "shards": 1, "size": "M", "sync": "async", "zone": "single"}}
          ],
          "edges": [{"from": "users", "to": "lb"}, {"from": "lb", "to": "app"}, {"from": "app", "to": "db"}]
        },
        "goals": [
          {"type": "has", "kind": "ws"},
          {"type": "link", "from": "clients", "to": "ws"},
          {"type": "link", "from": "ws", "to": "app"},
          {"type": "util", "kind": "ws", "max": 0.8}
        ],
        "solution": {
