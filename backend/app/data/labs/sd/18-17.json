    {
      "id": "sd17-reserved",
      "title": "Резерв для постоянной нагрузки",
      "statement": "Нагрузка стабильна: 4000 запросов в секунду круглые сутки. Серверы оплачиваются по требованию. Переведите их на резервный тариф (параметр «Тариф» показан в упражнении) со скидкой около 40% и уложитесь в $1000 в месяц при загрузке не выше 80%.",
      "hint": "Восемь серверов M по требованию стоят 960 за одни серверы — вместе с базой и балансировщиком больше 1200. С резервом — около 580 за серверы.",
      "spec": {
        "workload": {"static_rps": 0, "read_rps": 3600, "write_rps": 400, "data_gb": 60, "hot_set": 0.2},
        "palette": ["lb", "app", "db"],
        "start": {
          "nodes": [
            {"id": "users", "kind": "clients", "name": "Пользователи", "x": 70, "y": 235, "params": {}},
            {"id": "lb", "kind": "lb", "name": "Балансировщик", "x": 520, "y": 235, "params": {"instances": 1, "layer": "L4"}},
            {"id": "app", "kind": "app", "name": "Сервер приложения", "x": 670, "y": 235, "params": {"breaker": false, "deploy": "all", "feed": "pull", "idempotency": false, "instances": 8, "pricing": "ondemand", "retries": 0, "sessions": "external", "size": "M", "weight": 1, "zone": "single"}},
            {"id": "db", "kind": "db", "name": "База данных", "x": 1120, "y": 235, "params": {"engine": "sql", "failover": false, "replicas": 0, "shard_key": "hash", "shards": 1, "size": "L", "sync": "async", "zone": "single"}}
          ],
          "edges": [{"from": "users", "to": "lb"}, {"from": "lb", "to": "app"}, {"from": "app", "to": "db"}]
        },
        "goals": [
          {"type": "capacity", "max": 0.8},
          {"type": "param", "kind": "app", "key": "pricing", "op": "==", "value": "reserved"},
          {"type": "cost", "max": 1300}
        ],
        "solution": {
          "nodes": [
            {"id": "users", "kind": "clients", "name": "Пользователи", "x": 70, "y": 235, "params": {}},
            {"id": "lb", "kind": "lb", "name": "Балансировщик", "x": 520, "y": 235, "params": {"instances": 1, "layer": "L4"}},
            {"id": "app", "kind": "app", "name": "Сервер приложения", "x": 670, "y": 235, "params": {"breaker": false, "deploy": "all", "feed": "pull", "idempotency": false, "instances": 8, "pricing": "reserved", "retries": 0, "sessions": "external", "size": "M", "weight": 1, "zone": "single"}},
            {"id": "db", "kind": "db", "name": "База данных", "x": 1120, "y": 235, "params": {"engine": "sql", "failover": false, "replicas": 0, "shard_key": "hash", "shards": 1, "size": "L", "sync": "async", "zone": "single"}}
