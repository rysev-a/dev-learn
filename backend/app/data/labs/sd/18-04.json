    {
      "id": "sd04-replicas",
      "title": "Реплики под чтения",
      "statement": "Чтений 2500 в секунду при 100 записях. База S тянет 1000 чтений, и она перегружена. Кэша нет. Добавьте реплики (параметр базы «Реплики на шард»): загрузка не выше 80%, стоимость не больше $1200 в месяц. Подумайте: что дешевле — реплики или база покрупнее?",
      "hint": "Каждая реплика S добавляет 1000 чтений. Нужно 4 реплики: 2500 / 4000 = 63%. База M с одной репликой даёт 83% — не хватает.",
      "spec": {
        "workload": {"static_rps": 0, "read_rps": 2500, "write_rps": 100, "data_gb": 50, "hot_set": 0.2},
        "palette": ["lb", "app", "db"],
        "start": {
          "nodes": [
            {"id": "users", "kind": "clients", "name": "Пользователи", "x": 70, "y": 235, "params": {}},
            {"id": "lb", "kind": "lb", "name": "Балансировщик", "x": 520, "y": 235, "params": {"instances": 1, "layer": "L4"}},
            {"id": "app", "kind": "app", "name": "Сервер приложения", "x": 670, "y": 235, "params": {"breaker": false, "deploy": "all", "feed": "pull", "idempotency": false, "instances": 5, "pricing": "ondemand", "retries": 0, "sessions": "external", "size": "M", "weight": 1, "zone": "single"}},
            {"id": "db", "kind": "db", "name": "База данных", "x": 1120, "y": 235, "params": {"engine": "sql", "failover": false, "replicas": 0, "shard_key": "hash", "shards": 1, "size": "S", "sync": "async", "zone": "single"}}
          ],
          "edges": [{"from": "users", "to": "lb"}, {"from": "lb", "to": "app"}, {"from": "app", "to": "db"}]
        },
        "goals": [
          {"type": "capacity", "max": 0.8},
          {"type": "success", "min": 0.99},
          {"type": "cost", "max": 1200}
        ],
        "solution": {
          "nodes": [
            {"id": "users", "kind": "clients", "name": "Пользователи", "x": 70, "y": 235, "params": {}},
            {"id": "lb", "kind": "lb", "name": "Балансировщик", "x": 520, "y": 235, "params": {"instances": 1, "layer": "L4"}},
            {"id": "app", "kind": "app", "name": "Сервер приложения", "x": 670, "y": 235, "params": {"breaker": false, "deploy": "all", "feed": "pull", "idempotency": false, "instances": 5, "pricing": "ondemand", "retries": 0, "sessions": "external", "size": "M", "weight": 1, "zone": "single"}},
            {"id": "db", "kind": "db", "name": "База данных", "x": 1120, "y": 235, "params": {"engine": "sql", "failover": false, "replicas": 4, "shard_key": "hash", "shards": 1, "size": "S", "sync": "async", "zone": "single"}}
