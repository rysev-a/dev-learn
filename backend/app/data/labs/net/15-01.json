    {
      "id": "n1-cable",
      "title": "Соедините два компьютера",
      "statement": "Два компьютера уже настроены: адреса 192.168.0.1 и 192.168.0.2 в одной подсети. Но между ними нет канала. Нажмите «Кабель», выберите первый узел, затем второй, и проверьте связь командой ping.",
      "hint": "Канал — это ребро графа. Без кабеля узлы не могут обменяться даже одним пакетом.",
      "spec": {
        "tools": {
          "cable": true
        },
        "start": {
          "devices": [
            {
              "id": "pc1",
              "kind": "host",
              "name": "ПК 1",
              "x": 160,
              "y": 180,
              "ifaces": [
                {
                  "name": "eth0",
                  "mac": "28:28:00:00:00:01",
                  "ip": "192.168.0.1",
                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [],
              "forward": false,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [],
              "locked": false,
              "drop_private": false
            },
            {
              "id": "pc2",
              "kind": "host",
              "name": "ПК 2",
              "x": 480,
              "y": 180,
              "ifaces": [
                {
                  "name": "eth0",
                  "mac": "28:28:00:00:00:02",
                  "ip": "192.168.0.2",
                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [],
              "forward": false,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [],
              "locked": false,
              "drop_private": false
            }
          ],
          "links": []
        },
        "goals": [
          {
            "id": "g1",
            "text": "ПК 1 пингует ПК 2",
            "ping": {
              "from": "pc1",
              "to": "@pc2"
            }
          }
        ],
        "solution": [
          {
            "op": "cable",
            "a": "pc1",
            "b": "pc2"
          }
        ]
      }
    },
