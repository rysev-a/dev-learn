{
  "book": 15,
  "chapter": 13,
  "lab": "net",
  "tasks": [
    {
      "id": "n13-expired",
      "title": "Сертификат просрочен",
      "statement": "Сайт перестал открываться по HTTPS: `curl https://www.example.org/` выдаёт «certificate has expired». Проверьте срок на сервере (`tls show`; сегодня 2026-10-16) и выпустите новый сертификат на 90 дней у промежуточного центра PublicIntCA на то же имя.",
      "hint": "На сервере: `tls cert new www.example.org --issuer PublicIntCA --days 90`. Цепочка и версии остаются. Проверка: `openssl s_client -connect www.example.org:443`.",
      "spec": {
        "tools": {
          "tls": true
        },
        "start": {
          "devices": [
            {
              "id": "pc",
              "kind": "host",
              "name": "Браузер (ПК)",
              "x": 80,
              "y": 180,
              "ifaces": [
                {
                  "name": "eth0",
                  "mac": "28:28:00:00:01:a8",
                  "ip": "192.168.0.10",
                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [],
              "forward": false,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [],
              "locked": false,
              "drop_private": false,
              "hosts": {
                "www.example.org": "192.168.0.20"
              }
            },
            {
              "id": "sw",
              "kind": "switch",
              "name": "Коммутатор",
              "x": 260,
              "y": 180,
              "ifaces": [
                {
                  "name": "p1",
                  "mac": "28:28:00:00:01:a9",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                },
                {
                  "name": "p2",
                  "mac": "28:28:00:00:01:aa",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                },
                {
                  "name": "p3",
                  "mac": "28:28:00:00:01:ab",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                },
                {
                  "name": "p4",
                  "mac": "28:28:00:00:01:ac",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [],
              "forward": false,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [],
              "locked": false,
              "drop_private": false
            },
            {
              "id": "web",
              "kind": "server",
              "name": "Веб-сервер",
              "x": 520,
              "y": 180,
              "ifaces": [
                {
                  "name": "eth0",
                  "mac": "28:28:00:00:01:ad",
                  "ip": "192.168.0.20",
                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [],
              "forward": false,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [
                {
                  "proto": "tcp",
                  "port": 443
                }
              ],
              "locked": false,
              "drop_private": false,
              "http": {
                "routes": [
                  {
                    "path": "/",
                    "status": 200,
                    "body": "<h1>Защищённая главная</h1>"
                  }
                ]
              },
              "tls": {
                "cert": {
                  "cn": "www.example.org",
                  "san": [
                    "www.example.org"
                  ],
                  "issuer": "PublicIntCA",
                  "not_after": "2026-09-01"
                },
                "chain": [
                  "PublicIntCA"
                ],
                "versions": [
                  "1.2",
                  "1.3"
                ]
              }
            }
          ],
          "links": [
            {
              "a": "pc:eth0",
              "b": "sw:p1",
              "km": 0.01,
              "mbps": 1000
            },
            {
              "a": "web:eth0",
              "b": "sw:p2",
              "km": 0.01,
              "mbps": 1000
            }
          ],
          "pki": {
            "cas": {
              "PublicRootCA": {
                "issuer": null
              },
              "PublicIntCA": {
                "issuer": "PublicRootCA"
              },
              "CorpRootCA": {
                "issuer": null
              },
              "CorpIntCA": {
                "issuer": "CorpRootCA"
              },
              "ShadyRootCA": {
                "issuer": null
              }
            }
          }
        },
        "goals": [
          {
            "id": "g1",
            "text": "HTTPS-запрос возвращает 200",
            "http": {
              "from": "pc",
              "url": "https://www.example.org/",
              "status": 200,
              "body_includes": "Защищённая"
            }
          }
        ],
        "solution": [
          {
            "op": "cmd",
            "dev": "web",
            "line": "tls cert new www.example.org --issuer PublicIntCA --days 90"
          }
        ]
      }
    },
