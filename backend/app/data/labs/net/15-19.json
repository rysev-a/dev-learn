        "tools": {},
        "start": {
          "devices": [
            {
              "id": "pc",
              "kind": "host",
              "name": "ПК жертвы",
              "x": 70,
              "y": 80,
              "ifaces": [
                {
                  "name": "eth0",
                  "mac": "28:28:00:00:02:68",
                  "ip": "192.168.0.10",
                  "prefix": 24,
                  "up": true
                }
