              "to": "@pb",
              "via": "gb"
            }
          }
        ],
        "solution": [
          {
            "op": "cmd",
            "dev": "ga",
            "line": "vpn add wg0 --peer 198.51.100.1 --address 10.9.0.1/30 --key s3cr3t"
