    {
      "id": "n18-keys",
      "title": "Вход по ключу вместо пароля",
      "statement": "Сервер пускает пользователя alice по паролю alice123, и ботам этого достаточно. Нужно перейти на ключи. На ПК создайте ключ (`ssh-keygen`), скопируйте его на сервер (`ssh-copy-id -P alice123 alice@192.168.0.20`; пароль нужен один раз), проверьте вход по ключу, а затем выключите парольный вход на сервере (`sshd password off`).",
      "hint": "Порядок важен: сначала ключ и копирование, потом отключение паролей — иначе вы отрежете себе вход. Проверка: `ssh alice@192.168.0.20` входит по ключу, `ssh -o PubkeyAuthentication=no -P alice123 alice@192.168.0.20` — отказ.",
      "spec": {
        "tools": {
          "ssh": true
        },
        "start": {
          "devices": [
            {
              "id": "pc",
              "kind": "host",
              "name": "ПК админа",
              "x": 100,
              "y": 180,
              "ifaces": [
                {
                  "name": "eth0",
                  "mac": "28:28:00:00:02:40",
                  "ip": "192.168.0.10",
                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [],
              "forward": false,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [],
              "locked": false,
              "drop_private": false
            },
            {
              "id": "sw",
              "kind": "switch",
              "name": "SW",
              "x": 310,
              "y": 180,
              "ifaces": [
                {
                  "name": "p1",
                  "mac": "28:28:00:00:02:41",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                },
                {
                  "name": "p2",
                  "mac": "28:28:00:00:02:42",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                },
                {
                  "name": "p3",
                  "mac": "28:28:00:00:02:43",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                },
                {
                  "name": "p4",
                  "mac": "28:28:00:00:02:44",
                  "ip": null,
                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [],
              "forward": false,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [],
              "locked": false,
              "drop_private": false
            },
            {
              "id": "srv",
              "kind": "server",
              "name": "Сервер",
              "x": 520,
              "y": 180,
              "ifaces": [
                {
                  "name": "eth0",
                  "mac": "28:28:00:00:02:45",
                  "ip": "192.168.0.20",
                  "prefix": 24,
                  "up": true
                }
              ],
              "routes": [],
              "forward": false,
              "nat": [],
              "fw": {
                "policy": "ACCEPT",
                "rules": []
              },
              "services": [
                {
                  "proto": "tcp",
                  "port": 22
                }
              ],
              "locked": false,
              "drop_private": false,
              "ssh": {
                "host_key": "SHA256:hostKeyA1",
                "password_auth": true,
                "users": {
                  "alice": {
                    "keys": [],
                    "password": "alice123"
                  }
                }
              }
            }
          ],
          "links": [
            {
              "a": "pc:eth0",
              "b": "sw:p1",
              "km": 0.01,
              "mbps": 1000
            },
            {
              "a": "srv:eth0",
              "b": "sw:p2",
              "km": 0.01,
              "mbps": 1000
            }
          ]
        },
        "goals": [
          {
            "id": "g1",
            "text": "Вход alice по ключу работает",
            "ssh": {
              "from": "pc",
              "to": "@srv",
              "user": "alice",
              "auth": "key"
            }
          },
          {
            "id": "g2",
            "text": "Вход по паролю закрыт",
            "ssh": {
              "from": "pc",
              "to": "@srv",
              "user": "alice",
              "pass": "alice123",
              "auth": "password",
              "expect": "fail"
            }
          }
        ],
        "solution": [
          {
            "op": "cmd",
            "dev": "pc",
            "line": "ssh-keygen"
          },
          {
            "op": "cmd",
            "dev": "pc",
            "line": "ssh-copy-id -P alice123 alice@192.168.0.20"
          },
          {
            "op": "cmd",
            "dev": "srv",
            "line": "sshd password off"
          }
        ]
      }
    },
    {
