":"Дальше — раздел «Rust после Python».","body":[{"t":"scene","labels":["Запомнить","Шпаргалка","Дальше"],"captions":["struct — поля, impl — методы, enum — варианты с данными, match — обработка всех","Option — «значение или ничего», Result — «получилось или ошибка»","Дальше раздел «Rust после Python»: сравним все темы по очереди и закрепим"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"struct","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"impl","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"enum","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"match","tone":"green","size":11.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["struct P { x: i32 }","impl P { fn new(x: i32) -> P { P { x } } }","enum E { A, B(i32) }","let o: Option<i32> = Some(1);"],"lang":"rust","size":8.5,"lh":22.0,"w":340.0}],[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":240.0,"h":34.0,"text":"Python → Rust: типы, функции, …","tone":"blue","size":10.5,"sub_size":8.5}]],"cues":[11.4,22.6]}]}]}