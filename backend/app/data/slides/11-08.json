on*","yield","yield*"],"captions":["Функция со звёздочкой при вызове не выполняется, а возвращает объект-генератор","Каждый yield приостанавливает выполнение и отдаёт значение; следующий next() продолжает с того же места","yield* делегирует перебор другому итерируемому объекту; на генераторах построены и async-функции"],"frames":[[{"t":"code","id":"c","x":30.0,"y":36.0,"lines":["function* gen() {","  yield 1;","  yield 2;","}","const g = gen();   // ничего не выполнено"],"hl":[0,4],"lang":"js","size":10.0,"lh":20.0,"w":310.0}],[{"t":"code","id":"c","x":20.0,"y":24.0,"lines":["function* fib() {","  let [a, b] = [0, 1];","  while (true) {","    yield a;","    [a, b] = [b, a + b];","  }","}","[...take(fib(), 6)]  // 0 1 1 2 3 5"],"hl":[3],"lang":"js","size":9.5,"lh":18.0,"w":330.0}],[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["function* walk(t) {","  if (!t) return;","  yield* walk(t.left);","  yield t.value;","  yield* walk(t.right);","}"],"hl":[2,4],"lang":"js","size":10.0,"lh":20.0,"w":310.0}]],"cues":[10.8,28.5]}]},{"title":"Итоги","sub":"Что дальше","short":"Итоги","main":"Дальше — асинхронность: цикл событий, промисы, async и await.","body":[{"t":"scene","labels":["Классы","Итераторы","Дальше"],"captions":["Каждый объект ссылается на прототип; класс — запись конструктора и прототипа; поля с #, static, get и set","Наследование — extends и super, но композиция часто надёжнее; итераторы питают for…of и spread, а генераторы пишут их коротко","Дальше — модули и ошибки, а затем асинхронность: промисы, async и await"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":120.0,"h":30.0,"text":"прототип","tone":"yellow","size":10.5,"sub_size":8.5},{"t":"cell","id":"b","x":240.0,"y":60.0,"w":130.0,"h":30.0,"text":"class #поле","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"c","x":160.0,"y":116.0,"w":190.0,"h":28.0,"text":"this теряется — привязывайте","tone":"green","size":9.5,"sub_size":8.5}],[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":120.0,"h":30.0,"t