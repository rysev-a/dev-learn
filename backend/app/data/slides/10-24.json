роки","FromStr даёт \"…\".parse::<T>() для своего типа; Display даёт to_string()"],"frames":[[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["impl From<Celsius> for Kelvin { … }","let k: Kelvin = c.into();"],"hl":[1],"lang":"rust","size":10.0,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["fn open(p: impl AsRef<Path>) { … }","fn name(s: impl Into<String>) { … }"],"lang":"rust","size":10.0,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["impl FromStr for Point { … }","let p: Point = \"1,2\".parse().unwrap();"],"hl":[1],"lang":"rust","size":9.5,"lh":26.0,"w":340.0}]],"cues":[11.1,30.0]}]},{"title":"std::iter","sub":"Конструкторы итераторов","short":"iter","main":"once, repeat, successors, from_fn; адаптеры и потребители.","body":[{"t":"scene","labels":["once, repeat, empty","successors, from_fn","Адаптеры и потребители"],"captions":["iter::once(x), repeat(x), empty() — маленькие кирпичики","successors(Some(1), |&x| Some(x * 2)) — последовательность «следующий из предыдущего»; from_fn вызывает замыкание на каждом шаге","chain, zip, cycle, skip, take, step_by — адаптеры; sum, product, count, last, min, max, fold, collect — потребители"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"once","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"repeat","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"empty","tone":"blue","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["iter::successors(Some(1), |&x| Some(x * 2))","    .take(5)   // 1 2 4 8 16"],"hl":[0],"lang":"rust","size":8.5,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["a.iter().chain(b.iter()).zip(c.iter())","    .skip(1).take(3).sum::<i32>()"],"lang":"rust","size":9.0,"lh":26.0,"w":340.0}]],"cues":[20.2,25.1]}]},{"title":"env, process, документация","sub":"Окружение","short