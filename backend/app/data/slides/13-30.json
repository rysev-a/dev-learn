file__","Плагины: pkgutil перечисляет подмодули, importlib.metadata читает точки входа — без явного списка"],"frames":[[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["mod = importlib.import_module('json')","func = getattr(mod, 'dumps')","func({'a': 1})"],"hl":[0,1],"lang":"python","size":11.0,"lh":26.0,"w":310.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["'json' in sys.modules","json.__name__    # 'json'","json.__file__    # путь к файлу"],"lang":"python","size":11.0,"lh":26.0,"w":300.0}],[{"t":"cell","id":"a","x":70.0,"y":70.0,"w":100.0,"h":30.0,"text":"пакет\nplugins/","tone":"blue","size":9.5,"sub_size":8.5},{"t":"cell","id":"b","x":190.0,"y":70.0,"w":100.0,"h":30.0,"text":"iter_modules","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"c~cell","x":306.0,"y":70.0,"w":90.0,"h":30.0,"text":"import_module","tone":"yellow","size":9.0,"sub_size":8.5},{"t":"line","id":"e1","x1":120.0,"y1":70.0,"x2":140.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"line","id":"e2","x1":240.0,"y1":70.0,"x2":262.0,"y2":70.0,"tone":"yellow","arrow":true,"width":1.6}]],"cues":[15.4,24.2]}]},{"title":"Применения","sub":"Где это нужно","short":"Применения","main":"Вся информация уже лежит в объектах.","body":[{"t":"scene","labels":["Представление","Конфигурации","Фреймворки"],"captions":["Универсальный __repr__ и сериализация класса в словарь собираются из vars и полей","Тесты находят по префиксу test_, а командная строка строится по подписи функции","Внедрение зависимостей: фреймворк смотрит на параметры и аннотации вашей функции и сам решает, что передать"],"frames":[[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["def to_dict(obj):","    return dict(vars(obj))","to_dict(p)   # {'x': 1, 'y': 2}"],"hl":[1],"lang":"python","size":11.0,"lh":26.0,"w":310.0}],[{"t":"code","id":"c","x":30.0,"y":56.0,"lines":["for name in dir(module):","    if name.startswith('test_'):","        getattr(module, name)()"],"hl":[1,2],"lang":"python","size":11.0,"lh":26.0,"w":310.0}