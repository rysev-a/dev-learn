ue","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"rayon: вычисления","tone":"green","size":10.0,"sub_size":8.5}]],"cues":[12.2,21.2]}]},{"title":"Параллелизм","sub":"Work-stealing и Send","short":"Параллелизм","main":"Многопоточный рантайм и требование Send.","body":[{"t":"scene","labels":["Один поток","Work-stealing","Send"],"captions":["asyncio: один поток, задачи не выполняются одновременно — гонок нет, ядра не используются","tokio по умолчанию многопоточный: пул рабочих потоков и кража работы; задача может менять поток между .await","spawn требует Send + 'static: данные, живущие через .await, безопасно переходят между потоками — гонок данных нет"],"frames":[[{"t":"cell","id":"t","x":180.0,"y":40.0,"w":100.0,"h":26.0,"text":"1 поток","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"k0","x":80.0,"y":100.0,"w":70.0,"h":28.0,"text":"задача 1","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"k1","x":180.0,"y":100.0,"w":70.0,"h":28.0,"text":"задача 2","tone":"blue","size":9.0,"sub_size":8.5},{"t":"cell","id":"k2","x":280.0,"y":100.0,"w":70.0,"h":28.0,"text":"задача 3","tone":"blue","size":9.0,"sub_size":8.5}],[{"t":"cell","id":"t0","x":60.0,"y":40.0,"w":66.0,"h":26.0,"text":"поток 1","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"t1","x":140.0,"y":40.0,"w":66.0,"h":26.0,"text":"поток 2","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"t2","x":220.0,"y":40.0,"w":66.0,"h":26.0,"text":"поток 3","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"t3","x":300.0,"y":40.0,"w":66.0,"h":26.0,"text":"поток 4","tone":"green","size":9.0,"sub_size":8.5},{"t":"cell","id":"k0","x":50.0,"y":100.0,"w":56.0,"h":26.0,"text":"1","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"k1","x":115.0,"y":100.0,"w":56.0,"h":26.0,"text":"2","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"k2","x":180.0,"y":100.0,"w":56.0,"h":26.0,"text":"3","tone":"blue","size":10.0,"sub_size