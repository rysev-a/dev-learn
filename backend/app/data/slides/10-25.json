uous();"],"lang":"rust","size":11.0,"lh":28.0,"w":340.0}]],"cues":[13.2,28.4]}]},{"title":"HashMap","sub":"Swiss table","short":"HashMap","main":"Метки хеша, рост, retain, drain.","body":[{"t":"scene","labels":["Swiss table","Рост","Методы"],"captions":["Таблица hashbrown: метки хеша хранятся отдельно; сравнение по 16 меток SIMD-инструкциями","Вставка и поиск O(1) в среднем; при заполнении — рост вдвое и перехеширование; with_capacity и reserve","retain, drain, extend, entry; порядок обхода зависит от хеша и случайной соли"],"frames":[[{"t":"cell","id":"h0","x":60.0,"y":46.0,"w":54.0,"h":32.0,"text":"a","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"h1","x":126.0,"y":46.0,"w":54.0,"h":32.0,"text":"b","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"h2","x":192.0,"y":46.0,"w":54.0,"h":32.0,"text":"c","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"h3","x":258.0,"y":46.0,"w":54.0,"h":32.0,"text":"d","tone":"muted","size":11.0,"sub_size":8.5},{"t":"cell","id":"v0","x":60.0,"y":100.0,"w":54.0,"h":32.0,"text":"·","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"v1","x":126.0,"y":100.0,"w":54.0,"h":32.0,"text":"·","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"v2","x":192.0,"y":100.0,"w":54.0,"h":32.0,"text":"·","tone":"green","size":11.0,"sub_size":8.5},{"t":"cell","id":"v3","x":258.0,"y":100.0,"w":54.0,"h":32.0,"text":"·","tone":"green","size":11.0,"sub_size":8.5},{"t":"text","id":"n","x":180.0,"y":140.0,"text":"метки хеша — отдельно","size":9.0}],[{"t":"cell","id":"pa","x":90.0,"y":60.0,"w":130.0,"h":34.0,"text":"cap 8\n→ 16 + rehash","tone":"yellow","size":10.0,"sub_size":8.5},{"t":"cell","id":"pb","x":270.0,"y":60.0,"w":130.0,"h":34.0,"text":"reserve(n)\nзаранее","tone":"green","size":10.0,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":40.0,"lines":["m.retain(|_, v| *v > 0);","m.extend(other);","for (k, v) in m.drain() { … }"],"lang":"rust","size":10.0,"lh":24.0,"w":340.0}]],"cues":[17.3,27.9]}]},{