енний poll Pending → остаёмся; Ready → к следующему","Размер фьючера — самое большое состояние: проверяется size_of_val(&async_block)"],"frames":[[{"t":"cell","id":"a0","x":50.0,"y":66.0,"w":76.0,"h":30.0,"text":"Start","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"a1","x":136.0,"y":66.0,"w":76.0,"h":30.0,"text":"Wait1","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"a2","x":222.0,"y":66.0,"w":76.0,"h":30.0,"text":"Wait2","tone":"blue","size":10.5,"sub_size":8.5},{"t":"cell","id":"a3","x":308.0,"y":66.0,"w":76.0,"h":30.0,"text":"Done","tone":"blue","size":10.5,"sub_size":8.5}],[{"t":"cell","id":"a","x":70.0,"y":66.0,"w":70.0,"h":30.0,"text":"Wait1","tone":"blue","size":10.5,"sub_size":8.5},{"t":"line","id":"e","x1":110.0,"y1":66.0,"x2":170.0,"y2":66.0,"tone":"green","arrow":true,"width":1.6},{"t":"cell","id":"b","x":210.0,"y":66.0,"w":70.0,"h":30.0,"text":"Wait2","tone":"blue","size":10.5,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":110.0,"text":"Ready → следующий","size":10.0}],[{"t":"code","id":"c","x":20.0,"y":50.0,"lines":["let f = async { let big = [0u8; 100]; tick().await; big.len() };","println!(\"{}\", size_of_val(&f));"],"hl":[1],"lang":"rust","size":8.0,"lh":28.0,"w":340.0}]],"cues":[12.9,30.5]}]},{"title":"Ловушки","sub":"Типичные ошибки","short":"Ловушки","main":"Pending без wake, poll после Ready, блокировка.","body":[{"t":"scene","labels":["Pending без wake","Poll после Ready","Блокировка в poll"],"captions":["Зависание: вернули Pending и забыли организовать wake","Poll после Ready — поведение не определено, может быть паника: оборачивайте в Fuse","Блокирующий вызов внутри poll замораживает исполнитель; потерянный и устаревший вейкер; гонка флага и вейкера — мьютекс"],"frames":[[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":230.0,"h":34.0,"text":"Pending, wake нет ✕","tone":"red","size":11.5,"sub_size":8.5}],[{"t":"cell","id":"a","x":180.0,"y":60.0,"w":230.0,"h":34.0,"text":"Ready → ещё poll ✕","tone":"red","size":11.5,"su