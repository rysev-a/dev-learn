яет. Закон 2: map(f ∘ g) равен map(g) и затем map(f)","Если есть ещё flatMap — «применить функцию, возвращающую контейнер, и выпрямить» — это монада: у массива flatMap, у промиса then"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":100.0,"h":34.0,"text":"[1, 2, 3]","tone":"blue","size":11.0,"sub_size":8.5},{"t":"line","id":"e","x1":140.0,"y1":70.0,"x2":222.0,"y2":70.0,"tone":"green","arrow":true,"width":1.6},{"t":"text","id":"m","x":180.0,"y":56.0,"text":"map(f)","size":10.0,"mono":true},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":100.0,"h":34.0,"text":"[f(1), f(2), f(3)]","tone":"green","size":8.5,"sub_size":8.5}],[{"t":"code","id":"c","x":20.0,"y":44.0,"lines":["xs.map(x => x)   ≡  xs","","xs.map(x => f(g(x)))","  ≡  xs.map(g).map(f)"],"hl":[0,3],"lang":"js","size":10.5,"lh":22.0,"w":330.0}],[{"t":"code","id":"c","x":20.0,"y":36.0,"lines":["[1, 2].flatMap(x => [x, x * 10])","// [1, 10, 2, 20]","","fetchUser(1).then(u => fetchPosts(u.id))"],"hl":[0,3],"lang":"js","size":9.5,"lh":22.0,"w":330.0}]],"cues":[15.0,35.4]}]},{"title":"Ленивость","sub":"Генераторы и итераторы","short":"Ленивость","main":"Ленивый конвейер не создаёт промежуточных массивов.","body":[{"t":"scene","labels":["Генераторы","Без промежуточных массивов","Iterator helpers"],"captions":["Генераторы выдают значения по одному: из бесконечной последовательности можно взять первые десять","Ленивый конвейер не создаёт промежуточных массивов: каждый элемент проходит все шаги целиком","Новые методы итераторов — map, filter, take — дают ленивые цепочки без библиотек; но ленивость усложняет отладку"],"frames":[[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["function* nat() {","  let n = 1;","  while (true) yield n++;","}"],"hl":[2],"lang":"js","size":11.0,"lh":22.0,"w":310.0}],[{"t":"cell","id":"e0","x":60.0,"y":50.0,"w":30.0,"h":22.0,"text":"1","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"e1","x":80.0,"y":80.0,"w":30.0,"h":22.0,"text":"2","tone":"green","size":10.0,"sub_size":8.5},{