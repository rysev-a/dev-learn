и — это ссылочная прозрачность","Нечисты: Math.random, Date.now, изменение аргумента, console.log, обращение к DOM, чтение файла","Чистые функции проверяются без моков, их безопасно кэшировать, переставлять и запускать параллельно"],"frames":[[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["const add = (a, b) => a + b;","","add(2, 3)   // всегда 5","// можно заменить на 5"],"hl":[0,2],"lang":"js","size":11.0,"lh":22.0,"w":300.0}],[{"t":"code","id":"c","x":20.0,"y":30.0,"lines":["const f1 = () => Math.random();","const f2 = () => Date.now();","const f3 = (a) => a.push(1);","const f4 = (x) => console.log(x);"],"bad":[0,1,2,3],"lang":"js","size":10.5,"lh":22.0,"w":330.0}],[{"t":"cell","id":"p0","x":66.0,"y":70.0,"w":100.0,"h":34.0,"text":"тесты без моков","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"p1","x":180.0,"y":70.0,"w":100.0,"h":34.0,"text":"кэширование","tone":"green","size":9.5,"sub_size":8.5},{"t":"cell","id":"p2","x":294.0,"y":70.0,"w":100.0,"h":34.0,"text":"параллельность","tone":"green","size":9.5,"sub_size":8.5}]],"cues":[15.0,31.1]}]},{"title":"Эффекты на краях","sub":"Ядро и оболочка","short":"Эффекты","main":"Время и случайность передают параметром.","body":[{"t":"scene","labels":["Ядро и оболочка","Внедрение зависимостей","Тестирование"],"captions":["Эффекты нужны, но отделяются от вычислений: чистое ядро внутри, ввод-вывод на краях","Текущее время или случайное число передают параметром — тогда в тесте подставляют фиксированное","Логику проверяют мгновенно, а тонкий слой взаимодействия с миром — отдельно"],"frames":[[{"t":"cell","id":"o","x":180.0,"y":76.0,"w":240.0,"h":100.0,"text":"","tone":"muted","size":9.0,"sub_size":8.5},{"t":"text","id":"t","x":180.0,"y":40.0,"text":"оболочка: ввод-вывод","tone":"muted","size":9.5},{"t":"cell","id":"c","x":180.0,"y":84.0,"w":130.0,"h":50.0,"text":"чистое ядро","tone":"green","size":11.0,"sub_size":8.5}],[{"t":"code","id":"c~code","x":30.0,"y":40.0,"lines":["const makeId = (rand) =>","  'id' + M