ойное освобождение, гонки данных","По оценкам Microsoft и Chromium, около 70% серьёзных уязвимостей — ошибки памяти","Rust переносит правила в компилятор: опасный код не соберётся, и ошибка находится на вашем компьютере"],"frames":[[{"t":"cell","id":"e0","x":90.0,"y":50.0,"w":160.0,"h":28.0,"text":"выход за массив","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"e1","x":270.0,"y":50.0,"w":160.0,"h":28.0,"text":"освобождённая память","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"e2","x":90.0,"y":90.0,"w":160.0,"h":28.0,"text":"двойной free","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"e3","x":270.0,"y":90.0,"w":160.0,"h":28.0,"text":"гонка данных","tone":"red","size":9.5,"sub_size":8.5}],[{"t":"bar","id":"a","x":120.0,"y":130.0,"w":60.0,"hh":90.0,"max":100.0,"tone":"red","text":"70%"},{"t":"bar","id":"b","x":240.0,"y":130.0,"w":60.0,"hh":38.0,"max":100.0,"tone":"blue","text":"30%"},{"t":"text","id":"l1","x":120.0,"y":148.0,"text":"память","size":9.0},{"t":"text","id":"l2","x":240.0,"y":148.0,"text":"прочее","size":9.0}],[{"t":"cell","id":"a~cell","x":90.0,"y":66.0,"w":120.0,"h":34.0,"text":"ошибка при\nсборке","tone":"green","size":10.0,"sub_size":8.5},{"t":"cell","id":"b~cell","x":270.0,"y":66.0,"w":120.0,"h":34.0,"text":"а не у\nпользователя","tone":"green","size":10.0,"sub_size":8.5},{"t":"line","id":"e","x1":150.0,"y1":66.0,"x2":210.0,"y2":66.0,"tone":"green","arrow":true,"width":1.6}]],"cues":[15.8,31.7]}]},{"title":"Где используется","sub":"От браузера до ядра","short":"Где","main":"Firefox, Android, Windows, облака, утилиты и драйверы Linux.","body":[{"t":"scene","labels":["Браузеры и системы","Облака и утилиты","Ядро Linux"],"captions":["Части Firefox, Android и Windows написаны на Rust","Облачные сервисы, базы данных, консольные утилиты, игровые движки, встраиваемые устройства, WebAssembly","С 2022 года Rust допускается в ядре Linux: на нём пишут драйверы"],"frames":[[{"t":"cell","id":"a0","x":70.0,"y":70.0,"w":90.0,"h":34.