 макрос, печатает строку.","body":[{"t":"scene","labels":["fn main","println!","Запуск"],"captions":["fn объявляет функцию, main — точка входа: с неё начинается выполнение; тело — в фигурных скобках","println! печатает строку и переводит строку; восклицательный знак значит «макрос»; в конце — точка с запятой","Запустили — на экране «Привет, мир!»; программа закончилась"],"frames":[[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["fn main() {","","}"],"hl":[0,2],"lang":"rust","size":13.0,"lh":22.0,"w":300.0}],[{"t":"code","id":"c","x":30.0,"y":40.0,"lines":["fn main() {","    println!(\"Привет, мир!\");","}"],"hl":[1],"lang":"rust","size":13.0,"lh":22.0,"w":300.0}],[{"t":"code","id":"c","x":30.0,"y":24.0,"lines":["fn main() {","    println!(\"Привет, мир!\");","}"],"lang":"rust","size":11.0,"lh":18.0,"w":300.0},{"t":"cell","id":"o","x":180.0,"y":110.0,"w":220.0,"h":34.0,"text":"Привет, мир!","tone":"green","size":12.0,"sub_size":8.5}]],"cues":[9.2,21.8]}]},{"title":"Форматирование вывода","sub":"{} и \\n","short":"println!","main":"{} подставляет значения; {{ }} печатает скобки; print! не переводит строку.","body":[{"t":"scene","labels":["Скобки {}","Имена и {{ }}","print! и \\n"],"captions":["Пара фигурных скобок в строке заменяется значением: println!(\"{} + {} = {}\", 2, 3, 5);","Внутри скобок можно писать имя переменной: {name}; две скобки подряд — {{ — печатают одну настоящую","print! не переводит строку; перевод строки задаётся символом \\n; \\t — табуляция"],"frames":[[{"t":"code","id":"c","x":14.0,"y":40.0,"lines":["println!(\"{} + {} = {}\", 2, 3, 5);"],"hl":[0],"lang":"rust","size":10.0,"lh":20.0,"w":340.0},{"t":"cell","id":"o","x":180.0,"y":100.0,"w":160.0,"h":28.0,"text":"2 + 3 = 5","tone":"green","size":12.0,"sub_size":8.5}],[{"t":"code","id":"c","x":14.0,"y":36.0,"lines":["let name = \"Аня\";","println!(\"Привет, {name}! {{ok}}\");"],"hl":[1],"lang":"rust","size":10.0,"lh":20.0,"w":340.0},{"t":"cell","id":"o","x":180.0,"y":106.0,"w":200.0,"h":28.0,"text