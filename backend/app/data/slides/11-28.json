":["Proxy оборачивает объект: get и set перехватывают чтение и запись полей","get → track(поле): эффект зависит от поля; set → trigger(поле): будим подписчиков поля","Деструктуризация и копии теряют связь; прокси не равен оригиналу"],"frames":[[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["const state = reactive({ count: 0 });","effect(() => log(state.count));   // читает поле","state.count++;                    // пишет поле"],"hl":[1,2],"lang":"js","size":9.0,"lh":26.0,"w":340.0}],[{"t":"code","id":"c","x":10.0,"y":20.0,"lines":["get(obj, key) { track(obj, key); return obj[key]; },","set(obj, key, v) { obj[key] = v; trigger(obj, key); return true; }"],"hl":[0,1],"lang":"js","size":8.5,"lh":30.0,"w":340.0}],[{"t":"cell","id":"a","x":90.0,"y":70.0,"w":150.0,"h":36.0,"text":"const { count } = state\n— потеряли реактивность","tone":"red","size":8.5,"sub_size":8.5},{"t":"cell","id":"b","x":270.0,"y":70.0,"w":150.0,"h":36.0,"text":"state === raw\n→ false","tone":"yellow","size":10.0,"sub_size":8.5}]],"cues":[12.8,25.5]}]},{"title":"Асинхронность и ошибки","sub":"Гонки и сбои","short":"Async","main":"Асинхронный результат учитывают только от последнего запроса; ошибки эффекта не должны ломать остальные.","body":[{"t":"scene","labels":["Гонка запросов","Последний выигрывает","Ошибки и предохранитель"],"captions":["Старый ответ приходит позже нового и перетирает его","Запоминаем номер последнего запроса и игнорируем устаревшие","Ошибку эффекта ловят и передают обработчику; цикл записи в собственный источник — стоп после лимита"],"frames":[[{"t":"cell","id":"a","x":90.0,"y":60.0,"w":110.0,"h":28.0,"text":"запрос id=1","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"b","x":90.0,"y":110.0,"w":110.0,"h":28.0,"text":"запрос id=2","tone":"blue","size":10.0,"sub_size":8.5},{"t":"cell","id":"c","x":270.0,"y":60.0,"w":110.0,"h":28.0,"text":"ответ 1 — позже ✗","tone":"red","size":9.5,"sub_size":8.5},{"t":"cell","id":"d","x":270.0,"y":110.0,"w":110.0,"h":28.0,"text":"о