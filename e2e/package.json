{
  "name": "say-e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "E2E-тесты курса на Playwright (TypeScript): Leptos-фронт + backend, проверка по одной главе одной книги",
  "scripts": {
    "build:app": "cd ../frontend/app && trunk build --dist ../../e2e/.dist",
    "build:backend": "cd ../backend && cargo build",
    "build": "npm run build:app && npm run build:backend",
    "test": "playwright test",
    "test:book": "playwright test books/",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
